(*
# Graphics3D
Software 3D rasterizer.
Renders Gouraud-shaded and flat-coloured triangles into an integer pixel buffer.

The pixel format is ABGR (Alpha<<24 | Blue<<16 | Green<<8 | Red), matching
Simba's TImage / PColorBGRA convention. Colour palette values come from the
Palette field, which the caller points at a ColorUtils.SpritePalette result.
*)
{$include_once ../utils/color.simba}
{$include_once ./circularangle.simba}

type
  TGraphics3D = record
    // Rasterizer2D fields
    Pixels, Palette: TIntegerArray;
    PixelWidth, PixelHeight,
    DrawTop, DrawBottom, DrawLeft, DrawRight: Integer;

    // Graphics3D fields
    Zoom, CenterX, CenterY,
    ClipWidth, ClipHeight,
    ClipNegMidX, ClipMidX2, ClipNegMidY, ClipMidY2: Integer;
    ClipY: TIntegerArray;
    RasterClipEnable,
    RasterGouraudLowRes: Boolean;
    RasterAlpha: Integer;
  end;

(*
## Graphics3D.SetDrawRegion
```pascal
procedure TGraphics3D.SetDrawRegion(bounds: TBox);
```
Restricts drawing to `bounds`, clipped to the buffer. Call
{ref}`TGraphics3D.SetRasterClipping` afterwards to rebuild the row table for the new region.
*)
procedure TGraphics3D.SetDrawRegion(bounds: TBox);
begin
  bounds := bounds.Clip([0,0,Self.PixelWidth, Self.PixelHeight]);

  Self.DrawLeft := bounds.X1;
  Self.DrawTop := bounds.Y1;
  Self.DrawRight := bounds.X2;
  Self.DrawBottom := bounds.Y2;
end;

(*
## Graphics3D.SetRasterBuffer
```pascal
procedure TGraphics3D.SetRasterBuffer(constref buf: TIntegerArray; w, h: Integer);
```
Points the rasterizer at the pixel buffer it should draw into and resets the draw region to all
of it.

The buffer is shared rather than copied, so whatever owns it sees the drawing as it happens.
*)
procedure TGraphics3D.SetRasterBuffer(constref buf: TIntegerArray; w, h: Integer);
begin
  Self.Pixels := buf;
  Self.PixelWidth := w;
  Self.PixelHeight := h;

  Self.DrawLeft := 0;
  Self.DrawTop := 0;
  Self.DrawRight := Min(w, Self.PixelWidth);
  Self.DrawBottom := Min(h, Self.PixelHeight);
end;

(*
## Graphics3D.Reset
```pascal
procedure TGraphics3D.Reset();
```
Clears the pixel buffer to transparent.
*)
procedure TGraphics3D.Reset();
var
  i: Integer;
begin
  for i := 0 to High(Self.Pixels) do
    Self.Pixels[i] := 0;
end;

(*
## Graphics3D.UpdateClipDims
```pascal
procedure TGraphics3D.UpdateClipDims();
```
Recentres projection on the middle of the clip region and recomputes the bounds triangles are
tested against.
*)
procedure TGraphics3D.UpdateClipDims();
begin
  Self.CenterX := Self.ClipWidth div 2;
  Self.CenterY := Self.ClipHeight div 2;
  Self.ClipNegMidX := -Self.CenterX;
  Self.ClipMidX2 := Self.ClipWidth - Self.CenterX;
  Self.ClipNegMidY := -Self.CenterY;
  Self.ClipMidY2 := Self.ClipHeight - Self.CenterY;
end;

(*
## Graphics3D.SetRasterClipping
```pascal
procedure TGraphics3D.SetRasterClipping();
```
Prepares the rasterizer for the current draw region.

`ClipY` ends up holding the buffer offset of each row of that region, so a scanline can start
from a single lookup instead of a multiply. It is grown to the next power of two and kept, since
this runs per rendered sprite.
*)
procedure TGraphics3D.SetRasterClipping();
var
  v, area, i: Integer;
begin
  Self.ClipWidth := Self.DrawRight - Self.DrawLeft;
  Self.ClipHeight := Self.DrawBottom - Self.DrawTop;
  Self.UpdateClipDims();

  if Length(Self.ClipY) < Self.ClipHeight then
  begin
    v := Self.ClipHeight - 1;
    v := v or (v shr 1);
    v := v or (v shr 2);
    v := v or (v shr 4);
    v := v or (v shr 8);
    v := v or (v shr 16);
    SetLength(Self.ClipY, v + 1);
  end;

  area := Self.DrawLeft + Self.PixelWidth * Self.DrawTop;
  for i := 0 to Self.ClipHeight - 1 do
  begin
    Self.ClipY[i] := area;
    area += Self.PixelWidth;
  end;
end;

(*
## Graphics3D.SetOffset
```pascal
procedure TGraphics3D.SetOffset(x, y: Integer);
```
Moves the point that projection treats as the centre to `x, y` within the buffer.

An item icon is drawn around the middle of its 36 by 32 canvas rather than around the middle of
the draw region, which is what this is for.
*)
procedure TGraphics3D.SetOffset(x, y: Integer);
var
  base, row, col: Integer;
begin
  base := Self.ClipY[0];
  row := base div Self.PixelWidth;
  col := base - row * Self.PixelWidth;

  Self.CenterX := x - col;
  Self.CenterY := y - row;
  Self.ClipNegMidX := -Self.CenterX;
  Self.ClipMidX2 := Self.ClipWidth - Self.CenterX;
  Self.ClipNegMidY := -Self.CenterY;
  Self.ClipMidY2 := Self.ClipHeight - Self.CenterY;
end;

(*
## Graphics3D.GouraudRaster
```pascal
procedure TGraphics3D.GouraudRaster(baseIdx, leftX, rightX, startColor, colorStep: Integer);
```
Interpolates a colour value across [leftX, rightX]
using a fixed-point step, looks up each pixel in the colour palette, and optionally
applies alpha blending.

`startColor` is the colour extrapolated back to x = 0, not the colour at
`leftX` - this re-adds leftX * colorStep itself, so that clipping leftX to 0 still
lands on the right colour. When RasterGouraudLowRes is true, every 4 pixels share one
colour for speed (as the original client does on low-res mode).
*)
procedure TGraphics3D.GouraudRaster(baseIdx, leftX, rightX, startColor, colorStep: Integer);
var
  span, i, pixelIdx, color, pal, blended, existing, alpha, invAlpha: Integer;
begin
  if Self.RasterClipEnable then
  begin
    if rightX > Self.ClipWidth then
      rightX := Self.ClipWidth;
    if leftX < 0 then
      leftX := 0;
  end;

  if leftX >= rightX then
    Exit;

  pixelIdx := baseIdx + leftX;
  color := startColor + leftX * colorStep;

  if not Self.RasterGouraudLowRes then
  begin
    span := rightX - leftX;
    if Self.RasterAlpha = 0 then
    begin
      for i := 0 to span - 1 do
      begin
        Self.Pixels[pixelIdx] := Self.Palette[color shr 8];
        color += colorStep;
        Inc(pixelIdx);
      end;
    end
    else
    begin
      alpha := Self.RasterAlpha;
      invAlpha := 256 - alpha;
      for i := 0 to span - 1 do
      begin
        pal := Self.Palette[color shr 8];
        color += colorStep;
        blended := ((invAlpha * (pal and $FF00) shr 8) and $FF00) +
                   ((invAlpha * (pal and $FF00FF) shr 8) and $FF00FF);
        existing := Self.Pixels[pixelIdx];
        Self.Pixels[pixelIdx] := (((existing and $FF00FF) * alpha shr 8) and $FF00FF) +
                                 blended +
                                 ((alpha * (existing and $FF00) shr 8) and $FF00);
        Inc(pixelIdx);
      end;
    end;
    Exit;
  end;

  // Low-res mode: 4x pixel blocks
  span := (rightX - leftX) div 4;
  colorStep := colorStep shl 2;
  if Self.RasterAlpha = 0 then
  begin
    for i := 0 to span - 1 do
    begin
      pal := Self.Palette[color shr 8];
      Self.Pixels[pixelIdx] := pal;
      Self.Pixels[pixelIdx + 1] := pal;
      Self.Pixels[pixelIdx + 2] := pal;
      Self.Pixels[pixelIdx + 3] := pal;
      color += colorStep;
      Inc(pixelIdx, 4);
    end;

    span := (rightX - leftX) and 3;
    if span > 0 then
    begin
      pal := Self.Palette[color shr 8];
      for i := 0 to span - 1 do
        Self.Pixels[pixelIdx + i] := pal;
    end;
    Exit;
  end;

  alpha := Self.RasterAlpha;
  invAlpha := 256 - alpha;

  for i := 0 to span - 1 do
  begin
    pal := Self.Palette[color shr 8];
    color += colorStep;
    blended := ((invAlpha * (pal and $FF00) shr 8) and $FF00) +
               ((invAlpha * (pal and $FF00FF) shr 8) and $FF00FF);
    existing := Self.Pixels[pixelIdx];
    Self.Pixels[pixelIdx] := (((existing and $FF00FF) * alpha shr 8) and $FF00FF) + blended + ((alpha * (existing and $FF00) shr 8) and $FF00);
    existing := Self.Pixels[pixelIdx + 1];
    Self.Pixels[pixelIdx + 1] := (((existing and $FF00FF) * alpha shr 8) and $FF00FF) + blended + ((alpha * (existing and $FF00) shr 8) and $FF00);
    existing := Self.Pixels[pixelIdx + 2];
    Self.Pixels[pixelIdx + 2] := (((existing and $FF00FF) * alpha shr 8) and $FF00FF) + blended + ((alpha * (existing and $FF00) shr 8) and $FF00);
    existing := Self.Pixels[pixelIdx + 3];
    Self.Pixels[pixelIdx + 3] := (((existing and $FF00FF) * alpha shr 8) and $FF00FF) + blended + ((alpha * (existing and $FF00) shr 8) and $FF00);
    Inc(pixelIdx, 4);
  end;

  span := (rightX - leftX) and 3;

  if span <= 0 then
    Exit;

  pal := Self.Palette[color shr 8];
  blended := ((invAlpha * (pal and $FF00) shr 8) and $FF00) + ((invAlpha * (pal and $FF00FF) shr 8) and $FF00FF);
  for i := 0 to span - 1 do
  begin
    existing := Self.Pixels[pixelIdx + i];
    Self.Pixels[pixelIdx + i] := (((existing and $FF00FF) * alpha shr 8) and $FF00FF) + blended + ((alpha * (existing and $FF00) shr 8) and $FF00);
  end;
end;

(*
## Graphics3D.GouraudTriangle
```pascal
procedure TGraphics3D.GouraudTriangle(y0, y1, y2, x0, x1, x2, c0, c1, c2: Integer);
```
Fills a triangle whose three corners each have their own colour, blending between them across
the face.

The three vertices are sorted by height and the triangle is walked one scanline at a time, with
the two edges bounding that scanline and the colour along it all advanced by fixed point steps
rather than recomputed. Colour is a palette index, so what is interpolated is the index and not
the colour itself - which is why shading a face means walking its palette rather than mixing
channels. Each scanline is handed to {ref}`TGraphics3D.GouraudRaster`.

A degenerate triangle - one with no area - is dropped, since it has no gradient to interpolate
along.
*)
procedure TGraphics3D.GouraudTriangle(y0, y1, y2, x0, x1, x2, c0, c1, c2: Integer);
var
  dx1, dy1, dx2, dy2, dc1, dc2,
  slope0, slope1, slope2,
  area, dColorDX, dColorDY, pixelRow: Integer;
begin
  dx1 := x1 - x0;
  dy1 := y1 - y0;
  dx2 := x2 - x0;
  dy2 := y2 - y0;

  dc1 := c1 - c0;
  dc2 := c2 - c0;

  slope0 := 0;
  if y2 <> y1 then slope0 := ((x2 - x1) shl 14) div (y2 - y1);
  slope1 := 0;
  if y0 <> y1 then slope1 := (dx1 shl 14) div dy1;
  slope2 := 0;
  if y0 <> y2 then slope2 := (dx2 shl 14) div dy2;

  area := dx1 * dy2 - dx2 * dy1;
  if area = 0 then Exit;

  dColorDX := ((dc1 * dy2 - dc2 * dy1) shl 8) div area;
  dColorDY := ((dc2 * dx1 - dc1 * dx2) shl 8) div area;

  if (y0 <= y1) and (y0 <= y2) then
  begin
    if y0 >= Self.ClipHeight then Exit;
    if y1 > Self.ClipHeight then y1 := Self.ClipHeight;
    if y2 > Self.ClipHeight then y2 := Self.ClipHeight;

    c0 := dColorDX + ((c0 shl 8) - x0 * dColorDX);

    if y1 < y2 then
    begin
      x0 := x0 shl 14;
      x2 := x0;
      if y0 < 0 then
      begin
        x2 -= y0 * slope2;
        x0 -= y0 * slope1;
        c0 -= y0 * dColorDY;
        y0 := 0;
      end;

      x1 := x1 shl 14;
      if y1 < 0 then
      begin
        x1 -= slope0 * y1;
        y1 := 0;
      end;

      if ((y0 = y1) or (slope2 >= slope1)) and ((y0 <> y1) or (slope2 <= slope0)) then
      begin
        y2 -= y1;
        y1 -= y0;
        pixelRow := Self.ClipY[y0];

        while True do
        begin
          Dec(y1);
          if y1 < 0 then
            while True do
            begin
              Dec(y2);
              if y2 < 0 then Exit;
              Self.GouraudRaster(pixelRow, ArithmeticShr(x1, 14), ArithmeticShr(x2, 14), c0, dColorDX);
              x2 += slope2;
              x1 += slope0;
              c0 += dColorDY;
              pixelRow += Self.PixelWidth;
            end;

          Self.GouraudRaster(pixelRow, ArithmeticShr(x0, 14), ArithmeticShr(x2, 14), c0, dColorDX);
          x2 += slope2;
          x0 += slope1;
          c0 += dColorDY;
          pixelRow += Self.PixelWidth;
        end;
      end;

      y2 -= y1;
      y1 -= y0;
      pixelRow := Self.ClipY[y0];

      while True do
      begin
        Dec(y1);
        if y1 < 0 then
          while True do
          begin
            Dec(y2);
            if y2 < 0 then Exit;
            Self.GouraudRaster(pixelRow, ArithmeticShr(x2, 14), ArithmeticShr(x1, 14), c0, dColorDX);
            x2 += slope2;
            x1 += slope0;
            c0 += dColorDY;
            pixelRow += Self.PixelWidth;
          end;

        Self.GouraudRaster(pixelRow, ArithmeticShr(x2, 14), ArithmeticShr(x0, 14), c0, dColorDX);
        x2 += slope2;
        x0 += slope1;
        c0 += dColorDY;
        pixelRow += Self.PixelWidth;
      end;
    end;

    x0 := x0 shl 14;
    x1 := x0;
    if y0 < 0 then
    begin
      x1 -= y0 * slope2;
      x0 -= y0 * slope1;
      c0 -= y0 * dColorDY;
      y0 := 0;
    end;

    x2 := x2 shl 14;
    if y2 < 0 then
    begin
      x2 -= slope0 * y2;
      y2 := 0;
    end;

    if ((y0 <> y2) and (slope2 < slope1)) or ((y0 = y2) and (slope0 > slope1)) then
    begin
      y1 -= y2;
      y2 -= y0;
      pixelRow := Self.ClipY[y0];

      while True do
      begin
        Dec(y2);
        if y2 < 0 then
          while True do
          begin
            Dec(y1);
            if y1 < 0 then Exit;
            Self.GouraudRaster(pixelRow, ArithmeticShr(x2, 14), ArithmeticShr(x0, 14), c0, dColorDX);
            x2 += slope0;
            x0 += slope1;
            c0 += dColorDY;
            pixelRow += Self.PixelWidth;
          end;

        Self.GouraudRaster(pixelRow, ArithmeticShr(x1, 14), ArithmeticShr(x0, 14), c0, dColorDX);
        x1 += slope2;
        x0 += slope1;
        c0 += dColorDY;
        pixelRow += Self.PixelWidth;
      end;
    end;

    y1 -= y2;
    y2 -= y0;
    pixelRow := Self.ClipY[y0];

    while True do
    begin
      Dec(y2);
      if y2 < 0 then
        while True do
        begin
          Dec(y1);
          if y1 < 0 then Exit;
          Self.GouraudRaster(pixelRow, ArithmeticShr(x0, 14), ArithmeticShr(x2, 14), c0, dColorDX);
          x2 += slope0;
          x0 += slope1;
          c0 += dColorDY;
          pixelRow += Self.PixelWidth;
        end;

      Self.GouraudRaster(pixelRow, ArithmeticShr(x0, 14), ArithmeticShr(x1, 14), c0, dColorDX);
      x1 += slope2;
      x0 += slope1;
      c0 += dColorDY;
      pixelRow += Self.PixelWidth;
    end;
  end;

  if y1 <= y2 then
  begin
    if y1 >= Self.ClipHeight then Exit;
    if y2 > Self.ClipHeight then y2 := Self.ClipHeight;
    if y0 > Self.ClipHeight then y0 := Self.ClipHeight;

    c1 := dColorDX + ((c1 shl 8) - dColorDX * x1);

    if y2 < y0 then
    begin
      x1 := x1 shl 14;
      x0 := x1;
      if y1 < 0 then
      begin
        x0 -= slope1 * y1;
        x1 -= slope0 * y1;
        c1 -= dColorDY * y1;
        y1 := 0;
      end;

      x2 := x2 shl 14;
      if y2 < 0 then
      begin
        x2 -= slope2 * y2;
        y2 := 0;
      end;

      if ((y2 = y1) or (slope1 >= slope0)) and ((y2 <> y1) or (slope1 <= slope2)) then
      begin
        y0 -= y2;
        y2 -= y1;
        pixelRow := Self.ClipY[y1];

        while True do
        begin
          Dec(y2);
          if y2 < 0 then
            while True do
            begin
              Dec(y0);
              if y0 < 0 then Exit;
              Self.GouraudRaster(pixelRow, ArithmeticShr(x2, 14), ArithmeticShr(x0, 14), c1, dColorDX);
              x0 += slope1;
              x2 += slope2;
              c1 += dColorDY;
              pixelRow += Self.PixelWidth;
            end;

          Self.GouraudRaster(pixelRow, ArithmeticShr(x1, 14), ArithmeticShr(x0, 14), c1, dColorDX);
          x0 += slope1;
          x1 += slope0;
          c1 += dColorDY;
          pixelRow += Self.PixelWidth;
        end;
      end;

      y0 -= y2;
      y2 -= y1;
      pixelRow := Self.ClipY[y1];

      while True do
      begin
        Dec(y2);
        if y2 < 0 then
          while True do
          begin
            Dec(y0);
            if y0 < 0 then Exit;
            Self.GouraudRaster(pixelRow, ArithmeticShr(x0, 14), ArithmeticShr(x2, 14), c1, dColorDX);
            x0 += slope1;
            x2 += slope2;
            c1 += dColorDY;
            pixelRow += Self.PixelWidth;
          end;

        Self.GouraudRaster(pixelRow, ArithmeticShr(x0, 14), ArithmeticShr(x1, 14), c1, dColorDX);
        x0 += slope1;
        x1 += slope0;
        c1 += dColorDY;
        pixelRow += Self.PixelWidth;
      end;
    end;

    x1 := x1 shl 14;
    x2 := x1;
    if y1 < 0 then
    begin
      x2 -= slope1 * y1;
      x1 -= slope0 * y1;
      c1 -= dColorDY * y1;
      y1 := 0;
    end;

    x0 := x0 shl 14;
    if y0 < 0 then
    begin
      x0 -= y0 * slope2;
      y0 := 0;
    end;

    if slope1 < slope0 then
    begin
      y2 -= y0;
      y0 -= y1;
      pixelRow := Self.ClipY[y1];

      while True do
      begin
        Dec(y0);
        if y0 < 0 then
          while True do
          begin
            Dec(y2);
            if y2 < 0 then Exit;
            Self.GouraudRaster(pixelRow, ArithmeticShr(x0, 14), ArithmeticShr(x1, 14), c1, dColorDX);
            x0 += slope2;
            x1 += slope0;
            c1 += dColorDY;
            pixelRow += Self.PixelWidth;
          end;

        Self.GouraudRaster(pixelRow, ArithmeticShr(x2, 14), ArithmeticShr(x1, 14), c1, dColorDX);
        x2 += slope1;
        x1 += slope0;
        c1 += dColorDY;
        pixelRow += Self.PixelWidth;
      end;
    end;

    y2 -= y0;
    y0 -= y1;
    pixelRow := Self.ClipY[y1];

    while True do
    begin
      Dec(y0);
      if y0 < 0 then
        while True do
        begin
          Dec(y2);
          if y2 < 0 then Exit;
          Self.GouraudRaster(pixelRow, ArithmeticShr(x1, 14), ArithmeticShr(x0, 14), c1, dColorDX);
          x0 += slope2;
          x1 += slope0;
          c1 += dColorDY;
          pixelRow += Self.PixelWidth;
        end;

      Self.GouraudRaster(pixelRow, ArithmeticShr(x1, 14), ArithmeticShr(x2, 14), c1, dColorDX);
      x2 += slope1;
      x1 += slope0;
      c1 += dColorDY;
      pixelRow += Self.PixelWidth;
    end;
  end;

  if y2 >= Self.ClipHeight then Exit;
  if y0 > Self.ClipHeight then y0 := Self.ClipHeight;
  if y1 > Self.ClipHeight then y1 := Self.ClipHeight;

  c2 := dColorDX + ((c2 shl 8) - x2 * dColorDX);

  if y0 < y1 then
  begin
    x2 := x2 shl 14;
    x1 := x2;
    if y2 < 0 then
    begin
      x1 -= slope0 * y2;
      x2 -= slope2 * y2;
      c2 -= dColorDY * y2;
      y2 := 0;
    end;

    x0 := x0 shl 14;
    if y0 < 0 then
    begin
      x0 -= y0 * slope1;
      y0 := 0;
    end;

    if slope0 < slope2 then
    begin
      y1 -= y0;
      y0 -= y2;
      pixelRow := Self.ClipY[y2];

      while True do
      begin
        Dec(y0);
        if y0 < 0 then
          while True do
          begin
            Dec(y1);
            if y1 < 0 then Exit;
            Self.GouraudRaster(pixelRow, ArithmeticShr(x1, 14), ArithmeticShr(x0, 14), c2, dColorDX);
            x1 += slope0;
            x0 += slope1;
            c2 += dColorDY;
            pixelRow += Self.PixelWidth;
          end;

        Self.GouraudRaster(pixelRow, ArithmeticShr(x1, 14), ArithmeticShr(x2, 14), c2, dColorDX);
        x1 += slope0;
        x2 += slope2;
        c2 += dColorDY;
        pixelRow += Self.PixelWidth;
      end;
    end;

    y1 -= y0;
    y0 -= y2;
    pixelRow := Self.ClipY[y2];

    while True do
    begin
      Dec(y0);
      if y0 < 0 then
        while True do
        begin
          Dec(y1);
          if y1 < 0 then Exit;
          Self.GouraudRaster(pixelRow, ArithmeticShr(x0, 14), ArithmeticShr(x1, 14), c2, dColorDX);
          x1 += slope0;
          x0 += slope1;
          c2 += dColorDY;
          pixelRow += Self.PixelWidth;
        end;

      Self.GouraudRaster(pixelRow, ArithmeticShr(x2, 14), ArithmeticShr(x1, 14), c2, dColorDX);
      x1 += slope0;
      x2 += slope2;
      c2 += dColorDY;
      pixelRow += Self.PixelWidth;
    end;
  end;

  x2 := x2 shl 14;
  x0 := x2;
  if y2 < 0 then
  begin
    x0 -= slope0 * y2;
    x2 -= slope2 * y2;
    c2 -= dColorDY * y2;
    y2 := 0;
  end;

  x1 := x1 shl 14;
  if y1 < 0 then
  begin
    x1 -= slope1 * y1;
    y1 := 0;
  end;

  if slope0 < slope2 then
  begin
    y0 -= y1;
    y1 -= y2;
    pixelRow := Self.ClipY[y2];

    while True do
    begin
      Dec(y1);
      if y1 < 0 then
        while True do
        begin
          Dec(y0);
          if y0 < 0 then Exit;
          Self.GouraudRaster(pixelRow, ArithmeticShr(x1, 14), ArithmeticShr(x2, 14), c2, dColorDX);
          x1 += slope1;
          x2 += slope2;
          c2 += dColorDY;
          pixelRow += Self.PixelWidth;
        end;

      Self.GouraudRaster(pixelRow, ArithmeticShr(x0, 14), ArithmeticShr(x2, 14), c2, dColorDX);
      x0 += slope0;
      x2 += slope2;
      c2 += dColorDY;
      pixelRow += Self.PixelWidth;
    end;
  end;

  y0 -= y1;
  y1 -= y2;
  pixelRow := Self.ClipY[y2];

  while True do
  begin
    Dec(y1);
    if y1 < 0 then
      while True do
      begin
        Dec(y0);
        if y0 < 0 then Exit;
        Self.GouraudRaster(pixelRow, ArithmeticShr(x2, 14), ArithmeticShr(x1, 14), c2, dColorDX);
        x1 += slope1;
        x2 += slope2;
        c2 += dColorDY;
        pixelRow += Self.PixelWidth;
      end;

    Self.GouraudRaster(pixelRow, ArithmeticShr(x2, 14), ArithmeticShr(x0, 14), c2, dColorDX);
    x0 += slope0;
    x2 += slope2;
    c2 += dColorDY;
    pixelRow += Self.PixelWidth;
  end;
end;


(*
## Graphics3D.RasterFlat
```pascal
procedure TGraphics3D.RasterFlat(x0, x1, x2, y0, y1, y2, color: Integer);
```
Flat-colour scanline filler — writes one horizontal span of a single colour.
*)
procedure TGraphics3D.FlatRaster(baseIdx, leftX, rightX, color: Integer);
var
  span, i, pixelIdx, alpha, invAlpha, blended, existing: Integer;
begin
  if Self.RasterClipEnable then
  begin
    if rightX > Self.ClipWidth then rightX := Self.ClipWidth;
    if leftX < 0 then leftX := 0;
  end;

  if leftX >= rightX then Exit;

  pixelIdx := baseIdx + leftX;

  if Self.RasterAlpha = 0 then
  begin
    span := rightX - leftX;
    for i := 0 to span - 1 do
    begin
      Self.Pixels[pixelIdx] := color;
      Inc(pixelIdx);
    end;
  end
  else
  begin
    alpha := Self.RasterAlpha;
    invAlpha := 256 - alpha;
    blended := ((invAlpha * (color and $FF00) shr 8) and $FF00) +
               ((invAlpha * (color and $FF00FF) shr 8) and $FF00FF);
    span := rightX - leftX;
    for i := 0 to span - 1 do
    begin
      existing := Self.Pixels[pixelIdx];
      Self.Pixels[pixelIdx] := (((existing and $FF00FF) * alpha shr 8) and $FF00FF) +
                                blended +
                                ((alpha * (existing and $FF00) shr 8) and $FF00);
      Inc(pixelIdx);
    end;
  end;
end;

(*
## Graphics3D.RasterFlat
```pascal
procedure TGraphics3D.RasterFlat(x0, x1, x2, y0, y1, y2, color: Integer);
```
Flat-coloured triangle — three vertices with X/Y, filled with a single colour.
Uses the same scanline approach as {ref}`Graphics3D.GouraudTriangle` but without colour interpolation.
*)
procedure TGraphics3D.RasterFlat(x0, x1, x2, y0, y1, y2, color: Integer);
var
  ax, ay, bx, by, cx, cy, tmp: Integer;
  slopeAB, slopeAC, slopeBC: Integer;
  y, leftX, rightX, baseIdx: Integer;
  yStart, yEnd, yMid: Integer;
  leftXFrac, rightXFrac: Integer;
begin
  ax := x0; ay := y0;
  bx := x1; by := y1;
  cx := x2; cy := y2;

  if ay > by then
  begin
    tmp := ax; ax := bx; bx := tmp;
    tmp := ay; ay := by; by := tmp;
  end;
  if by > cy then
  begin
    tmp := bx; bx := cx; cx := tmp;
    tmp := by; by := cy; cy := tmp;
  end;
  if ay > by then
  begin
    tmp := ax; ax := bx; bx := tmp;
    tmp := ay; ay := by; by := tmp;
  end;

  if ay <> by then
    slopeAB := ((bx - ax) shl 14) div (by - ay)
  else
    slopeAB := 0;
  if ay <> cy then
    slopeAC := ((cx - ax) shl 14) div (cy - ay)
  else
    slopeAC := 0;
  if by <> cy then
    slopeBC := ((cx - bx) shl 14) div (cy - by)
  else
    slopeBC := 0;

  yMid := EnsureRange(by, 0, Self.ClipHeight);
  yStart := EnsureRange(ay, 0, Self.ClipHeight);
  yEnd := EnsureRange(cy, 0, Self.ClipHeight);

  // Upper half
  if yStart < yMid then
  begin
    if ay < 0 then
    begin
      leftXFrac := (ax shl 14) - ay * slopeAB;
      rightXFrac := (ax shl 14) - ay * slopeAC;
    end
    else
    begin
      leftXFrac := ax shl 14;
      rightXFrac := ax shl 14;
    end;

    if slopeAB < slopeAC then
    begin
      for y := yStart to yMid - 1 do
      begin
        baseIdx := Self.ClipY[y];
        Self.FlatRaster(baseIdx, ArithmeticShr(leftXFrac, 14), ArithmeticShr(rightXFrac, 14), color);
        leftXFrac += slopeAB;
        rightXFrac += slopeAC;
      end;
    end
    else
    begin
      for y := yStart to yMid - 1 do
      begin
        baseIdx := Self.ClipY[y];
        Self.FlatRaster(baseIdx, ArithmeticShr(rightXFrac, 14), ArithmeticShr(leftXFrac, 14), color);
        leftXFrac += slopeAB;
        rightXFrac += slopeAC;
      end;
    end;
  end;

  // Lower half
  if yMid < yEnd then
  begin
    if by < 0 then
    begin
      leftXFrac := (bx shl 14) - by * slopeBC;
      rightXFrac := (ax shl 14) - ay * slopeAC;
    end
    else
    begin
      leftXFrac := bx shl 14;
      rightXFrac := (ax shl 14) + (by - ay) * slopeAC;
    end;

    if slopeBC < slopeAC then
    begin
      for y := yMid to yEnd - 1 do
      begin
        baseIdx := Self.ClipY[y];
        Self.FlatRaster(baseIdx, ArithmeticShr(leftXFrac, 14), ArithmeticShr(rightXFrac, 14), color);
        leftXFrac += slopeBC;
        rightXFrac += slopeAC;
      end;
    end
    else
    begin
      for y := yMid to yEnd - 1 do
      begin
        baseIdx := Self.ClipY[y];
        Self.FlatRaster(baseIdx, ArithmeticShr(rightXFrac, 14), ArithmeticShr(leftXFrac, 14), color);
        leftXFrac += slopeBC;
        rightXFrac += slopeAC;
      end;
    end;
  end;
end;
