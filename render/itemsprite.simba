(*
# Item Sprite
Renders an item's inventory icon from its 3D model, the way the game does: light the model from
the fixed inventory light, project it through the item's own camera angles onto a 36 by 32
canvas, then outline it and drop a shadow behind it.

Example:
```pascal
sprite := TItemSprite.Create(CacheReader, itemDef);
if sprite.Valid then
  sprite.ToImage().Show();
```
*)
{$include_once ../utils/color.simba}
{$include_once ./circularangle.simba}
{$include_once ./graphics3d.simba}
{$include_once ./spritepixels.simba}
{$include_once ./litmodel.simba}
{$include_once ./spritedebug.simba}
{$include_once ../reader/index.simba}
{$include_once ../definitions/items.simba}
{$include_once ../definitions/models.simba}

(*
# ItemSprite
Renders item inventory icons from 3D models.
*)
type
  TItemSprite = record
    ItemDef: TItemDefinition;
    ModelDef: TModelDefinition;
    LitModel: TLitModel;
    Graphics: TGraphics3D;
    Pixels: TSpritePixels;
    Brightness: Double;
    Valid: Boolean;
  end;

(*
## Bound2To126
```pascal
function Bound2To126(val: Integer): Integer; static;
```
Clamps a luminance to the range the palette actually covers.

A palette index packs luminance into 7 bits, but `0`, `1` and `127` are not usable levels, so
lighting is kept inside `2` to `126`.
*)
function Bound2To126(val: Integer): Integer; static;
begin
  if val < 2 then Exit(2);
  if val > 126 then Exit(126);
  Result := val;
end;

(*
  RuneLite's method2608 - scale a colour's luminance by a light intensity.

  Pascal's `shr` is a *logical* shift, so it cannot be used here: `intensity`
  is unclamped and goes negative for a face turned away from the light, and a
  logical shift would turn that into a large positive value that clamps to full
  brightness instead of the minimum. Truncating division differs from Java's
  arithmetic `>>` by at most 1, and only for negative products - which
  Bound2To126 floors to 2 either way.
*)
function ApplyLightIntensity(color, intensity: Integer): Integer; static;
var
  newLum: Integer;
begin
  newLum := Bound2To126(((color and $7F) * intensity) div 128);
  Result := (color and $FF80) + newLum;
end;

(*
  Lighting helper - the dot product RuneLite computes inline in
  ItemSpriteFactory.light():

    tmp = (y * n.y + z * n.z + x * n.x) / (attenuation * n.magnitude) + ambient

  with the light direction (x, y, z) = (-50, -10, -50).

  The result is deliberately NOT clamped to [2..126]. ApplyLightIntensity
  scales the face colour by this value and clamps only the *product*, so
  clamping here first would cap every lit face at roughly its own base
  luminance and flatten the highlights.

  Magnitude 0 means no face contributed a normal to this vertex; RuneLite
  divides by it and throws, so fall back to the unlit ambient level.
*)
function ComputeLightIntensity(normalX, normalY, normalZ, mag, atten, ambient: Integer): Integer; static;
var
  dp: Integer;
begin
  if (mag = 0) or (atten = 0) then Exit(ambient);
  dp := (-50) * normalX + (-10) * normalY + (-50) * normalZ;
  Result := dp div (atten * mag) + ambient;
end;

(*
  TItemSprite.Create — loads the item's inventory model and prepares it for lighting.
  Sets Valid to False if the model archive/data can't be loaded.
*)
function TItemSprite.Create(constref cacheReader: TCacheReader; const itemDef: TItemDefinition; brightness: Double = TColorUtils.BRIGHTNESS_MAX): TItemSprite; static;
var
  modelSector: TArchiveSector;
  modelData: TByteArray;
  i: Integer;
begin
  Result.ItemDef := itemDef;
  Result.Brightness := brightness;
  Result.Valid := False;

  modelSector := cacheReader.Indices[ECacheIndex.MODELS].ReadArchiveSector(
    itemDef.InventoryModel, cacheReader.Indices[ECacheIndex.MODELS].ID, cacheReader.Indices[ECacheIndex.MODELS].IndexData
  );
  if Length(modelSector.Data) = 0 then
    Exit;

  modelData := modelSector.Decompress();
  if Length(modelData) = 0 then
    Exit;

  Result.ModelDef := TModelDefinition.Create(itemDef.InventoryModel, modelData);

  if (itemDef.ResizeX <> 128) or (itemDef.ResizeY <> 128) or (itemDef.ResizeZ <> 128) then
    Result.ModelDef.Resize(itemDef.ResizeX, itemDef.ResizeY, itemDef.ResizeZ);

  for i := 0 to High(itemDef.ColorFind) do
    Result.ModelDef.Recolor(itemDef.ColorFind[i], itemDef.ColorReplace[i]);

  for i := 0 to High(itemDef.TextureFind) do
    Result.ModelDef.Retexture(itemDef.TextureFind[i], itemDef.TextureReplace[i]);

  DebugLine('def', 'id=' + ToStr(itemDef.ID) + ' model=' + ToStr(itemDef.InventoryModel) +
    ' zoom2d=' + ToStr(itemDef.Zoom2D) + ' xan2d=' + ToStr(itemDef.Xan2D) +
    ' yan2d=' + ToStr(itemDef.Yan2D) + ' zan2d=' + ToStr(itemDef.Zan2D) +
    ' offX=' + ToStr(itemDef.XOffset2D) + ' offY=' + ToStr(itemDef.YOffset2D) +
    ' ambient=' + ToStr(itemDef.Ambient) + ' contrast=' + ToStr(itemDef.Contrast) +
    ' rx=' + ToStr(itemDef.ResizeX) + ' ry=' + ToStr(itemDef.ResizeY) + ' rz=' + ToStr(itemDef.ResizeZ));

  Result.LitModel := TLitModel.Create(Result.ModelDef);
  Result.Valid := True;
end;

(*
  TItemSprite.Light — computes vertex/face normals and lights each face,
  writing the result into LitModel.FaceColors1/2/3.
*)
procedure TItemSprite.Light();
const
  LIGHT_MAGNITUDE: Integer = 71; //Trunc(Sqrt(5100))
var
  attenuation,
  i, faceIdx, faceType, faceRenderType, r1, r2, r3,
  nx, ny, nz,
  faceTexId, faceAlphaVal: Integer;
  vMag, vNx, vNy, vNz,
  fNx, fNy, fNz, dump: TIntegerArray;
  hasFaceNormals: Boolean;
begin
  // RuneLite allocates fresh VertexNormals per model. These are accumulated into with `+=`, so
  // they have to start at zero, which is what SetLength hands back - a vMag carried over from a
  // previously rendered item would shrink dp div (atten * mag) toward zero, pulling every vertex
  // to the ambient level and washing the shading out.
  SetLength(vNx, Self.ModelDef.VertexCount);
  SetLength(vNy, Self.ModelDef.VertexCount);
  SetLength(vNz, Self.ModelDef.VertexCount);
  SetLength(vMag, Self.ModelDef.VertexCount);
  SetLength(fNx, Self.ModelDef.FaceCount);
  SetLength(fNy, Self.ModelDef.FaceCount);
  SetLength(fNz, Self.ModelDef.FaceCount);

  hasFaceNormals := False;

  // Precompute attenuation (-50, -10, -50 direction)
  attenuation := Max((LIGHT_MAGNITUDE * (Self.ItemDef.Contrast * 5 + 768)) shr 8, 1);

  for i := 0 to Self.ModelDef.FaceCount - 1 do
  begin
    Self.LitModel.FaceNormal(i, nx, ny, nz);

    if Length(Self.ModelDef.FaceRenderTypes) = 0 then
      faceRenderType := 0
    else
    begin
      faceRenderType := Self.ModelDef.FaceRenderTypes[i];
      if faceRenderType > 127 then
        faceRenderType -= 256;
    end;

    if faceRenderType = 0 then
    begin
      vNx[Self.ModelDef.FaceIndices1[i]] += nx;
      vNy[Self.ModelDef.FaceIndices1[i]] += ny;
      vNz[Self.ModelDef.FaceIndices1[i]] += nz;
      Inc(vMag[Self.ModelDef.FaceIndices1[i]]);

      vNx[Self.ModelDef.FaceIndices2[i]] += nx;
      vNy[Self.ModelDef.FaceIndices2[i]] += ny;
      vNz[Self.ModelDef.FaceIndices2[i]] += nz;
      Inc(vMag[Self.ModelDef.FaceIndices2[i]]);

      vNx[Self.ModelDef.FaceIndices3[i]] += nx;
      vNy[Self.ModelDef.FaceIndices3[i]] += ny;
      vNz[Self.ModelDef.FaceIndices3[i]] += nz;
      Inc(vMag[Self.ModelDef.FaceIndices3[i]]);
    end
    else if faceRenderType = 1 then
    begin
      hasFaceNormals := True;
      fNx[i] := nx;
      fNy[i] := ny;
      fNz[i] := nz;
    end;
  end;

  // Light each face
  DebugLine('light', 'ambient=' + ToStr(Self.ItemDef.Ambient + 64) +
    ' contrast=' + ToStr(Self.ItemDef.Contrast * 5 + 768) +
    ' lightLen=' + ToStr(LIGHT_MAGNITUDE) + ' attenuation=' + ToStr(attenuation));

  if SpriteDebugEnabled then
  begin
    SetLength(dump, Self.ModelDef.VertexCount);
    for i := 0 to Self.ModelDef.VertexCount - 1 do dump[i] := vNx[i];
    DebugInts('normals', 'normalX', dump, Self.ModelDef.VertexCount);
    for i := 0 to Self.ModelDef.VertexCount - 1 do dump[i] := vNy[i];
    DebugInts('normals', 'normalY', dump, Self.ModelDef.VertexCount);
    for i := 0 to Self.ModelDef.VertexCount - 1 do dump[i] := vNz[i];
    DebugInts('normals', 'normalZ', dump, Self.ModelDef.VertexCount);
    for i := 0 to Self.ModelDef.VertexCount - 1 do dump[i] := vMag[i];
    DebugInts('normals', 'normalMag', dump, Self.ModelDef.VertexCount);
  end;

  for faceIdx := 0 to Self.ModelDef.FaceCount - 1 do
  begin
    faceType := 0;
    faceAlphaVal := 0;
    faceTexId := -1;

    if Length(Self.ModelDef.FaceRenderTypes) > 0 then
      faceType := Self.ModelDef.FaceRenderTypes[faceIdx] and $FF;
    if Length(Self.ModelDef.FaceTransparencies) > 0 then
    begin
      // RuneLite reads this as a *signed* byte, so 0xFE/0xFF mean -2/-1.
      // TByteArray is unsigned here, so sign-extend before the comparisons
      // below, otherwise the "always bright" and "hidden face" render types
      // never trigger and fully transparent faces get drawn.
      faceAlphaVal := Self.ModelDef.FaceTransparencies[faceIdx];
      if faceAlphaVal > 127 then
        faceAlphaVal -= 256;
    end;
    if Length(Self.ModelDef.FaceTextures) > 0 then
      faceTexId := Self.ModelDef.FaceTextures[faceIdx];

    if faceAlphaVal = -2 then
      faceType := 3;
    if faceAlphaVal = -1 then
      faceType := 2;

    case faceType of
      0: // Gouraud flat-shaded (no texture, 3 vertex colors)
        begin
          r1 := ApplyLightIntensity(Self.ModelDef.FaceColors[faceIdx] and $FFFF,
            ComputeLightIntensity(vNx[Self.ModelDef.FaceIndices1[faceIdx]], vNy[Self.ModelDef.FaceIndices1[faceIdx]], vNz[Self.ModelDef.FaceIndices1[faceIdx]], vMag[Self.ModelDef.FaceIndices1[faceIdx]], attenuation, Self.ItemDef.Ambient + 64));
          r2 := ApplyLightIntensity(Self.ModelDef.FaceColors[faceIdx] and $FFFF,
            ComputeLightIntensity(vNx[Self.ModelDef.FaceIndices2[faceIdx]], vNy[Self.ModelDef.FaceIndices2[faceIdx]], vNz[Self.ModelDef.FaceIndices2[faceIdx]], vMag[Self.ModelDef.FaceIndices2[faceIdx]], attenuation, Self.ItemDef.Ambient + 64));
          r3 := ApplyLightIntensity(Self.ModelDef.FaceColors[faceIdx] and $FFFF,
            ComputeLightIntensity(vNx[Self.ModelDef.FaceIndices3[faceIdx]], vNy[Self.ModelDef.FaceIndices3[faceIdx]], vNz[Self.ModelDef.FaceIndices3[faceIdx]], vMag[Self.ModelDef.FaceIndices3[faceIdx]], attenuation, Self.ItemDef.Ambient + 64));
        end;
      1: // Single-color face with face normal
        begin
          if hasFaceNormals then
          begin
            r1 := ApplyLightIntensity(Self.ModelDef.FaceColors[faceIdx] and $FFFF,
              ComputeLightIntensity(fNx[faceIdx], fNy[faceIdx], fNz[faceIdx], 1, (attenuation shr 1) + attenuation, Self.ItemDef.Ambient + 64));
            r2 := -1; r3 := -1;
          end
          else
          begin
            r1 := Self.ModelDef.FaceColors[faceIdx] and $FFFF;
            r2 := -1; r3 := -1;
          end;
        end;
      3: // Always bright face
        begin r1 := 128; r2 := -1; r3 := -1; end;
      else // No lighting change
        begin
          r1 := Self.ModelDef.FaceColors[faceIdx] and $FFFF;
          r2 := -1;
          r3 := -2;
        end;
    end;

    Self.LitModel.FaceColors1[faceIdx] := r1;
    Self.LitModel.FaceColors2[faceIdx] := r2;
    Self.LitModel.FaceColors3[faceIdx] := r3;
  end;

  DebugInts('facecolors', 'colorA', Self.LitModel.FaceColors1, Self.ModelDef.FaceCount);
  DebugInts('facecolors', 'colorB', Self.LitModel.FaceColors2, Self.ModelDef.FaceCount);
  DebugInts('facecolors', 'colorC', Self.LitModel.FaceColors3, Self.ModelDef.FaceCount);
end;

(*
  TItemSprite.Project — sets up the 36x32 rasterizer and projects + draws
  the model using the item's calibrated 2D camera parameters.
*)
procedure TItemSprite.Project();
var
  zoom2d, xOffset, yOffset: Integer;
  xanSin, pitchOffsetY, pitchOffsetZ, i: Integer;
  dump: TIntegerArray;
begin
  zoom2d := Self.ItemDef.Zoom2D;
  xanSin := Self.ItemDef.Xan2D;
  xOffset := Self.ItemDef.XOffset2D;
  yOffset := Self.ItemDef.YOffset2D;

  Self.Pixels := TSpritePixels.Create(36, 32);
  Self.Graphics.SetRasterBuffer(Self.Pixels.Pixels, 36, 32);
  Self.Graphics.Palette := ColorUtils.SpritePalette(Self.Brightness);
  Self.Graphics.Reset();
  Self.Graphics.Zoom := 512;
  Self.Graphics.SetRasterClipping();
  Self.Graphics.SetOffset(16, 16);
  Self.Graphics.RasterGouraudLowRes := False;

  pitchOffsetY := zoom2d * CircularAngle.SINE[xanSin] shr 16;
  pitchOffsetZ := zoom2d * CircularAngle.COSINE[xanSin] shr 16;

  DebugPalette('palette', Self.Graphics.Palette);
  DebugLine('model', 'vertexCount=' + ToStr(Self.LitModel.VerticesCount) +
    ' faceCount=' + ToStr(Self.LitModel.IndicesCount));
  DebugInts('model', 'vertexX', Self.LitModel.VertexX, Self.LitModel.VerticesCount);
  DebugInts('model', 'vertexY', Self.LitModel.VertexY, Self.LitModel.VerticesCount);
  DebugInts('model', 'vertexZ', Self.LitModel.VertexZ, Self.LitModel.VerticesCount);
  DebugBytes('model', 'faceAlphas', Self.LitModel.FaceTransparencies, Self.LitModel.IndicesCount);
  DebugBytes('model', 'facePriorities', Self.LitModel.FacePriorities, Self.LitModel.IndicesCount);
  DebugInts('model', 'faceTextures', Self.LitModel.FaceTextures, Self.LitModel.IndicesCount);

  Self.LitModel.CalcBoundsCylinder();

  DebugLine('bounds', 'height=' + ToStr(Self.LitModel.ModelHeight) +
    ' bottomY=' + ToStr(Self.LitModel.BottomY) + ' xzRadius=' + ToStr(Self.LitModel.XYZMag) +
    ' radius=' + ToStr(Self.LitModel.Radius) + ' diameter=' + ToStr(Self.LitModel.Diameter));
  DebugLine('project', 'zoom=' + ToStr(Self.Graphics.Zoom) +
    ' midX=' + ToStr(Self.Graphics.CenterX) + ' midY=' + ToStr(Self.Graphics.CenterY) +
    ' zoom2d=' + ToStr(zoom2d) + ' yan2d=' + ToStr(Self.ItemDef.Yan2D) +
    ' zan2d=' + ToStr(Self.ItemDef.Zan2D) + ' xan2d=' + ToStr(Self.ItemDef.Xan2D) +
    ' offX=' + ToStr(xOffset) +
    ' offY=' + ToStr(Self.LitModel.ModelHeight div 2 + pitchOffsetY + yOffset) +
    ' offZ=' + ToStr(pitchOffsetZ + yOffset));

  Self.LitModel.ProjectAndDraw(
    Self.Graphics,
    0,
    Self.ItemDef.Yan2D,
    Self.ItemDef.Zan2D,
    Self.ItemDef.Xan2D,
    xOffset,
    Self.LitModel.ModelHeight div 2 + pitchOffsetY + yOffset,
    pitchOffsetZ + yOffset
  );

  if SpriteDebugEnabled then
  begin
    SetLength(dump, Self.LitModel.VerticesCount);
    for i := 0 to Self.LitModel.VerticesCount - 1 do dump[i] := Viewport.ScreenX[i];
    DebugInts('project', 'screenX', dump, Self.LitModel.VerticesCount);
    for i := 0 to Self.LitModel.VerticesCount - 1 do dump[i] := Viewport.ScreenY[i];
    DebugInts('project', 'screenY', dump, Self.LitModel.VerticesCount);
    for i := 0 to Self.LitModel.VerticesCount - 1 do dump[i] := Viewport.Depth[i];
    DebugInts('project', 'depth', dump, Self.LitModel.VerticesCount);
    DebugPixelRows('pixels', Self.Pixels.Pixels, 36, 32);
  end;
end;

(*
  TItemSprite.Draw — applies the border/shadow decoration on top of the
  model rasterized by Project.
*)
procedure TItemSprite.Draw();
const
  BORDER_COLOR = 1;
  SHADOW_COLOR = 3153952;
begin
  Self.Pixels.DrawBorder(BORDER_COLOR);
  Self.Pixels.DrawShadow(SHADOW_COLOR);
end;

(*
  TItemSprite.ToImage — lights, projects and rasterizes the model, then
  returns the resulting 36x32 icon.
*)
function TItemSprite.ToImage(): TImage;
begin
  Self.Light();
  Self.Project();
  Self.Draw();
  Result := Self.Pixels.ToImage();
end;
