(*
# Item Sprite
Renders an item's inventory icon from its 3D model, the way the game does: light the model from
the fixed inventory light, project it through the item's own camera angles onto a 36 by 32
canvas, then outline it and drop a shadow behind it.

Example:
```pascal
sprite := TItemSprite.Create(CacheReader, itemDef);
if sprite.Valid then
  sprite.ToImage().Show();
```
*)

{$DEFINE WL_CACHE_ITEM_SPRITE_INCLUDED}
{$IFNDEF WL_CACHE_SPRITE_PIXELS_INCLUDED}  {$INCLUDE_ONCE ../utils/spritepixels.simba}  {$ENDIF}
{$IFNDEF WL_CACHE_LITMODEL_INCLUDED}       {$INCLUDE_ONCE litmodel.simba}               {$ENDIF}
{$IFNDEF WL_CACHE_INDEX_INCLUDED}          {$INCLUDE_ONCE ../reader/index.simba}        {$ENDIF}
{$IFNDEF WL_CACHE_DEFINITION_ITEMS_INCLUDED}     {$INCLUDE_ONCE ../definitions/items.simba}   {$ENDIF}

(*
## TItemSprite
Renders item inventory icons from 3D models.
*)
type
  TItemSprite = record
    ItemDef: TItemDefinition;
    ModelDef: TModelDefinition;
    LitModel: TLitModel;
    Graphics: TGraphics3D;
    Pixels: TSpritePixels;
    Valid: Boolean;
  end;

(*
## TItemSprite.ApplyLightIntensity
```pascal
function TItemSprite.ApplyLightIntensity(color, intensity: Integer): Integer; static;
```
Scale a colour's luminance by a light intensity.

Pascal's `shr` is a *logical* shift, so it cannot be used here: `intensity`
is unclamped and goes negative for a face turned away from the light, and a
logical shift would turn that into a large positive value that clamps to full
brightness instead of the minimum.
*)
function TItemSprite.ApplyLightIntensity(color, normalX, normalY, normalZ, mag, atten, ambient: Integer): Integer; static;
var
  dp, intensity: Integer;
begin
  if (mag = 0) or (atten = 0) then
    intensity := ambient
  else
  begin
    dp := (-50) * normalX + (-10) * normalY + (-50) * normalZ;
    intensity := dp div (atten * mag) + ambient;
  end;

  Result := (color and $FF80) + EnsureRange(((color and $7F) * intensity) div 128, 2, 126);
end;

(*
## TItemSprite.Create
```pascal
function TItemSprite.Create(constref cacheReader: TCacheReader; const itemDef: TItemDefinition): TItemSprite; static;
```
Loads the item's inventory model and prepares it for lighting.
Sets `TItemSprite.Valid` to `False` if the model archive/data can't be loaded.
*)
function TItemSprite.Create(constref cacheReader: TCacheReader; const itemDef: TItemDefinition): TItemSprite; static;
var
  modelSector: TArchiveSector;
  modelData: TByteArray;
  i: Integer;
begin
  Result.ItemDef := itemDef;
  Result.Valid := False;

  modelSector := cacheReader.Indices[ECacheIndex.MODELS].ReadArchiveSector(
    itemDef.InventoryModel, cacheReader.Indices[ECacheIndex.MODELS].ID, cacheReader.Indices[ECacheIndex.MODELS].IndexData
  );
  if Length(modelSector.Data) = 0 then
    Exit;

  modelData := modelSector.Decompress();
  if Length(modelData) = 0 then
    Exit;

  Result.ModelDef := TModelDefinition.Create(itemDef.InventoryModel, modelData);

  if (itemDef.ResizeX <> 128) or (itemDef.ResizeY <> 128) or (itemDef.ResizeZ <> 128) then
    Result.ModelDef.Resize(itemDef.ResizeX, itemDef.ResizeY, itemDef.ResizeZ);

  for i := 0 to High(itemDef.ColorFind) do
    Result.ModelDef.Recolor(itemDef.ColorFind[i], itemDef.ColorReplace[i]);

  for i := 0 to High(itemDef.TextureFind) do
    Result.ModelDef.Retexture(itemDef.TextureFind[i], itemDef.TextureReplace[i]);

  Result.LitModel := TLitModel.Create(Result.ModelDef);
  Result.Valid := True;
end;

(*
## TItemSprite.Light
```pascal
procedure TItemSprite.Light();
```
Computes vertex/face normals and lights each face, writing the result into
`TItemSprite.LitModel.FaceColors1/2/3`.
*)
procedure TItemSprite.Light();
const
  LIGHT_MAGNITUDE: Integer = 71; //Trunc(Sqrt(5100))
var
  attenuation, ambient, faceColor, faceAttenuation,
  i, faceIdx, faceType, faceRenderType, r1, r2, r3,
  nx, ny, nz,
  faceTexId, faceAlphaVal: Integer;
  vMag, vNx, vNy, vNz,
  fNx, fNy, fNz, dump,
  faceIndices1, faceIndices2, faceIndices3, faceColors, faceTextures: TIntegerArray;
  faceRenderTypes, faceTransparencies: TByteArray;
  hasFaceNormals, hasRenderTypes, hasTransparencies, hasTextures: Boolean;
begin
  SetLength(vNx, Self.ModelDef.VertexCount);
  SetLength(vNy, Self.ModelDef.VertexCount);
  SetLength(vNz, Self.ModelDef.VertexCount);
  SetLength(vMag, Self.ModelDef.VertexCount);
  SetLength(fNx, Self.ModelDef.FaceCount);
  SetLength(fNy, Self.ModelDef.FaceCount);
  SetLength(fNz, Self.ModelDef.FaceCount);

  hasFaceNormals := False;

  //everything below is fixed for the whole model, so it is read out once rather than per face
  faceIndices1 := Self.ModelDef.FaceIndices1;
  faceIndices2 := Self.ModelDef.FaceIndices2;
  faceIndices3 := Self.ModelDef.FaceIndices3;
  faceColors := Self.ModelDef.FaceColors;
  faceTextures := Self.ModelDef.FaceTextures;
  faceRenderTypes := Self.ModelDef.FaceRenderTypes;
  faceTransparencies := Self.ModelDef.FaceTransparencies;

  hasRenderTypes := Length(faceRenderTypes) > 0;
  hasTransparencies := Length(faceTransparencies) > 0;
  hasTextures := Length(faceTextures) > 0;

  ambient := Self.ItemDef.Ambient + 64;

  // Precompute attenuation (-50, -10, -50 direction)
  attenuation := Max((LIGHT_MAGNITUDE * (Self.ItemDef.Contrast * 5 + 768)) shr 8, 1);
  faceAttenuation := (attenuation shr 1) + attenuation;

  for i := 0 to Self.ModelDef.FaceCount - 1 do
  begin
    Self.LitModel.FaceNormal(i, nx, ny, nz);

    if not hasRenderTypes then
      faceRenderType := 0
    else
    begin
      faceRenderType := faceRenderTypes[i];
      if faceRenderType > 127 then
        faceRenderType -= 256;
    end;

    if faceRenderType = 0 then
    begin
      vNx[faceIndices1[i]] += nx;
      vNy[faceIndices1[i]] += ny;
      vNz[faceIndices1[i]] += nz;
      Inc(vMag[faceIndices1[i]]);

      vNx[faceIndices2[i]] += nx;
      vNy[faceIndices2[i]] += ny;
      vNz[faceIndices2[i]] += nz;
      Inc(vMag[faceIndices2[i]]);

      vNx[faceIndices3[i]] += nx;
      vNy[faceIndices3[i]] += ny;
      vNz[faceIndices3[i]] += nz;
      Inc(vMag[faceIndices3[i]]);
    end
    else if faceRenderType = 1 then
    begin
      hasFaceNormals := True;
      fNx[i] := nx;
      fNy[i] := ny;
      fNz[i] := nz;
    end;
  end;

  for faceIdx := 0 to Self.ModelDef.FaceCount - 1 do
  begin
    faceType := 0;
    faceAlphaVal := 0;
    faceTexId := -1;

    if hasRenderTypes then
      faceType := faceRenderTypes[faceIdx] and $FF;
    if hasTransparencies then
    begin
      // RuneLite reads this as a *signed* byte, so 0xFE/0xFF mean -2/-1.
      // TByteArray is unsigned here, so sign-extend before the comparisons
      // below, otherwise the "always bright" and "hidden face" render types
      // never trigger and fully transparent faces get drawn.
      faceAlphaVal := faceTransparencies[faceIdx];
      if faceAlphaVal > 127 then
        faceAlphaVal -= 256;
    end;
    if hasTextures then
      faceTexId := faceTextures[faceIdx];

    if faceAlphaVal = -2 then
      faceType := 3;
    if faceAlphaVal = -1 then
      faceType := 2;

    faceColor := faceColors[faceIdx] and $FFFF;

    case faceType of
      0: // Gouraud flat-shaded (no texture, 3 vertex colors)
        begin
          r1 := TItemSprite.ApplyLightIntensity(faceColor, vNx[faceIndices1[faceIdx]], vNy[faceIndices1[faceIdx]], vNz[faceIndices1[faceIdx]], vMag[faceIndices1[faceIdx]], attenuation, ambient);
          r2 := TItemSprite.ApplyLightIntensity(faceColor, vNx[faceIndices2[faceIdx]], vNy[faceIndices2[faceIdx]], vNz[faceIndices2[faceIdx]], vMag[faceIndices2[faceIdx]], attenuation, ambient);
          r3 := TItemSprite.ApplyLightIntensity(faceColor, vNx[faceIndices3[faceIdx]], vNy[faceIndices3[faceIdx]], vNz[faceIndices3[faceIdx]], vMag[faceIndices3[faceIdx]], attenuation, ambient);
        end;
      1: // Single-color face with face normal
        begin
          if hasFaceNormals then
          begin
            r1 := TItemSprite.ApplyLightIntensity(faceColor, fNx[faceIdx], fNy[faceIdx], fNz[faceIdx], 1, faceAttenuation, ambient);
            r2 := -1;
            r3 := -1;
          end
          else
          begin
            r1 := faceColor;
            r2 := -1; r3 := -1;
          end;
        end;
      3: // Always bright face
        begin r1 := 128; r2 := -1; r3 := -1; end;
      else // No lighting change
        begin
          r1 := faceColor;
          r2 := -1;
          r3 := -2;
        end;
    end;

    Self.LitModel.FaceColors1[faceIdx] := r1;
    Self.LitModel.FaceColors2[faceIdx] := r2;
    Self.LitModel.FaceColors3[faceIdx] := r3;
  end;
end;

(*
  TItemSprite.Project — sets up the 36x32 rasterizer and projects + draws
  the model using the item's calibrated 2D camera parameters.
*)
procedure TItemSprite.Project();
var
  zoom2d, xOffset, yOffset: Integer;
  xanSin, pitchOffsetY, pitchOffsetZ, i: Integer;
  dump: TIntegerArray;
begin
  zoom2d := Self.ItemDef.Zoom2D;
  xanSin := Self.ItemDef.Xan2D;
  xOffset := Self.ItemDef.XOffset2D;
  yOffset := Self.ItemDef.YOffset2D;

  Self.Pixels := TSpritePixels.Create(36, 32);
  Self.Graphics.SetRasterBuffer(Self.Pixels.Pixels, 36, 32);
  Self.Graphics.Reset();
  Self.Graphics.Zoom := 512;
  Self.Graphics.SetRasterClipping();
  Self.Graphics.SetOffset(16, 16);
  Self.Graphics.RasterGouraudLowRes := False;

  pitchOffsetY := zoom2d * CircularAngle.SINE[xanSin] shr 16;
  pitchOffsetZ := zoom2d * CircularAngle.COSINE[xanSin] shr 16;

  Self.LitModel.CalcBoundsCylinder();

  Self.LitModel.ProjectAndDraw(
    Self.Graphics,
    0,
    Self.ItemDef.Yan2D,
    Self.ItemDef.Zan2D,
    Self.ItemDef.Xan2D,
    xOffset,
    Self.LitModel.ModelHeight div 2 + pitchOffsetY + yOffset,
    pitchOffsetZ + yOffset
  );
end;

(*
  TItemSprite.ToImage — lights, projects and rasterizes the model, then
  returns the resulting 36x32 icon.

  The border and shadow are written straight into the rasterizer's buffer, so they are given in
  the palette's channel order - red in the low byte - and are swapped along with everything else
  by TSpritePixels.ToImage. The border is the near-black the client uses: not quite zero, since
  zero is what marks a pixel as untouched.
*)
function TItemSprite.ToImage(shadow: Boolean = True): TImage;
begin
  Self.Light();
  Self.Project();
  Self.Pixels.DrawBorder($10000);
  if shadow then
    Self.Pixels.DrawShadow($202030);
  Result := Self.Pixels.ToImage();
end;
