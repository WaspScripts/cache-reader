(*
# Item Sprite
Renders an item's inventory icon from its 3D model, the way the game does: light the model from
the fixed inventory light, project it through the item's own camera angles onto a 36 by 32
canvas, then outline it and drop a shadow behind it.

Example:
```pascal
sprite := TItemSprite.Create(CacheReader, itemDef);
if sprite.Valid then
  sprite.ToImage().Show();
```
*)

{$DEFINE WL_CACHE_ITEM_SPRITE_INCLUDED} 
{$IFNDEF WL_CACHE_READER_INCLUDED}               {$INCLUDE_ONCE ../reader/reader.simba}        {$ENDIF}
{$IFNDEF WL_CACHE_SPRITE_PIXELS_INCLUDED}        {$INCLUDE_ONCE ../utils/spritepixels.simba}  {$ENDIF}
{$IFNDEF WL_CACHE_LITMODEL_INCLUDED}             {$INCLUDE_ONCE litmodel.simba}               {$ENDIF}
{$IFNDEF WL_CACHE_DEFINITION_ITEMS_INCLUDED}     {$INCLUDE_ONCE ../definitions/items.simba}   {$ENDIF}

(*
## TItemSprite
Renders item inventory icons from 3D models.
*)
type
  TItemSprite = record
    ItemDef: TItemDefinition;
    ModelDef: TModelDefinition;
    LitModel: TLitModel;
    Graphics: TGraphics3D;
    Sprite: TSpritePixels;
    NotePixels: array of TSpritePixels;
    Valid: Boolean;
  end;

(*
## TItemSprite.LightIntensity
```pascal
function TItemSprite.LightIntensity(normalX, normalY, normalZ, mag, atten, ambient: Integer): Integer; static;
```
How brightly the fixed inventory light falls on a surface facing along the normal, unclamped.
`mag` is how many face normals were summed into the normal, `1` for a single face's own normal.
*)
function TItemSprite.LightIntensity(normalX, normalY, normalZ, mag, atten, ambient: Integer): Integer; static;
begin
  if (mag = 0) or (atten = 0) then
    Exit(ambient);

  Result := ((-50) * normalX + (-10) * normalY + (-50) * normalZ) div (atten * mag) + ambient;
end;

(*
## TItemSprite.ApplyLightIntensity
```pascal
function TItemSprite.ApplyLightIntensity(color, intensity: Integer): Integer; static;
```
Scale a colour's luminance by a light intensity.

Pascal's `shr` is a *logical* shift, so it cannot be used here: `intensity`
is unclamped and goes negative for a face turned away from the light, and a
logical shift would turn that into a large positive value that clamps to full
brightness instead of the minimum.
*)
function TItemSprite.ApplyLightIntensity(color, normalX, normalY, normalZ, mag, atten, ambient: Integer): Integer; static;
begin
  Result := (color and $FF80) + EnsureRange(((color and $7F) * TItemSprite.LightIntensity(normalX, normalY, normalZ, mag, atten, ambient)) div 128, 2, 126);
end;

(*
## TItemSprite.Create
```pascal
function TItemSprite.Create(const itemDef: TItemDefinition): TItemSprite; static;
function TItemSprite.Create(const archive: TArchive; id: Integer): TItemSprite; static; overload;
function TItemSprite.Create(id: Integer): TItemSprite; static; overload;
```
Loads the item's inventory model and lights it.
Sets `TItemSprite.Valid` to `False` if the model archive/data can't be loaded.

Noted items are only drawn properly by the overloads that take an item id. Those link the item
to its note paper with {ref}`TItemDefinition.LinkNote` and render every animation frame of the
unnoted item into `TItemSprite.NotePixels`, which every image is then drawn with on top of the
paper. A noted item whose paper or unnoted item can't be rendered is not valid.

Lighting depends only on the model and the item, not on how the icon is drawn, so it is done
once here rather than again by every {ref}`TItemSprite.ToImage` or {ref}`TItemSprite.BorderImage`.
*)
function TItemSprite.Create(const itemDef: TItemDefinition): TItemSprite; static;
var
  idx: TCacheIndex;
  sector: TArchiveSector;
  data: TByteArray;
  i: Integer;
begin
  Result.ItemDef := itemDef;
  Result.Valid := False;

  idx := CacheReader.Indices[ECacheIndex.MODELS];
  sector := idx.ReadArchiveSector(itemDef.InventoryModel, idx.ID, idx.IndexData);
  if sector.Data.IsEmpty then
    Exit;

  data := sector.Decompress();
  if data.IsEmpty then
    Exit;

  Result.ModelDef := TModelDefinition.Create(itemDef.InventoryModel, data);

  if (itemDef.ResizeX <> 128) or (itemDef.ResizeY <> 128) or (itemDef.ResizeZ <> 128) then
    Result.ModelDef.Resize(itemDef.ResizeX, itemDef.ResizeY, itemDef.ResizeZ);

  for i := 0 to High(itemDef.ColorFind) do
    Result.ModelDef.Recolor(itemDef.ColorFind[i], itemDef.ColorReplace[i]);

  for i := 0 to High(itemDef.TextureFind) do
    Result.ModelDef.Retexture(itemDef.TextureFind[i], itemDef.TextureReplace[i]);

  Result.LitModel := TLitModel.Create(Result.ModelDef);
  Result.Light();
  Result.Valid := True;
end;

function TItemSprite.Create(const archive: TArchive; id: Integer): TItemSprite; static; overload;
var
  itemDef, unnotedDef: TItemDefinition;
  tmp, unnotedSprite: TItemSprite;
  i, unnotedID, frame: Integer;
begin
  if not archive.Files.Exists(id) then
    Exit;

  itemDef := TItemDefinition.Create(id, archive.Files.Value[id].Data);

  //an item with no model and no noted variant is a gap in the id space rather than an item
  if (itemDef.InventoryModel = 0) and (itemDef.NotedTemplate = -1) then
    Exit;

  if itemDef.NotedTemplate <> -1 then
  begin
    if not archive.Files.Exists(itemDef.NotedTemplate) or not archive.Files.Exists(itemDef.NotedID) then
      Exit;

    unnotedDef := TItemDefinition.Create(itemDef.NotedID, archive.Files.Value[itemDef.NotedID].Data);
    itemDef.LinkNote(
      TItemDefinition.Create(itemDef.NotedTemplate, archive.Files.Value[itemDef.NotedTemplate].Data),
      unnotedDef
    );
  end;

  tmp := TItemSprite.Create(itemDef);
  if not tmp.Valid then
    Exit;

  if itemDef.NotedTemplate <> -1 then
  begin
    unnotedID := itemDef.NotedID;
    for i := 0 to High(unnotedDef.CountCo) do
      if (unnotedDef.CountCo[i] <> 0) and (unnotedDef.CountCo[i] <= 10) then
        unnotedID := unnotedDef.CountObj[i];

    unnotedSprite := TItemSprite.Create(archive, unnotedID);
    if not unnotedSprite.Valid then
      Exit;

    SetLength(tmp.NotePixels, unnotedSprite.FrameCount());
    for frame := 0 to High(tmp.NotePixels) do
    begin
      unnotedSprite.Project(False, True, frame);
      unnotedSprite.Sprite.DrawBorder($FF000001);
      tmp.NotePixels[frame] := unnotedSprite.Sprite;
    end;
  end;

  Result := tmp;
end;

function TItemSprite.Create(id: Integer): TItemSprite; static; overload;
var
  archive: TArchive;
begin
  archive := CacheReader.Indices[ECacheIndex.CONFIGS].ReferenceTable.Archives.Value[EConfigArchive.ITEM];
  Result := TItemSprite.Create(archive, id);
end;


(*
## TItemSprite.Light
```pascal
procedure TItemSprite.Light();
```
Computes vertex/face normals and lights each face, writing the result into
`TItemSprite.LitModel.FaceColors1/2/3`.
*)
procedure TItemSprite.Light();
const
  LIGHT_MAGNITUDE: Integer = 71; //Trunc(Sqrt(5100))
var
  attenuation, ambient, faceColor, faceAttenuation,
  i, faceIdx, faceType, faceRenderType, r1, r2, r3,
  nx, ny, nz,
  faceTexId, faceAlphaVal: Integer;
  vMag, vNx, vNy, vNz,
  fNx, fNy, fNz, dump,
  faceIndices1, faceIndices2, faceIndices3, faceColors, faceTextures: TIntegerArray;
  faceRenderTypes, faceTransparencies: TByteArray;
  hasFaceNormals, hasRenderTypes, hasTransparencies, hasTextures: Boolean;
begin
  SetLength(vNx, Self.ModelDef.VertexCount);
  SetLength(vNy, Self.ModelDef.VertexCount);
  SetLength(vNz, Self.ModelDef.VertexCount);
  SetLength(vMag, Self.ModelDef.VertexCount);
  SetLength(fNx, Self.ModelDef.FaceCount);
  SetLength(fNy, Self.ModelDef.FaceCount);
  SetLength(fNz, Self.ModelDef.FaceCount);

  hasFaceNormals := False;

  //everything below is fixed for the whole model, so it is read out once rather than per face
  faceIndices1 := Self.ModelDef.FaceIndices1;
  faceIndices2 := Self.ModelDef.FaceIndices2;
  faceIndices3 := Self.ModelDef.FaceIndices3;
  faceColors := Self.ModelDef.FaceColors;
  faceTextures := Self.ModelDef.FaceTextures;
  faceRenderTypes := Self.ModelDef.FaceRenderTypes;
  faceTransparencies := Self.ModelDef.FaceTransparencies;

  hasRenderTypes := Length(faceRenderTypes) > 0;
  hasTransparencies := Length(faceTransparencies) > 0;
  hasTextures := Length(faceTextures) > 0;

  ambient := Self.ItemDef.Ambient + 64;

  // Precompute attenuation (-50, -10, -50 direction)
  attenuation := Max((LIGHT_MAGNITUDE * (Self.ItemDef.Contrast * 5 + 768)) shr 8, 1);
  faceAttenuation := (attenuation shr 1) + attenuation;

  for i := 0 to Self.ModelDef.FaceCount - 1 do
  begin
    Self.LitModel.FaceNormal(i, nx, ny, nz);

    if not hasRenderTypes then
      faceRenderType := 0
    else
    begin
      faceRenderType := faceRenderTypes[i];
      if faceRenderType > 127 then
        faceRenderType -= 256;
    end;

    if faceRenderType = 0 then
    begin
      vNx[faceIndices1[i]] += nx;
      vNy[faceIndices1[i]] += ny;
      vNz[faceIndices1[i]] += nz;
      Inc(vMag[faceIndices1[i]]);

      vNx[faceIndices2[i]] += nx;
      vNy[faceIndices2[i]] += ny;
      vNz[faceIndices2[i]] += nz;
      Inc(vMag[faceIndices2[i]]);

      vNx[faceIndices3[i]] += nx;
      vNy[faceIndices3[i]] += ny;
      vNz[faceIndices3[i]] += nz;
      Inc(vMag[faceIndices3[i]]);
    end
    else if faceRenderType = 1 then
    begin
      hasFaceNormals := True;
      fNx[i] := nx;
      fNy[i] := ny;
      fNz[i] := nz;
    end;
  end;

  for faceIdx := 0 to Self.ModelDef.FaceCount - 1 do
  begin
    faceType := 0;
    faceAlphaVal := 0;
    faceTexId := -1;

    if hasRenderTypes then
      faceType := faceRenderTypes[faceIdx] and $FF;
    if hasTransparencies then
    begin
      // RuneLite reads this as a *signed* byte, so 0xFE/0xFF mean -2/-1.
      // TByteArray is unsigned here, so sign-extend before the comparisons
      // below, otherwise the "always bright" and "hidden face" render types
      // never trigger and fully transparent faces get drawn.
      faceAlphaVal := faceTransparencies[faceIdx];
      if faceAlphaVal > 127 then
        faceAlphaVal -= 256;
    end;
    if hasTextures then
      faceTexId := faceTextures[faceIdx];

    if faceAlphaVal = -2 then
      faceType := 3;
    if faceAlphaVal = -1 then
      faceType := 2;

    faceColor := faceColors[faceIdx] and $FFFF;

    if faceTexId <> -1 then
      case faceType of
        0:
          begin
            r1 := EnsureRange(TItemSprite.LightIntensity(vNx[faceIndices1[faceIdx]], vNy[faceIndices1[faceIdx]], vNz[faceIndices1[faceIdx]], vMag[faceIndices1[faceIdx]], attenuation, ambient), 2, 126);
            r2 := EnsureRange(TItemSprite.LightIntensity(vNx[faceIndices2[faceIdx]], vNy[faceIndices2[faceIdx]], vNz[faceIndices2[faceIdx]], vMag[faceIndices2[faceIdx]], attenuation, ambient), 2, 126);
            r3 := EnsureRange(TItemSprite.LightIntensity(vNx[faceIndices3[faceIdx]], vNy[faceIndices3[faceIdx]], vNz[faceIndices3[faceIdx]], vMag[faceIndices3[faceIdx]], attenuation, ambient), 2, 126);
          end;
        1:
          begin
            r1 := EnsureRange(TItemSprite.LightIntensity(fNx[faceIdx], fNy[faceIdx], fNz[faceIdx], 1, faceAttenuation, ambient), 2, 126);
            r2 := -1;
            r3 := -1;
          end;
        else
          begin
            r1 := faceColor;
            r2 := -1;
            r3 := -2;
          end;
      end
    else
    case faceType of
      0: // Gouraud flat-shaded (no texture, 3 vertex colors)
        begin
          r1 := TItemSprite.ApplyLightIntensity(faceColor, vNx[faceIndices1[faceIdx]], vNy[faceIndices1[faceIdx]], vNz[faceIndices1[faceIdx]], vMag[faceIndices1[faceIdx]], attenuation, ambient);
          r2 := TItemSprite.ApplyLightIntensity(faceColor, vNx[faceIndices2[faceIdx]], vNy[faceIndices2[faceIdx]], vNz[faceIndices2[faceIdx]], vMag[faceIndices2[faceIdx]], attenuation, ambient);
          r3 := TItemSprite.ApplyLightIntensity(faceColor, vNx[faceIndices3[faceIdx]], vNy[faceIndices3[faceIdx]], vNz[faceIndices3[faceIdx]], vMag[faceIndices3[faceIdx]], attenuation, ambient);
        end;
      1: // Single-color face with face normal
        begin
          if hasFaceNormals then
          begin
            r1 := TItemSprite.ApplyLightIntensity(faceColor, fNx[faceIdx], fNy[faceIdx], fNz[faceIdx], 1, faceAttenuation, ambient);
            r2 := -1;
            r3 := -1;
          end
          else
          begin
            r1 := faceColor;
            r2 := -1; r3 := -1;
          end;
        end;
      3: // Always bright face
        begin r1 := 128; r2 := -1; r3 := -1; end;
      else // No lighting change
        begin
          r1 := faceColor;
          r2 := -1;
          r3 := -2;
        end;
    end;

    Self.LitModel.FaceColors1[faceIdx] := r1;
    Self.LitModel.FaceColors2[faceIdx] := r2;
    Self.LitModel.FaceColors3[faceIdx] := r3;
  end;
end;

(*
## TItemSprite.FrameCount
```pascal
function TItemSprite.FrameCount(): Integer;
```
How many different icons the item's animated textures cycle through, `1` for an item that
doesn't animate. Any `frame` given to {ref}`TItemSprite.ToImage` wraps around at this.

Every animated texture on the model and on the item a note is of has to be back where it started
at once, so this is the smallest count all their own frame counts divide into.

Example:
```pascal
sprite := TItemSprite.Create(6570);
for frame := 0 to sprite.FrameCount() - 1 do
  sprite.ToImage(False, 0, frame).Show();
```
*)
function TItemSprite.FrameCount(): Integer;
var
  i, texture: Integer;
  counted: TIntegerArray;
begin
  Result := Max(Length(Self.NotePixels), 1);

  for i := 0 to High(Self.LitModel.FaceTextures) do
  begin
    texture := Self.LitModel.FaceTextures[i];
    if (texture = -1) or (Self.LitModel.FaceColors3[i] = -2) or counted.Contains(texture) then
      Continue;

    counted += texture;
    Result := TTextureLoader.CombineFrameCounts(Result, TextureLoader.FrameCount(texture));
  end;
end;

(*
## TItemSprite.Project
```pascal
procedure TItemSprite.Project(selected: Boolean = False; noted: Boolean = False; frame: Integer = 0);
```
Sets up the 36x32 rasterizer and projects and draws the model through the item's calibrated 2D
camera parameters.

`selected` pushes the camera back to 1.04 times the item's `Zoom2D`, which is what the game does
for the item you currently have selected so its thicker outline still fits inside the icon.

`noted` pushes it back to 1.5 times instead, the smaller icon the game draws on top of note paper.
It takes priority over `selected`.

`frame` is which animation frame textured faces are drawn with, see {ref}`TItemSprite.FrameCount`.
*)
procedure TItemSprite.Project(selected: Boolean = False; noted: Boolean = False; frame: Integer = 0);
var
  zoom2d, xOffset, yOffset: Integer;
  xanSin, pitchOffsetY, pitchOffsetZ, i: Integer;
  dump: TIntegerArray;
begin
  zoom2d := Self.ItemDef.Zoom2D;
  if noted then
    zoom2d := Trunc(1.5 * zoom2d)
  else if selected then
    zoom2d := Trunc(1.04 * zoom2d);

  xanSin := Self.ItemDef.Xan2D;
  xOffset := Self.ItemDef.XOffset2D;
  yOffset := Self.ItemDef.YOffset2D;

  Self.Sprite := TSpritePixels.Create(36, 32);
  Self.Graphics.SetRasterBuffer(Self.Sprite.Pixels, 36, 32);
  Self.Graphics.Reset();
  Self.Graphics.Zoom := 512;
  Self.Graphics.SetRasterClipping();
  Self.Graphics.SetOffset(16, 16);
  Self.Graphics.RasterGouraudLowRes := False;
  Self.Graphics.TextureFrame := frame;

  pitchOffsetY := zoom2d * CircularAngle.SINE[xanSin] shr 16;
  pitchOffsetZ := zoom2d * CircularAngle.COSINE[xanSin] shr 16;

  Self.LitModel.CalcBoundsCylinder();

  Self.LitModel.ProjectAndDraw(
    Self.Graphics,
    0,
    Self.ItemDef.Yan2D,
    Self.ItemDef.Zan2D,
    Self.ItemDef.Xan2D,
    xOffset,
    Self.LitModel.ModelHeight div 2 + pitchOffsetY + yOffset,
    pitchOffsetZ + yOffset
  );
end;

(*
## TItemSprite.ToImage
```pascal
function TItemSprite.ToImage(selected: Boolean = False; shadowColor: Integer = 0; frame: Integer = 0): TImage;
```
Projects and rasterizes the model lit by {ref}`TItemSprite.Create` and returns the resulting
36x32 icon.

`shadowColor` can be set by the user, items use `$FF333333` most of the time except when the
bank is open, in which case `$FF302020` is used instead.
`0` which is the default means no shadow will be drawn.

`frame` picks the animation frame of an item with animated textures, see
{ref}`TItemSprite.FrameCount`.

Colours are given the way `ColorUtils.Palette` writes one - alpha, red, green and blue -
because they go straight into the rasterizer's buffer. The near-black outline is not quite
zero, since zero is what marks a pixel as untouched.

```pascal
img := sprite.ToImage();
img.Show();
Sleep(3000);
img := sprite.ToImage(True, 0);
img.Show();
```
*)
function TItemSprite.ToImage(selected: Boolean = False; shadowColor: Integer = 0; frame: Integer = 0): TImage;
begin
  Self.Project(selected, False, frame);

  Self.Sprite.DrawBorder($FF000001);
  if selected then
    Self.Sprite.DrawBorder($FFFFFFFF);

  if shadowColor <> 0 then
    Self.Sprite.DrawShadow(shadowColor);

  if Length(Self.NotePixels) > 0 then
    Self.Sprite.Overlay(Self.NotePixels[frame mod Length(Self.NotePixels)]);

  Result := Self.Sprite.ToImage();
end;

(*
## TItemSprite.BorderImage
```pascal
function TItemSprite.BorderImage(selected: Boolean = False; frame: Integer = 0): TImage;
```
The item's outline on its own, without the item or a shadow behind it.

Renders the icon exactly as {ref}`TItemSprite.ToImage` does and then returns only the pixels
{ref}`TSpritePixels.DrawBorder` laid down, so the outline sits at the same place in the 36x32
canvas as it does in the full icon.

```pascal
img := sprite.BorderImage();
img.Show();
```
*)
function TItemSprite.BorderImage(selected: Boolean = False; frame: Integer = 0): TImage;
begin
  Self.Project(selected, False, frame);

  Self.Sprite.DrawBorder($FF000001);
  if selected then
    Self.Sprite.DrawBorder($FFFFFFFF);

  if Length(Self.NotePixels) > 0 then
    Self.Sprite.Overlay(Self.NotePixels[frame mod Length(Self.NotePixels)]);

  Result := Self.Sprite.BorderImage();
end;

(*
## TItemSprite.MaskImage
```pascal
function TItemSprite.MaskImage(selected: Boolean = False; frame: Integer = 0): TImage;
```
The item's outline on its own filled white.

```pascal
img := sprite.MaskImage();
img.Show();
```
*)
function TItemSprite.MaskImage(selected: Boolean = False; frame: Integer = 0): TImage;
begin
  Self.Project(selected, False, frame);

  Self.Sprite.DrawBorder($FF000001);
  if selected then
    Self.Sprite.DrawBorder($FFFFFFFF);

  if Length(Self.NotePixels) > 0 then
    Self.Sprite.Overlay(Self.NotePixels[frame mod Length(Self.NotePixels)]);

  Result := Self.Sprite.MaskImage();
end;

function TItemSprite.GetCRC(img: TImage; top: Integer = 9): UInt32; static;
var
  ptr: PColorBGRA;
begin
  ptr := img.Data;
  Inc(ptr, top*36);  //skip the top pixels e.g. stack numbers
  Result := CrcData(ptr, 3312);
end;
