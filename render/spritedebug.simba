(*
# Sprite Debug
Tracing for the sprite renderer, off unless `SpriteDebugEnabled` is set.

The renderer is a port of the game's own, so the way to find a difference is to dump the same
intermediate values at each step and compare them against the original's.
*)
var
  SpriteDebugEnabled: Boolean = False;

(*
## DebugLine
```pascal
procedure DebugLine(stage, body: String);
```
Prints one tagged line while `SpriteDebugEnabled` is set, and nothing otherwise.

The sprite renderer is a port of the game's own, so the way to tell whether it went wrong is to
dump the same intermediate values the original produces and compare. `stage` names which step
the line belongs to.
*)
procedure DebugLine(stage, body: String);
begin
  if not SpriteDebugEnabled then Exit;
  WriteLn('[', stage, '] ', body);
end;

(*
## DebugInts
```pascal
procedure DebugInts(stage, name: String; constref values: TIntegerArray; count: Integer);
```
Summarises an array as its length, its sum and its first few entries - enough to spot a
divergence without printing thousands of numbers.
*)
procedure DebugInts(stage, name: String; constref values: TIntegerArray; count: Integer);
var
  i, shown: Integer;
  sum: Int64;
  head: String;
begin
  if not SpriteDebugEnabled then Exit;

  if count > Length(values) then
    count := Length(values);

  sum := 0;
  for i := 0 to count - 1 do
    sum += values[i];

  shown := count;
  if shown > 8 then shown := 8;

  head := '';
  for i := 0 to shown - 1 do
  begin
    if i > 0 then head += ',';
    head += ToStr(values[i]);
  end;

  WriteLn('[', stage, '] ', name, ' n=', count, ' sum=', sum, ' head=', head);
end;

(*
## DebugBytes
```pascal
procedure DebugBytes(stage, name: String; constref values: TByteArray; count: Integer);
```
{ref}`DebugInts` for a byte array, widened so the values print unsigned.
*)
procedure DebugBytes(stage, name: String; constref values: TByteArray; count: Integer);
var
  i: Integer;
  widened: TIntegerArray;
begin
  if not SpriteDebugEnabled then Exit;

  if Length(values) = 0 then
  begin
    WriteLn('[', stage, '] ', name, ' null');
    Exit;
  end;

  if count > Length(values) then
    count := Length(values);

  SetLength(widened, count);
  for i := 0 to count - 1 do
    widened[i] := values[i] and 255;

  DebugInts(stage, name, widened, count);
end;

(*
## DebugPixelRows
```pascal
procedure DebugPixelRows(stage: String; constref pixels: TIntegerArray; width, height: Integer);
```
Summarises a rendered buffer per row: how much colour each row holds and how many of its pixels
were touched, which localises a difference to a band of the image.
*)
procedure DebugPixelRows(stage: String; constref pixels: TIntegerArray; width, height: Integer);
var
  row, col, value, nonzero, rowNonzero: Integer;
  total, rowTotal: Int64;
  rowSums, rowCounts: String;
begin
  if not SpriteDebugEnabled then Exit;

  total := 0;
  nonzero := 0;
  rowSums := '';
  rowCounts := '';

  for row := 0 to height - 1 do
  begin
    rowTotal := 0;
    rowNonzero := 0;
    for col := 0 to width - 1 do
    begin
      value := pixels[row * width + col];
      rowTotal += value;
      if value <> 0 then Inc(rowNonzero);
    end;

    total += rowTotal;
    nonzero += rowNonzero;

    if row > 0 then
    begin
      rowSums += ',';
      rowCounts += ',';
    end;
    rowSums += ToStr(rowTotal);
    rowCounts += ToStr(rowNonzero);
  end;

  WriteLn('[', stage, '] total=', total, ' nonzero=', nonzero);
  WriteLn('[', stage, '] rowsums=', rowSums);
  WriteLn('[', stage, '] rowcounts=', rowCounts);
end;

(*
## DebugPalette
```pascal
procedure DebugPalette(stage: String; constref palette: TIntegerArray);
```
Prints a handful of fixed entries of a palette, to confirm two palettes are the same one without
comparing 65536 values.
*)
procedure DebugPalette(stage: String; constref palette: TIntegerArray);
var
  i: Integer;
  body: String;
  probes: TIntegerArray;
begin
  if not SpriteDebugEnabled then Exit;

  probes := [128, 1000, 12345, 32000, 45678, 65535];
  body := '';
  for i := 0 to High(probes) do
  begin
    if i > 0 then body += ' ';
    body += 'p' + ToStr(probes[i]) + '=' + ToStr(palette[probes[i]]);
  end;

  WriteLn('[', stage, '] ', body);
end;
