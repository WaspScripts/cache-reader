(*
# Lit Model
A model prepared for drawing: the geometry of a model definition, plus the per face colours
lighting writes and the routines that project and rasterize it.

The geometry is shared with the definition rather than copied - nothing here writes to it, and
lighting keeps its colours in arrays of its own.
*)

{$DEFINE WL_CACHE_LITMODEL_INCLUDED}
{$IFNDEF WL_CACHE_GRAPHICS3D_INCLUDED}   {$INCLUDE_ONCE ../utils/graphics3d.simba}    {$ENDIF}
{$IFNDEF WL_CACHE_DEFINITION_MODELS_INCLUDED}  {$INCLUDE_ONCE ../definitions/models.simba}  {$ENDIF}
{$IFNDEF WL_CACHE_LOADER_TEXTURES_INCLUDED}    {$INCLUDE_ONCE ../loaders/textureloader.simba}  {$ENDIF}

type
  TLitModel = record
    VerticesCount, IndicesCount,
    NumTextureFaces,
    BoundsType,
    BottomY,
    XYZMag,
    Radius, Diameter, ModelHeight: Integer;

    Extremes: array [0..2] of Integer;

    VertexX, VertexY, VertexZ,
    FaceIndices1, FaceIndices2, FaceIndices3,
    FaceColors1, FaceColors2, FaceColors3,
    FaceTextures, FaceColors,
    TexIndices1, TexIndices2, TexIndices3: TIntegerArray;

    FacePriorities, FaceTransparencies,
    TextureCoords, TextureRenderTypes,
    FaceRenderTypes: TByteArray;

    HasTransparencies, HasTextures: Boolean;
  end;

(*
## LitModel.Create
```pascal
function TLitModel.Create(const src: TModelDefinition): TLitModel; static;
```
A decoded model, ready to light and draw.

The geometry arrays are shared with `src` rather than copied, since lighting writes its per face
colours into arrays of its own. Apply any recolouring, retexturing or resizing to the definition
first, and leave it alone afterwards - changing `src` later changes this model with it.
*)
function TLitModel.Create(const src: TModelDefinition): TLitModel; static;
var
  i: Integer;
begin
  Result.VerticesCount := src.VertexCount;

  Result.VertexX := src.VertexX;
  Result.VertexY := src.VertexY;
  Result.VertexZ := src.VertexZ;

  Result.IndicesCount := src.FaceCount;

  Result.FaceIndices1 := src.FaceIndices1;
  Result.FaceIndices2 := src.FaceIndices2;
  Result.FaceIndices3 := src.FaceIndices3;

  SetLength(Result.FaceColors1, src.FaceCount);
  SetLength(Result.FaceColors2, src.FaceCount);
  SetLength(Result.FaceColors3, src.FaceCount);

  Result.FacePriorities := src.FaceRenderPriorities;
  Result.FaceTransparencies := src.FaceTransparencies;
  Result.TextureCoords := src.TextureCoords;
  Result.TextureRenderTypes := src.TextureRenderTypes;
  Result.FaceTextures := src.FaceTextures;
  Result.FaceRenderTypes := src.FaceRenderTypes;
  Result.FaceColors := src.FaceColors;

  Result.NumTextureFaces := src.NumTextureFaces;

  Result.TexIndices1 := src.TexIndices1;
  Result.TexIndices2 := src.TexIndices2;
  Result.TexIndices3 := src.TexIndices3;

  Result.HasTransparencies := Length(Result.FaceTransparencies) > 0;
  Result.HasTextures := Length(Result.FaceTextures) > 0;

  Result.ModelHeight := 1000;

  for i := 0 to 2 do
    Result.Extremes[i] := -1;
end;

(*
## LitModel.FaceNormal
```pascal
procedure TLitModel.FaceNormal(idx: Integer; out nX, nY, nZ: Integer);
```
The normal of face `idx`, as the cross product of the face's two edges scaled to a length of
roughly 256.

The cross product is halved until it fits in 13 bits so that the squares below cannot overflow,
using an arithmetic shift - a logical one would turn a negative component into a large positive
and flip the face's normal.
*)
procedure TLitModel.FaceNormal(idx: Integer; out nX, nY, nZ: Integer);
var
  dxAB, dyAB, dzAB, dxAC, dyAC, dzAC,
  faceIdx1, faceIdx2, faceIdx3, len: Integer;
begin
  faceIdx1 := Self.FaceIndices1[idx];
  faceIdx2 := Self.FaceIndices2[idx];
  faceIdx3 := Self.FaceIndices3[idx];

  dxAB := Self.VertexX[faceIdx2] - Self.VertexX[faceIdx1];
  dyAB := Self.VertexY[faceIdx2] - Self.VertexY[faceIdx1];
  dzAB := Self.VertexZ[faceIdx2] - Self.VertexZ[faceIdx1];
  dxAC := Self.VertexX[faceIdx3] - Self.VertexX[faceIdx1];
  dyAC := Self.VertexY[faceIdx3] - Self.VertexY[faceIdx1];
  dzAC := Self.VertexZ[faceIdx3] - Self.VertexZ[faceIdx1];

  nX := dyAB * dzAC - dzAB * dyAC;
  nY := dzAB * dxAC - dxAB * dzAC;
  nZ := dxAB * dyAC - dxAC * dyAB;

  while (nX > 8192) or (nY > 8192) or (nZ > 8192) or (nX < -8192) or (nY < -8192) or (nZ < -8192) do
  begin
    nX := ArithmeticShr(nX, 1);
    nY := ArithmeticShr(nY, 1);
    nZ := ArithmeticShr(nZ, 1);
  end;

  len := Max(Trunc(Sqrt(nZ * nZ + nX * nX + nY * nY)), 1);

  nX := nX * 256 div len;
  nY := nY * 256 div len;
  nZ := nZ * 256 div len;
end;

(*
## LitModel.LightIntensity
```pascal
function TLitModel.LightIntensity(normalX, normalY, normalZ, mag, atten, ambient: Integer): Integer; static;
```
How brightly the fixed light falls on a surface facing along the normal, unclamped.
`mag` is how many face normals were summed into the normal, `1` for a single face's own normal.
*)
function TLitModel.LightIntensity(normalX, normalY, normalZ, mag, atten, ambient: Integer): Integer; static;
begin
  if (mag = 0) or (atten = 0) then
    Exit(ambient);

  Result := ((-50) * normalX + (-10) * normalY + (-50) * normalZ) div (atten * mag) + ambient;
end;

(*
## LitModel.ApplyLightIntensity
```pascal
function TLitModel.ApplyLightIntensity(color, intensity: Integer): Integer; static;
```
Scale a colour's luminance by a light intensity.

Pascal's `shr` is a *logical* shift, so it cannot be used here: `intensity`
is unclamped and goes negative for a face turned away from the light, and a
logical shift would turn that into a large positive value that clamps to full
brightness instead of the minimum.
*)
function TLitModel.ApplyLightIntensity(color, normalX, normalY, normalZ, mag, atten, ambient: Integer): Integer; static;
begin
  Result := (color and $FF80) + EnsureRange(((color and $7F) * TLitModel.LightIntensity(normalX, normalY, normalZ, mag, atten, ambient)) div 128, 2, 126);
end;

(*
## LitModel.Light
```pascal
procedure TLitModel.Light(ambient, contrast: Integer);
```
Computes vertex/face normals and lights each face from the fixed `-50, -10, -50` light the game
uses for items and world objects, writing the result into `FaceColors1/2/3`.

`ambient` and `contrast` are the values the client passes once it has added its base to the
definition's own: `Ambient + 64` for both, and `Contrast + 768` where the definition's contrast
is already scaled - by 5 for items and by 25 for objects.
*)
procedure TLitModel.Light(ambient, contrast: Integer);
const
  LIGHT_MAGNITUDE: Integer = 71; //Trunc(Sqrt(5100))
var
  attenuation, faceColor, faceAttenuation,
  i, faceIdx, faceType, faceRenderType, r1, r2, r3,
  nx, ny, nz,
  faceTexId, faceAlphaVal: Integer;
  vMag, vNx, vNy, vNz,
  fNx, fNy, fNz, dump,
  faceIndices1, faceIndices2, faceIndices3, faceColors, faceTextures: TIntegerArray;
  faceRenderTypes, faceTransparencies: TByteArray;
  hasFaceNormals, hasRenderTypes, hasTransparencies, hasTextures: Boolean;
begin
  SetLength(vNx, Self.VerticesCount);
  SetLength(vNy, Self.VerticesCount);
  SetLength(vNz, Self.VerticesCount);
  SetLength(vMag, Self.VerticesCount);
  SetLength(fNx, Self.IndicesCount);
  SetLength(fNy, Self.IndicesCount);
  SetLength(fNz, Self.IndicesCount);

  hasFaceNormals := False;

  //everything below is fixed for the whole model, so it is read out once rather than per face
  faceIndices1 := Self.FaceIndices1;
  faceIndices2 := Self.FaceIndices2;
  faceIndices3 := Self.FaceIndices3;
  faceColors := Self.FaceColors;
  faceTextures := Self.FaceTextures;
  faceRenderTypes := Self.FaceRenderTypes;
  faceTransparencies := Self.FaceTransparencies;

  hasRenderTypes := Length(faceRenderTypes) > 0;
  hasTransparencies := Length(faceTransparencies) > 0;
  hasTextures := Length(faceTextures) > 0;

  // Precompute attenuation (-50, -10, -50 direction)
  attenuation := Max((LIGHT_MAGNITUDE * contrast) shr 8, 1);
  faceAttenuation := (attenuation shr 1) + attenuation;

  for i := 0 to Self.IndicesCount - 1 do
  begin
    Self.FaceNormal(i, nx, ny, nz);

    if not hasRenderTypes then
      faceRenderType := 0
    else
    begin
      faceRenderType := faceRenderTypes[i];
      if faceRenderType > 127 then
        faceRenderType -= 256;
    end;

    if faceRenderType = 0 then
    begin
      vNx[faceIndices1[i]] += nx;
      vNy[faceIndices1[i]] += ny;
      vNz[faceIndices1[i]] += nz;
      Inc(vMag[faceIndices1[i]]);

      vNx[faceIndices2[i]] += nx;
      vNy[faceIndices2[i]] += ny;
      vNz[faceIndices2[i]] += nz;
      Inc(vMag[faceIndices2[i]]);

      vNx[faceIndices3[i]] += nx;
      vNy[faceIndices3[i]] += ny;
      vNz[faceIndices3[i]] += nz;
      Inc(vMag[faceIndices3[i]]);
    end
    else if faceRenderType = 1 then
    begin
      hasFaceNormals := True;
      fNx[i] := nx;
      fNy[i] := ny;
      fNz[i] := nz;
    end;
  end;

  for faceIdx := 0 to Self.IndicesCount - 1 do
  begin
    faceType := 0;
    faceAlphaVal := 0;
    faceTexId := -1;

    if hasRenderTypes then
      faceType := faceRenderTypes[faceIdx] and $FF;
    if hasTransparencies then
    begin
      // RuneLite reads this as a *signed* byte, so 0xFE/0xFF mean -2/-1.
      // TByteArray is unsigned here, so sign-extend before the comparisons
      // below, otherwise the "always bright" and "hidden face" render types
      // never trigger and fully transparent faces get drawn.
      faceAlphaVal := faceTransparencies[faceIdx];
      if faceAlphaVal > 127 then
        faceAlphaVal -= 256;
    end;
    if hasTextures then
      faceTexId := faceTextures[faceIdx];

    if faceAlphaVal = -2 then
      faceType := 3;
    if faceAlphaVal = -1 then
      faceType := 2;

    faceColor := faceColors[faceIdx] and $FFFF;

    if faceTexId <> -1 then
      case faceType of
        0:
          begin
            r1 := EnsureRange(TLitModel.LightIntensity(vNx[faceIndices1[faceIdx]], vNy[faceIndices1[faceIdx]], vNz[faceIndices1[faceIdx]], vMag[faceIndices1[faceIdx]], attenuation, ambient), 2, 126);
            r2 := EnsureRange(TLitModel.LightIntensity(vNx[faceIndices2[faceIdx]], vNy[faceIndices2[faceIdx]], vNz[faceIndices2[faceIdx]], vMag[faceIndices2[faceIdx]], attenuation, ambient), 2, 126);
            r3 := EnsureRange(TLitModel.LightIntensity(vNx[faceIndices3[faceIdx]], vNy[faceIndices3[faceIdx]], vNz[faceIndices3[faceIdx]], vMag[faceIndices3[faceIdx]], attenuation, ambient), 2, 126);
          end;
        1:
          begin
            r1 := EnsureRange(TLitModel.LightIntensity(fNx[faceIdx], fNy[faceIdx], fNz[faceIdx], 1, faceAttenuation, ambient), 2, 126);
            r2 := -1;
            r3 := -1;
          end;
        else
          begin
            r1 := faceColor;
            r2 := -1;
            r3 := -2;
          end;
      end
    else
    case faceType of
      0: // Gouraud flat-shaded (no texture, 3 vertex colors)
        begin
          r1 := TLitModel.ApplyLightIntensity(faceColor, vNx[faceIndices1[faceIdx]], vNy[faceIndices1[faceIdx]], vNz[faceIndices1[faceIdx]], vMag[faceIndices1[faceIdx]], attenuation, ambient);
          r2 := TLitModel.ApplyLightIntensity(faceColor, vNx[faceIndices2[faceIdx]], vNy[faceIndices2[faceIdx]], vNz[faceIndices2[faceIdx]], vMag[faceIndices2[faceIdx]], attenuation, ambient);
          r3 := TLitModel.ApplyLightIntensity(faceColor, vNx[faceIndices3[faceIdx]], vNy[faceIndices3[faceIdx]], vNz[faceIndices3[faceIdx]], vMag[faceIndices3[faceIdx]], attenuation, ambient);
        end;
      1: // Single-color face with face normal
        begin
          if hasFaceNormals then
          begin
            r1 := TLitModel.ApplyLightIntensity(faceColor, fNx[faceIdx], fNy[faceIdx], fNz[faceIdx], 1, faceAttenuation, ambient);
            r2 := -1;
            r3 := -1;
          end
          else
          begin
            r1 := faceColor;
            r2 := -1; r3 := -1;
          end;
        end;
      3: // Always bright face
        begin r1 := 128; r2 := -1; r3 := -1; end;
      else // No lighting change
        begin
          r1 := faceColor;
          r2 := -1;
          r3 := -2;
        end;
    end;

    Self.FaceColors1[faceIdx] := r1;
    Self.FaceColors2[faceIdx] := r2;
    Self.FaceColors3[faceIdx] := r3;
  end;
end;

(*
## LitModel.CalcBoundsCylinder
```pascal
procedure TLitModel.CalcBoundsCylinder();
```
Measures the cylinder the model fits inside: how far it reaches from the vertical axis, and how
far it rises above and drops below its origin.

The height is what an item icon is centred on, and the radius is what face sorting offsets
depths by so that they never go negative. It is computed once and remembered.
*)
procedure TLitModel.CalcBoundsCylinder();
var
  i, value: Integer;
begin
  if Self.BoundsType = 1 then
    Exit;

  Self.BoundsType := 1;
  Self.ModelHeight := 0;
  Self.BottomY := 0;
  Self.XYZMag := 0;

  for i := 0 to Self.VerticesCount - 1 do
  begin
    value := Self.VertexX[i] * Self.VertexX[i] + Self.VertexZ[i] * Self.VertexZ[i];
    if value > Self.XYZMag then
      Self.XYZMag := value;

    if -Self.VertexY[i] > Self.ModelHeight then
      Self.ModelHeight := -Self.VertexY[i];

    if Self.VertexY[i] > Self.BottomY then
      Self.BottomY := Self.VertexY[i];
  end;

  Self.XYZMag := Trunc(Sqrt(Self.XYZMag) + 0.99);
  Self.Radius := Trunc(Sqrt(Self.XYZMag * Self.XYZMag + Self.ModelHeight * Self.ModelHeight) + 0.99);
  Self.Diameter := Self.Radius + Trunc(Sqrt(Self.XYZMag * Self.XYZMag + Self.BottomY * Self.BottomY) + 0.99);
end;

type
  TLitModelViewport = record
    FaceClipped: TBooleanArray;
    ScreenX, ScreenY, Depth,
    LocalX, LocalY, LocalZ,
    SortedFaceIdx, SortedFaceDepth: TIntegerArray;
    SortedCount: Integer;
  end;

var
  Viewport: TLitModelViewport;

begin
  SetLength(Viewport.FaceClipped, 6500);
  SetLength(Viewport.ScreenX, 6500);
  SetLength(Viewport.ScreenY, 6500);
  SetLength(Viewport.Depth, 6500);
  SetLength(Viewport.LocalX, 6500);
  SetLength(Viewport.LocalY, 6500);
  SetLength(Viewport.LocalZ, 6500);
  SetLength(Viewport.SortedFaceIdx, 6500);
  SetLength(Viewport.SortedFaceDepth, 6500);
end;

(*
## LitModel.RasterFace
```pascal
procedure TLitModel.RasterFace(var graphics: TGraphics3D; faceIdx: Integer);
```
Draws one face, already projected to screen space by
{ref}`TLitModel.ProjectAndDraw`.

A face with three distinct vertex colours is Gouraud shaded and one with a single colour is
filled flat. Clipping is only turned on for faces that actually reach outside the viewport.

A textured face is drawn with the texels of `graphics.TextureFrame`. Its colours are light levels
rather than palette indices, and the texture is laid across it by the three points its texture
coordinate names, or by the face's own corners when it has none or names one that isn't mapped
flat. A texture that can't be loaded is drawn in its average colour instead.
*)
procedure TLitModel.RasterFace(var graphics: TGraphics3D; faceIdx: Integer);
var
  idx1, idx2, idx3, pal,
  texture, textureFace, origin, edgeU, edgeV,
  light1, light2, light3, average: Integer;
  texels: TIntegerArray;
begin
  idx1 := Self.FaceIndices1[faceIdx];
  idx2 := Self.FaceIndices2[faceIdx];
  idx3 := Self.FaceIndices3[faceIdx];
  graphics.RasterClipEnable := Viewport.FaceClipped[faceIdx];

  if not Self.HasTransparencies then
    graphics.RasterAlpha := 0
  else
    graphics.RasterAlpha := Self.FaceTransparencies[faceIdx] and $FF;

  if Self.HasTextures and (Self.FaceTextures[faceIdx] <> -1) then
  begin
    texture := Self.FaceTextures[faceIdx];

    textureFace := 255;
    if Length(Self.TextureCoords) > 0 then
      textureFace := Self.TextureCoords[faceIdx];
    if (textureFace <> 255) and (Self.TextureRenderTypes[textureFace] <> 0) then
      textureFace := 255;

    if textureFace = 255 then
    begin
      origin := idx1;
      edgeU := idx2;
      edgeV := idx3;
    end
    else
    begin
      origin := Self.TexIndices1[textureFace];
      edgeU := Self.TexIndices2[textureFace];
      edgeV := Self.TexIndices3[textureFace];
    end;

    light1 := Self.FaceColors1[faceIdx];
    if Self.FaceColors3[faceIdx] = -1 then
    begin
      light2 := light1;
      light3 := light1;
    end
    else
    begin
      light2 := Self.FaceColors2[faceIdx];
      light3 := Self.FaceColors3[faceIdx];
    end;

    texels := TextureLoader.Texels(texture, graphics.TextureFrame);
    if Length(texels) = 0 then
    begin
      average := 0;
      if TextureLoader.Exists(texture) then
        average := TextureLoader.Definitions[texture].AverageRGB;

      graphics.GouraudTriangle(
        Viewport.ScreenY[idx1], Viewport.ScreenY[idx2], Viewport.ScreenY[idx3],
        Viewport.ScreenX[idx1], Viewport.ScreenX[idx2], Viewport.ScreenX[idx3],
        (average and $FF80) + EnsureRange(((average and $7F) * light1) shr 7, 2, 126),
        (average and $FF80) + EnsureRange(((average and $7F) * light2) shr 7, 2, 126),
        (average and $FF80) + EnsureRange(((average and $7F) * light3) shr 7, 2, 126)
      );
      Exit;
    end;

    graphics.TexturedTriangle(
      Viewport.ScreenY[idx1], Viewport.ScreenY[idx2], Viewport.ScreenY[idx3],
      Viewport.ScreenX[idx1], Viewport.ScreenX[idx2], Viewport.ScreenX[idx3],
      light1, light2, light3,
      Viewport.LocalX[origin], Viewport.LocalX[edgeU], Viewport.LocalX[edgeV],
      Viewport.LocalY[origin], Viewport.LocalY[edgeU], Viewport.LocalY[edgeV],
      Viewport.LocalZ[origin], Viewport.LocalZ[edgeU], Viewport.LocalZ[edgeV],
      texels, TextureLoader.Definitions[texture].IsTransparent
    );
  end
  else if Self.FaceColors3[faceIdx] = -1 then
  begin
    pal := ColorUtils.Palette[Self.FaceColors1[faceIdx]];
    graphics.RasterFlat(Viewport.ScreenX[idx1], Viewport.ScreenX[idx2], Viewport.ScreenX[idx3], Viewport.ScreenY[idx1], Viewport.ScreenY[idx2], Viewport.ScreenY[idx3], pal);
  end
  else
  begin
    graphics.GouraudTriangle(Viewport.ScreenY[idx1], Viewport.ScreenY[idx2], Viewport.ScreenY[idx3], Viewport.ScreenX[idx1], Viewport.ScreenX[idx2], Viewport.ScreenX[idx3], Self.FaceColors1[faceIdx], Self.FaceColors2[faceIdx], Self.FaceColors3[faceIdx]);
  end;
end;

(*
## LitModel.DrawByPriority
```pascal
procedure TLitModel.DrawByPriority(var graphics: TGraphics3D);
```
Draws faces in the order their render priorities ask for, rather than purely by depth.

Depth sorting alone gets some models wrong, so faces can carry a priority that pins them in
front of or behind others regardless of where they sit. Priorities 0 to 9 are drawn as groups in
order, while 10 and 11 stay depth sorted and are woven in between them at the points where their
depth passes the average depth of the group being drawn.
*)
procedure TLitModel.DrawByPriority(var graphics: TGraphics3D);
var
  i, j, face, priority, dist, pos, listEnd, idx, curDist,
  avg0, avg1, avg2: Integer;
  numOfPriority, prioritySum: array [0..11] of Integer;
  orderedFaces, orderedDist: array [0..11] of TIntegerArray;
begin
  for i := 0 to 11 do
    SetLength(orderedFaces[i], Viewport.SortedCount);

  SetLength(orderedDist[10], Viewport.SortedCount);
  SetLength(orderedDist[11], Viewport.SortedCount);

  for i := 0 to Viewport.SortedCount - 1 do
  begin
    face := Viewport.SortedFaceIdx[i];
    dist := Viewport.SortedFaceDepth[i] + Self.Radius;
    priority := Self.FacePriorities[face];

    pos := numOfPriority[priority];
    orderedFaces[priority][pos] := face;
    Inc(numOfPriority[priority]);

    if priority < 10 then
      prioritySum[priority] += dist
    else
      orderedDist[priority][pos] := dist;
  end;

  if (numOfPriority[1] > 0) or (numOfPriority[2] > 0) then
    avg0 := (prioritySum[1] + prioritySum[2]) div (numOfPriority[1] + numOfPriority[2]);

  if (numOfPriority[3] > 0) or (numOfPriority[4] > 0) then
    avg1 := (prioritySum[3] + prioritySum[4]) div (numOfPriority[3] + numOfPriority[4]);

  if (numOfPriority[6] > 0) or (numOfPriority[8] > 0) then
    avg2 := (prioritySum[8] + prioritySum[6]) div (numOfPriority[8] + numOfPriority[6]);

  idx := 10;
  pos := 0;
  listEnd := numOfPriority[10];
  if pos = listEnd then
  begin
    idx := 11;
    listEnd := numOfPriority[11];
  end;

  if pos < listEnd then
    curDist := orderedDist[idx][pos]
  else
    curDist := -1000;

  for j := 0 to 9 do
  begin
    while ((j = 0) and (curDist > avg0)) or
          ((j = 3) and (curDist > avg1)) or
          ((j = 5) and (curDist > avg2)) do
    begin
      Self.RasterFace(graphics, orderedFaces[idx][pos]);
      Inc(pos);

      if (pos = listEnd) and (idx <> 11) then
      begin
        idx := 11;
        pos := 0;
        listEnd := numOfPriority[11];
      end;

      if pos < listEnd then
        curDist := orderedDist[idx][pos]
      else
        curDist := -1000;
    end;

    for i := 0 to numOfPriority[j] - 1 do
      Self.RasterFace(graphics, orderedFaces[j][i]);
  end;

  while curDist <> -1000 do
  begin
    Self.RasterFace(graphics, orderedFaces[idx][pos]);
    Inc(pos);

    if (pos = listEnd) and (idx <> 11) then
    begin
      idx := 11;
      pos := 0;
      listEnd := numOfPriority[11];
    end;

    if pos < listEnd then
      curDist := orderedDist[idx][pos]
    else
      curDist := -1000;
  end;
end;

(*
## LitModel.Draw
```pascal
procedure TLitModel.Draw(var graphics: TGraphics3D);
```
Draws every visible face of the projected model, furthest first.

Back faces are dropped by the sign of their screen-space winding, and what is left is sorted by
average depth with an insertion sort - models are small enough that it beats anything cleverer.
Models with render priorities are handed to {ref}`TLitModel.DrawByPriority` instead.
*)
procedure TLitModel.Draw(var graphics: TGraphics3D);
var
  i, idx1, idx2, idx3, j, tmpI, tmpD, viewport1, viewport2, viewport3: Integer;
begin
  Viewport.SortedCount := 0;

  for i := 0 to Self.IndicesCount - 1 do
  begin
    if Self.FaceColors3[i] = -2 then Continue;
    idx1 := Self.FaceIndices1[i];
    idx2 := Self.FaceIndices2[i];
    idx3 := Self.FaceIndices3[i];

    viewport1 := Viewport.ScreenX[idx1];
    viewport2 := Viewport.ScreenX[idx2];
    viewport3 := Viewport.ScreenX[idx3];

    if (viewport1 - viewport2) * (Viewport.ScreenY[idx3] - Viewport.ScreenY[idx2]) -
       (viewport3 - viewport2) * (Viewport.ScreenY[idx1] - Viewport.ScreenY[idx2]) <= 0 then
      Continue;

    if (viewport1 >= 0) and (viewport2 >= 0) and (viewport3 >= 0) and
       (viewport1 <= graphics.ClipWidth) and (viewport2 <= graphics.ClipWidth) and (viewport3 <= graphics.ClipWidth) then
      Viewport.FaceClipped[i] := False
    else
      Viewport.FaceClipped[i] := True;
    Viewport.SortedFaceIdx[Viewport.SortedCount] := i;
    Viewport.SortedFaceDepth[Viewport.SortedCount] := (Viewport.Depth[idx1] + Viewport.Depth[idx2] + Viewport.Depth[idx3]) div 3;
    Inc(Viewport.SortedCount);
  end;

  for i := 1 to Viewport.SortedCount - 1 do
  begin
    tmpI := Viewport.SortedFaceIdx[i];
    tmpD := Viewport.SortedFaceDepth[i];
    j := i - 1;
    while (j >= 0) and (Viewport.SortedFaceDepth[j] < tmpD) do
    begin
      Viewport.SortedFaceIdx[j + 1] := Viewport.SortedFaceIdx[j];
      Viewport.SortedFaceDepth[j + 1] := Viewport.SortedFaceDepth[j];
      Dec(j);
    end;
    Viewport.SortedFaceIdx[j + 1] := tmpI;
    Viewport.SortedFaceDepth[j + 1] := tmpD;
  end;

  if Length(Self.FacePriorities) = 0 then
  begin
    for i := 0 to Viewport.SortedCount - 1 do
      Self.RasterFace(graphics, Viewport.SortedFaceIdx[i]);
    Exit;
  end;

  Self.DrawByPriority(graphics);
end;

(*
## LitModel.ProjectAndDraw
```pascal
procedure TLitModel.ProjectAndDraw(var graphics: TGraphics3D; yzRot, xzRot, xyRot, orientation, xOffset, yOffset, zOffset: Integer);
```
Rotates the model, projects its vertices onto the screen and draws it.

The three rotations are applied about each axis in turn, the model is moved by the offsets, and
then the camera pitch given by `orientation` is applied. Every angle is in the client's units of
2048 to a full turn and every multiply is fixed point, matching what the game does rather than
using floating point. Vertices land in {ref}`Viewport`, which {ref}`TLitModel.Draw` then reads.
*)
procedure TLitModel.ProjectAndDraw(var graphics: TGraphics3D; yzRot, xzRot, xyRot, orientation, xOffset, yOffset, zOffset: Integer);
var
  centerX, centerY, sinR1, cosR1, sinY, cosY, sinZ, cosZ, sinX, cosX, zRelatedVar, tmp: Integer;
  i, vx, vy, vz: Integer;
begin
  if (Self.BoundsType <> 2) and (Self.BoundsType <> 1) then
  begin
    Self.BoundsType := 2;
    Self.XYZMag := 0;

    for i := 0 to Self.VerticesCount - 1 do
    begin
      tmp := Self.VertexX[i] * Self.VertexX[i] + Self.VertexY[i] * Self.VertexY[i] + Self.VertexZ[i] * Self.VertexZ[i];
      if tmp > Self.XYZMag then
        Self.XYZMag := tmp;
    end;

    Self.XYZMag := Trunc(Sqrt(Self.XYZMag) + 0.99);
    Self.Radius := Self.XYZMag;
    Self.Diameter := Self.XYZMag + Self.XYZMag;
  end;

  centerX := graphics.CenterX;
  centerY := graphics.CenterY;
  sinR1 := CircularAngle.SINE[yzRot];
  cosR1 := CircularAngle.COSINE[yzRot];
  sinY := CircularAngle.SINE[xzRot];
  cosY := CircularAngle.COSINE[xzRot];
  sinZ := CircularAngle.SINE[xyRot];
  cosZ := CircularAngle.COSINE[xyRot];
  sinX := CircularAngle.SINE[orientation];
  cosX := CircularAngle.COSINE[orientation];
  zRelatedVar := (sinX * yOffset + cosX * zOffset) shr 16;

  for i := 0 to Self.VerticesCount - 1 do
  begin
    vx := Self.VertexX[i];
    vy := Self.VertexY[i];
    vz := Self.VertexZ[i];

    if xyRot <> 0 then
    begin
      tmp := (vy * sinZ + vx * cosZ) shr 16;
      vy := (vy * cosZ - vx * sinZ) shr 16;
      vx := tmp;
    end;

    if yzRot <> 0 then
    begin
      tmp := (vy * cosR1 - vz * sinR1) shr 16;
      vz := (vy * sinR1 + vz * cosR1) shr 16;
      vy := tmp;
    end;

    if xzRot <> 0 then
    begin
      tmp := (vz * sinY + vx * cosY) shr 16;
      vz := (vz * cosY - vx * sinY) shr 16;
      vx := tmp;
    end;

    vx += xOffset;
    vy += yOffset;
    vz += zOffset;
    tmp := (vy * cosX - vz * sinX) shr 16;
    vz := (vy * sinX + vz * cosX) shr 16;
    Viewport.Depth[i] := vz - zRelatedVar;
    Viewport.ScreenX[i] := vx * graphics.Zoom div vz + centerX;
    Viewport.ScreenY[i] := tmp * graphics.Zoom div vz + centerY;

    if Self.HasTextures then
    begin
      Viewport.LocalX[i] := vx;
      Viewport.LocalY[i] := tmp;
      Viewport.LocalZ[i] := vz;
    end;
  end;

  Self.Draw(graphics);
end;
