{$include_once ../utils/helpers.simba}
{$include_once ./circularangle.simba}
{$include_once ./graphics3d.simba}
{$include_once ../definitions/models.simba}

type
  TLitModel = record
    VerticesCount: Integer;
    VertexX, VertexY, VertexZ: TIntegerArray;
    IndicesCount: Integer;
    FaceIndices1, FaceIndices2, FaceIndices3: TIntegerArray;
    FaceColors1, FaceColors2, FaceColors3: TIntegerArray;
    FacePriorities: TByteArray;
    FaceTransparencies: TByteArray;
    TextureCoords: TByteArray;
    FaceTextures: TIntegerArray;
    FaceColors: TIntegerArray;
    FaceRenderTypes: TByteArray;
    NumTextureFaces: Integer;
    TexIndices1, TexIndices2, TexIndices3: TIntegerArray;
    BoundsType: Integer;
    BottomY: Integer;
    XYZMag: Integer;
    Radius, Diameter: Integer;
    Extremes: array [0..2] of Integer;
    ModelHeight: Integer;
    VertexNormals: TVertexNormalArray;
    FaceNormals: TFaceNormalArray;
  end;

function TLitModel.Create(const src: TModelDefinition): TLitModel; static;
var
  i: Integer;
begin
  Result.VerticesCount := src.VertexCount;

  SetLength(Result.VertexX, src.VertexCount);
  SetLength(Result.VertexY, src.VertexCount);
  SetLength(Result.VertexZ, src.VertexCount);
  Move(src.VertexX[0], Result.VertexX[0], src.VertexCount * SizeOf(Integer));
  Move(src.VertexY[0], Result.VertexY[0], src.VertexCount * SizeOf(Integer));
  Move(src.VertexZ[0], Result.VertexZ[0], src.VertexCount * SizeOf(Integer));

  Result.IndicesCount := src.FaceCount;

  SetLength(Result.FaceIndices1, src.FaceCount);
  SetLength(Result.FaceIndices2, src.FaceCount);
  SetLength(Result.FaceIndices3, src.FaceCount);
  Move(src.FaceIndices1[0], Result.FaceIndices1[0], src.FaceCount * SizeOf(Integer));
  Move(src.FaceIndices2[0], Result.FaceIndices2[0], src.FaceCount * SizeOf(Integer));
  Move(src.FaceIndices3[0], Result.FaceIndices3[0], src.FaceCount * SizeOf(Integer));

  SetLength(Result.FaceColors1, src.FaceCount);
  SetLength(Result.FaceColors2, src.FaceCount);
  SetLength(Result.FaceColors3, src.FaceCount);
  SetLength(Result.FacePriorities, src.FaceCount);
  SetLength(Result.FaceTransparencies, src.FaceCount);

  if Length(src.TextureCoords) > 0 then
    SetLength(Result.TextureCoords, src.FaceCount);
  if Length(src.FaceTextures) > 0 then
    SetLength(Result.FaceTextures, src.FaceCount);
  if Length(src.FaceRenderTypes) > 0 then
    SetLength(Result.FaceRenderTypes, src.FaceCount);
  if Length(src.FaceColors) > 0 then
    SetLength(Result.FaceColors, src.FaceCount);

  Result.NumTextureFaces := src.NumTextureFaces;

  if src.TexIndices1 <> [] then
    SetLength(Result.TexIndices1, src.NumTextureFaces);
  if src.TexIndices2 <> [] then
    SetLength(Result.TexIndices2, src.NumTextureFaces);
  if src.TexIndices3 <> [] then
    SetLength(Result.TexIndices3, src.NumTextureFaces);

  Result.ModelHeight := 1000;

  for i := 0 to 2 do
    Result.Extremes[i] := -1;
end;

procedure TLitModel._ComputeNormals(idx: Integer; out nX, nY, nZ: Integer);
var
  dxAB, dyAB, dzAB, dxAC, dyAC, dzAC,
  faceIdx1, faceIdx2, faceIdx3, len: Integer;
begin
  faceIdx1 := Self.FaceIndices1[idx];
  faceIdx2 := Self.FaceIndices2[idx];
  faceIdx3 := Self.FaceIndices3[idx];

  dxAB := Self.VertexX[faceIdx2] - Self.VertexX[faceIdx1];
  dyAB := Self.VertexY[faceIdx2] - Self.VertexY[faceIdx1];
  dzAB := Self.VertexZ[faceIdx2] - Self.VertexZ[faceIdx1];
  dxAC := Self.VertexX[faceIdx3] - Self.VertexX[faceIdx1];
  dyAC := Self.VertexY[faceIdx3] - Self.VertexY[faceIdx1];
  dzAC := Self.VertexZ[faceIdx3] - Self.VertexZ[faceIdx1];

  nX := dyAB * dzAC - dzAB * dyAC;
  nY := dzAB * dxAC - dxAB * dzAC;
  nZ := dxAB * dyAC - dxAC * dyAB;

  while (nX > 8192) or (nY > 8192) or (nZ > 8192) or (nX < -8192) or (nY < -8192) or (nZ < -8192) do
  begin
    nX := nX shr 1;
    nY := nY shr 1;
    nZ := nZ shr 1;
  end;

  len := Min(Round(Sqrt(nZ * nZ + nX * nX + nY * nY)), 1);

  nX := nX * 256 div len;
  nY := nY * 256 div len;
  nZ := nZ * 256 div len;
end;

procedure TLitModel.ComputeNormals();
var
  nx, ny, nz, i,
  faceIdx1, faceIdx2, faceIdx3: Integer;
  vertex: TVertexNormal;
begin
  SetLength(Self.VertexNormals, Self.VerticesCount);
  SetLength(Self.FaceNormals, 0);

  if Self.FaceRenderTypes.IsEmpty then
  begin
    for i := 0 to Self.IndicesCount - 1 do
    begin
      Self._ComputeNormals(i, nX, nY, nZ);

      faceIdx1 := Self.FaceIndices1[i];
      Self.VertexNormals[faceIdx1].X += nx;
      Self.VertexNormals[faceIdx1].Y += ny;
      Self.VertexNormals[faceIdx1].Z += nz;
      Self.VertexNormals[faceIdx1].Magnitude += 1;

      faceIdx2 := Self.FaceIndices2[i];
      Self.VertexNormals[faceIdx2].X += nx;
      Self.VertexNormals[faceIdx2].Y += ny;
      Self.VertexNormals[faceIdx2].Z += nz;
      Self.VertexNormals[faceIdx2].Magnitude += 1;

      faceIdx3 := Self.FaceIndices3[i];
      Self.VertexNormals[faceIdx3].X += nx;
      Self.VertexNormals[faceIdx3].Y += ny;
      Self.VertexNormals[faceIdx3].Z += nz;
      Self.VertexNormals[faceIdx3].Magnitude += 1;
    end;

    Exit;
  end;

  SetLength(Self.FaceNormals, Self.IndicesCount);
  for i := 0 to Self.IndicesCount - 1 do
  begin
    Self._ComputeNormals(i, nX, nY, nZ);
    Self.FaceNormals[i] := [nx, ny, nz];
  end;
end;


procedure TLitModel.Reset();
begin
  SetLength(Self.VertexNormals, 0);
  SetLength(Self.FaceNormals, 0);
end;

procedure TLitModel.Resize(sx, sy, sz: Integer);
var
  i: Integer;
begin
  for i := 0 to Self.VerticesCount - 1 do
  begin
    Self.VertexX[i] := Self.VertexX[i] * sx div 128;
    Self.VertexY[i] := sy * Self.VertexY[i] div 128;
    Self.VertexZ[i] := sz * Self.VertexZ[i] div 128;
  end;

  Self.Reset();
end;


procedure TLitModel.Recolor(oldColor, newColor: Integer);
var
  i: Integer;
begin
  i := Self.FaceColors.IndexOf(oldColor);
  if i > -1 then
    Self.FaceColors[i] := newColor;
end;

procedure TLitModel.Retexture(oldTex, newTex: Integer);
var
  i: Integer;
begin
  i := Self.FaceTextures.IndexOf(oldTex);
  if i > -1 then
    Self.FaceTextures[i] := newTex;
end;

procedure TLitModel.CalcBoundsCylinder();
var
  i, value: Integer;
begin
  if Self.BoundsType = 1 then
    Exit;

  Self.BoundsType := 1;
  Self.ModelHeight := 0;
  Self.BottomY := 0;
  Self.XYZMag := 0;

  for i := 0 to Self.VerticesCount - 1 do
  begin
    value := Self.VertexX[i] * Self.VertexX[i] + Self.VertexZ[i] * Self.VertexZ[i];
    if value > Self.XYZMag then
      Self.XYZMag := value;

    if -Self.VertexY[i] > Self.ModelHeight then
      Self.ModelHeight := -Self.VertexY[i];

    if Self.VertexY[i] > Self.BottomY then
      Self.BottomY := Self.VertexY[i];
  end;

  Self.XYZMag := Round(Sqrt(Self.XYZMag) + 0.99);
  Self.Radius := Round(Sqrt(Self.XYZMag * Self.XYZMag + Self.ModelHeight * Self.ModelHeight) + 0.99);
  Self.Diameter := Self.Radius + Round(Sqrt(Self.XYZMag * Self.XYZMag + Self.BottomY * Self.BottomY) + 0.99);
end;

const
  MAX_FACES = 6500;
var
  FaceClipped: array [0..MAX_FACES - 1] of Boolean;
  ViewportYs, ViewportXs, ViewportZs: array [0..MAX_FACES - 1] of Integer;
  SortedFaceIdx, SortedFaceDepth: array [0..MAX_FACES - 1] of Integer;
  SortedCount: Integer;

procedure TLitModel.RasterFace(var graphics: TGraphics3D; faceIdx: Integer);
var
  idx1, idx2, idx3, pal: Integer;
  hasTextures: Boolean;
begin
  idx1 := Self.FaceIndices1[faceIdx];
  idx2 := Self.FaceIndices2[faceIdx];
  idx3 := Self.FaceIndices3[faceIdx];
  graphics.RasterClipEnable := FaceClipped[faceIdx];

  if Length(Self.FaceTransparencies) = 0 then
    graphics.RasterAlpha := 0
  else
    graphics.RasterAlpha := Self.FaceTransparencies[faceIdx] and $FF;

  hasTextures := Self.FaceTextures <> [];
  if hasTextures and (Self.FaceTextures[faceIdx] <> -1) then
  begin
    pal := ColorUtils.PaletteBGR[Self.FaceColors1[faceIdx]];
    graphics.RasterFlat(ViewportXs[idx1], ViewportXs[idx2], ViewportXs[idx3], ViewportYs[idx1], ViewportYs[idx2], ViewportYs[idx3], pal);
  end
  else if (not hasTextures) or ((Self.FaceTextures[faceIdx] = -1) and (Self.FaceColors3[faceIdx] = -1)) then
  begin
    pal := ColorUtils.PaletteBGR[Self.FaceColors1[faceIdx]];
    graphics.RasterFlat(ViewportXs[idx1], ViewportXs[idx2], ViewportXs[idx3], ViewportYs[idx1], ViewportYs[idx2], ViewportYs[idx3], pal);
  end
  else
  begin
    graphics.GouraudTriangle(ViewportXs[idx1], ViewportXs[idx2], ViewportXs[idx3], ViewportYs[idx1], ViewportYs[idx2], ViewportYs[idx3], Self.FaceColors1[faceIdx], Self.FaceColors2[faceIdx], Self.FaceColors3[faceIdx]);
  end;
end;

procedure TLitModel.Draw(var graphics: TGraphics3D);
var
  i, idx1, idx2, idx3, j, tmpI, tmpD, viewport1, viewport2, viewport3: Integer;
begin
  SortedCount := 0;

  for i := 0 to Self.IndicesCount - 1 do
  begin
    if Self.FaceColors3[i] = -2 then Continue;
    idx1 := Self.FaceIndices1[i];
    idx2 := Self.FaceIndices2[i];
    idx3 := Self.FaceIndices3[i];
    // Auto-clipping per face — accept any face with at least one in-range vertex
    if ((ViewportXs[idx1] >= 0) or (ViewportXs[idx2] >= 0) or (ViewportXs[idx3] >= 0)) and
       ((ViewportXs[idx1] <= graphics.ClipWidth) or (ViewportXs[idx2] <= graphics.ClipWidth) or (ViewportXs[idx3] <= graphics.ClipWidth)) and
       ((ViewportYs[idx1] >= 0) or (ViewportYs[idx2] >= 0) or (ViewportYs[idx3] >= 0)) and
       ((ViewportYs[idx1] <= graphics.ClipHeight) or (ViewportYs[idx2] <= graphics.ClipHeight) or (ViewportYs[idx3] <= graphics.ClipHeight)) then
      FaceClipped[i] := False
    else
      FaceClipped[i] := True;
    SortedFaceIdx[SortedCount] := i;
    SortedFaceDepth[SortedCount] := (ViewportZs[idx1] + ViewportZs[idx2] + ViewportZs[idx3]) div 3;
    Inc(SortedCount);
  end;

  for i := 1 to SortedCount - 1 do
  begin
    tmpI := SortedFaceIdx[i];
    tmpD := SortedFaceDepth[i];
    j := i - 1;
    while (j >= 0) and (SortedFaceDepth[j] < tmpD) do
    begin
      SortedFaceIdx[j + 1] := SortedFaceIdx[j];
      SortedFaceDepth[j + 1] := SortedFaceDepth[j];
      Dec(j);
    end;
    SortedFaceIdx[j + 1] := tmpI;
    SortedFaceDepth[j + 1] := tmpD;
  end;

  for i := 0 to SortedCount - 1 do
    Self.RasterFace(graphics, SortedFaceIdx[i]);
end;

procedure TLitModel.ProjectAndDraw(var graphics: TGraphics3D; yzRot, xzRot, xyRot, orientation, xOffset, yOffset, zOffset: Integer);
var
  centerX, centerY, sinR1, cosR1, sinY, cosY, sinZ, cosZ, sinX, cosX, zRelatedVar, tmp: Integer;
  i, vx, vy, vz: Integer;
begin
  if Self.BoundsType <> 2 then
    Self.CalcBoundsCylinder();

  Self.BoundsType := 2;
  Self.XYZMag := 0;

  for i := 0 to Self.VerticesCount - 1 do
  begin
    tmp := Self.VertexX[i] * Self.VertexX[i] + Self.VertexY[i] * Self.VertexY[i] + Self.VertexZ[i] * Self.VertexZ[i];
    if tmp > Self.XYZMag then
      Self.XYZMag := tmp;
  end;

  Self.XYZMag := Round(Sqrt(Self.XYZMag) + 0.99);
  Self.Radius := Self.XYZMag;
  Self.Diameter := Self.XYZMag + Self.XYZMag;
  centerX := graphics.CenterX;
  centerY := graphics.CenterY;
  sinR1 := CircularAngle.SINE[yzRot];
  cosR1 := CircularAngle.COSINE[yzRot];
  sinY := CircularAngle.SINE[xzRot];
  cosY := CircularAngle.COSINE[xzRot];
  sinZ := CircularAngle.SINE[xyRot];
  cosZ := CircularAngle.COSINE[xyRot];
  sinX := CircularAngle.SINE[orientation];
  cosX := CircularAngle.COSINE[orientation];
  zRelatedVar := (sinX * yOffset + cosX * zOffset) shr 16;

  for i := 0 to Self.VerticesCount - 1 do
  begin
    vx := Self.VertexX[i];
    vy := Self.VertexY[i];
    vz := Self.VertexZ[i];

    if xyRot <> 0 then
    begin
      tmp := (vy * sinZ + vx * cosZ) shr 16;
      vy := (vy * cosZ - vx * sinZ) shr 16;
      vx := tmp;
    end;

    if yzRot <> 0 then
    begin
      tmp := (vy * cosR1 - vz * sinR1) shr 16;
      vz := (vy * sinR1 + vz * cosR1) shr 16;
      vy := tmp;
    end;

    if xzRot <> 0 then
    begin
      tmp := (vz * sinY + vx * cosY) shr 16;
      vz := (vz * cosY - vx * sinY) shr 16;
      vx := tmp;
    end;

    vx += xOffset;
    vy += yOffset;
    vz += zOffset;
    tmp := (vy * cosX - vz * sinX) shr 16;
    vz := (vy * sinX + vz * cosX) shr 16;
    ViewportZs[i] := vz - zRelatedVar;
    ViewportYs[i] := vx * graphics.Zoom div vz + centerX;
    ViewportXs[i] := tmp * graphics.Zoom div vz + centerY;
  end;

  Self.Draw(graphics);
end;
