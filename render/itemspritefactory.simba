{$include_once ../utils/color.simba}
{$include_once ./circularangle.simba}
{$include_once ./graphics3d.simba}
{$include_once ./spritepixels.simba}
{$include_once ./litmodel.simba}
{$include_once ../reader/index.simba}
{$include_once ../definitions/items.simba}
{$include_once ../definitions/models.simba}

(*
# ItemSpriteFactory
Orchestrates rendering of item inventory icons from 3D models.
*)
type
  TItemSpriteFactory = record
    CacheReaderPtr: Pointer;
  end;

function Bound2To126(val: Integer): Integer; static;
begin
  if val < 2 then Exit(2);
  if val > 126 then Exit(126);
  Result := val;
end;

function Method2608(color, intensity: Integer): Integer; static;
var
  newLum: Integer;
begin
  newLum := ((color and $7F) * intensity) shr 7;
  newLum := Bound2To126(newLum);
  Result := (color and $FF80) + newLum;
end;

(*
  Lighting helper — compute normalized dot product of lightDir with normal,
  scaled by attenuation and offset by ambient. Returns value in range [2..126].
  Safe against zero-magnitude normals.
*)
function ComputeLightIntensity(normalX, normalY, normalZ, mag, atten, ambient: Integer): Integer; static;
var
  dp: Integer;
begin
  if mag = 0 then Exit(64); // default mid-gray
  dp := (-50) * normalX + (-10) * normalY + (-50) * normalZ;
  Result := dp div (atten * mag) + ambient;
  if Result < 2 then Result := 2;
  if Result > 126 then Result := 126;
end;

(*
  CreateItemImage — full pipeline for one item icon.
  Loads model → applies transforms → lights → projects → rasterizes.
*)
function CreateItemImage(cacheReader: TCacheReader; const itemDef: TItemDefinition; quantity: Integer; noted: Boolean): TImage;
var
  modelSector: TArchiveSector;
  modelData: TByteArray;
  modelDef: TModelDefinition;
  litModel: TLitModel;
  grfx: TGraphics3D;
  spritePixels: TSpritePixels;
  zoom2d, xOffset, yOffset, shadowColor: Integer;
  xanSin, pitchOffsetY, pitchOffsetZ: Integer;
  attenuation: Integer;
  i, faceIdx, faceType, r1, r2, r3, tmp: Integer;
  dxAB, dyAB, dzAB, dxAC, dyAC, dzAC: Integer;
  nx, ny, nz, len: Integer;
  vMag: array [0..6499] of Integer;
  vNx, vNy, vNz: array [0..6499] of Integer;
  hasFaceNormals: Boolean;
  fNx, fNy, fNz: array [0..6499] of Integer;
  faceTexId, faceAlphaVal: Integer;
  minY, maxY, minX, maxX, cxOff, cyOff: Integer;
begin
  try
    modelSector := cacheReader.Indices[ECacheIndex.MODELS].ReadArchiveSector(
      itemDef.InventoryModel, cacheReader.Indices[ECacheIndex.MODELS].ID, cacheReader.Indices[ECacheIndex.MODELS].IndexData
    );
    if Length(modelSector.Data) = 0 then
      Exit(nil);
    modelData := modelSector.Decompress();
    if Length(modelData) = 0 then
      Exit(nil);

    modelDef := TModelDefinition.Create(itemDef.InventoryModel, modelData);

    // Apply resize (only if all dims > 0 — OSRS uses 0 for "no resize")
    if (itemDef.ResizeX > 0) and (itemDef.ResizeY > 0) and (itemDef.ResizeZ > 0) then
      modelDef.Resize(itemDef.ResizeX, itemDef.ResizeY, itemDef.ResizeZ);

    // Copy geometry to TLitModel
    litModel := TLitModel.Create(modelDef);

    // Precompute attenuation (-50, -10, -50 direction)
    attenuation := Round(Sqrt(7500)) * (itemDef.Contrast + 768) shr 8;
    if attenuation <= 0 then attenuation := 1;

    // Compute vertex normals (flat shading) — zero-fill first
    for i := 0 to High(vMag) do begin vMag[i] := 0; vNx[i] := 0; vNy[i] := 0; vNz[i] := 0; end;
    for i := 0 to High(fNx) do begin fNx[i] := 0; fNy[i] := 0; fNz[i] := 0; end;
    hasFaceNormals := False;

    for i := 0 to modelDef.FaceCount - 1 do
    begin
      dxAB := modelDef.VertexX[modelDef.FaceIndices2[i]] - modelDef.VertexX[modelDef.FaceIndices1[i]];
      dyAB := modelDef.VertexY[modelDef.FaceIndices2[i]] - modelDef.VertexY[modelDef.FaceIndices1[i]];
      dzAB := modelDef.VertexZ[modelDef.FaceIndices2[i]] - modelDef.VertexZ[modelDef.FaceIndices1[i]];
      dxAC := modelDef.VertexX[modelDef.FaceIndices3[i]] - modelDef.VertexX[modelDef.FaceIndices1[i]];
      dyAC := modelDef.VertexY[modelDef.FaceIndices3[i]] - modelDef.VertexY[modelDef.FaceIndices1[i]];
      dzAC := modelDef.VertexZ[modelDef.FaceIndices3[i]] - modelDef.VertexZ[modelDef.FaceIndices1[i]];
      nx := dyAB * dzAC - dzAB * dyAC;
      ny := dzAB * dxAC - dxAB * dzAC;
      nz := dxAB * dyAC - dxAC * dyAB;
      while (nx > 8192) or (ny > 8192) or (nz > 8192) or (nx < -8192) or (ny < -8192) or (nz < -8192) do
      begin
        nx := nx shr 1; ny := ny shr 1; nz := nz shr 1;
      end;
      len := Round(Sqrt(nz * nz + nx * nx + ny * ny));
      if len <= 0 then len := 1;
      nx := nx * 256 div len;
      ny := ny * 256 div len;
      nz := nz * 256 div len;

      if Length(modelDef.FaceRenderTypes) = 0 then
      begin
        vNx[modelDef.FaceIndices1[i]] += nx; vNy[modelDef.FaceIndices1[i]] += ny; vNz[modelDef.FaceIndices1[i]] += nz; Inc(vMag[modelDef.FaceIndices1[i]]);
        vNx[modelDef.FaceIndices2[i]] += nx; vNy[modelDef.FaceIndices2[i]] += ny; vNz[modelDef.FaceIndices2[i]] += nz; Inc(vMag[modelDef.FaceIndices2[i]]);
        vNx[modelDef.FaceIndices3[i]] += nx; vNy[modelDef.FaceIndices3[i]] += ny; vNz[modelDef.FaceIndices3[i]] += nz; Inc(vMag[modelDef.FaceIndices3[i]]);
      end
      else
      begin
        hasFaceNormals := True;
        fNx[i] := nx; fNy[i] := ny; fNz[i] := nz;
      end;
    end;

    // Light each face
    for faceIdx := 0 to modelDef.FaceCount - 1 do
    begin
      faceType := 0;
      if Length(modelDef.FaceRenderTypes) > 0 then
        faceType := modelDef.FaceRenderTypes[faceIdx] and $FF;
      faceAlphaVal := 0;
      if Length(modelDef.FaceTransparencies) > 0 then
        faceAlphaVal := modelDef.FaceTransparencies[faceIdx];
      faceTexId := -1;
      if Length(modelDef.FaceTextures) > 0 then
        faceTexId := modelDef.FaceTextures[faceIdx];

      if faceAlphaVal = -2 then faceType := 3;
      if faceAlphaVal = -1 then faceType := 2;

      case faceType of
        0: // Gouraud flat-shaded (no texture, 3 vertex colors)
          begin
            r1 := Method2608(modelDef.FaceColors[faceIdx] and $FFFF,
              ComputeLightIntensity(vNx[modelDef.FaceIndices1[faceIdx]], vNy[modelDef.FaceIndices1[faceIdx]], vNz[modelDef.FaceIndices1[faceIdx]], vMag[modelDef.FaceIndices1[faceIdx]], attenuation, itemDef.Ambient + 64));
            r2 := Method2608(modelDef.FaceColors[faceIdx] and $FFFF,
              ComputeLightIntensity(vNx[modelDef.FaceIndices2[faceIdx]], vNy[modelDef.FaceIndices2[faceIdx]], vNz[modelDef.FaceIndices2[faceIdx]], vMag[modelDef.FaceIndices2[faceIdx]], attenuation, itemDef.Ambient + 64));
            r3 := Method2608(modelDef.FaceColors[faceIdx] and $FFFF,
              ComputeLightIntensity(vNx[modelDef.FaceIndices3[faceIdx]], vNy[modelDef.FaceIndices3[faceIdx]], vNz[modelDef.FaceIndices3[faceIdx]], vMag[modelDef.FaceIndices3[faceIdx]], attenuation, itemDef.Ambient + 64));
          end;
        1: // Single-color face with face normal
          begin
            if hasFaceNormals then
            begin
              r1 := Method2608(modelDef.FaceColors[faceIdx] and $FFFF,
                ComputeLightIntensity(fNx[faceIdx], fNy[faceIdx], fNz[faceIdx], 1, attenuation shr 1 + attenuation, itemDef.Ambient + 64));
              r2 := -1; r3 := -1;
            end
            else
            begin
              r1 := modelDef.FaceColors[faceIdx] and $FFFF;
              r2 := -1; r3 := -1;
            end;
          end;
        3: // Always bright face
          begin r1 := 128; r2 := -1; r3 := -1; end;
        else // No lighting change
          begin
            r1 := modelDef.FaceColors[faceIdx] and $FFFF;
            r2 := -1;
            r3 := -2;
          end;
      end;

      litModel.FaceColors1[faceIdx] := r1;
      litModel.FaceColors2[faceIdx] := r2;
      litModel.FaceColors3[faceIdx] := r3;
    end;

    // Setup projection parameters
    zoom2d := itemDef.Zoom2D;
    xanSin := itemDef.Xan2D;
    xOffset := itemDef.XOffset2D;
    yOffset := itemDef.YOffset2D;
    shadowColor := (3153952 and $FF00) or ((3153952 and $FF) shl 16) or ((3153952 shr 16) and $FF);

    // Setup rasterizer
    spritePixels := TSpritePixels.Create(36, 32);
    grfx.SetRasterBuffer(spritePixels.Pixels, 36, 32);
    grfx.Reset();
    grfx.Zoom := 512;
    grfx.SetRasterClipping();
    grfx.SetOffset(16, 16);
    grfx.RasterGouraudLowRes := False;

    pitchOffsetY := zoom2d * CircularAngle.SINE[xanSin] shr 16;
    pitchOffsetZ := zoom2d * CircularAngle.COSINE[xanSin] shr 16;

    litModel.CalcBoundsCylinder();
    litModel.ProjectAndDraw(grfx, 0, itemDef.Yan2D, itemDef.Zan2D, itemDef.Xan2D,
      xOffset, litModel.ModelHeight div 2 + pitchOffsetY + yOffset, pitchOffsetZ + yOffset);

    // Shift viewport coords to center within canvas (after projection)
    if litModel.VerticesCount > 0 then
    begin
      minY := 999999; maxY := -999999; minX := 999999; maxX := -999999;
      for i := 0 to litModel.VerticesCount - 1 do
      begin
        if ViewportXs[i] < minX then minX := ViewportXs[i];
        if ViewportXs[i] > maxX then maxX := ViewportXs[i];
        if ViewportYs[i] < minY then minY := ViewportYs[i];
        if ViewportYs[i] > maxY then maxY := ViewportYs[i];
      end;
      cxOff := 16 - Round((minX + maxX) / 2);
      cyOff := 16 - Round((minY + maxY) / 2);
      for i := 0 to litModel.VerticesCount - 1 do
      begin
        ViewportXs[i] += cxOff;
        ViewportYs[i] += cyOff;
      end;
    end;

    // Re-draw with centered coords
    litModel.Draw(grfx);

    // Border and shadow
    spritePixels.DrawBorder($AAAAAA);
    if shadowColor <> 0 then
      spritePixels.DrawShadow(shadowColor);

    Result := spritePixels.ToImage();
  except
    Exit(nil);
  end;
end;
