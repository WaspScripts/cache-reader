(*
# Sprite Definition
2D images. One sprite archive holds several frames that share a palette and a canvas size, so
decoding one gives an array.
*)

{$DEFINE WL_CACHE_DEFINITION_SPRITES_INCLUDED}

{$IFNDEF WL_CACHE_HELPERS_INCLUDED}
  {$INCLUDE_ONCE ../utils/helpers.simba}
{$ENDIF}

type
  TSpriteDefinition = record
    ID, Frame,
    OffsetX, OffsetY,
    Width, Height,
    MaxWidth, MaxHeight: Integer;

    Pixels, Palette: TIntegerArray;

    const FLAG_VERTICAL: Integer = 1;
    const FLAG_ALPHA:    Integer = 2;
  end;

  TSpriteDefinitionArray = array of TSpriteDefinition;

(*
## SpriteDefinition.Create
```pascal
function TSpriteDefinition.Create(id: Integer; const data: TByteArray): TSpriteDefinitionArray; static;
```
Decodes a sprite archive into its frames. One archive holds several frames sharing a palette and
a common canvas size, which is why this returns an array.

The archive is read back to front: the frame count is the last two bytes, the frame headers sit
above it and the palette above those, leaving the pixel data at the front. Each frame's pixels
are palette indices, stored either row by row or column by column depending on its flags, and
index `0` is transparent - so alpha is only read when a frame says it has any, and any pixel
that is not index `0` is opaque regardless.
*)
function TSpriteDefinition.Create(id: Integer; const data: TByteArray): TSpriteDefinitionArray; static;
var
  offset, spriteCount, width, height, paletteLength: Integer;
  palette: TIntegerArray;
  i, j, k, dimension, flags, index, frameWidth, frameHeight: Integer;
  pixelIdx, pixelAlphas: TByteArray;
  bgr: Integer;
  frameHasAlpha: Boolean;
begin
  offset := Length(data) - 2;
  spriteCount := Read16Bits(data, offset);

  SetLength(Result, spriteCount);

  offset := Length(data) - 7 - spriteCount * 8;
  width := Read16Bits(data, offset);
  height := Read16Bits(data, offset);
  paletteLength := Read8Bits(data, offset) + 1;

  for i := 0 to spriteCount - 1 do
  begin
    Result[i].ID := id;
    Result[i].Frame := i;
    Result[i].MaxWidth := width;
    Result[i].MaxHeight := height;
  end;

  for i := 0 to spriteCount - 1 do
    Result[i].OffsetX := Read16Bits(data, offset);
  for i := 0 to spriteCount - 1 do
    Result[i].OffsetY := Read16Bits(data, offset);
  for i := 0 to spriteCount - 1 do
    Result[i].Width := Read16Bits(data, offset);
  for i := 0 to spriteCount - 1 do
    Result[i].Height := Read16Bits(data, offset);

  offset := Length(data) - 7 - spriteCount * 8 - (paletteLength - 1) * 3;
  SetLength(palette, paletteLength);

  for i := 1 to paletteLength - 1 do
  begin
    bgr := Read24Bits(data, offset);
    if bgr = 0 then
      bgr := 1;
    palette[i] := bgr;
  end;

  offset := 0;

  for i := 0 to spriteCount - 1 do
  begin
    frameWidth  := Result[i].Width;
    frameHeight := Result[i].Height;
    dimension   := frameWidth * frameHeight;

    SetLength(pixelIdx, dimension);
    Result[i].Palette := palette;

    flags := Read8Bits(data, offset);
    frameHasAlpha := (flags and TSpriteDefinition.FLAG_ALPHA) <> 0;

    if (flags and TSpriteDefinition.FLAG_VERTICAL) = 0 then
    begin
      for j := 0 to dimension - 1 do
        pixelIdx[j] := Read8Bits(data, offset);
    end
    else
    begin
      for j := 0 to frameWidth - 1 do
        for k := 0 to frameHeight - 1 do
          pixelIdx[frameWidth * k + j] := Read8Bits(data, offset);
    end;

    if frameHasAlpha then
    begin
      //the buffer is dropped rather than resized so a shorter frame cannot read the previous
      //frame's alphas back out of the tail SetLength leaves untouched
      SetLength(pixelAlphas, 0);
      SetLength(pixelAlphas, dimension);

      if (flags and TSpriteDefinition.FLAG_VERTICAL) = 0 then
      begin
        for j := 0 to dimension - 1 do
          pixelAlphas[j] := Read8Bits(data, offset);
      end
      else
      begin
        for j := 0 to frameWidth - 1 do
          for k := 0 to frameHeight - 1 do
            pixelAlphas[frameWidth * k + j] := Read8Bits(data, offset);
      end;
    end;

    //ABGR which is what simba uses. Palette index 0 is transparent, so it keeps whatever alpha
    //the frame stored for it - which is none at all when the frame has no alpha channel.
    SetLength(Result[i].Pixels, dimension);
    for j := 0 to dimension - 1 do
    begin
      index := pixelIdx[j];
      if index <> 0 then
        Result[i].Pixels[j] := $FF000000 or palette[index]
      else if frameHasAlpha then
        Result[i].Pixels[j] := pixelAlphas[j] shl 24;
    end;
  end;
end;

(*
## SpriteDefinition.ToImage
```pascal
function TSpriteDefinition.ToImage(): TImage;
```
The frame as an image, at its own size rather than the archive's canvas size.
*)
function TSpriteDefinition.ToImage(): TImage;
begin
  Result := new TImage(Self.Width, Self.Height);
  Result.FromData(Self.Width, Self.Height, PColorBGRA(@Self.Pixels[0]), Self.Width);
end;

(*
## TSpriteDefinitionArray.IndexOf
```pascal
function TSpriteDefinitionArray.IndexOf(id: Integer): Integer;
```
The position of `id` in the array, or `-1` if there is no such sprite.

Sprite definitions are stored one per id with no gaps, so an id is its own index; this exists to
keep that assumption in one place.
*)
function TSpriteDefinitionArray.IndexOf(id: Integer): Integer;
begin
  if InRange(id, 0, High(Self)) then
    Exit(id);
  Result := -1;
end;

