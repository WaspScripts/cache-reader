{$include_once ../utils/helpers.simba}

type
  TLocation = record
    ID, LocType, Orientation,
    LocalX, LocalY, Height: Integer;
  end;

  TLocationsDefinition = record
    RegionX, RegionY: Integer;
    Locations: array of TLocation;
  end;

function TLocationsDefinition.Create(regionX, regionY: Integer; const data: TByteArray): TLocationsDefinition; static;
var
  offset, id, idOffset, position, positionOffset,
  attributes, locType, orientation, localX, localY, height: Integer;
  n: Integer;
begin
  Result.RegionX := regionX;
  Result.RegionY := regionY;

  id := -1;

  idOffset := ReadUnsignedIntSmartShortCompat(data, offset);
  while idOffset <> 0 do
  begin
    id += idOffset;

    position := 0;
    positionOffset := ReadUnsignedShortSmart(data, offset);
    while positionOffset <> 0 do
    begin
      position := position + positionOffset - 1;

      localY := position and $3F;
      localX := (position shr 6) and $3F;
      height := (position shr 12) and $3;

      attributes := Read8Bits(data, offset);
      locType := attributes shr 2;
      orientation := attributes and $3;

      n := Length(Result.Locations);
      SetLength(Result.Locations, n + 1);
      Result.Locations[n].ID := id;
      Result.Locations[n].LocType := locType;
      Result.Locations[n].Orientation := orientation;
      Result.Locations[n].LocalX := localX;
      Result.Locations[n].LocalY := localY;
      Result.Locations[n].Height := height;

      positionOffset := ReadUnsignedShortSmart(data, offset);
    end;

    idOffset := ReadUnsignedIntSmartShortCompat(data, offset);
  end;
end;

