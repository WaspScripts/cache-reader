(*
# Locations Definition
Where a region's objects stand: their id, their tile, and the shape and rotation they are
placed at.

This is only the placement. What is being placed is a {ref}`TObjectDefinition`.
*)

{$DEFINE WL_CACHE_DEFINITION_LOCATIONS_INCLUDED}

{$IFNDEF WL_CACHE_HELPERS_INCLUDED}
  {$INCLUDE_ONCE ../utils/helpers.simba}
{$ENDIF}

type
  TLocation = record
    ID, LocType, Orientation,
    LocalX, LocalY, Height: Integer;
  end;

  TLocationsDefinition = record
    RegionX, RegionY: Integer;
    Locations: array of TLocation;
  end;

(*
## LocationsDefinition.Create
```pascal
function TLocationsDefinition.Create(regionX, regionY: Integer; const data: TByteArray): TLocationsDefinition; static;
```
Decodes a region's object placements.

Locations are stored as a run of deltas, so their number is only known once the whole buffer has
been read; the array is grown in doublings while decoding and trimmed to size at the end, rather
than resized once per location.
*)
function TLocationsDefinition.Create(regionX, regionY: Integer; const data: TByteArray): TLocationsDefinition; static;
var
  offset, id, idOffset, position, posOffset, attributes, count: Integer;
  loc: TLocation;
begin
  Result.RegionX := regionX;
  Result.RegionY := regionY;

  id := -1;

  idOffset := ReadUnsignedIntSmartShortCompat(data, offset);
  while idOffset <> 0 do
  begin
    id += idOffset;
    loc.ID := id;

    position := 0;
    posOffset := ReadUnsignedShortSmart(data, offset);
    while posOffset <> 0 do
    begin
      position += posOffset - 1;
      attributes := Read8Bits(data, offset);

      loc.LocalY := position and $3F;
      loc.LocalX := (position shr 6) and $3F;
      loc.Height := (position shr 12) and $3;
      loc.LocType := attributes shr 2;
      loc.Orientation := attributes and $3;

      if count = Length(Result.Locations) then
        SetLength(Result.Locations, Max(64, count * 2));

      Result.Locations[count] := loc;
      Inc(count);

      posOffset := ReadUnsignedShortSmart(data, offset);
    end;

    idOffset := ReadUnsignedIntSmartShortCompat(data, offset);
  end;

  SetLength(Result.Locations, count);
end;

