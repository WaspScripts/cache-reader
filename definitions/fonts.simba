(*
# Font Definition
The game's fonts: one advance width per character code, and a sprite per glyph.
*)
{$include_once ./sprites.simba}

const
  FONT_NAMES: TStringArray = [
    'p11_full', 'p12_full', 'b12_full',
    'verdana_11pt_regular', 'verdana_13pt_regular', 'verdana_15pt_regular'
  ];

type
  TFontDefinition = record
    HashName: Integer;
    Advances: array [0..255] of Integer;
    Ascent: Integer;
    Glyphs: TSpriteDefinitionArray;
  end;

(*
## FontDefinition.Create
```pascal
function TFontDefinition.Create(hashName: Integer; const fontData, spriteData: TByteArray): TFontDefinition; static;
```
Builds a font out of the two archives that make one up: the metrics, and the sprite sheet whose
frames are the glyphs.

`fontData` is exactly 257 bytes - one advance width per character code, then the ascent - and
anything else raises.
*)
function TFontDefinition.Create(hashName: Integer; const fontData, spriteData: TByteArray): TFontDefinition; static;
var
  i: Integer;
begin
  if Length(fontData) <> 257 then
    raise 'Font data buffer is the wrong size';

  Result.HashName := hashName;

  for i := 0 to 255 do
    Result.Advances[i] := fontData[i];

  Result.Ascent := fontData[256];

  Result.Glyphs := TSpriteDefinition.Create(hashName, spriteData);
end;

(*
## FontDefinition.GetGlyphImage
```pascal
function TFontDefinition.GetGlyphImage(charCode: Integer): TImage;
```
The glyph drawn for `charCode` as an image. A code the font has no glyph for raises.
*)
function TFontDefinition.GetGlyphImage(charCode: Integer): TImage;
begin
  if (charCode < 0) or (charCode > High(Self.Glyphs)) then
    raise 'Invalid character code: ' + ToStr(charCode);

  Result := Self.Glyphs[charCode].ToImage();
end;

