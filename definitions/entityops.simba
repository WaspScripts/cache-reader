(*
# Entity Ops Definition
The right-click menu of an item or object.

Beyond the five plain operations an entity can have submenus, and operations that only appear
while a varp or varbit sits inside a given range - which is how a door offers `Open` or `Close`
but never both.
*)

{$DEFINE WL_CACHE_DEFINITION_ENTITYOPS_INCLUDED}
{$IFNDEF WL_CACHE_HELPERS_INCLUDED}  {$INCLUDE_ONCE ../utils/helpers.simba}  {$ENDIF}

type
  TEntityOpsDefinition = record
    Ops: array of record
      Index: Integer;
      Text: String;
    end;

    SubOps: array of record
      Index, SubID: Integer;
      Text: String;
    end;

    ConditionalOps: array of record
      Index, VarpID, VarbitID, MinValue, MaxValue: Integer;
      Text: String;
    end;

    ConditionalSubOps: array of record
      Index, SubID, VarpID, VarbitID, MinValue, MaxValue: Integer;
      Text: String;
    end;
  end;


(*
## EntityOpsDefinition.SetOp
```pascal
procedure TEntityOpsDefinition.SetOp(index: Integer; text: String);
```
Sets the text of the operation at `index`, replacing it if that slot already has one.

`index` is the operation's place in the right-click menu, not its place in `Ops`, which only
holds the slots that are actually filled.
*)
procedure TEntityOpsDefinition.SetOp(index: Integer; text: String);
var
  i: Integer;
begin
  for i := 0 to High(Self.Ops) do
    if Self.Ops[i].Index = index then
    begin
      Self.Ops[i].Text := text;
      Exit;
    end;

  i := Length(Self.Ops);
  SetLength(Self.Ops, i+1);
  Self.Ops[i].Index := index;
  Self.Ops[i].Text := text;
end;

(*
## EntityOpsDefinition.DecodeOp
```pascal
procedure TEntityOpsDefinition.DecodeOp(const data: TByteArray; var offset: Integer; index: Integer);
```
Reads one menu operation into slot `index`.

The text `hidden` is how the cache says a slot inherited from a template should be blanked out
rather than shown, so it is read and dropped.
*)
procedure TEntityOpsDefinition.DecodeOp(const data: TByteArray; var offset: Integer; index: Integer);
var
  text: String;
begin
  text := data.ReadCString(offset);
  if SameText(text, 'hidden') then
    Exit;
  Self.SetOp(index, text);
end;

(*
## EntityOpsDefinition.DecodeSubOp
```pascal
procedure TEntityOpsDefinition.DecodeSubOp(const data: TByteArray; var offset: Integer);
```
Reads one entry of a submenu: which operation it hangs off, its place within that submenu, and
its text.
*)
procedure TEntityOpsDefinition.DecodeSubOp(const data: TByteArray; var offset: Integer);
var
  i: Integer;
begin
  i := Length(Self.SubOps);
  SetLength(Self.SubOps, i + 1);
  Self.SubOps[i].Index := Read8Bits(data, offset);
  Self.SubOps[i].SubID := Read8Bits(data, offset);
  Self.SubOps[i].Text := data.ReadCString(offset);
end;

(*
## EntityOpsDefinition.DecodeConditionalOp
```pascal
procedure TEntityOpsDefinition.DecodeConditionalOp(const data: TByteArray; var offset: Integer);
```
Reads an operation that only appears while a varp or varbit sits inside a given range - a door
that offers `Close` only once it is open, for instance.
*)
procedure TEntityOpsDefinition.DecodeConditionalOp(const data: TByteArray; var offset: Integer);
var
  i: Integer;
begin
  i := Length(Self.ConditionalOps);
  SetLength(Self.ConditionalOps, i+1);
  Self.ConditionalOps[i].Index := Read8Bits(data, offset);
  Self.ConditionalOps[i].VarpID := Read16Bits(data, offset);
  Self.ConditionalOps[i].VarbitID := Read16Bits(data, offset);
  Self.ConditionalOps[i].MinValue := Read32Bits(data, offset);
  Self.ConditionalOps[i].MaxValue := Read32Bits(data, offset);
  Self.ConditionalOps[i].Text := data.ReadCString(offset);
end;

(*
## EntityOpsDefinition.DecodeConditionalSubOp
```pascal
procedure TEntityOpsDefinition.DecodeConditionalSubOp(const data: TByteArray; var offset: Integer);
```
{ref}`TEntityOpsDefinition.DecodeConditionalOp` for a submenu entry, so it carries the submenu
position as well as the varp range that gates it.
*)
procedure TEntityOpsDefinition.DecodeConditionalSubOp(const data: TByteArray; var offset: Integer);
var
  i: Integer;
begin
  i := Length(Self.ConditionalSubOps);
  SetLength(Self.ConditionalSubOps, i+1);
  Self.ConditionalSubOps[i].Index := Read8Bits(data, offset);
  Self.ConditionalSubOps[i].SubID := Read16Bits(data, offset);
  Self.ConditionalSubOps[i].VarpID := Read16Bits(data, offset);
  Self.ConditionalSubOps[i].VarbitID := Read16Bits(data, offset);
  Self.ConditionalSubOps[i].MinValue := Read32Bits(data, offset);
  Self.ConditionalSubOps[i].MaxValue := Read32Bits(data, offset);
  Self.ConditionalSubOps[i].Text := data.ReadCString(offset);
end;

