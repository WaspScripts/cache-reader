(*
# Area Definition
Map areas: the named places the world map labels and the icons the minimap draws for them.
*)
{$include_once ../utils/helpers.simba}

type
  TAreaDefinition = record
    ID, SpriteId, SecondarySpriteID, TextColor, Category, TextScale: Integer;
    Name, Tooltip: String; //not sure if tooltip is a tooltip lol.
    MenuActions: array [0..4] of String;
    PolygonVertices, PolygonColors: TIntegerArray;
    PolygonColorIndices: TByteArray;
  end;

  TAreaDefinitionArray = array of TAreaDefinition;

(*
## AreaDefinition.Create
```pascal
function TAreaDefinition.Create(id: Integer; const data: TByteArray): TAreaDefinition; static;
```
Decodes a map area - the named places the world map labels, and the icons the minimap draws for
them.

`SpriteId` is what {ref}`TMapDataLoader.LoadAreaIcons` turns into the icon itself. The opcodes
this does not keep are still read past, because the stream has to stay aligned for the ones
that follow.
*)
function TAreaDefinition.Create(id: Integer; const data: TByteArray): TAreaDefinition; static;
var
  offset, opcode, i, count, count2: Integer;
begin
  Result.ID := id;
  Result.SpriteId := -1;
  Result.SecondarySpriteID := -1;
  Result.Category := -1;

  while True do
  begin
    opcode := Read8Bits(data, offset);

    case opcode of
      0: Break;
      1: Result.SpriteId := ReadBigSmart2(data, offset);
      2: Result.SecondarySpriteID := ReadBigSmart2(data, offset);
      3: Result.Name := data.ReadCString(offset);
      4: Result.TextColor := Read24Bits(data, offset);
      6: Result.TextScale := Read8Bits(data, offset);
      10..14: Result.MenuActions[opcode-10] := data.ReadCString(offset);
      15:
        begin
          count := Read8Bits(data, offset);
          SetLength(Result.PolygonVertices, count * 2);
          for i := 0 to count * 2 - 1 do
            Result.PolygonVertices[i] := Read16Bits(data, offset);

          Read32Bits(data, offset); // discarded

          count2 := Read8Bits(data, offset);
          SetLength(Result.PolygonColors, count2);
          for i := 0 to count2 - 1 do
            Result.PolygonColors[i] := Read32Bits(data, offset);

          SetLength(Result.PolygonColorIndices, count);
          for i := 0 to count - 1 do
            Result.PolygonColorIndices[i] := Read8Bits(data, offset);
        end;
      16: ; //no bytes read
      17: Result.Tooltip := data.ReadCString(offset);
      19: Result.Category := Read16Bits(data, offset);

      //all below are discarded
      5: Read24Bits(data, offset);
      7: Read8Bits(data, offset);
      8: Read8Bits(data, offset);
      18: ReadBigSmart2(data, offset);
      21, 22: Read32Bits(data, offset);
      23:
        begin
          Read8Bits(data, offset);
          Read8Bits(data, offset);
          Read8Bits(data, offset);
        end;
      24:
        begin
          Read16Bits(data, offset);
          Read16Bits(data, offset);
        end;
      25: ReadBigSmart2(data, offset);
      28, 29, 30: Read8Bits(data, offset);
    end;
  end;
end;


(*
## TAreaDefinitionArray.IndexOf
```pascal
function TAreaDefinitionArray.IndexOf(id: Integer): Integer;
```
The position of `id` in the array, or `-1` if there is no such area.

Area definitions are stored one per id with no gaps, so an id is its own index; this exists to
keep that assumption in one place.
*)
function TAreaDefinitionArray.IndexOf(id: Integer): Integer;
begin
  if InRange(id, 0, High(Self)) then
    Exit(id);
  Result := -1;
end;

