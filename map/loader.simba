(*
# Map Data Loader
Everything {ref}`TMapChunkLoader` needs before it can draw a map: ground colours, object
definitions, and the sprites for map scenes and area icons.

Load it once - see {ref}`TMapDataLoader.Load` - not per chunk.
*)
{$include_once ../reader/reader.simba}
{$include_once ../utils/color.simba}
{$include_once ../definitions/objects.simba}
{$include_once ../definitions/underlay.simba}
{$include_once ../definitions/overlay.simba}
{$include_once ../definitions/sprites.simba}
{$include_once ../definitions/area.simba}
{$include_once ../definitions/texture.simba}

type
  TMapDataLoader = record
    Underlays: TUnderlayDefinitionArray;
    Overlays: TOverlayDefinitionArray;
    Objects: TObjectDefinitionArray;
    Areas: TAreaDefinitionArray;
    Textures: TTextureDefinitionArray;
    MapScenes, AreaIcons: TSpriteDefinitionArray;
    AreaIconImages: TImageArray;
    MapScenePixels: T2DIntegerArray;
  end;

(*
## MapDataLoader.LoadUnderlays
```pascal
procedure TMapDataLoader.LoadUnderlays();
```
Loads every ground underlay definition. The config index has to be cached first.
*)
procedure TMapDataLoader.LoadUnderlays();
var
  archive: TArchive;
  files: TFileArray;
  i: Integer;
begin
  archive := CacheReader.Indices[ECacheIndex.CONFIGS].ReferenceTable.Archives.Value[EConfigArchive.UNDERLAY];

  files := archive.Files.Values;
  SetLength(Self.Underlays, Length(files));
  for i := 0 to High(files) do
    Self.Underlays[i] := TUnderlayDefinition.Create(files[i].ID, files[i].Data);
end;

(*
## MapDataLoader.LoadOverlays
```pascal
procedure TMapDataLoader.LoadOverlays();
```
Loads every ground overlay definition. The config index has to be cached first.
*)
procedure TMapDataLoader.LoadOverlays();
var
  archive: TArchive;
  files: TFileArray;
  i: Integer;
begin
  archive := CacheReader.Indices[ECacheIndex.CONFIGS].ReferenceTable.Archives.Value[EConfigArchive.OVERLAY];

  files := archive.Files.Values;
  SetLength(Self.Overlays, Length(files));
  for i := 0 to High(files) do
    Self.Overlays[i] := TOverlayDefinition.Create(files[i].ID, files[i].Data);
end;

(*
## MapDataLoader.LoadObjects
```pascal
procedure TMapDataLoader.LoadObjects();
```
Loads every world object definition. The config index has to be cached first.

This is the slowest part of {ref}`TMapDataLoader.Load` by some distance - there are tens of
thousands of them, and the map renderer needs any of them to be reachable by id.
*)
procedure TMapDataLoader.LoadObjects();
var
  archive: TArchive;
  files: TFileArray;
  i: Integer;
begin
  archive := CacheReader.Indices[ECacheIndex.CONFIGS].ReferenceTable.Archives.Value[EConfigArchive.OBJ];

  files := archive.Files.Values;
  SetLength(Self.Objects, Length(files));
  for i := 0 to High(files) do
    Self.Objects[i] := TObjectDefinition.Create(files[i].ID, archive.Revision, files[i].Data);
end;

(*
## MapDataLoader.LoadAreas
```pascal
procedure TMapDataLoader.LoadAreas();
```
Loads every map area definition. The config index has to be cached first.
*)
procedure TMapDataLoader.LoadAreas();
var
  archive: TArchive;
  files: TFileArray;
  i: Integer;
begin
  archive := CacheReader.Indices[ECacheIndex.CONFIGS].ReferenceTable.Archives.Value[EConfigArchive.AREA];

  files := archive.Files.Values;
  SetLength(Self.Areas, Length(files));
  for i := 0 to High(files) do
    Self.Areas[i] := TAreaDefinition.Create(files[i].ID, files[i].Data);
end;

(*
## MapDataLoader.LoadSpriteArchive
```pascal
function TMapDataLoader.LoadSpriteArchive(archiveId: Integer): TSpriteDefinitionArray;
```
Every frame of one sprite archive.

Sprite archives are read straight out of the index rather than through
{ref}`TCacheIndex.Cache`, so that pulling in a handful of icons does not mean decompressing all
of them. A negative id, a missing archive or an empty one all come back as an empty array.
*)
function TMapDataLoader.LoadSpriteArchive(archiveId: Integer): TSpriteDefinitionArray;
var
  spritesIdx: TCacheIndex;
  sector: TArchiveSector;
  data: TByteArray;
begin
  if archiveId < 0 then
    Exit;

  spritesIdx := CacheReader.Indices[ECacheIndex.SPRITES];

  sector := spritesIdx.ReadArchiveSector(archiveId, spritesIdx.ID, spritesIdx.IndexData);
  if Length(sector.Data) = 0 then
    Exit;

  data := sector.Decompress();
  if Length(data) = 0 then
    Exit;

  Result := TSpriteDefinition.Create(archiveId, data);
end;

(*
## MapDataLoader.LoadMapScenes
```pascal
procedure TMapDataLoader.LoadMapScenes();
```
Loads the map scene sprites - the little pictures the minimap draws in place of certain objects,
such as staircases, altars and furnaces.
*)
procedure TMapDataLoader.LoadMapScenes();
var
  idx: TCacheIndex;
begin
  idx := CacheReader.Indices[ECacheIndex.SPRITES];
  Self.MapScenes := Self.LoadSpriteArchive(idx.ReferenceTable.ArchiveID('mapscene'));
end;

(*
## MapDataLoader.LoadAreaIcons
```pascal
procedure TMapDataLoader.LoadAreaIcons();
```
Loads the icon of every area that has one, indexed to line up with `Areas`.

{ref}`TMapDataLoader.LoadAreas` has to have run first, since it is the area definitions that say
which sprite each icon comes from.
*)
procedure TMapDataLoader.LoadAreaIcons();
var
  i: Integer;
  frames: TSpriteDefinitionArray;
begin
  SetLength(Self.AreaIcons, Length(Self.Areas));

  for i := 0 to High(Self.Areas) do
  begin
    if Self.Areas[i].SpriteId < 0 then
      Continue;

    frames := Self.LoadSpriteArchive(Self.Areas[i].SpriteId);
    if Length(frames) > 0 then
      Self.AreaIcons[i] := frames[0];
  end;
end;

(*
## MapDataLoader.LoadSpriteFrame
```pascal
function TMapDataLoader.LoadSpriteFrame(archiveId, frame: Integer): TSpriteDefinition; static;
```
A single frame of a sprite archive, for when the whole archive is not wanted. A missing archive
or frame comes back blank.
*)
function TMapDataLoader.LoadSpriteFrame(archiveId, frame: Integer): TSpriteDefinition; static;
var
  sector: TArchiveSector;
  data: TByteArray;
  sprites: TSpriteDefinitionArray;
begin
  sector := CacheReader.Indices[ECacheIndex.SPRITES].ReadArchiveSector(
    archiveId,
    CacheReader.Indices[ECacheIndex.SPRITES].ID,
    CacheReader.Indices[ECacheIndex.SPRITES].IndexData
  );

  if sector.Data.IsEmpty then
    Exit;

  data := sector.Decompress();
  if data.IsEmpty then
    Exit;

  sprites := TSpriteDefinition.Create(archiveId, data);
  if frame <= High(sprites) then
    Result := sprites[frame];
end;


(*
## MapDataLoader.LoadTextures
```pascal
procedure TMapDataLoader.LoadTextures();
```
Loads every texture definition, caching the texture index first if it has not been already.

The map renderer only wants their average colours, which is what a textured ground overlay is
drawn as.
*)
procedure TMapDataLoader.LoadTextures();
var
  archive: TArchive;
  files: TFileArray;
  i: Integer;
begin
  CacheReader.Indices[ECacheIndex.TEXTURES].Cache();
  archive := CacheReader.Indices[ECacheIndex.TEXTURES].ReferenceTable.Archives.Value[0];

  files := archive.Files.Values;
  SetLength(Self.Textures, Length(files));
  for i := 0 to High(files) do
    Self.Textures[i] := TTextureDefinition.Create(files[i].ID, files[i].Data);
end;


(*
## MapDataLoader.BuildOverlayColors
```pascal
procedure TMapDataLoader.BuildOverlayColors();
```
Works out the colour each ground overlay is drawn as on the minimap.

It depends only on the overlay - its secondary colour, its texture's average colour, or its own
colour, in that order - so it is settled per overlay here instead of per tile of every plane of
every region.

This is the one part of {ref}`TMapDataLoader.PrepareForRendering` that reads the palette, which
is why it is separate: {ref}`TMapChunkLoader.EnsureColorsCurrent` runs it again on its own when
the brightness changes.
*)
procedure TMapDataLoader.BuildOverlayColors();
var
  i, j: Integer;
begin
  for i := 0 to High(Self.Overlays) do
    with Self.Overlays[i] do
    begin
      MinimapColor := 0;

      if SecondaryRGBColor <> -1 then
        MinimapColor := ColorUtils.OverlayColor(
          ColorUtils.PackHSL(OtherHue, OtherSaturation, OtherLightness)
        ) or $FF000000
      else if Texture >= 0 then
      begin
        j := Self.Textures.IndexOf(Texture);
        if j <> -1 then
          MinimapColor := ColorUtils.OverlayColor(Self.Textures[j].AverageRGB) or $FF000000;
      end
      else if RGBColor <> $FF00FF then
        MinimapColor := ColorUtils.OverlayColor(
          ColorUtils.PackHSL(Hue, Saturation, Lightness)
        ) or $FF000000;
    end;
end;

(*
## MapDataLoader.PrepareForRendering
```pascal
procedure TMapDataLoader.PrepareForRendering();
```
Works out everything the map renderer would otherwise derive over and over from data that never
changes once loaded. Run at the end of {ref}`TMapDataLoader.Load`, after every definition it
reads is in place.

Three things are settled here: the overlay colours {ref}`TMapDataLoader.BuildOverlayColors`
works out, the map scene sprites converted from the RGB the cache stores to the BGR the pixel
buffers use with a fully transparent pixel flattened to `0` so that drawing one is a copy, and
one {ref}`TImage` per area icon so that drawing the same icon in a dozen regions does not build
a dozen images of it.
*)
procedure TMapDataLoader.PrepareForRendering();
var
  i, j, color: Integer;
  pixels: TIntegerArray;
begin
  Self.BuildOverlayColors();

  SetLength(Self.MapScenePixels, Length(Self.MapScenes));
  for i := 0 to High(Self.MapScenes) do
  begin
    //the buffer is dropped rather than resized so that the one just handed to MapScenePixels is
    //not the one being written into again
    SetLength(pixels, 0);
    SetLength(pixels, Length(Self.MapScenes[i].Pixels));

    for j := 0 to High(pixels) do
    begin
      color := Self.MapScenes[i].Pixels[j] and $00FFFFFF;
      if color = 0 then
        Continue;
      pixels[j] := $FF000000 or ((color and $0000FF) shl 16) or (color and $00FF00) or ((color shr 16) and $0000FF);
    end;

    Self.MapScenePixels[i] := pixels;
  end;

  SetLength(Self.AreaIconImages, Length(Self.AreaIcons));
  for i := 0 to High(Self.AreaIcons) do
    if (Self.AreaIcons[i].Width > 0) and (Self.AreaIcons[i].Height > 0) then
      Self.AreaIconImages[i] := Self.AreaIcons[i].ToImage();
end;


(*
## MapDataLoader.Load
```pascal
procedure TMapDataLoader.Load();
```
Loads everything {ref}`TMapChunkLoader` needs to draw a map: ground colours, object definitions,
and the sprites for map scenes and area icons.

This caches the config index, so it takes a second or so and a few hundred megabytes. Do it once
before rendering rather than per chunk.

Example:
```pascal
CacheReader := TCacheReader.Create();
CacheReader.Indices[ECacheIndex.MAPS].Cache();
chunkLoader.MapData.Load();
```
*)
procedure TMapDataLoader.Load();
begin
  CacheReader.Indices[ECacheIndex.CONFIGS].Cache();

  Self.LoadUnderlays();
  Self.LoadOverlays();
  Self.LoadObjects();
  Self.LoadAreas(); 
  Self.LoadTextures();
  Self.LoadMapScenes();
  Self.LoadAreaIcons();
  Self.PrepareForRendering();
end;
