(*
# SpritePixels
A 2D pixel buffer used as the output of the software 3D rasterizer.
Holds RGBA pixels in ABGR format (matching Simba's PColorBGRA / TImage),
with width and height matching the target buffer size (36 × 32 for items).

Methods:
  DrawBorder(color) — draws an outline around non-transparent pixels.
  DrawShadow(color) — draws a drop shadow behind non-transparent pixels.
  ToImage()           — converts the buffer to a Simba TImage with full alpha.
*)

{$DEFINE WL_CACHE_SPRITE_PIXELS_INCLUDED}
{$IFNDEF WL_CACHE_HELPERS_INCLUDED}        {$INCLUDE_ONCE ../utils/helpers.simba} {$ENDIF}
{$IFNDEF WL_CACHE_GRAPHICS3D_INCLUDED}     {$INCLUDE_ONCE graphics3d.simba}       {$ENDIF}

type
  TSpritePixels = record
    Pixels, Border: TIntegerArray;
    Width, Height, OffsetX, OffsetY: Integer;
  end;

(*
## SpritePixels.Create
```pascal
function TSpritePixels.Create(w, h: Integer): TSpritePixels; static;
```
An empty, fully transparent pixel buffer.
*)
function TSpritePixels.Create(w, h: Integer): TSpritePixels; static;
begin
  Result.Width := w;
  Result.Height := h;
  SetLength(Result.Pixels, w * h);
  SetLength(Result.Border, w * h);
end;

(*
## SpritePixels.DrawBorder
```pascal
procedure TSpritePixels.DrawBorder(color: Integer);
```
Outlines the drawn pixels, colouring every transparent pixel that touches one of them on any of
its four sides.

It builds a second buffer rather than writing in place, so that the outline it is adding does
not itself count as a neighbour and grow outwards.
*)
procedure TSpritePixels.DrawBorder(color: Integer);
var
  x, y, i: Integer;
  pixels, border: TIntegerArray;
begin
  SetLength(pixels, Self.Width * Self.Height);
  SetLength(border, Self.Width * Self.Height);
  i := -1;

  for y := 0 to Self.Height - 1 do
    for x := 0 to Self.Width - 1 do
    begin
      Inc(i);

      if Self.Pixels[i] = 0 then
      begin
        // Check N, S, E, W neighbors for non-zero
        if (x > 0) and (Self.Pixels[i - 1] <> 0) then
        begin
          pixels[i] := color;
          border[i] := color;
        end
        else if (y > 0) and (Self.Pixels[i - Self.Width] <> 0) then
        begin
          pixels[i] := color;
          border[i] := color;
        end
        else if (x < Self.Width - 1) and (Self.Pixels[i + 1] <> 0) then
        begin
          pixels[i] := color;
          border[i] := color;
        end
        else if (y < Self.Height - 1) and (Self.Pixels[i + Self.Width] <> 0) then
        begin
          pixels[i] := color;
          border[i] := color;
        end;
        Continue;
      end;

      pixels[i] := Self.Pixels[i];
      border[i] := Self.Border[i];
    end;

  Self.Pixels := pixels;
  Self.Border := border;
end;

(*
## SpritePixels.DrawShadow
```pascal
procedure TSpritePixels.DrawShadow(color: Integer);
```
Casts a one pixel shadow down and to the right of the drawn pixels.

This one does work in place, walking from the bottom right corner backwards so that a pixel it
writes is never read again as a source.
*)
procedure TSpritePixels.DrawShadow(color: Integer);
var
  x, y, rowOffset: Integer;
begin
  y := Self.Height - 1;
  while y > 0 do
  begin
    rowOffset := y * Self.Width;
    x := Self.Width - 1;
    while x > 0 do
    begin
      // If this pixel is transparent but the NW pixel isn't, draw shadow
      if (Self.Pixels[x + rowOffset] = 0) and (Self.Pixels[x + rowOffset - 1 - Self.Width] <> 0) then
        Self.Pixels[x + rowOffset] := color;
      Dec(x);
    end;
    Dec(y);
  end;
end;

(*
## SpritePixels.DrawAtOn
```pascal
procedure TSpritePixels.DrawAtOn(var graphics: TGraphics3D; x, y: Integer);
```
Copies this buffer onto a rasterizer's buffer at `x, y`, clipped to its draw region and skipping
transparent pixels.
*)
procedure TSpritePixels.DrawAtOn(var graphics: TGraphics3D; x, y: Integer);
var
  pixelIdx, deltaIndex,
  w, h,
  sourceRowSkip,
  deltaY, deltaX, pal: Integer;
begin
  x += Self.OffsetX;
  y += Self.OffsetY;

  pixelIdx := x + y * graphics.PixelWidth;
  w := Self.Width;
  h := Self.Height;

  if y < graphics.DrawTop then
  begin
    deltaY := graphics.DrawTop - y;
    h -= deltaY;
    y := graphics.DrawTop;
    deltaIndex += deltaY * w;
    pixelIdx += deltaY * graphics.PixelWidth;
  end;

  if h + y > graphics.DrawBottom then
    h -= (h + y - graphics.DrawBottom);

  if x < graphics.DrawLeft then
  begin
    deltaX := graphics.DrawLeft - x;
    w -= deltaX;
    x := graphics.DrawLeft;
    deltaIndex += deltaX;
    pixelIdx += deltaX;
    sourceRowSkip += deltaX;
  end;

  if w + x > graphics.DrawRight then
  begin
    deltaX := w + x - graphics.DrawRight;
    w -= deltaX;
    sourceRowSkip += deltaX;
  end;

  if (w <= 0) or (h <= 0) then
    Exit;

  for 0 to h - 1 do
  begin
    for deltaX := 0 to w - 1 do
    begin
      pal := Self.Pixels[deltaIndex + deltaX];
      if pal <> 0 then
        graphics.Pixels[pixelIdx + deltaX] := pal;
    end;
    pixelIdx += graphics.PixelWidth;
    // Advance past the w pixels just read, then over the clipped-off columns.
    deltaIndex += w + sourceRowSkip;
  end;
end;

(*
## SpritePixels.ToImage
```pascal
function TSpritePixels.ToImage(): TImage;
```
The buffer as an image with proper transparency.

Nothing has to be converted here. The rasterizer draws through `ColorUtils.Palette`,
whose entries are already in the order `TImage.FromData` reads and already carry a full alpha
byte, so a pixel that was drawn is opaque and a pixel that was never touched is still zero -
transparent, which is exactly how the original client turns its buffers into images.
*)
function TSpritePixels.ToImage(): TImage;
begin
  Result := new TImage(Self.Width, Self.Height);
  Result.FromData(Self.Width, Self.Height, PColorBGRA(@Self.Pixels[0]), Self.Width);
end;

(*
## SpritePixels.BorderImage
```pascal
function TSpritePixels.BorderImage(): TImage;
```
Get an image of the sprite border.

Only the outline pixels {ref}`TSpritePixels.DrawBorder` laid down are in it - the item itself
and the shadow are not - so everything else is left at zero and comes out transparent.
*)
function TSpritePixels.BorderImage(): TImage;
begin
  Result := new TImage(Self.Width, Self.Height);
  Result.FromData(Self.Width, Self.Height, PColorBGRA(@Self.Border[0]), Self.Width);
end;
