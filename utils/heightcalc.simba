(*
# Height Calc
The procedural terrain the game generates rather than stores.

Most tiles carry their own height, but the ones that do not fall back to layered value noise
that depends only on the tile's world position - so it can be reproduced exactly here. See
{ref}`THeightCalc.Calculate` for one tile and {ref}`THeightCalc.CalculateArea` for a region.
*)

{$include_once circularangle.simba}

type
  THeightCalc = record
    CoarseWeights: array [0..3] of Integer;
  end;

(*
## HeightCalc.Setup
```pascal
procedure THeightCalc.Setup();
```
Fills the cosine tables the noise interpolation reads. Called once at startup by `cache.simba`.

`CosTable` is the table {ref}`THeightCalc.Interpolate` blends along. `CoarseWeights` holds the
only four blend weights the coarsest noise layer can ever ask for - a tile sits at one of four
positions within a 4 tile sample - so {ref}`THeightCalc.CalculateArea` indexes them rather than
going back to the cosine table per row and column.
*)
procedure THeightCalc.Setup();
var
  i: Integer;
begin
  for i := 0 to 3 do
    Self.CoarseWeights[i] := (65536 - CircularAngle.COSINE[256 * i]) shr 1;
end;

(*
## HeightCalc.Noise
```pascal
function THeightCalc.Noise(x, y: Integer): Integer;
```
A repeatable pseudo-random value from `0` to `255` for a point.

It is a hash rather than a random number: the same point always gives the same value, which is
what lets the client generate terrain on the fly instead of storing it, and lets this reproduce
the terrain the client would have generated.
*)
function THeightCalc.Noise(x, y: Integer): Integer;
var
  n: Integer;
  hash: Integer;
begin
  n := x + y * 57;
  n := n xor (n shl 13);

  hash := (n * n * $3D73 + $C0AE5) + $5208DD0D;
  Result := ((n * hash) and $7FFFFFFF) shr 19 and $FF;
end;


(*
## HeightCalc.Interpolate
```pascal
function THeightCalc.Interpolate(a, b, x, frequency: Integer): Integer;
```
Blends from `a` to `b` along a cosine curve, `x` steps of the way through `frequency`.

A cosine rather than a straight line, so that the terrain flattens out as it approaches each
grid point instead of meeting the next slope at a crease.
*)
function THeightCalc.Interpolate(a, b, x, frequency: Integer): Integer;
var
  f: Integer;
begin
  f := (65536 - CircularAngle.COSINE[1024 * x div frequency]) shr 1;
  Result := ((f * b) shr 16) + ((a * (65536 - f)) shr 16);
end;


(*
## HeightCalc.SmoothedNoiseArea
```pascal
function THeightCalc.SmoothedNoiseArea(x, y, width, height: Integer): TIntegerMatrix;
```
{ref}`THeightCalc.SmoothedNoise` for every point of a `width` by `height` rectangle whose
top-left corner is `x, y`, returned indexed `[x, y]`.

Each point smooths the 3x3 block of raw noise around it, so neighbouring points overlap by two
thirds. Laying the raw noise out once and reading it back nine times costs a ninth of the
`Noise` calls that smoothing each point on its own would.
*)
function THeightCalc.SmoothedNoiseArea(x, y, width, height: Integer): TIntegerMatrix;
var
  i, j, corners, sides: Integer;
  noise: TIntegerMatrix;
  left, middle, right, row: TIntegerArray;
begin
  SetLength(noise, width + 2, height + 2);
  for i := 0 to width + 1 do
  begin
    row := noise[i];
    for j := 0 to height + 1 do
      row[j] := Self.Noise(x - 1 + i, y - 1 + j);
  end;

  SetLength(Result, width, height);
  for i := 0 to width - 1 do
  begin
    left   := noise[i];
    middle := noise[i + 1];
    right  := noise[i + 2];
    row    := Result[i];

    for j := 0 to height - 1 do
    begin
      corners := left[j] + right[j] + left[j + 2] + right[j + 2];
      sides   := left[j + 1] + right[j + 1] + middle[j] + middle[j + 2];
      row[j]  := (middle[j + 1] shr 2) + (sides shr 3) + (corners shr 4);
    end;
  end;
end;

(*
## HeightCalc.CalculateArea
```pascal
function THeightCalc.CalculateArea(x, y, size: Integer): TIntegerMatrix;
```
{ref}`THeightCalc.Calculate` for every tile of a `size` by `size` square whose corner is `x, y`,
returned indexed `[x, y]`.

The result is identical to calling `Calculate` per tile, but the three noise layers it sums are
built as grids first. The two coarse layers are sampled every 4 and every 2 tiles, so a whole
square shares a handful of their points rather than re-deriving them for each tile.

The cosine blend {ref}`THeightCalc.Interpolate` would do is folded in as well: at frequency 4 a
tile's position within a sample can only be one of four, so the weight is read out of
`CoarseWeights` once per column and row instead of being derived once per tile.
*)
function THeightCalc.CalculateArea(x, y, size: Integer): TIntegerMatrix;
var
  coarseX, coarseY, midX, midY,
  i, j, n, idxY, sample, interpolatedLow, interpolatedHigh,
  weightX, weightY, invWeightX, invWeightY: Integer;
  coarse, mid, fine: TIntegerMatrix;
  coarseIdxX, coarseIdxY, coarseWeightX, coarseWeightY, midIdxX, midIdxY: TIntegerArray;
  row, fineRow, midRow, coarseRow, coarseNextRow: TIntegerArray;
begin
  coarseX := (x + 45365) div 4;
  coarseY := (y + 91923) div 4;
  coarse := Self.SmoothedNoiseArea(
    coarseX, coarseY,
    ((x + 45365 + size - 1) div 4) - coarseX + 2,
    ((y + 91923 + size - 1) div 4) - coarseY + 2
  );

  midX := (x + 10294) div 2;
  midY := (y + 37821) div 2;
  mid := Self.SmoothedNoiseArea(
    midX, midY,
    ((x + 10294 + size - 1) div 2) - midX + 2,
    ((y + 37821 + size - 1) div 2) - midY + 2
  );

  fine := Self.SmoothedNoiseArea(x, y, size, size);

  SetLength(coarseIdxX, size);
  SetLength(coarseIdxY, size);
  SetLength(coarseWeightX, size);
  SetLength(coarseWeightY, size);
  SetLength(midIdxX, size);
  SetLength(midIdxY, size);

  for i := 0 to size - 1 do
  begin
    coarseIdxX[i]    := ((x + 45365 + i) div 4) - coarseX;
    coarseWeightX[i] := Self.CoarseWeights[(x + 45365 + i) and 3];
    coarseIdxY[i]    := ((y + 91923 + i) div 4) - coarseY;
    coarseWeightY[i] := Self.CoarseWeights[(y + 91923 + i) and 3];
    //at frequency 2 the client snaps to the nearer grid point instead of interpolating
    midIdxX[i] := ((x + 10294 + i) div 2) + ((x + 10294 + i) and 1) - midX;
    midIdxY[i] := ((y + 37821 + i) div 2) + ((y + 37821 + i) and 1) - midY;
  end;

  SetLength(Result, size, size);
  for i := 0 to size - 1 do
  begin
    row           := Result[i];
    fineRow       := fine[i];
    midRow        := mid[midIdxX[i]];
    coarseRow     := coarse[coarseIdxX[i]];
    coarseNextRow := coarse[coarseIdxX[i] + 1];
    weightX       := coarseWeightX[i];
    invWeightX    := 65536 - weightX;

    for j := 0 to size - 1 do
    begin
      idxY := coarseIdxY[j];

      interpolatedLow  := ((weightX * coarseNextRow[idxY]) shr 16) +
                          ((coarseRow[idxY] * invWeightX) shr 16);
      interpolatedHigh := ((weightX * coarseNextRow[idxY + 1]) shr 16) +
                          ((coarseRow[idxY + 1] * invWeightX) shr 16);

      weightY    := coarseWeightY[j];
      invWeightY := 65536 - weightY;
      sample     := ((weightY * interpolatedHigh) shr 16) +
                    ((interpolatedLow * invWeightY) shr 16);

      n := sample - 128 +
           ((midRow[midIdxY[j]] - 128) shr 1) +
           ((fineRow[j] - 128) shr 2);

      n := 35 + (n * 3) div 10;

      if n < 10 then
        n := 10
      else if n > 60 then
        n := 60;

      row[j] := n;
    end;
  end;
end;

var
  HeightCalc: THeightCalc;
