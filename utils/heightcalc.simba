(*
# Height Calc
The procedural terrain the game generates rather than stores.

Most tiles carry their own height, but the ones that do not fall back to layered value noise
that depends only on the tile's world position - so it can be reproduced exactly here. See
{ref}`THeightCalc.Calculate` for one tile and {ref}`THeightCalc.CalculateArea` for a region.
*)

{$DEFINE WL_CACHE_HEIGHTCALC_INCLUDED}
{$IFNDEF WL_CACHE_CIRCULARANGLE_INCLUDED}  {$INCLUDE_ONCE circularangle.simba}  {$ENDIF}

type
  THeightCalc = record
    CoarseWeights: array [0..3] of Integer;
    MidWeights: array [0..1] of Integer;
  end;

(*
## HeightCalc.Setup
```pascal
procedure THeightCalc.Setup();
```
Fills the blend weights the noise interpolation reads. Called once at startup by `cache.simba`.

A noise layer sampled every `frequency` tiles blends between its samples along a cosine curve,
and a tile can only sit at one of `frequency` positions within a sample. `CoarseWeights` holds
the four weights of the layer sampled every 4 tiles and `MidWeights` the two of the layer sampled
every 2, so {ref}`THeightCalc.CalculateArea` indexes them rather than going back to the cosine
table per row and column.
*)
procedure THeightCalc.Setup();
var
  i: Integer;
begin
  for i := 0 to 3 do
    Self.CoarseWeights[i] := (65536 - CircularAngle.COSINE[256 * i]) shr 1;
  for i := 0 to 1 do
    Self.MidWeights[i] := (65536 - CircularAngle.COSINE[512 * i]) shr 1;
end;

(*
## HeightCalc.Noise
```pascal
function THeightCalc.Noise(x, y: Integer): Integer;
```
A repeatable pseudo-random value from `0` to `255` for a point.

It is a hash rather than a random number: the same point always gives the same value, which is
what lets the client generate terrain on the fly instead of storing it, and lets this reproduce
the terrain the client would have generated.
*)
function THeightCalc.Noise(x, y: Integer): Integer;
var
  n: Integer;
  hash: Integer;
begin
  n := x + y * 57;
  n := n xor (n shl 13);

  hash := n * (n * n * $3D73 + $C0AE5) + $5208DD0D;
  Result := (hash and $7FFFFFFF) shr 19 and $FF;
end;


(*
## HeightCalc.Interpolate
```pascal
function THeightCalc.Interpolate(a, b, x, frequency: Integer): Integer;
```
Blends from `a` to `b` along a cosine curve, `x` steps of the way through `frequency`.

A cosine rather than a straight line, so that the terrain flattens out as it approaches each
grid point instead of meeting the next slope at a crease.
*)
function THeightCalc.Interpolate(a, b, x, frequency: Integer): Integer;
var
  f: Integer;
begin
  f := (65536 - CircularAngle.COSINE[1024 * x div frequency]) shr 1;
  Result := ((f * b) shr 16) + ((a * (65536 - f)) shr 16);
end;


(*
## HeightCalc.SmoothedNoiseArea
```pascal
function THeightCalc.SmoothedNoiseArea(x, y, width, height: Integer): TIntegerMatrix;
```
{ref}`THeightCalc.Noise` smoothed over the 3x3 block around each point of a `width` by `height`
rectangle whose top-left corner is `x, y`, returned indexed `[x, y]`.

Neighbouring points overlap by two thirds, so laying the raw noise out once and reading it back
nine times costs a ninth of the `Noise` calls that smoothing each point on its own would.
*)
function THeightCalc.SmoothedNoiseArea(x, y, width, height: Integer): TIntegerMatrix;
var
  i, j, corners, sides: Integer;
  noise: TIntegerMatrix;
  left, middle, right, row: TIntegerArray;
begin
  SetLength(noise, width + 2, height + 2);
  for i := 0 to width + 1 do
  begin
    row := noise[i];
    for j := 0 to height + 1 do
      row[j] := Self.Noise(x - 1 + i, y - 1 + j);
  end;

  SetLength(Result, width, height);
  for i := 0 to width - 1 do
  begin
    left   := noise[i];
    middle := noise[i + 1];
    right  := noise[i + 2];
    row    := Result[i];

    for j := 0 to height - 1 do
    begin
      corners := left[j] + right[j] + left[j + 2] + right[j + 2];
      sides   := left[j + 1] + right[j + 1] + middle[j] + middle[j + 2];
      row[j]  := (middle[j + 1] shr 2) + (sides shr 3) + (corners shr 4);
    end;
  end;
end;

(*
## HeightCalc.InterpolatedNoiseArea
```pascal
function THeightCalc.InterpolatedNoiseArea(x, y, size, frequency: Integer; constref weights: array of Integer): TIntegerMatrix;
```
One noise layer for every tile of a `size` by `size` square whose corner is `x, y`: smoothed
noise sampled every `frequency` tiles, with the tiles in between blended from the four samples
around them. `weights` are that layer's blend weights, from {ref}`THeightCalc.Setup`.

The whole square shares a handful of samples, so they are built as a grid first rather than
re-derived for every tile.
*)
function THeightCalc.InterpolatedNoiseArea(x, y, size, frequency: Integer; constref weights: array of Integer): TIntegerMatrix;
var
  gridX, gridY, i, j, idxY, low, high, weightX, invWeightX, weightY: Integer;
  grid: TIntegerMatrix;
  idxX, idxYs, weightXs, weightYs: TIntegerArray;
  row, gridRow, gridNextRow: TIntegerArray;
begin
  gridX := x div frequency;
  gridY := y div frequency;
  grid := Self.SmoothedNoiseArea(
    gridX, gridY,
    ((x + size - 1) div frequency) - gridX + 2,
    ((y + size - 1) div frequency) - gridY + 2
  );

  SetLength(idxX, size);
  SetLength(idxYs, size);
  SetLength(weightXs, size);
  SetLength(weightYs, size);
  for i := 0 to size - 1 do
  begin
    idxX[i]     := ((x + i) div frequency) - gridX;
    weightXs[i] := weights[(x + i) and (frequency - 1)];
    idxYs[i]    := ((y + i) div frequency) - gridY;
    weightYs[i] := weights[(y + i) and (frequency - 1)];
  end;

  SetLength(Result, size, size);
  for i := 0 to size - 1 do
  begin
    row         := Result[i];
    gridRow     := grid[idxX[i]];
    gridNextRow := grid[idxX[i] + 1];
    weightX     := weightXs[i];
    invWeightX  := 65536 - weightX;

    for j := 0 to size - 1 do
    begin
      idxY := idxYs[j];
      low  := ((invWeightX * gridRow[idxY]) shr 16) + ((gridNextRow[idxY] * weightX) shr 16);
      high := ((invWeightX * gridRow[idxY + 1]) shr 16) + ((gridNextRow[idxY + 1] * weightX) shr 16);

      weightY := weightYs[j];
      row[j]  := (((65536 - weightY) * low) shr 16) + ((high * weightY) shr 16);
    end;
  end;
end;

(*
## HeightCalc.CalculateArea
```pascal
function THeightCalc.CalculateArea(x, y, size: Integer): TIntegerMatrix;
```
The procedural height of every tile of a `size` by `size` square whose corner is `x, y`, returned
indexed `[x, y]`, from `10` to `60`. `x` and `y` are world tile coordinates already moved by the
client's `932731, 556238` offset.

The height is three noise layers summed: one sampled every 4 tiles, one every 2 tiles at half the
weight, and one every tile at a quarter of the weight.
*)
function THeightCalc.CalculateArea(x, y, size: Integer): TIntegerMatrix;
var
  i, j, n: Integer;
  coarse, mid, fine: TIntegerMatrix;
  row, coarseRow, midRow, fineRow: TIntegerArray;
begin
  coarse := Self.InterpolatedNoiseArea(x + 45365, y + 91923, size, 4, Self.CoarseWeights);
  mid    := Self.InterpolatedNoiseArea(x + 10294, y + 37821, size, 2, Self.MidWeights);
  //every tile is a sample, so there is nothing to blend
  fine   := Self.SmoothedNoiseArea(x, y, size, size);

  SetLength(Result, size, size);
  for i := 0 to size - 1 do
  begin
    row       := Result[i];
    coarseRow := coarse[i];
    midRow    := mid[i];
    fineRow   := fine[i];

    for j := 0 to size - 1 do
    begin
      n := coarseRow[j] - 128 + Sar(midRow[j] - 128, 1) + Sar(fineRow[j] - 128, 2);
      //the client truncates a double, which can round differently from n * 3 div 10
      n := Trunc(n * 0.3) + 35;

      if n < 10 then
        n := 10
      else if n > 60 then
        n := 60;

      row[j] := n;
    end;
  end;
end;

var
  HeightCalc: THeightCalc;
