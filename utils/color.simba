(*
# Color Utils
The game's colour model.

Colours are not stored as RGB but as a 16 bit hue, saturation and luminance index into a palette
built once at startup - see {ref}`TColorUtils.PackHSL` and
{ref}`TColorUtils.CreateHSVPalette`. The global `ColorUtils` holds those palettes.

There is one set of colours, and everything draws through it - the map renderer reads
`ColorUtils.Palette` and the sprite rasterizer `ColorUtils.SpritePalette`, which is the same
lookup in the pixel order `TImage.FromData` reads, rather than either carrying one of its own.
They are built by {ref}`TColorUtils.Setup` at whatever brightness you ask for and stay put;
{ref}`TColorUtils.SetBrightness` rebuilds them if you want a different look.
*)

{$DEFINE WL_CACHE_COLOR_INCLUDED}
{$IFNDEF WL_CACHE_HELPERS_INCLUDED}  {$INCLUDE_ONCE helpers.simba}  {$ENDIF}

type
  TColorUtils = record
    const WALL_COLOR: TColor = $FFEEEEEE;
    const DOOR_COLOR: TColor = $FF0000EE;

    const COLLISION_COLOR: Integer = $333333;
    const COLLISION_WALL_COLOR: Integer = $000000;
    const COLLISION_DOOR_COLOR: Integer = $0000FF;
    const COLLISION_WALKABLE_COLOR: Integer = $FFFFFF;

    const BRIGHTNESS_MAX: Double = 0.5;
    const BRIGHTNESS_HIGH: Double = 0.7;
    const BRIGHTNESS_LOW: Double = 0.8;
    const BRIGHTNESS_MIN: Double = 0.9;

    const HUE_OFFSET: Double = 0.5 / 64.0;
    const SATURATION_OFFSET: Double = 0.5 / 8.0;

    Palette, MinimapPalette, SpritePalette: TIntegerArray;
    Brightness: Double;
    Revision: Integer;
  end;

(*
## ColorUtils.PackHSL
```pascal
function TColorUtils.PackHSL(hue, saturation, luminance: Integer): Integer; static;
```
Packs a colour into the 16 bit index the game's palettes are addressed by: 6 bits of hue, 3 of
saturation and 7 of luminance.

Saturation is halved at each of four luminance thresholds on the way up, because a colour that
bright cannot carry much saturation without looking wrong - the same taper the client applies.
*)
function TColorUtils.PackHSL(hue, saturation, luminance: Integer): Integer; static;
begin
  if luminance > 179 then saturation := saturation shr 1;
  if luminance > 192 then saturation := saturation shr 1;
  if luminance > 217 then saturation := saturation shr 1;
  if luminance > 243 then saturation := saturation shr 1;

  Result := ((saturation shr 5) shl 7) + ((hue shr 2) shl 10) + (luminance shr 1);
end;


(*
## ColorUtils.CreateHSVPalette
```pascal
function TColorUtils.CreateHSVPalette(brightness: Double; mn, mx: Integer): TColorArray; static;
```
Builds the 65536 entry palette that a {ref}`TColorUtils.PackHSL` index looks up.

Every index is unpacked back into hue, saturation and luminance, converted to RGB, and then bent
by `brightness` - a gamma exponent, where a lower number means a brighter image. The client
offers a few fixed brightness settings, which are the `BRIGHTNESS_` constants.

`mn` and `mx` bound which entries are actually computed; the rest are left black.
*)
function TColorUtils.CreateHSVPalette(brightness: Double; mn, mx: Integer): TColorArray; static;
var
  i, rIdx, gIdx, bIdx: Integer;
  hue, sat, lum, r, g, b, p, q, t1, t2: Double;
  gamma: array [0..256] of Integer;
begin
  SetLength(Result, 65536);

  //Each channel is quantised to 0..256 before the brightness curve is applied to it, so the
  //curve is a 257 entry table rather than three Power() calls per palette entry.
  for i := 0 to 256 do
    gamma[i] := Trunc(Power(i / 256.0, brightness) * 256);

  for i := mn to mx - 1 do
  begin
    hue := ((i shr 10) and $3F) / 64 + 0.0078125;
    sat := ((i shr 7) and $7) / 8 + 0.0625;
    lum := (i and $7F) / 128;

    r := lum; g := lum; b := lum;

    if sat <> 0 then
    begin
      if lum < 0.5 then
        q := (sat + 1) * lum
      else
        q := lum + sat - sat * lum;

      p := lum * 2 - q;

      t1 := hue + 1/3;
      if t1 > 1 then t1 := t1 - 1;

      t2 := hue - 1/3;
      if t2 < 0 then t2 := t2 + 1;

      if hue * 6 < 1 then
        g := p + hue * 6 * (q - p)
      else if hue * 2 < 1 then
        g := q
      else if hue * 3 < 2 then
        g := (q - p) * (0.6666666666666666 - hue) * 6 + p
      else
        g := p;

      if t1 * 6 < 1 then
        r := t1 * 6 * (q - p) + p
      else if t1 * 2 < 1 then
        r := q
      else if t1 * 3 < 2 then
        r := p + (q - p) * 6 * (0.6666666666666666 - t1)
      else
        r := p;

      if t2 * 6 < 1 then
        b := p + (q - p) * 6 * t2
      else if t2 * 2 < 1 then
        b := q
      else if t2 * 3 < 2 then
        b := (0.6666666666666666 - t2) * (q - p) * 6 + p
      else
        b := p;
    end;

    rIdx := gamma[Trunc(r * 256)];
    gIdx := gamma[Trunc(g * 256)];
    bIdx := gamma[Trunc(b * 256)];

    if (rIdx or gIdx or bIdx) = 0 then
      bIdx := 1;

    Result[i] := rIdx + (bIdx shl 16) + (gIdx shl 8);
  end;
end;

(*
## ColorUtils.SetBrightness
```pascal
procedure TColorUtils.SetBrightness(brightness: Double);
```
Rebuilds both palettes at a new brightness. Everything that draws - the map renderer and the
sprite rasterizer alike - reads them, so this changes the whole library's colours at once.

`Palette` is the plain lookup a packed HSL index goes through. `MinimapPalette` is that same
lookup with the flatter minimap lighting already folded into it, so that
{ref}`TColorUtils.UnderlayColor` and {ref}`TColorUtils.OverlayColor` are a single array read
rather than a rescale and a clamp per tile.

Both of those are in the order {ref}`TColorUtils.CreateHSVPalette` produces, which is the order
a `TColor` and `TImage.FromMatrix` use - red in the low byte. `SpritePalette` is the same
entries with red and blue swapped and the alpha byte already full, which is the order the
`PColorBGRA` buffer `TImage.FromData` reads. The sprite rasterizer draws through that one, so
{ref}`TSpritePixels.ToImage` hands its buffer straight over instead of converting every pixel
on the way out.

Rebuilding costs around 25ms, nearly all of it the brightness curve, so this is meant for
setting a look up front rather than for switching back and forth. Setting the brightness it
already has does nothing.

Work already derived from the old palette is thrown away rather than left to go stale, but not
from here - `ColorUtils` is defined long before anything that draws and there may be more than
one map renderer. Instead `Revision` counts the changes, and
{ref}`TMapChunkLoader.EnsureColorsCurrent` compares it against the revision its caches were
built at and rebuilds them when they no longer match.
*)
procedure TColorUtils.SetBrightness(brightness: Double);
const
  TARGET_LUM: Integer = 96;
var
  i, lum, color: Integer;
begin
  if Self.Brightness = brightness then
    Exit;

  Self.Brightness := brightness;
  Self.Revision += 1;
  Self.Palette := TColorUtils.CreateHSVPalette(brightness, 0, 65536);

  SetLength(Self.MinimapPalette, 65536);
  SetLength(Self.SpritePalette, 65536);
  for i := 0 to 65535 do
  begin
    lum := EnsureRange((i and 127) * TARGET_LUM div 128, 2, 126);
    Self.MinimapPalette[i] := Self.Palette[(i and 65408) + lum];

    color := Self.Palette[i];
    Self.SpritePalette[i] := $FF000000 or ((color and $FF) shl 16) or (color and $FF00) or ((color shr 16) and $FF);
  end;
end;


(*
## ColorUtils.UnderlayColor
```pascal
function TColorUtils.UnderlayColor(hsl: Integer): Integer;
```
The colour a ground underlay is drawn as on the minimap.

The minimap is lit flatter than the world is, so the luminance in the index is scaled towards a
fixed level before the palette is looked up. That rescale is already baked into `MinimapPalette`
by {ref}`TColorUtils.Setup`, which leaves this a plain lookup. An `hsl` of `-1` means the tile
has no underlay.
*)
function TColorUtils.UnderlayColor(hsl: Integer): Integer;
begin
  if hsl = -1 then
    Exit(12345678);
  Result := Self.MinimapPalette[hsl];
end;

(*
## ColorUtils.OverlayColor
```pascal
function TColorUtils.OverlayColor(hsl: Integer): Integer;
```
{ref}`TColorUtils.UnderlayColor` for an overlay, which additionally distinguishes an overlay
that is deliberately blank, `-2`, from one that is drawn at the flat minimap luminance, `-1`.
*)
function TColorUtils.OverlayColor(hsl: Integer): Integer;
const
  TARGET_LUM: Integer = 96;
begin
  case hsl of
    -2: Exit(12345678);
    -1: Exit(Self.Palette[TARGET_LUM]);
  end;

  Result := Self.MinimapPalette[hsl];
end;

(*
## ColorUtils.Height2Color
```pascal
function TColorUtils.Height2Color(height: Integer): Integer; static;
```
A terrain height as a shade of grey, black at ground level and white at the highest terrain the
game uses. Heights are negative upwards, which is why the sign is flipped.
*)
function TColorUtils.Height2Color(height: Integer): Integer; static;
const
  MAX_HEIGHT: Integer = 6048;
var
  v: Integer;
begin
  v := EnsureRange(Round((-height / MAX_HEIGHT) * 255), 0, 255);
  Result := $FF000000 or (v shl 16) or (v shl 8) or v;
end;

(*
## ColorUtils.Collision2Color
```pascal
function TColorUtils.Collision2Color(flag: Integer): Integer; static;
```
A collision flag as a colour: white for walkable, black for blocked, grey for a tile an object
stands on.
*)
function TColorUtils.Collision2Color(flag: Integer): Integer; static;
begin
  case flag of
    0:   Result := $FFFFFF; // walkable
    1:   Result := $000000; // blocked
    else Result := $333333; // collision object
  end;
end;

var
  ColorUtils: TColorUtils;
