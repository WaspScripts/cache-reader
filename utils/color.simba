{$include_once ./helpers.simba}

//TODO: delete most of this I think... most is not used
type
  TColorUtils = record
    const WALL_COLOR: TColor = $FFEEEEEE;
    const DOOR_COLOR: TColor = $FF0000EE;

    const BRIGHTNESS_MAX: Double = 0.5;
    const BRIGHTNESS_HIGH: Double = 0.7;
    const BRIGHTNESS_LOW: Double = 0.8;
    const BRIGHTNESS_MIN: Double = 0.9;

    const HUE_OFFSET: Double = 0.5 / 64.0;
    const SATURATION_OFFSET: Double = 0.5 / 8.0;

    Palette: TIntegerArray;
    IsSetup: Boolean;
  end;

function TColorUtils.PackHSL(hue, saturation, luminance: Integer): Integer; static;
begin
  if luminance > 179 then saturation := saturation div 2;
  if luminance > 192 then saturation := saturation div 2;
  if luminance > 217 then saturation := saturation div 2;
  if luminance > 243 then saturation := saturation div 2;

  Result := ((saturation div 32) shl 7) + ((hue div 4) shl 10) + (luminance div 2);
end;

function TColorUtils.PackHSLFull(hue, saturation, luminance: Integer): Integer; static;
begin
  Result := ((hue and $FF) shl 16) or ((saturation and $FF) shl 8) or (luminance and $FF);
end;

function TColorUtils.UnpackHue(hsl: Integer): Integer; static;
begin
  Result := (hsl shr 10) and 63;
end;

function TColorUtils.UnpackSaturation(hsl: Integer): Integer; static;
begin
  Result := (hsl shr 7) and 7;
end;

function TColorUtils.UnpackLuminance(hsl: Integer): Integer; static;
begin
  Result := hsl and 127;
end;

function TColorUtils.UnpackHueFull(hsl: Integer): Integer; static;
begin
  Result := (hsl shr 16) and $FF;
end;

function TColorUtils.UnpackSaturationFull(hsl: Integer): Integer; static;
begin
  Result := (hsl shr 8) and $FF;
end;

function TColorUtils.UnpackLuminanceFull(hsl: Integer): Integer; static;
begin
  Result := hsl and $FF;
end;

function TColorUtils.AdjustForBrightness(bgr: Integer; brightness: Double): Integer; static;
var
  r, g, b: Double;
begin
  b := (bgr shr 16) / 256;
  g := ((bgr shr 8) and 255) / 256;
  r := (bgr and 255) / 256;

  b := Power(b, brightness);
  g := Power(g, brightness);
  r := Power(r, brightness);

  Result := Trunc(r * 256) + (Trunc(g * 256) shl 8) + (Trunc(b * 256) shl 16);
end;

function TColorUtils.HSL2BGR(hsl: Integer; brightness: Double): Integer; static;
var
  hue, saturation, luminance, chroma, x, lightness, r, g, b: Double;
begin
  hue := TColorUtils.UnpackHue(hsl) / 64 + TColorUtils.HUE_OFFSET;
  saturation := TColorUtils.UnpackSaturation(hsl) / 8 + TColorUtils.SATURATION_OFFSET;
  luminance := TColorUtils.UnpackLuminance(hsl) / 128;

  chroma := (1 - Abs((2 * luminance) - 1)) * saturation;
  x := chroma * (1 - Abs(Modulo(hue * 6, 2) - 1));
  lightness := luminance - (chroma / 2);

  r := lightness; g := lightness; b := lightness;

  case Trunc(hue * 6) of
    0: begin r := r + chroma; g := g + x; end;
    1: begin g := g + chroma; r := r + x; end;
    2: begin g := g + chroma; b := b + x; end;
    3: begin b := b + chroma; g := g + x; end;
    4: begin b := b + chroma; r := r + x; end;
  else
    begin r := r + chroma; b := b + x; end;
  end;

  Result := (Trunc(b * 256) shl 16) or (Trunc(g * 256) shl 8) or Trunc(r * 256);
  Result := TColorUtils.AdjustForBrightness(Result, brightness);

  if Result = 0 then
    Result := 1;
end;

function TColorUtils.HSL2BGRFull(hsl: Integer): Integer; static;
var
  hue, saturation, luminance, chroma, x, lightness, r, g, b: Double;
begin
  hue := TColorUtils.UnpackHueFull(hsl) / 256;
  saturation := TColorUtils.UnpackSaturationFull(hsl) / 256;
  luminance := TColorUtils.UnpackLuminanceFull(hsl) / 256;

  chroma := (1 - Abs((2 * luminance) - 1)) * saturation;
  x := chroma * (1 - Abs(Modulo(hue * 6, 2) - 1));
  lightness := luminance - (chroma / 2);

  r := lightness; g := lightness; b := lightness;

  case Trunc(hue * 6) of
    0: begin r := r + chroma; g := g + x; end;
    1: begin g := g + chroma; r := r + x; end;
    2: begin g := g + chroma; b := b + x; end;
    3: begin b := b + chroma; g := g + x; end;
    4: begin b := b + chroma; r := r + x; end;
  else
    begin r := r + chroma; b := b + x; end;
  end;

  Result := ((Trunc(b * 256) and 255) shl 16) or ((Trunc(g * 256) and 255) shl 8) or (Trunc(r * 256) and 255);

  if Result = 0 then
    Result := 1;
end;

function TColorUtils.HSL2BGRFull(hsl: Integer; brightness: Double): Integer; static; overload;
var
  hue, saturation, luminance, chroma, x, lightness, r, g, b: Double;
begin
  hue := TColorUtils.UnpackHueFull(hsl) / 256;
  saturation := TColorUtils.UnpackSaturationFull(hsl) / 256;
  luminance := TColorUtils.UnpackLuminanceFull(hsl) / 256;

  chroma := (1 - Abs((2 * luminance) - 1)) * saturation;
  x := chroma * (1 - Abs(Modulo(hue * 6, 2) - 1));
  lightness := luminance - (chroma / 2);

  r := lightness; g := lightness; b := lightness;

  case Trunc(hue * 6) of
    0:   begin r := r + chroma; g := g + x; end;
    1:   begin g := g + chroma; r := r + x; end;
    2:   begin g := g + chroma; b := b + x; end;
    3:   begin b := b + chroma; g := g + x; end;
    4:   begin b := b + chroma; r := r + x; end;
    else begin r := r + chroma; b := b + x; end;
  end;

  Result := ((Trunc(b * 256) and 255) shl 16) or ((Trunc(g * 256) and 255) shl 8) or (Trunc(r * 256) and 255);
  Result := TColorUtils.AdjustForBrightness(Result, brightness);

  if Result = 0 then
    Result := 1;
end;

function TColorUtils.CreateHSVPalette(brightness: Double; mn, mx: Integer): TColorArray; static;
var
  i: Integer;
  hue, sat, lum, r, g, b, p, q, t1, t2: Double;
begin
  SetLength(Result, 65536);

  for i := mn to mx - 1 do
  begin
    hue := ((i shr 10) and $3F) / 64 + 0.0078125;
    sat := ((i shr 7) and $7) / 8 + 0.0625;
    lum := (i and $7F) / 128;

    r := lum; g := lum; b := lum;

    if sat <> 0 then
    begin
      if lum < 0.5 then
        q := (sat + 1) * lum
      else
        q := lum + sat - sat * lum;

      p := lum * 2 - q;

      t1 := hue + 1/3;
      if t1 > 1 then t1 := t1 - 1;

      t2 := hue - 1/3;
      if t2 < 0 then t2 := t2 + 1;

      if hue * 6 < 1 then
        g := p + hue * 6 * (q - p)
      else if hue * 2 < 1 then
        g := q
      else if hue * 3 < 2 then
        g := (q - p) * (0.6666666666666666 - hue) * 6 + p
      else
        g := p;

      if t1 * 6 < 1 then
        r := t1 * 6 * (q - p) + p
      else if t1 * 2 < 1 then
        r := q
      else if t1 * 3 < 2 then
        r := p + (q - p) * 6 * (0.6666666666666666 - t1)
      else
        r := p;

      if t2 * 6 < 1 then
        b := p + (q - p) * 6 * t2
      else if t2 * 2 < 1 then
        b := q
      else if t2 * 3 < 2 then
        b := (0.6666666666666666 - t2) * (q - p) * 6 + p
      else
        b := p;
    end;

    r := Power(r, brightness);
    g := Power(g, brightness);
    b := Power(b, brightness);

    //BGR:
    Result[i] := Trunc(r * 256) + (Trunc(b * 256) shl 16) + (Trunc(g * 256) shl 8);
    //RGB:
    //Result[i] := Trunc(b * 256) + (Trunc(r * 256) shl 16) + (Trunc(g * 256) shl 8);
  end;
end;

function TColorUtils.CreatePalette(brightness: Double): TIntegerArray; static;
begin
  Result := TColorUtils.CreateHSVPalette(brightness, 0, 65536);
end;

function TColorUtils.CreatePalette(brightness: Double; mn, mx: Integer): TIntegerArray; static; overload;
var
  i, j, idx: Integer;
  hue, sat, lum, r, g, b, p, q, t1, t2: Double;
begin
  SetLength(Result, 65536);
  idx := mn * 128;

  for i := mn to mx - 1 do
  begin
    hue := (i shr 3) / 64 + 0.0078125;
    sat := (i and 7) / 8 + 0.0625;

    for j := 0 to 127 do
    begin
      lum := j / 128;
      r := lum; g := lum; b := lum;

      if sat <> 0 then
      begin
        if lum < 0.5 then
          q := lum * (1 + sat)
        else
          q := lum + sat - lum * sat;

        p := 2 * lum - q;
        t1 := hue + 0.3333333333333333;
        if t1 > 1 then t1 := t1 - 1;

        t2 := hue - 0.3333333333333333;
        if t2 < 0 then t2 := t2 + 1;

        if 6 * t1 < 1 then
          r := p + (q - p) * 6 * t1
        else if 2 * t1 < 1 then
          r := q
        else if 3 * t1 < 2 then
          r := p + (q - p) * (0.6666666666666666 - t1) * 6
        else
          r := p;

        if 6 * hue < 1 then
          g := p + (q - p) * 6 * hue
        else if 2 * hue < 1 then
          g := q
        else if 3 * hue < 2 then
          g := p + (q - p) * (0.6666666666666666 - hue) * 6
        else
          g := p;

        if 6 * t2 < 1 then
          b := p + (q - p) * 6 * t2
        else if 2 * t2 < 1 then
          b := q
        else if 3 * t2 < 2 then
          b := p + (q - p) * (0.6666666666666666 - t2) * 6
        else
          b := p;
      end;

      Result[idx] := Trunc(r * 256) + (Trunc(g * 256) shl 8) + (Trunc(b * 256) shl 16);
      Result[idx] := TColorUtils.AdjustForBrightness(Result[idx], brightness);
      if Result[idx] = 0 then
        Result[idx] := 1;
      Inc(idx);
    end;
  end;
end;

function TColorUtils.CreateHSLPalette(brightness: Double; mn, mx: Integer): TIntegerArray; static;
var
  i, j, idx, hi, hi6: Integer;
  hue, sat, lum, r, g, b, p, q, t, f: Double;
begin
  SetLength(Result, 65536);
  idx := 0;

  for i := mn to mx - 1 do
  begin
    hue := ((i shr 3) / 64 + 0.0078125) * 360;
    sat := (i and 7) / 8 + 0.0625;

    for j := 0 to 127 do
    begin
      lum := j / 128;
      r := 0; g := 0; b := 0;

      hi6 := Trunc(hue / 60);
      hi := hi6 mod 6;
      f := (hue / 60) - hi6;

      p := lum * (1 - sat);
      q := lum * (1 - f * sat);
      t := (1 - sat * (1 - f)) * lum;

      case hi of
        0: begin r := lum; b := p; g := t; end;
        1: begin b := p; r := q; g := lum; end;
        2: begin r := p; g := lum; b := t; end;
        3: begin g := q; r := p; b := lum; end;
        4: begin b := lum; r := t; g := p; end;
      else
        begin g := p; b := q; r := lum; end;
      end;

      r := Power(r, brightness);
      g := Power(g, brightness);
      b := Power(b, brightness);

      Result[idx] := (Trunc(g * 256) shl 8) + (Trunc(b * 256) shl 16) + Trunc(r * 256) - 16777216;
      Inc(idx);
    end;
  end;
end;

procedure TColorUtils.Setup(brightness: Double = TColorUtils.BRIGHTNESS_MAX);
begin
  if Self.IsSetup then
    Exit;

  Self.Palette := TColorUtils.CreateHSVPalette(brightness, 0, 65536);
  Self.IsSetup := True;
end;


function TColorUtils.UnderlayColor(hsl, targetLum: Integer): Integer;
begin
  if hsl = -1 then
    Exit(12345678);
  targetLum := EnsureRange((hsl and 127) * targetLum div 128, 2, 126);
  Result := Self.Palette[(hsl and 65408) + targetLum];
end;

function TColorUtils.OverlayColor(hsl, targetLum: Integer): Integer;
begin
  case hsl of
    -2: Exit(12345678);
    -1: Exit(Self.Palette[EnsureRange(targetLum, 2, 126)]);
  end;

  targetLum := EnsureRange((hsl and 127) * targetLum div 128, 2, 126);
  Result := Self.Palette[(hsl and 65408) + targetLum];
end;

var
  ColorUtils: TColorUtils;

