(*
# Graphics3D
Software 3D rasterizer.
Renders Gouraud-shaded, flat-coloured and textured triangles into an integer pixel buffer.

The pixel format is Alpha<<24 | Red<<16 | Green<<8 | Blue, which is what the `PColorBGRA` buffer
`TImage.FromData` reads, so a finished buffer becomes an image without being walked again.
Colours are palette indices rather than colours, looked up in `ColorUtils.Palette` - the one
palette the whole library draws through, so there is nothing to point this at and nothing to
keep in step.
*)

{$DEFINE WL_CACHE_GRAPHICS3D_INCLUDED}
{$IFNDEF WL_CACHE_COLOR_INCLUDED}        {$INCLUDE_ONCE ../utils/color.simba}  {$ENDIF}
{$IFNDEF WL_CACHE_CIRCULARANGLE_INCLUDED}      {$INCLUDE_ONCE circularangle.simba}   {$ENDIF}

type
  TGraphics3D = record
    // Rasterizer2D fields
    Pixels: TIntegerArray;
    PixelWidth, PixelHeight,
    DrawTop, DrawBottom, DrawLeft, DrawRight: Integer;

    // Graphics3D fields
    Zoom, CenterX, CenterY,
    ClipWidth, ClipHeight,
    ClipNegMidX, ClipMidX2, ClipNegMidY, ClipMidY2: Integer;
    ClipY: TIntegerArray;
    RasterClipEnable,
    RasterGouraudLowRes: Boolean;
    RasterAlpha: Integer;
    TextureFrame: Integer;
  end;

(*
## Graphics3D.SetDrawRegion
```pascal
procedure TGraphics3D.SetDrawRegion(bounds: TBox);
```
Restricts drawing to `bounds`, clipped to the buffer. Call
{ref}`TGraphics3D.SetRasterClipping` afterwards to rebuild the row table for the new region.
*)
procedure TGraphics3D.SetDrawRegion(bounds: TBox);
begin
  bounds := bounds.Clip([0,0,Self.PixelWidth, Self.PixelHeight]);

  Self.DrawLeft := bounds.X1;
  Self.DrawTop := bounds.Y1;
  Self.DrawRight := bounds.X2;
  Self.DrawBottom := bounds.Y2;
end;

(*
## Graphics3D.SetRasterBuffer
```pascal
procedure TGraphics3D.SetRasterBuffer(constref buf: TIntegerArray; w, h: Integer);
```
Points the rasterizer at the pixel buffer it should draw into and resets the draw region to all
of it.

The buffer is shared rather than copied, so whatever owns it sees the drawing as it happens.
*)
procedure TGraphics3D.SetRasterBuffer(constref buf: TIntegerArray; w, h: Integer);
begin
  Self.Pixels := buf;
  Self.PixelWidth := w;
  Self.PixelHeight := h;

  Self.DrawLeft := 0;
  Self.DrawTop := 0;
  Self.DrawRight := Min(w, Self.PixelWidth);
  Self.DrawBottom := Min(h, Self.PixelHeight);
end;

(*
## Graphics3D.Reset
```pascal
procedure TGraphics3D.Reset();
```
Clears the pixel buffer to transparent.
*)
procedure TGraphics3D.Reset();
var
  i: Integer;
begin
  for i := 0 to High(Self.Pixels) do
    Self.Pixels[i] := 0;
end;

(*
## Graphics3D.UpdateClipDims
```pascal
procedure TGraphics3D.UpdateClipDims();
```
Recentres projection on the middle of the clip region and recomputes the bounds triangles are
tested against.
*)
procedure TGraphics3D.UpdateClipDims();
begin
  Self.CenterX := Self.ClipWidth div 2;
  Self.CenterY := Self.ClipHeight div 2;
  Self.ClipNegMidX := -Self.CenterX;
  Self.ClipMidX2 := Self.ClipWidth - Self.CenterX;
  Self.ClipNegMidY := -Self.CenterY;
  Self.ClipMidY2 := Self.ClipHeight - Self.CenterY;
end;

(*
## Graphics3D.SetRasterClipping
```pascal
procedure TGraphics3D.SetRasterClipping();
```
Prepares the rasterizer for the current draw region.

`ClipY` ends up holding the buffer offset of each row of that region, so a scanline can start
from a single lookup instead of a multiply. It is grown to the next power of two and kept, since
this runs per rendered sprite.
*)
procedure TGraphics3D.SetRasterClipping();
var
  v, area, i: Integer;
begin
  Self.ClipWidth := Self.DrawRight - Self.DrawLeft;
  Self.ClipHeight := Self.DrawBottom - Self.DrawTop;
  Self.UpdateClipDims();

  if Length(Self.ClipY) < Self.ClipHeight then
  begin
    v := Self.ClipHeight - 1;
    v := v or (v shr 1);
    v := v or (v shr 2);
    v := v or (v shr 4);
    v := v or (v shr 8);
    v := v or (v shr 16);
    SetLength(Self.ClipY, v + 1);
  end;

  area := Self.DrawLeft + Self.PixelWidth * Self.DrawTop;
  for i := 0 to Self.ClipHeight - 1 do
  begin
    Self.ClipY[i] := area;
    area += Self.PixelWidth;
  end;
end;

(*
## Graphics3D.SetOffset
```pascal
procedure TGraphics3D.SetOffset(x, y: Integer);
```
Moves the point that projection treats as the centre to `x, y` within the buffer.

An item icon is drawn around the middle of its 36 by 32 canvas rather than around the middle of
the draw region, which is what this is for.
*)
procedure TGraphics3D.SetOffset(x, y: Integer);
var
  base, row, col: Integer;
begin
  base := Self.ClipY[0];
  row := base div Self.PixelWidth;
  col := base - row * Self.PixelWidth;

  Self.CenterX := x - col;
  Self.CenterY := y - row;
  Self.ClipNegMidX := -Self.CenterX;
  Self.ClipMidX2 := Self.ClipWidth - Self.CenterX;
  Self.ClipNegMidY := -Self.CenterY;
  Self.ClipMidY2 := Self.ClipHeight - Self.CenterY;
end;

(*
## Graphics3D.GouraudRaster
```pascal
procedure TGraphics3D.GouraudRaster(baseIdx, leftX, rightX, startColor, colorStep: Integer);
```
Interpolates a colour value across [leftX, rightX]
using a fixed-point step, looks up each pixel in the colour palette, and optionally
applies alpha blending.

`startColor` is the colour extrapolated back to x = 0, not the colour at
`leftX` - this re-adds leftX * colorStep itself, so that clipping leftX to 0 still
lands on the right colour. When RasterGouraudLowRes is true, every 4 pixels share one
colour for speed (as the original client does on low-res mode).
*)
procedure TGraphics3D.GouraudRaster(baseIdx, leftX, rightX, startColor, colorStep: Integer);
var
  span, i, pixelIdx, color, pal, blended, existing, alpha, invAlpha: Integer;
  palette: TIntegerArray;
begin
  if Self.RasterClipEnable then
  begin
    if rightX > Self.ClipWidth then
      rightX := Self.ClipWidth;
    if leftX < 0 then
      leftX := 0;
  end;

  if leftX >= rightX then
    Exit;

  palette := ColorUtils.Palette;
  pixelIdx := baseIdx + leftX;
  color := startColor + leftX * colorStep;

  if not Self.RasterGouraudLowRes then
  begin
    span := rightX - leftX;
    if Self.RasterAlpha = 0 then
    begin
      for i := 0 to span - 1 do
      begin
        Self.Pixels[pixelIdx] := palette[color shr 8];
        color += colorStep;
        Inc(pixelIdx);
      end;
    end
    else
    begin
      alpha := Self.RasterAlpha;
      invAlpha := 256 - alpha;
      for i := 0 to span - 1 do
      begin
        pal := palette[color shr 8];
        color += colorStep;
        blended := $FF000000 or (((invAlpha * (pal and $FF00) shr 8) and $FF00) +
                                 ((invAlpha * (pal and $FF00FF) shr 8) and $FF00FF));
        existing := Self.Pixels[pixelIdx];
        Self.Pixels[pixelIdx] := (((existing and $FF00FF) * alpha shr 8) and $FF00FF) +
                                 blended +
                                 ((alpha * (existing and $FF00) shr 8) and $FF00);
        Inc(pixelIdx);
      end;
    end;
    Exit;
  end;

  // Low-res mode: 4x pixel blocks
  span := (rightX - leftX) div 4;
  colorStep := colorStep shl 2;
  if Self.RasterAlpha = 0 then
  begin
    for i := 0 to span - 1 do
    begin
      pal := palette[color shr 8];
      Self.Pixels[pixelIdx] := pal;
      Self.Pixels[pixelIdx + 1] := pal;
      Self.Pixels[pixelIdx + 2] := pal;
      Self.Pixels[pixelIdx + 3] := pal;
      color += colorStep;
      Inc(pixelIdx, 4);
    end;

    span := (rightX - leftX) and 3;
    if span > 0 then
    begin
      pal := palette[color shr 8];
      for i := 0 to span - 1 do
        Self.Pixels[pixelIdx + i] := pal;
    end;
    Exit;
  end;

  alpha := Self.RasterAlpha;
  invAlpha := 256 - alpha;

  for i := 0 to span - 1 do
  begin
    pal := palette[color shr 8];
    color += colorStep;
    blended := $FF000000 or (((invAlpha * (pal and $FF00) shr 8) and $FF00) +
                             ((invAlpha * (pal and $FF00FF) shr 8) and $FF00FF));
    existing := Self.Pixels[pixelIdx];
    Self.Pixels[pixelIdx] := (((existing and $FF00FF) * alpha shr 8) and $FF00FF) + blended + ((alpha * (existing and $FF00) shr 8) and $FF00);
    existing := Self.Pixels[pixelIdx + 1];
    Self.Pixels[pixelIdx + 1] := (((existing and $FF00FF) * alpha shr 8) and $FF00FF) + blended + ((alpha * (existing and $FF00) shr 8) and $FF00);
    existing := Self.Pixels[pixelIdx + 2];
    Self.Pixels[pixelIdx + 2] := (((existing and $FF00FF) * alpha shr 8) and $FF00FF) + blended + ((alpha * (existing and $FF00) shr 8) and $FF00);
    existing := Self.Pixels[pixelIdx + 3];
    Self.Pixels[pixelIdx + 3] := (((existing and $FF00FF) * alpha shr 8) and $FF00FF) + blended + ((alpha * (existing and $FF00) shr 8) and $FF00);
    Inc(pixelIdx, 4);
  end;

  span := (rightX - leftX) and 3;

  if span <= 0 then
    Exit;

  pal := palette[color shr 8];
  blended := $FF000000 or (((invAlpha * (pal and $FF00) shr 8) and $FF00) + ((invAlpha * (pal and $FF00FF) shr 8) and $FF00FF));
  for i := 0 to span - 1 do
  begin
    existing := Self.Pixels[pixelIdx + i];
    Self.Pixels[pixelIdx + i] := (((existing and $FF00FF) * alpha shr 8) and $FF00FF) + blended + ((alpha * (existing and $FF00) shr 8) and $FF00);
  end;
end;

(*
## Graphics3D.GouraudTriangle
```pascal
procedure TGraphics3D.GouraudTriangle(y0, y1, y2, x0, x1, x2, c0, c1, c2: Integer);
```
Fills a triangle whose three corners each have their own colour, blending between them across
the face.

The three vertices are sorted by height and the triangle is walked one scanline at a time, with
the two edges bounding that scanline and the colour along it all advanced by fixed point steps
rather than recomputed. Colour is a palette index, so what is interpolated is the index and not
the colour itself - which is why shading a face means walking its palette rather than mixing
channels. Each scanline is handed to {ref}`TGraphics3D.GouraudRaster`.

A degenerate triangle - one with no area - is dropped, since it has no gradient to interpolate
along.
*)
procedure TGraphics3D.GouraudTriangle(y0, y1, y2, x0, x1, x2, c0, c1, c2: Integer);
var
  dx1, dy1, dx2, dy2, dc1, dc2,
  slope0, slope1, slope2,
  area, dColorDX, dColorDY, pixelRow: Integer;
begin
  dx1 := x1 - x0;
  dy1 := y1 - y0;
  dx2 := x2 - x0;
  dy2 := y2 - y0;

  dc1 := c1 - c0;
  dc2 := c2 - c0;

  slope0 := 0;
  if y2 <> y1 then slope0 := ((x2 - x1) shl 14) div (y2 - y1);
  slope1 := 0;
  if y0 <> y1 then slope1 := (dx1 shl 14) div dy1;
  slope2 := 0;
  if y0 <> y2 then slope2 := (dx2 shl 14) div dy2;

  area := dx1 * dy2 - dx2 * dy1;
  if area = 0 then Exit;

  dColorDX := ((dc1 * dy2 - dc2 * dy1) shl 8) div area;
  dColorDY := ((dc2 * dx1 - dc1 * dx2) shl 8) div area;

  if (y0 <= y1) and (y0 <= y2) then
  begin
    if y0 >= Self.ClipHeight then Exit;
    if y1 > Self.ClipHeight then y1 := Self.ClipHeight;
    if y2 > Self.ClipHeight then y2 := Self.ClipHeight;

    c0 := dColorDX + ((c0 shl 8) - x0 * dColorDX);

    if y1 < y2 then
    begin
      x0 := x0 shl 14;
      x2 := x0;
      if y0 < 0 then
      begin
        x2 -= y0 * slope2;
        x0 -= y0 * slope1;
        c0 -= y0 * dColorDY;
        y0 := 0;
      end;

      x1 := x1 shl 14;
      if y1 < 0 then
      begin
        x1 -= slope0 * y1;
        y1 := 0;
      end;

      if ((y0 = y1) or (slope2 >= slope1)) and ((y0 <> y1) or (slope2 <= slope0)) then
      begin
        y2 -= y1;
        y1 -= y0;
        pixelRow := Self.ClipY[y0];

        while True do
        begin
          Dec(y1);
          if y1 < 0 then
            while True do
            begin
              Dec(y2);
              if y2 < 0 then Exit;
              Self.GouraudRaster(pixelRow, ArithmeticShr(x1, 14), ArithmeticShr(x2, 14), c0, dColorDX);
              x2 += slope2;
              x1 += slope0;
              c0 += dColorDY;
              pixelRow += Self.PixelWidth;
            end;

          Self.GouraudRaster(pixelRow, ArithmeticShr(x0, 14), ArithmeticShr(x2, 14), c0, dColorDX);
          x2 += slope2;
          x0 += slope1;
          c0 += dColorDY;
          pixelRow += Self.PixelWidth;
        end;
      end;

      y2 -= y1;
      y1 -= y0;
      pixelRow := Self.ClipY[y0];

      while True do
      begin
        Dec(y1);
        if y1 < 0 then
          while True do
          begin
            Dec(y2);
            if y2 < 0 then Exit;
            Self.GouraudRaster(pixelRow, ArithmeticShr(x2, 14), ArithmeticShr(x1, 14), c0, dColorDX);
            x2 += slope2;
            x1 += slope0;
            c0 += dColorDY;
            pixelRow += Self.PixelWidth;
          end;

        Self.GouraudRaster(pixelRow, ArithmeticShr(x2, 14), ArithmeticShr(x0, 14), c0, dColorDX);
        x2 += slope2;
        x0 += slope1;
        c0 += dColorDY;
        pixelRow += Self.PixelWidth;
      end;
    end;

    x0 := x0 shl 14;
    x1 := x0;
    if y0 < 0 then
    begin
      x1 -= y0 * slope2;
      x0 -= y0 * slope1;
      c0 -= y0 * dColorDY;
      y0 := 0;
    end;

    x2 := x2 shl 14;
    if y2 < 0 then
    begin
      x2 -= slope0 * y2;
      y2 := 0;
    end;

    if ((y0 <> y2) and (slope2 < slope1)) or ((y0 = y2) and (slope0 > slope1)) then
    begin
      y1 -= y2;
      y2 -= y0;
      pixelRow := Self.ClipY[y0];

      while True do
      begin
        Dec(y2);
        if y2 < 0 then
          while True do
          begin
            Dec(y1);
            if y1 < 0 then Exit;
            Self.GouraudRaster(pixelRow, ArithmeticShr(x2, 14), ArithmeticShr(x0, 14), c0, dColorDX);
            x2 += slope0;
            x0 += slope1;
            c0 += dColorDY;
            pixelRow += Self.PixelWidth;
          end;

        Self.GouraudRaster(pixelRow, ArithmeticShr(x1, 14), ArithmeticShr(x0, 14), c0, dColorDX);
        x1 += slope2;
        x0 += slope1;
        c0 += dColorDY;
        pixelRow += Self.PixelWidth;
      end;
    end;

    y1 -= y2;
    y2 -= y0;
    pixelRow := Self.ClipY[y0];

    while True do
    begin
      Dec(y2);
      if y2 < 0 then
        while True do
        begin
          Dec(y1);
          if y1 < 0 then Exit;
          Self.GouraudRaster(pixelRow, ArithmeticShr(x0, 14), ArithmeticShr(x2, 14), c0, dColorDX);
          x2 += slope0;
          x0 += slope1;
          c0 += dColorDY;
          pixelRow += Self.PixelWidth;
        end;

      Self.GouraudRaster(pixelRow, ArithmeticShr(x0, 14), ArithmeticShr(x1, 14), c0, dColorDX);
      x1 += slope2;
      x0 += slope1;
      c0 += dColorDY;
      pixelRow += Self.PixelWidth;
    end;
  end;

  if y1 <= y2 then
  begin
    if y1 >= Self.ClipHeight then Exit;
    if y2 > Self.ClipHeight then y2 := Self.ClipHeight;
    if y0 > Self.ClipHeight then y0 := Self.ClipHeight;

    c1 := dColorDX + ((c1 shl 8) - dColorDX * x1);

    if y2 < y0 then
    begin
      x1 := x1 shl 14;
      x0 := x1;
      if y1 < 0 then
      begin
        x0 -= slope1 * y1;
        x1 -= slope0 * y1;
        c1 -= dColorDY * y1;
        y1 := 0;
      end;

      x2 := x2 shl 14;
      if y2 < 0 then
      begin
        x2 -= slope2 * y2;
        y2 := 0;
      end;

      if ((y2 = y1) or (slope1 >= slope0)) and ((y2 <> y1) or (slope1 <= slope2)) then
      begin
        y0 -= y2;
        y2 -= y1;
        pixelRow := Self.ClipY[y1];

        while True do
        begin
          Dec(y2);
          if y2 < 0 then
            while True do
            begin
              Dec(y0);
              if y0 < 0 then Exit;
              Self.GouraudRaster(pixelRow, ArithmeticShr(x2, 14), ArithmeticShr(x0, 14), c1, dColorDX);
              x0 += slope1;
              x2 += slope2;
              c1 += dColorDY;
              pixelRow += Self.PixelWidth;
            end;

          Self.GouraudRaster(pixelRow, ArithmeticShr(x1, 14), ArithmeticShr(x0, 14), c1, dColorDX);
          x0 += slope1;
          x1 += slope0;
          c1 += dColorDY;
          pixelRow += Self.PixelWidth;
        end;
      end;

      y0 -= y2;
      y2 -= y1;
      pixelRow := Self.ClipY[y1];

      while True do
      begin
        Dec(y2);
        if y2 < 0 then
          while True do
          begin
            Dec(y0);
            if y0 < 0 then Exit;
            Self.GouraudRaster(pixelRow, ArithmeticShr(x0, 14), ArithmeticShr(x2, 14), c1, dColorDX);
            x0 += slope1;
            x2 += slope2;
            c1 += dColorDY;
            pixelRow += Self.PixelWidth;
          end;

        Self.GouraudRaster(pixelRow, ArithmeticShr(x0, 14), ArithmeticShr(x1, 14), c1, dColorDX);
        x0 += slope1;
        x1 += slope0;
        c1 += dColorDY;
        pixelRow += Self.PixelWidth;
      end;
    end;

    x1 := x1 shl 14;
    x2 := x1;
    if y1 < 0 then
    begin
      x2 -= slope1 * y1;
      x1 -= slope0 * y1;
      c1 -= dColorDY * y1;
      y1 := 0;
    end;

    x0 := x0 shl 14;
    if y0 < 0 then
    begin
      x0 -= y0 * slope2;
      y0 := 0;
    end;

    if slope1 < slope0 then
    begin
      y2 -= y0;
      y0 -= y1;
      pixelRow := Self.ClipY[y1];

      while True do
      begin
        Dec(y0);
        if y0 < 0 then
          while True do
          begin
            Dec(y2);
            if y2 < 0 then Exit;
            Self.GouraudRaster(pixelRow, ArithmeticShr(x0, 14), ArithmeticShr(x1, 14), c1, dColorDX);
            x0 += slope2;
            x1 += slope0;
            c1 += dColorDY;
            pixelRow += Self.PixelWidth;
          end;

        Self.GouraudRaster(pixelRow, ArithmeticShr(x2, 14), ArithmeticShr(x1, 14), c1, dColorDX);
        x2 += slope1;
        x1 += slope0;
        c1 += dColorDY;
        pixelRow += Self.PixelWidth;
      end;
    end;

    y2 -= y0;
    y0 -= y1;
    pixelRow := Self.ClipY[y1];

    while True do
    begin
      Dec(y0);
      if y0 < 0 then
        while True do
        begin
          Dec(y2);
          if y2 < 0 then Exit;
          Self.GouraudRaster(pixelRow, ArithmeticShr(x1, 14), ArithmeticShr(x0, 14), c1, dColorDX);
          x0 += slope2;
          x1 += slope0;
          c1 += dColorDY;
          pixelRow += Self.PixelWidth;
        end;

      Self.GouraudRaster(pixelRow, ArithmeticShr(x1, 14), ArithmeticShr(x2, 14), c1, dColorDX);
      x2 += slope1;
      x1 += slope0;
      c1 += dColorDY;
      pixelRow += Self.PixelWidth;
    end;
  end;

  if y2 >= Self.ClipHeight then Exit;
  if y0 > Self.ClipHeight then y0 := Self.ClipHeight;
  if y1 > Self.ClipHeight then y1 := Self.ClipHeight;

  c2 := dColorDX + ((c2 shl 8) - x2 * dColorDX);

  if y0 < y1 then
  begin
    x2 := x2 shl 14;
    x1 := x2;
    if y2 < 0 then
    begin
      x1 -= slope0 * y2;
      x2 -= slope2 * y2;
      c2 -= dColorDY * y2;
      y2 := 0;
    end;

    x0 := x0 shl 14;
    if y0 < 0 then
    begin
      x0 -= y0 * slope1;
      y0 := 0;
    end;

    if slope0 < slope2 then
    begin
      y1 -= y0;
      y0 -= y2;
      pixelRow := Self.ClipY[y2];

      while True do
      begin
        Dec(y0);
        if y0 < 0 then
          while True do
          begin
            Dec(y1);
            if y1 < 0 then Exit;
            Self.GouraudRaster(pixelRow, ArithmeticShr(x1, 14), ArithmeticShr(x0, 14), c2, dColorDX);
            x1 += slope0;
            x0 += slope1;
            c2 += dColorDY;
            pixelRow += Self.PixelWidth;
          end;

        Self.GouraudRaster(pixelRow, ArithmeticShr(x1, 14), ArithmeticShr(x2, 14), c2, dColorDX);
        x1 += slope0;
        x2 += slope2;
        c2 += dColorDY;
        pixelRow += Self.PixelWidth;
      end;
    end;

    y1 -= y0;
    y0 -= y2;
    pixelRow := Self.ClipY[y2];

    while True do
    begin
      Dec(y0);
      if y0 < 0 then
        while True do
        begin
          Dec(y1);
          if y1 < 0 then Exit;
          Self.GouraudRaster(pixelRow, ArithmeticShr(x0, 14), ArithmeticShr(x1, 14), c2, dColorDX);
          x1 += slope0;
          x0 += slope1;
          c2 += dColorDY;
          pixelRow += Self.PixelWidth;
        end;

      Self.GouraudRaster(pixelRow, ArithmeticShr(x2, 14), ArithmeticShr(x1, 14), c2, dColorDX);
      x1 += slope0;
      x2 += slope2;
      c2 += dColorDY;
      pixelRow += Self.PixelWidth;
    end;
  end;

  x2 := x2 shl 14;
  x0 := x2;
  if y2 < 0 then
  begin
    x0 -= slope0 * y2;
    x2 -= slope2 * y2;
    c2 -= dColorDY * y2;
    y2 := 0;
  end;

  x1 := x1 shl 14;
  if y1 < 0 then
  begin
    x1 -= slope1 * y1;
    y1 := 0;
  end;

  if slope0 < slope2 then
  begin
    y0 -= y1;
    y1 -= y2;
    pixelRow := Self.ClipY[y2];

    while True do
    begin
      Dec(y1);
      if y1 < 0 then
        while True do
        begin
          Dec(y0);
          if y0 < 0 then Exit;
          Self.GouraudRaster(pixelRow, ArithmeticShr(x1, 14), ArithmeticShr(x2, 14), c2, dColorDX);
          x1 += slope1;
          x2 += slope2;
          c2 += dColorDY;
          pixelRow += Self.PixelWidth;
        end;

      Self.GouraudRaster(pixelRow, ArithmeticShr(x0, 14), ArithmeticShr(x2, 14), c2, dColorDX);
      x0 += slope0;
      x2 += slope2;
      c2 += dColorDY;
      pixelRow += Self.PixelWidth;
    end;
  end;

  y0 -= y1;
  y1 -= y2;
  pixelRow := Self.ClipY[y2];

  while True do
  begin
    Dec(y1);
    if y1 < 0 then
      while True do
      begin
        Dec(y0);
        if y0 < 0 then Exit;
        Self.GouraudRaster(pixelRow, ArithmeticShr(x2, 14), ArithmeticShr(x1, 14), c2, dColorDX);
        x1 += slope1;
        x2 += slope2;
        c2 += dColorDY;
        pixelRow += Self.PixelWidth;
      end;

    Self.GouraudRaster(pixelRow, ArithmeticShr(x2, 14), ArithmeticShr(x0, 14), c2, dColorDX);
    x0 += slope0;
    x2 += slope2;
    c2 += dColorDY;
    pixelRow += Self.PixelWidth;
  end;
end;


(*
## Graphics3D.FlatRaster
```pascal
procedure TGraphics3D.FlatRaster(baseIdx, leftX, rightX, color: Integer);
```
Fills one scanline of a flat triangle with a single colour, blending it into what is already there
when the face is translucent.

An alpha of `254` doesn't draw the colour at all. Instead every pixel of the scanline takes the
colour of the pixel to its right, smearing what is already drawn one pixel to the left. That is a
quirk of the client, whose copy reads the next pixel after it has already moved on to it, and
models use such faces on purpose, so it is reproduced here.
*)
procedure TGraphics3D.FlatRaster(baseIdx, leftX, rightX, color: Integer);
var
  span, i, pixelIdx, alpha, invAlpha, blended, existing: Integer;
begin
  if Self.RasterClipEnable then
  begin
    if rightX > Self.ClipWidth then rightX := Self.ClipWidth;
    if leftX < 0 then leftX := 0;
  end;

  if leftX >= rightX then Exit;

  pixelIdx := baseIdx + leftX;

  if Self.RasterAlpha = 254 then
  begin
    for i := pixelIdx to pixelIdx + rightX - leftX - 1 do
      Self.Pixels[i] := Self.Pixels[i + 1];
    Exit;
  end;

  if Self.RasterAlpha = 0 then
  begin
    span := rightX - leftX;
    for i := 0 to span - 1 do
    begin
      Self.Pixels[pixelIdx] := color;
      Inc(pixelIdx);
    end;
  end
  else
  begin
    alpha := Self.RasterAlpha;
    invAlpha := 256 - alpha;
    blended := $FF000000 or (((invAlpha * (color and $FF00) shr 8) and $FF00) +
                             ((invAlpha * (color and $FF00FF) shr 8) and $FF00FF));
    span := rightX - leftX;
    for i := 0 to span - 1 do
    begin
      existing := Self.Pixels[pixelIdx];
      Self.Pixels[pixelIdx] := (((existing and $FF00FF) * alpha shr 8) and $FF00FF) +
                                blended +
                                ((alpha * (existing and $FF00) shr 8) and $FF00);
      Inc(pixelIdx);
    end;
  end;
end;

(*
## Graphics3D.RasterFlat
```pascal
procedure TGraphics3D.RasterFlat(x0, x1, x2, y0, y1, y2, color: Integer);
```
Fills a triangle with a single colour.

It walks the triangle exactly as {ref}`TGraphics3D.GouraudTriangle` does - sorted by height,
one scanline at a time, edges advanced by fixed point steps - only without a colour to carry
along, and hands each scanline to {ref}`TGraphics3D.FlatRaster`. Unlike a shaded triangle, one
with no area is still walked.
*)
procedure TGraphics3D.RasterFlat(x0, x1, x2, y0, y1, y2, color: Integer);
var
  dx1, dy1, dx2, dy2,
  slope0, slope1, slope2,
  pixelRow: Integer;
begin
  dx1 := x1 - x0;
  dy1 := y1 - y0;
  dx2 := x2 - x0;
  dy2 := y2 - y0;

  slope0 := 0;
  if y2 <> y1 then slope0 := ((x2 - x1) shl 14) div (y2 - y1);
  slope1 := 0;
  if y0 <> y1 then slope1 := (dx1 shl 14) div dy1;
  slope2 := 0;
  if y0 <> y2 then slope2 := (dx2 shl 14) div dy2;

  if (y0 <= y1) and (y0 <= y2) then
  begin
    if y0 >= Self.ClipHeight then Exit;
    if y1 > Self.ClipHeight then y1 := Self.ClipHeight;
    if y2 > Self.ClipHeight then y2 := Self.ClipHeight;

    if y1 < y2 then
    begin
      x0 := x0 shl 14;
      x2 := x0;
      if y0 < 0 then
      begin
        x2 -= y0 * slope2;
        x0 -= y0 * slope1;
        y0 := 0;
      end;

      x1 := x1 shl 14;
      if y1 < 0 then
      begin
        x1 -= slope0 * y1;
        y1 := 0;
      end;

      if ((y0 = y1) or (slope2 >= slope1)) and ((y0 <> y1) or (slope2 <= slope0)) then
      begin
        y2 -= y1;
        y1 -= y0;
        pixelRow := Self.ClipY[y0];

        while True do
        begin
          Dec(y1);
          if y1 < 0 then
            while True do
            begin
              Dec(y2);
              if y2 < 0 then Exit;
              Self.FlatRaster(pixelRow, ArithmeticShr(x1, 14), ArithmeticShr(x2, 14), color);
              x2 += slope2;
              x1 += slope0;
              pixelRow += Self.PixelWidth;
            end;

          Self.FlatRaster(pixelRow, ArithmeticShr(x0, 14), ArithmeticShr(x2, 14), color);
          x2 += slope2;
          x0 += slope1;
          pixelRow += Self.PixelWidth;
        end;
      end;

      y2 -= y1;
      y1 -= y0;
      pixelRow := Self.ClipY[y0];

      while True do
      begin
        Dec(y1);
        if y1 < 0 then
          while True do
          begin
            Dec(y2);
            if y2 < 0 then Exit;
            Self.FlatRaster(pixelRow, ArithmeticShr(x2, 14), ArithmeticShr(x1, 14), color);
            x2 += slope2;
            x1 += slope0;
            pixelRow += Self.PixelWidth;
          end;

        Self.FlatRaster(pixelRow, ArithmeticShr(x2, 14), ArithmeticShr(x0, 14), color);
        x2 += slope2;
        x0 += slope1;
        pixelRow += Self.PixelWidth;
      end;
    end;

    x0 := x0 shl 14;
    x1 := x0;
    if y0 < 0 then
    begin
      x1 -= y0 * slope2;
      x0 -= y0 * slope1;
      y0 := 0;
    end;

    x2 := x2 shl 14;
    if y2 < 0 then
    begin
      x2 -= slope0 * y2;
      y2 := 0;
    end;

    if ((y0 <> y2) and (slope2 < slope1)) or ((y0 = y2) and (slope0 > slope1)) then
    begin
      y1 -= y2;
      y2 -= y0;
      pixelRow := Self.ClipY[y0];

      while True do
      begin
        Dec(y2);
        if y2 < 0 then
          while True do
          begin
            Dec(y1);
            if y1 < 0 then Exit;
            Self.FlatRaster(pixelRow, ArithmeticShr(x2, 14), ArithmeticShr(x0, 14), color);
            x2 += slope0;
            x0 += slope1;
            pixelRow += Self.PixelWidth;
          end;

        Self.FlatRaster(pixelRow, ArithmeticShr(x1, 14), ArithmeticShr(x0, 14), color);
        x1 += slope2;
        x0 += slope1;
        pixelRow += Self.PixelWidth;
      end;
    end;

    y1 -= y2;
    y2 -= y0;
    pixelRow := Self.ClipY[y0];

    while True do
    begin
      Dec(y2);
      if y2 < 0 then
        while True do
        begin
          Dec(y1);
          if y1 < 0 then Exit;
          Self.FlatRaster(pixelRow, ArithmeticShr(x0, 14), ArithmeticShr(x2, 14), color);
          x2 += slope0;
          x0 += slope1;
          pixelRow += Self.PixelWidth;
        end;

      Self.FlatRaster(pixelRow, ArithmeticShr(x0, 14), ArithmeticShr(x1, 14), color);
      x1 += slope2;
      x0 += slope1;
      pixelRow += Self.PixelWidth;
    end;
  end;

  if y1 <= y2 then
  begin
    if y1 >= Self.ClipHeight then Exit;
    if y2 > Self.ClipHeight then y2 := Self.ClipHeight;
    if y0 > Self.ClipHeight then y0 := Self.ClipHeight;

    if y2 < y0 then
    begin
      x1 := x1 shl 14;
      x0 := x1;
      if y1 < 0 then
      begin
        x0 -= slope1 * y1;
        x1 -= slope0 * y1;
        y1 := 0;
      end;

      x2 := x2 shl 14;
      if y2 < 0 then
      begin
        x2 -= slope2 * y2;
        y2 := 0;
      end;

      if ((y2 = y1) or (slope1 >= slope0)) and ((y2 <> y1) or (slope1 <= slope2)) then
      begin
        y0 -= y2;
        y2 -= y1;
        pixelRow := Self.ClipY[y1];

        while True do
        begin
          Dec(y2);
          if y2 < 0 then
            while True do
            begin
              Dec(y0);
              if y0 < 0 then Exit;
              Self.FlatRaster(pixelRow, ArithmeticShr(x2, 14), ArithmeticShr(x0, 14), color);
              x0 += slope1;
              x2 += slope2;
              pixelRow += Self.PixelWidth;
            end;

          Self.FlatRaster(pixelRow, ArithmeticShr(x1, 14), ArithmeticShr(x0, 14), color);
          x0 += slope1;
          x1 += slope0;
          pixelRow += Self.PixelWidth;
        end;
      end;

      y0 -= y2;
      y2 -= y1;
      pixelRow := Self.ClipY[y1];

      while True do
      begin
        Dec(y2);
        if y2 < 0 then
          while True do
          begin
            Dec(y0);
            if y0 < 0 then Exit;
            Self.FlatRaster(pixelRow, ArithmeticShr(x0, 14), ArithmeticShr(x2, 14), color);
            x0 += slope1;
            x2 += slope2;
            pixelRow += Self.PixelWidth;
          end;

        Self.FlatRaster(pixelRow, ArithmeticShr(x0, 14), ArithmeticShr(x1, 14), color);
        x0 += slope1;
        x1 += slope0;
        pixelRow += Self.PixelWidth;
      end;
    end;

    x1 := x1 shl 14;
    x2 := x1;
    if y1 < 0 then
    begin
      x2 -= slope1 * y1;
      x1 -= slope0 * y1;
      y1 := 0;
    end;

    x0 := x0 shl 14;
    if y0 < 0 then
    begin
      x0 -= y0 * slope2;
      y0 := 0;
    end;

    if slope1 < slope0 then
    begin
      y2 -= y0;
      y0 -= y1;
      pixelRow := Self.ClipY[y1];

      while True do
      begin
        Dec(y0);
        if y0 < 0 then
          while True do
          begin
            Dec(y2);
            if y2 < 0 then Exit;
            Self.FlatRaster(pixelRow, ArithmeticShr(x0, 14), ArithmeticShr(x1, 14), color);
            x0 += slope2;
            x1 += slope0;
            pixelRow += Self.PixelWidth;
          end;

        Self.FlatRaster(pixelRow, ArithmeticShr(x2, 14), ArithmeticShr(x1, 14), color);
        x2 += slope1;
        x1 += slope0;
        pixelRow += Self.PixelWidth;
      end;
    end;

    y2 -= y0;
    y0 -= y1;
    pixelRow := Self.ClipY[y1];

    while True do
    begin
      Dec(y0);
      if y0 < 0 then
        while True do
        begin
          Dec(y2);
          if y2 < 0 then Exit;
          Self.FlatRaster(pixelRow, ArithmeticShr(x1, 14), ArithmeticShr(x0, 14), color);
          x0 += slope2;
          x1 += slope0;
          pixelRow += Self.PixelWidth;
        end;

      Self.FlatRaster(pixelRow, ArithmeticShr(x1, 14), ArithmeticShr(x2, 14), color);
      x2 += slope1;
      x1 += slope0;
      pixelRow += Self.PixelWidth;
    end;
  end;

  if y2 >= Self.ClipHeight then Exit;
  if y0 > Self.ClipHeight then y0 := Self.ClipHeight;
  if y1 > Self.ClipHeight then y1 := Self.ClipHeight;

  if y0 < y1 then
  begin
    x2 := x2 shl 14;
    x1 := x2;
    if y2 < 0 then
    begin
      x1 -= slope0 * y2;
      x2 -= slope2 * y2;
      y2 := 0;
    end;

    x0 := x0 shl 14;
    if y0 < 0 then
    begin
      x0 -= y0 * slope1;
      y0 := 0;
    end;

    if slope0 < slope2 then
    begin
      y1 -= y0;
      y0 -= y2;
      pixelRow := Self.ClipY[y2];

      while True do
      begin
        Dec(y0);
        if y0 < 0 then
          while True do
          begin
            Dec(y1);
            if y1 < 0 then Exit;
            Self.FlatRaster(pixelRow, ArithmeticShr(x1, 14), ArithmeticShr(x0, 14), color);
            x1 += slope0;
            x0 += slope1;
            pixelRow += Self.PixelWidth;
          end;

        Self.FlatRaster(pixelRow, ArithmeticShr(x1, 14), ArithmeticShr(x2, 14), color);
        x1 += slope0;
        x2 += slope2;
        pixelRow += Self.PixelWidth;
      end;
    end;

    y1 -= y0;
    y0 -= y2;
    pixelRow := Self.ClipY[y2];

    while True do
    begin
      Dec(y0);
      if y0 < 0 then
        while True do
        begin
          Dec(y1);
          if y1 < 0 then Exit;
          Self.FlatRaster(pixelRow, ArithmeticShr(x0, 14), ArithmeticShr(x1, 14), color);
          x1 += slope0;
          x0 += slope1;
          pixelRow += Self.PixelWidth;
        end;

      Self.FlatRaster(pixelRow, ArithmeticShr(x2, 14), ArithmeticShr(x1, 14), color);
      x1 += slope0;
      x2 += slope2;
      pixelRow += Self.PixelWidth;
    end;
  end;

  x2 := x2 shl 14;
  x0 := x2;
  if y2 < 0 then
  begin
    x0 -= slope0 * y2;
    x2 -= slope2 * y2;
    y2 := 0;
  end;

  x1 := x1 shl 14;
  if y1 < 0 then
  begin
    x1 -= slope1 * y1;
    y1 := 0;
  end;

  if slope0 < slope2 then
  begin
    y0 -= y1;
    y1 -= y2;
    pixelRow := Self.ClipY[y2];

    while True do
    begin
      Dec(y1);
      if y1 < 0 then
        while True do
        begin
          Dec(y0);
          if y0 < 0 then Exit;
          Self.FlatRaster(pixelRow, ArithmeticShr(x1, 14), ArithmeticShr(x2, 14), color);
          x1 += slope1;
          x2 += slope2;
          pixelRow += Self.PixelWidth;
        end;

      Self.FlatRaster(pixelRow, ArithmeticShr(x0, 14), ArithmeticShr(x2, 14), color);
      x0 += slope0;
      x2 += slope2;
      pixelRow += Self.PixelWidth;
    end;
  end;

  y0 -= y1;
  y1 -= y2;
  pixelRow := Self.ClipY[y2];

  while True do
  begin
    Dec(y1);
    if y1 < 0 then
      while True do
      begin
        Dec(y0);
        if y0 < 0 then Exit;
        Self.FlatRaster(pixelRow, ArithmeticShr(x2, 14), ArithmeticShr(x1, 14), color);
        x1 += slope1;
        x2 += slope2;
        pixelRow += Self.PixelWidth;
      end;

    Self.FlatRaster(pixelRow, ArithmeticShr(x2, 14), ArithmeticShr(x0, 14), color);
    x0 += slope0;
    x2 += slope2;
    pixelRow += Self.PixelWidth;
  end;
end;

(*
## Graphics3D.TexturedRaster
```pascal
procedure TGraphics3D.TexturedRaster(baseIdx, leftX, rightX, shade, shadeStep, u, v, w, uStep, vStep, wStep: Integer; const texels: TIntegerArray; opaque: Boolean);
```
Fills one scanline of a textured triangle.

`u`, `v` and `w` are the texture coordinates and depth of the scanline, not yet divided by depth,
and each `Step` is how much they change per pixel. Dividing by depth for every pixel is what
keeps a texture from warping across a face, but it is only done every 8 pixels, with the texture
position stepped linearly in between, the same trade the client makes.

The texel position is packed into one integer, the column in its top 7 bits and the row in bits
7 to 13, so that one addition moves along both at once. The column is clamped to the texture
while the row wraps around it.

`shade` darkens each texel by the face's lighting. `opaque` is the texture's own flag: when it is
not set, texels that are `0` are holes and leave the pixel underneath alone.
*)
procedure TGraphics3D.TexturedRaster(baseIdx, leftX, rightX, shade, shadeStep, u, v, w, uStep, vStep, wStep: Integer; const texels: TIntegerArray; opaque: Boolean);
var
  pixelIdx, cameraX, depth, blocks, remaining, i,
  startU, startV, endU, endV,
  texelIdx, texelStep, texel, intensity, shaded: Integer;
begin
  if Self.RasterClipEnable then
  begin
    if rightX > Self.ClipWidth then rightX := Self.ClipWidth;
    if leftX < 0 then leftX := 0;
  end;

  if leftX >= rightX then Exit;

  pixelIdx := baseIdx + leftX;
  shade += leftX * shadeStep;
  cameraX := leftX - Self.CenterX;

  u += cameraX * ArithmeticShr(uStep, 3);
  v += ArithmeticShr(vStep, 3) * cameraX;
  w += cameraX * ArithmeticShr(wStep, 3);

  depth := ArithmeticShr(w, 14);
  startU := 0;
  startV := 0;
  if depth <> 0 then
  begin
    startU := EnsureRange(u div depth, 0, 16256);
    startV := v div depth;
  end;

  u += uStep;
  v += vStep;
  w += wStep;

  depth := ArithmeticShr(w, 14);
  endU := 0;
  endV := 0;
  if depth <> 0 then
  begin
    endU := EnsureRange(u div depth, 0, 16256);
    endV := v div depth;
  end;

  texelIdx := (startU shl 18) + startV;
  texelStep := ArithmeticShr(endV - startV, 3) + (ArithmeticShr(endU - startU, 3) shl 18);
  blocks := (rightX - leftX) shr 3;
  shadeStep := shadeStep shl 3;
  intensity := ArithmeticShr(shade, 8);

  for 1 to blocks do
  begin
    for i := 0 to 7 do
    begin
      texel := texels[(texelIdx and 16256) + (texelIdx shr 25)];
      if opaque or (texel <> 0) then
      begin
        shaded := ((((intensity * (texel and $FF00)) and $FF0000) + (((texel and $FF00FF) * intensity) and $FF00FF00)) shr 8) and $FFFFFF;
        if shaded <> 0 then
          shaded := shaded or $FF000000;
        Self.Pixels[pixelIdx] := shaded;
      end;
      Inc(pixelIdx);
      if i < 7 then
        texelIdx += texelStep;
    end;

    startU := endU;
    startV := endV;
    u += uStep;
    v += vStep;
    w += wStep;

    depth := ArithmeticShr(w, 14);
    endU := 0;
    endV := 0;
    if depth <> 0 then
    begin
      endU := EnsureRange(u div depth, 0, 16256);
      endV := v div depth;
    end;

    texelIdx := (startU shl 18) + startV;
    texelStep := ArithmeticShr(endV - startV, 3) + (ArithmeticShr(endU - startU, 3) shl 18);
    shade += shadeStep;
    intensity := ArithmeticShr(shade, 8);
  end;

  remaining := (rightX - leftX) and 7;
  for 1 to remaining do
  begin
    texel := texels[(texelIdx and 16256) + (texelIdx shr 25)];
    if opaque or (texel <> 0) then
    begin
      shaded := ((((intensity * (texel and $FF00)) and $FF0000) + (((texel and $FF00FF) * intensity) and $FF00FF00)) shr 8) and $FFFFFF;
      if shaded <> 0 then
        shaded := shaded or $FF000000;
      Self.Pixels[pixelIdx] := shaded;
    end;
    Inc(pixelIdx);
    texelIdx += texelStep;
  end;
end;

(*
## Graphics3D.TexturedTriangle
```pascal
procedure TGraphics3D.TexturedTriangle(y0, y1, y2, x0, x1, x2, c0, c1, c2, localX0, localX1, localX2, localY0, localY1, localY2, localZ0, localZ1, localZ2: Integer; const texels: TIntegerArray; opaque: Boolean);
```
Fills a triangle with a texture, perspective correct, and shaded by a lighting value at each
corner.

`x` and `y` are the corners on screen and `c` their lighting, as for
{ref}`TGraphics3D.GouraudTriangle`, except that `c` is a light level from `2` to `126` rather
than a palette index. The `local` coordinates are three points in camera space that set how the
texture lies across the face: the first is where the texture's origin sits and the other two are
where its edges run to. They are usually the face's own corners, but a model can stretch one
texture across several faces by pointing them all at the same three points.

`texels` is a 128 by 128 texture from {ref}`TTextureLoader.Texels` and `opaque` is its
{ref}`TTextureDefinition` flag.

The triangle is walked exactly like {ref}`TGraphics3D.GouraudTriangle`, carrying the texture
coordinates of the start of each scanline along with it for {ref}`TGraphics3D.TexturedRaster`.
*)
procedure TGraphics3D.TexturedTriangle(y0, y1, y2, x0, x1, x2, c0, c1, c2, localX0, localX1, localX2, localY0, localY1, localY2, localZ0, localZ1, localZ2: Integer; const texels: TIntegerArray; opaque: Boolean);
var
  dx1, dy1, dx2, dy2, dc1, dc2,
  slope0, slope1, slope2,
  area, shadeDX, shadeDY, pixelRow,
  uRow, uStepX, uStepY,
  vRow, vStepX, vStepY,
  wRow, wStepX, wStepY: Integer;
begin
  dx1 := x1 - x0;
  dy1 := y1 - y0;
  dx2 := x2 - x0;
  dy2 := y2 - y0;

  dc1 := c1 - c0;
  dc2 := c2 - c0;

  slope0 := 0;
  if y2 <> y1 then slope0 := ((x2 - x1) shl 14) div (y2 - y1);
  slope1 := 0;
  if y0 <> y1 then slope1 := (dx1 shl 14) div dy1;
  slope2 := 0;
  if y0 <> y2 then slope2 := (dx2 shl 14) div dy2;

  area := dx1 * dy2 - dx2 * dy1;
  if area = 0 then Exit;

  shadeDX := ((dc1 * dy2 - dc2 * dy1) shl 9) div area;
  shadeDY := ((dc2 * dx1 - dc1 * dx2) shl 9) div area;

  localX1 := localX0 - localX1;
  localY1 := localY0 - localY1;
  localZ1 := localZ0 - localZ1;
  localX2 -= localX0;
  localY2 -= localY0;
  localZ2 -= localZ0;

  uRow := (localX2 * localY0 - localX0 * localY2) shl 14;
  uStepX := (Int64(localZ0 * localY2 - localZ2 * localY0) shl 17) div Self.Zoom;
  uStepY := (Int64(localZ2 * localX0 - localX2 * localZ0) shl 14) div Self.Zoom;
  vRow := (localX1 * localY0 - localY1 * localX0) shl 14;
  vStepX := (Int64(localY1 * localZ0 - localZ1 * localY0) shl 17) div Self.Zoom;
  vStepY := (Int64(localZ1 * localX0 - localX1 * localZ0) shl 14) div Self.Zoom;
  wRow := (localY1 * localX2 - localX1 * localY2) shl 14;
  wStepX := (Int64(localZ1 * localY2 - localY1 * localZ2) shl 17) div Self.Zoom;
  wStepY := (Int64(localZ2 * localX1 - localX2 * localZ1) shl 14) div Self.Zoom;

  if (y0 <= y1) and (y0 <= y2) then
  begin
    if y0 >= Self.ClipHeight then Exit;
    if y1 > Self.ClipHeight then y1 := Self.ClipHeight;
    if y2 > Self.ClipHeight then y2 := Self.ClipHeight;

    c0 := shadeDX + ((c0 shl 9) - x0 * shadeDX);

    if y1 < y2 then
    begin
      x0 := x0 shl 14;
      x2 := x0;
      if y0 < 0 then
      begin
        x2 -= y0 * slope2;
        x0 -= y0 * slope1;
        c0 -= y0 * shadeDY;
        y0 := 0;
      end;

      x1 := x1 shl 14;
      if y1 < 0 then
      begin
        x1 -= slope0 * y1;
        y1 := 0;
      end;

      if ((y0 = y1) or (slope2 >= slope1)) and ((y0 <> y1) or (slope2 <= slope0)) then
      begin
        y2 -= y1;
        y1 -= y0;
        uRow += uStepY * (y0 - Self.CenterY);
        vRow += vStepY * (y0 - Self.CenterY);
        wRow += wStepY * (y0 - Self.CenterY);
        pixelRow := Self.ClipY[y0];

        while True do
        begin
          Dec(y1);
          if y1 < 0 then
            while True do
            begin
              Dec(y2);
              if y2 < 0 then Exit;
              Self.TexturedRaster(pixelRow, ArithmeticShr(x1, 14), ArithmeticShr(x2, 14), c0, shadeDX, uRow, vRow, wRow, uStepX, vStepX, wStepX, texels, opaque);
              x2 += slope2;
              x1 += slope0;
              c0 += shadeDY;
              uRow += uStepY;
              vRow += vStepY;
              wRow += wStepY;
              pixelRow += Self.PixelWidth;
            end;

          Self.TexturedRaster(pixelRow, ArithmeticShr(x0, 14), ArithmeticShr(x2, 14), c0, shadeDX, uRow, vRow, wRow, uStepX, vStepX, wStepX, texels, opaque);
          x2 += slope2;
          x0 += slope1;
          c0 += shadeDY;
          uRow += uStepY;
          vRow += vStepY;
          wRow += wStepY;
          pixelRow += Self.PixelWidth;
        end;
      end;

      y2 -= y1;
      y1 -= y0;
      uRow += uStepY * (y0 - Self.CenterY);
      vRow += vStepY * (y0 - Self.CenterY);
      wRow += wStepY * (y0 - Self.CenterY);
      pixelRow := Self.ClipY[y0];

      while True do
      begin
        Dec(y1);
        if y1 < 0 then
          while True do
          begin
            Dec(y2);
            if y2 < 0 then Exit;
            Self.TexturedRaster(pixelRow, ArithmeticShr(x2, 14), ArithmeticShr(x1, 14), c0, shadeDX, uRow, vRow, wRow, uStepX, vStepX, wStepX, texels, opaque);
            x2 += slope2;
            x1 += slope0;
            c0 += shadeDY;
            uRow += uStepY;
            vRow += vStepY;
            wRow += wStepY;
            pixelRow += Self.PixelWidth;
          end;

        Self.TexturedRaster(pixelRow, ArithmeticShr(x2, 14), ArithmeticShr(x0, 14), c0, shadeDX, uRow, vRow, wRow, uStepX, vStepX, wStepX, texels, opaque);
        x2 += slope2;
        x0 += slope1;
        c0 += shadeDY;
        uRow += uStepY;
        vRow += vStepY;
        wRow += wStepY;
        pixelRow += Self.PixelWidth;
      end;
    end;

    x0 := x0 shl 14;
    x1 := x0;
    if y0 < 0 then
    begin
      x1 -= y0 * slope2;
      x0 -= y0 * slope1;
      c0 -= y0 * shadeDY;
      y0 := 0;
    end;

    x2 := x2 shl 14;
    if y2 < 0 then
    begin
      x2 -= slope0 * y2;
      y2 := 0;
    end;

    if ((y0 <> y2) and (slope2 < slope1)) or ((y0 = y2) and (slope0 > slope1)) then
    begin
      y1 -= y2;
      y2 -= y0;
      uRow += uStepY * (y0 - Self.CenterY);
      vRow += vStepY * (y0 - Self.CenterY);
      wRow += wStepY * (y0 - Self.CenterY);
      pixelRow := Self.ClipY[y0];

      while True do
      begin
        Dec(y2);
        if y2 < 0 then
          while True do
          begin
            Dec(y1);
            if y1 < 0 then Exit;
            Self.TexturedRaster(pixelRow, ArithmeticShr(x2, 14), ArithmeticShr(x0, 14), c0, shadeDX, uRow, vRow, wRow, uStepX, vStepX, wStepX, texels, opaque);
            x2 += slope0;
            x0 += slope1;
            c0 += shadeDY;
            uRow += uStepY;
            vRow += vStepY;
            wRow += wStepY;
            pixelRow += Self.PixelWidth;
          end;

        Self.TexturedRaster(pixelRow, ArithmeticShr(x1, 14), ArithmeticShr(x0, 14), c0, shadeDX, uRow, vRow, wRow, uStepX, vStepX, wStepX, texels, opaque);
        x1 += slope2;
        x0 += slope1;
        c0 += shadeDY;
        uRow += uStepY;
        vRow += vStepY;
        wRow += wStepY;
        pixelRow += Self.PixelWidth;
      end;
    end;

    y1 -= y2;
    y2 -= y0;
    uRow += uStepY * (y0 - Self.CenterY);
    vRow += vStepY * (y0 - Self.CenterY);
    wRow += wStepY * (y0 - Self.CenterY);
    pixelRow := Self.ClipY[y0];

    while True do
    begin
      Dec(y2);
      if y2 < 0 then
        while True do
        begin
          Dec(y1);
          if y1 < 0 then Exit;
          Self.TexturedRaster(pixelRow, ArithmeticShr(x0, 14), ArithmeticShr(x2, 14), c0, shadeDX, uRow, vRow, wRow, uStepX, vStepX, wStepX, texels, opaque);
          x2 += slope0;
          x0 += slope1;
          c0 += shadeDY;
          uRow += uStepY;
          vRow += vStepY;
          wRow += wStepY;
          pixelRow += Self.PixelWidth;
        end;

      Self.TexturedRaster(pixelRow, ArithmeticShr(x0, 14), ArithmeticShr(x1, 14), c0, shadeDX, uRow, vRow, wRow, uStepX, vStepX, wStepX, texels, opaque);
      x1 += slope2;
      x0 += slope1;
      c0 += shadeDY;
      uRow += uStepY;
      vRow += vStepY;
      wRow += wStepY;
      pixelRow += Self.PixelWidth;
    end;
  end;

  if y1 <= y2 then
  begin
    if y1 >= Self.ClipHeight then Exit;
    if y2 > Self.ClipHeight then y2 := Self.ClipHeight;
    if y0 > Self.ClipHeight then y0 := Self.ClipHeight;

    c1 := shadeDX + ((c1 shl 9) - shadeDX * x1);

    if y2 < y0 then
    begin
      x1 := x1 shl 14;
      x0 := x1;
      if y1 < 0 then
      begin
        x0 -= slope1 * y1;
        x1 -= slope0 * y1;
        c1 -= shadeDY * y1;
        y1 := 0;
      end;

      x2 := x2 shl 14;
      if y2 < 0 then
      begin
        x2 -= slope2 * y2;
        y2 := 0;
      end;

      if ((y2 = y1) or (slope1 >= slope0)) and ((y2 <> y1) or (slope1 <= slope2)) then
      begin
        y0 -= y2;
        y2 -= y1;
        uRow += uStepY * (y1 - Self.CenterY);
        vRow += vStepY * (y1 - Self.CenterY);
        wRow += wStepY * (y1 - Self.CenterY);
        pixelRow := Self.ClipY[y1];

        while True do
        begin
          Dec(y2);
          if y2 < 0 then
            while True do
            begin
              Dec(y0);
              if y0 < 0 then Exit;
              Self.TexturedRaster(pixelRow, ArithmeticShr(x2, 14), ArithmeticShr(x0, 14), c1, shadeDX, uRow, vRow, wRow, uStepX, vStepX, wStepX, texels, opaque);
              x0 += slope1;
              x2 += slope2;
              c1 += shadeDY;
              uRow += uStepY;
              vRow += vStepY;
              wRow += wStepY;
              pixelRow += Self.PixelWidth;
            end;

          Self.TexturedRaster(pixelRow, ArithmeticShr(x1, 14), ArithmeticShr(x0, 14), c1, shadeDX, uRow, vRow, wRow, uStepX, vStepX, wStepX, texels, opaque);
          x0 += slope1;
          x1 += slope0;
          c1 += shadeDY;
          uRow += uStepY;
          vRow += vStepY;
          wRow += wStepY;
          pixelRow += Self.PixelWidth;
        end;
      end;

      y0 -= y2;
      y2 -= y1;
      uRow += uStepY * (y1 - Self.CenterY);
      vRow += vStepY * (y1 - Self.CenterY);
      wRow += wStepY * (y1 - Self.CenterY);
      pixelRow := Self.ClipY[y1];

      while True do
      begin
        Dec(y2);
        if y2 < 0 then
          while True do
          begin
            Dec(y0);
            if y0 < 0 then Exit;
            Self.TexturedRaster(pixelRow, ArithmeticShr(x0, 14), ArithmeticShr(x2, 14), c1, shadeDX, uRow, vRow, wRow, uStepX, vStepX, wStepX, texels, opaque);
            x0 += slope1;
            x2 += slope2;
            c1 += shadeDY;
            uRow += uStepY;
            vRow += vStepY;
            wRow += wStepY;
            pixelRow += Self.PixelWidth;
          end;

        Self.TexturedRaster(pixelRow, ArithmeticShr(x0, 14), ArithmeticShr(x1, 14), c1, shadeDX, uRow, vRow, wRow, uStepX, vStepX, wStepX, texels, opaque);
        x0 += slope1;
        x1 += slope0;
        c1 += shadeDY;
        uRow += uStepY;
        vRow += vStepY;
        wRow += wStepY;
        pixelRow += Self.PixelWidth;
      end;
    end;

    x1 := x1 shl 14;
    x2 := x1;
    if y1 < 0 then
    begin
      x2 -= slope1 * y1;
      x1 -= slope0 * y1;
      c1 -= shadeDY * y1;
      y1 := 0;
    end;

    x0 := x0 shl 14;
    if y0 < 0 then
    begin
      x0 -= y0 * slope2;
      y0 := 0;
    end;

    if slope1 < slope0 then
    begin
      y2 -= y0;
      y0 -= y1;
      uRow += uStepY * (y1 - Self.CenterY);
      vRow += vStepY * (y1 - Self.CenterY);
      wRow += wStepY * (y1 - Self.CenterY);
      pixelRow := Self.ClipY[y1];

      while True do
      begin
        Dec(y0);
        if y0 < 0 then
          while True do
          begin
            Dec(y2);
            if y2 < 0 then Exit;
            Self.TexturedRaster(pixelRow, ArithmeticShr(x0, 14), ArithmeticShr(x1, 14), c1, shadeDX, uRow, vRow, wRow, uStepX, vStepX, wStepX, texels, opaque);
            x0 += slope2;
            x1 += slope0;
            c1 += shadeDY;
            uRow += uStepY;
            vRow += vStepY;
            wRow += wStepY;
            pixelRow += Self.PixelWidth;
          end;

        Self.TexturedRaster(pixelRow, ArithmeticShr(x2, 14), ArithmeticShr(x1, 14), c1, shadeDX, uRow, vRow, wRow, uStepX, vStepX, wStepX, texels, opaque);
        x2 += slope1;
        x1 += slope0;
        c1 += shadeDY;
        uRow += uStepY;
        vRow += vStepY;
        wRow += wStepY;
        pixelRow += Self.PixelWidth;
      end;
    end;

    y2 -= y0;
    y0 -= y1;
    uRow += uStepY * (y1 - Self.CenterY);
    vRow += vStepY * (y1 - Self.CenterY);
    wRow += wStepY * (y1 - Self.CenterY);
    pixelRow := Self.ClipY[y1];

    while True do
    begin
      Dec(y0);
      if y0 < 0 then
        while True do
        begin
          Dec(y2);
          if y2 < 0 then Exit;
          Self.TexturedRaster(pixelRow, ArithmeticShr(x1, 14), ArithmeticShr(x0, 14), c1, shadeDX, uRow, vRow, wRow, uStepX, vStepX, wStepX, texels, opaque);
          x0 += slope2;
          x1 += slope0;
          c1 += shadeDY;
          uRow += uStepY;
          vRow += vStepY;
          wRow += wStepY;
          pixelRow += Self.PixelWidth;
        end;

      Self.TexturedRaster(pixelRow, ArithmeticShr(x1, 14), ArithmeticShr(x2, 14), c1, shadeDX, uRow, vRow, wRow, uStepX, vStepX, wStepX, texels, opaque);
      x2 += slope1;
      x1 += slope0;
      c1 += shadeDY;
      uRow += uStepY;
      vRow += vStepY;
      wRow += wStepY;
      pixelRow += Self.PixelWidth;
    end;
  end;

  if y2 >= Self.ClipHeight then Exit;
  if y0 > Self.ClipHeight then y0 := Self.ClipHeight;
  if y1 > Self.ClipHeight then y1 := Self.ClipHeight;

  c2 := shadeDX + ((c2 shl 9) - x2 * shadeDX);

  if y0 < y1 then
  begin
    x2 := x2 shl 14;
    x1 := x2;
    if y2 < 0 then
    begin
      x1 -= slope0 * y2;
      x2 -= slope2 * y2;
      c2 -= shadeDY * y2;
      y2 := 0;
    end;

    x0 := x0 shl 14;
    if y0 < 0 then
    begin
      x0 -= y0 * slope1;
      y0 := 0;
    end;

    if slope0 < slope2 then
    begin
      y1 -= y0;
      y0 -= y2;
      uRow += uStepY * (y2 - Self.CenterY);
      vRow += vStepY * (y2 - Self.CenterY);
      wRow += wStepY * (y2 - Self.CenterY);
      pixelRow := Self.ClipY[y2];

      while True do
      begin
        Dec(y0);
        if y0 < 0 then
          while True do
          begin
            Dec(y1);
            if y1 < 0 then Exit;
            Self.TexturedRaster(pixelRow, ArithmeticShr(x1, 14), ArithmeticShr(x0, 14), c2, shadeDX, uRow, vRow, wRow, uStepX, vStepX, wStepX, texels, opaque);
            x1 += slope0;
            x0 += slope1;
            c2 += shadeDY;
            uRow += uStepY;
            vRow += vStepY;
            wRow += wStepY;
            pixelRow += Self.PixelWidth;
          end;

        Self.TexturedRaster(pixelRow, ArithmeticShr(x1, 14), ArithmeticShr(x2, 14), c2, shadeDX, uRow, vRow, wRow, uStepX, vStepX, wStepX, texels, opaque);
        x1 += slope0;
        x2 += slope2;
        c2 += shadeDY;
        uRow += uStepY;
        vRow += vStepY;
        wRow += wStepY;
        pixelRow += Self.PixelWidth;
      end;
    end;

    y1 -= y0;
    y0 -= y2;
    uRow += uStepY * (y2 - Self.CenterY);
    vRow += vStepY * (y2 - Self.CenterY);
    wRow += wStepY * (y2 - Self.CenterY);
    pixelRow := Self.ClipY[y2];

    while True do
    begin
      Dec(y0);
      if y0 < 0 then
        while True do
        begin
          Dec(y1);
          if y1 < 0 then Exit;
          Self.TexturedRaster(pixelRow, ArithmeticShr(x0, 14), ArithmeticShr(x1, 14), c2, shadeDX, uRow, vRow, wRow, uStepX, vStepX, wStepX, texels, opaque);
          x1 += slope0;
          x0 += slope1;
          c2 += shadeDY;
          uRow += uStepY;
          vRow += vStepY;
          wRow += wStepY;
          pixelRow += Self.PixelWidth;
        end;

      Self.TexturedRaster(pixelRow, ArithmeticShr(x2, 14), ArithmeticShr(x1, 14), c2, shadeDX, uRow, vRow, wRow, uStepX, vStepX, wStepX, texels, opaque);
      x1 += slope0;
      x2 += slope2;
      c2 += shadeDY;
      uRow += uStepY;
      vRow += vStepY;
      wRow += wStepY;
      pixelRow += Self.PixelWidth;
    end;
  end;

  x2 := x2 shl 14;
  x0 := x2;
  if y2 < 0 then
  begin
    x0 -= slope0 * y2;
    x2 -= slope2 * y2;
    c2 -= shadeDY * y2;
    y2 := 0;
  end;

  x1 := x1 shl 14;
  if y1 < 0 then
  begin
    x1 -= slope1 * y1;
    y1 := 0;
  end;

  if slope0 < slope2 then
  begin
    y0 -= y1;
    y1 -= y2;
    uRow += uStepY * (y2 - Self.CenterY);
    vRow += vStepY * (y2 - Self.CenterY);
    wRow += wStepY * (y2 - Self.CenterY);
    pixelRow := Self.ClipY[y2];

    while True do
    begin
      Dec(y1);
      if y1 < 0 then
        while True do
        begin
          Dec(y0);
          if y0 < 0 then Exit;
          Self.TexturedRaster(pixelRow, ArithmeticShr(x1, 14), ArithmeticShr(x2, 14), c2, shadeDX, uRow, vRow, wRow, uStepX, vStepX, wStepX, texels, opaque);
          x1 += slope1;
          x2 += slope2;
          c2 += shadeDY;
          uRow += uStepY;
          vRow += vStepY;
          wRow += wStepY;
          pixelRow += Self.PixelWidth;
        end;

      Self.TexturedRaster(pixelRow, ArithmeticShr(x0, 14), ArithmeticShr(x2, 14), c2, shadeDX, uRow, vRow, wRow, uStepX, vStepX, wStepX, texels, opaque);
      x0 += slope0;
      x2 += slope2;
      c2 += shadeDY;
      uRow += uStepY;
      vRow += vStepY;
      wRow += wStepY;
      pixelRow += Self.PixelWidth;
    end;
  end;

  y0 -= y1;
  y1 -= y2;
  uRow += uStepY * (y2 - Self.CenterY);
  vRow += vStepY * (y2 - Self.CenterY);
  wRow += wStepY * (y2 - Self.CenterY);
  pixelRow := Self.ClipY[y2];

  while True do
  begin
    Dec(y1);
    if y1 < 0 then
      while True do
      begin
        Dec(y0);
        if y0 < 0 then Exit;
        Self.TexturedRaster(pixelRow, ArithmeticShr(x2, 14), ArithmeticShr(x1, 14), c2, shadeDX, uRow, vRow, wRow, uStepX, vStepX, wStepX, texels, opaque);
        x1 += slope1;
        x2 += slope2;
        c2 += shadeDY;
        uRow += uStepY;
        vRow += vStepY;
        wRow += wStepY;
        pixelRow += Self.PixelWidth;
      end;

    Self.TexturedRaster(pixelRow, ArithmeticShr(x2, 14), ArithmeticShr(x0, 14), c2, shadeDX, uRow, vRow, wRow, uStepX, vStepX, wStepX, texels, opaque);
    x0 += slope0;
    x2 += slope2;
    c2 += shadeDY;
    uRow += uStepY;
    vRow += vStepY;
    wRow += wStepY;
    pixelRow += Self.PixelWidth;
  end;
end;
