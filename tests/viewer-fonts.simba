{.$DEFINE DISABLE_CACHEREADER_RANGE_CHECKS}
{$I WaspLib/utils/cache-reader/cache.simba}

const
  GRID_COLS = 16;
  PADDING = 2;

var
  fontDef: TFontDefinition;
  i, idx, row, col: Integer;
  maxW, maxH, cellW, cellH: Integer;
  glyphImg, img: TImage;
begin
  CacheReader := TCacheReader.Create();
  FontLoader.Load();

  while True do
  begin
    i := ShowComboDialog('Font viewer', 'Pick a font:', TFontLoader.NAMES);
    if i < 0 then
      Break;

    maxW := 0;
    maxH := 0;

    fontDef := FontLoader.Fonts[i];

    for idx := 0 to 255 do
    begin
      if fontDef.Glyphs[idx].Width > maxW then
        maxW := fontDef.Glyphs[idx].Width;
      if fontDef.Glyphs[idx].Height > maxH then
        maxH := fontDef.Glyphs[idx].Height;
    end;

    cellW := maxW + PADDING;
    cellH := maxH + PADDING;

    img := new TImage(GRID_COLS * cellW, ((256 div GRID_COLS) + 1) * cellH);

    for idx := 0 to 255 do
    begin
      row := idx div GRID_COLS;
      col := idx mod GRID_COLS;

      if (fontDef.Glyphs[idx].Width = 0) or (fontDef.Glyphs[idx].Height = 0) then
        Continue;

      glyphImg := fontDef.GetGlyphImage(idx);
      img.DrawImage(glyphImg, [col * cellW, row * cellH]);
    end;

    img.Show();
  end;
end.
