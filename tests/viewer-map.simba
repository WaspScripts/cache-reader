{$DEFINE ENABLE_CACHEREADER_RANGE_CHECKS}
{$I WaspLib/utils/cache-reader/cache.simba}

var
  zSpinner, x1Spinner, y1Spinner, x2Spinner, y2Spinner, iterSpinner: TLazSpinEdit;
  combobox: TLazComboBox;
  chunkLoader: TMapChunkLoader;

procedure ShowImage(sender: TLazObject);
var
  img: TImage;
  t: Double;
  bounds: TBox;
  iterations, x, y, chunks: Integer;
begin
  iterations := iterSpinner.Value;

  //for 1 to iterations do img := chunkLoader.GetChunksImage([x1Spinner.Value, y1Spinner.Value, x2Spinner.Value, y2Spinner.Value], zSpinner.Value);

  t := PerformanceTime();
  for 1 to iterations do
    img := chunkLoader.GetChunksImage([x1Spinner.Value, y1Spinner.Value, x2Spinner.Value, y2Spinner.Value], zSpinner.Value);
  t := PerformanceTime() - t;
  WriteLn('Took: ', Round(t, 3), 'ms to run ', iterations, ' times (', Round(t / iterations, 3), 'ms each).');

  bounds := [x1Spinner.Value, y1Spinner.Value, x2Spinner.Value, y2Spinner.Value];
  bounds := bounds.Normalize();
  chunks := bounds.Width * bounds.Height;
  WriteLn('Loaded ', chunks, ' chunks (', Round(t / iterations / chunks, 3), 'ms per chunk).');
  img.Show();
end;

procedure OnBrightnessChange(sender: TLazObject);
const
  LEVELS: TSingleArray = [0.9, 0.8, 0.7, 0.6, 0.5];
var
  i: Integer;
begin
  i := TLazComboBox(sender).ItemIndex;
  ColorUtils.SetBrightness(LEVELS[i]);
end;

var
  form: TLazForm;
  lbl: TLazLabel;
  btn: TLazButton;
begin
  CacheReader := TCacheReader.Create();
  CacheReader.Indices[ECacheIndex.MAPS].Cache();

  chunkLoader.MapData.Load();

  form := TLazForm.Create();
  form.Height := 300;
  form.Position := ELazFormPosition.DesktopCenter;

  combobox := TLazComboBox.Create(form);
  combobox.Parent := form;
  combobox.Top := 50;
  combobox.Left := 20;
  combobox.Width := 80;
  combobox.Items.AddStrings(['Min', 'Low', 'Med', 'High', 'Max']);
  combobox.Style := ELazComboBoxStyle.DropDownList;
  combobox.ItemIndex := 4;
  combobox.OnChange := @OnBrightnessChange;

  lbl := TLazLabel.Create(form);
  lbl.Parent := form;
  lbl.Caption := 'Brightness:';
  lbl.AnchorSideBottom.Control := combobox;
  lbl.AnchorSideBottom.Side := ELazAnchorSideReference.Top;
  lbl.AnchorSideLeft.Control := combobox;
  lbl.AnchorSideLeft.Side := ELazAnchorSideReference.Top;
  lbl.Anchors := [ELazAnchorKind.Bottom, ELazAnchorKind.Left];

  iterSpinner := TLazSpinEdit.Create(form);
  iterSpinner.Parent := form;
  iterSpinner.Top := 50;
  iterSpinner.Left := 120;
  iterSpinner.MinValue := 1;
  iterSpinner.MaxValue := 10000;
  iterSpinner.Value := 100;

  lbl := TLazLabel.Create(form);
  lbl.Parent := form;
  lbl.Caption := 'Iterations:';
  lbl.AnchorSideBottom.Control := iterSpinner;
  lbl.AnchorSideBottom.Side := ELazAnchorSideReference.Top;
  lbl.AnchorSideLeft.Control := iterSpinner;
  lbl.AnchorSideLeft.Side := ELazAnchorSideReference.Top;
  lbl.Anchors := [ELazAnchorKind.Bottom, ELazAnchorKind.Left];

  zSpinner := TLazSpinEdit.Create(form);
  zSpinner.Parent := form;
  zSpinner.Top := 100;
  zSpinner.Left := 20;
  zSpinner.MinValue := 0;
  zSpinner.MaxValue := 3;
  zSpinner.Value := 0;

  lbl := TLazLabel.Create(form);
  lbl.Parent := form;
  lbl.Caption := 'Z:';
  lbl.AnchorSideBottom.Control := zSpinner;
  lbl.AnchorSideBottom.Side := ELazAnchorSideReference.Top;
  lbl.AnchorSideLeft.Control := zSpinner;
  lbl.AnchorSideLeft.Side := ELazAnchorSideReference.Top;
  lbl.Anchors := [ELazAnchorKind.Bottom, ELazAnchorKind.Left];

  x1Spinner := TLazSpinEdit.Create(form);
  x1Spinner.Parent := form;
  x1Spinner.Top := 150;
  x1Spinner.Left := 20;
  x1Spinner.MinValue := 0;
  x1Spinner.MaxValue := 99;
  x1Spinner.Value := 50;

  lbl := TLazLabel.Create(form);
  lbl.Parent := form;
  lbl.Caption := 'X1:';
  lbl.AnchorSideBottom.Control := x1Spinner;
  lbl.AnchorSideBottom.Side := ELazAnchorSideReference.Top;
  lbl.AnchorSideLeft.Control := x1Spinner;
  lbl.AnchorSideLeft.Side := ELazAnchorSideReference.Top;
  lbl.Anchors := [ELazAnchorKind.Bottom, ELazAnchorKind.Left];

  y1Spinner := TLazSpinEdit.Create(form);
  y1Spinner.Parent := form;
  y1Spinner.Top := 200;
  y1Spinner.Left := 20;
  y1Spinner.MinValue := 0;
  y1Spinner.MaxValue := 199;
  y1Spinner.Value := 50;

  lbl := TLazLabel.Create(form);
  lbl.Parent := form;
  lbl.Caption := 'Y1:';
  lbl.AnchorSideBottom.Control := y1Spinner;
  lbl.AnchorSideBottom.Side := ELazAnchorSideReference.Top;
  lbl.AnchorSideLeft.Control := y1Spinner;
  lbl.AnchorSideLeft.Side := ELazAnchorSideReference.Top;
  lbl.Anchors := [ELazAnchorKind.Bottom, ELazAnchorKind.Left];


  x2Spinner := TLazSpinEdit.Create(form);
  x2Spinner.Parent := form;
  x2Spinner.Top := 150;
  x2Spinner.Left := 120;
  x2Spinner.MinValue := 0;
  x2Spinner.MaxValue := 99;
  x2Spinner.Value := 50;

  lbl := TLazLabel.Create(form);
  lbl.Parent := form;
  lbl.Caption := 'X2:';
  lbl.AnchorSideBottom.Control := x2Spinner;
  lbl.AnchorSideBottom.Side := ELazAnchorSideReference.Top;
  lbl.AnchorSideLeft.Control := x2Spinner;
  lbl.AnchorSideLeft.Side := ELazAnchorSideReference.Top;
  lbl.Anchors := [ELazAnchorKind.Bottom, ELazAnchorKind.Left];

  y2Spinner := TLazSpinEdit.Create(form);
  y2Spinner.Parent := form;
  y2Spinner.Top := 200;
  y2Spinner.Left := 120;
  y2Spinner.MinValue := 0;
  y2Spinner.MaxValue := 199;
  y2Spinner.Value := 50;

  lbl := TLazLabel.Create(form);
  lbl.Parent := form;
  lbl.Caption := 'Y2:';
  lbl.AnchorSideBottom.Control := y2Spinner;
  lbl.AnchorSideBottom.Side := ELazAnchorSideReference.Top;
  lbl.AnchorSideLeft.Control := y2Spinner;
  lbl.AnchorSideLeft.Side := ELazAnchorSideReference.Top;
  lbl.Anchors := [ELazAnchorKind.Bottom, ELazAnchorKind.Left];

  btn := TLazButton.Create(form);
  btn.Parent := form;
  btn.Top := 250;
  btn.Left := 20;
  btn.Width := 200;
  btn.Caption := 'Render and show';
  btn.OnClick := @ShowImage;

  form.Show();
  while form.Showing do
    Sleep(100);
end.
