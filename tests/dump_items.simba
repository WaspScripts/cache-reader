{$I WaspLib/utils.simba}

var
  PATH: String = SimbaEnv.DataPath + 'items-db' + PATH_SEP;

var
  rows: Integer;
  start: Double;
begin
  ClearSimbaOutput();

  CacheReader := TCacheReader.Create();

  start := PerformanceTime();
  rows := ItemLoader.WriteDatabase(PATH);

  WriteLn('Saved ', rows, ' rows to ', PATH);
  WriteLn('Took ', Round(PerformanceTime()-start, 3), 'ms to run.');
end.
