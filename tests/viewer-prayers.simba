{.$DEFINE DISABLE_CACHEREADER_RANGE_CHECKS}
{$I WaspLib/utils/cache-reader/cache.simba}

const
  //the enums the client picks the prayer tab's contents from, each listing one item per prayer keyed
  //by its slot in the tab. 4956 is the standard prayer book, 3341, 3342 and 3343 are the same book
  //with Deadeye, Mystic Vigour or both replacing Eagle Eye and Mystic Might once unlocked.
  PRAYER_ENUMS: array [0..3] of Integer = [4956, 3341, 3342, 3343];

  PRAYER_NAME_PARAM   = 1752;
  PRAYER_LEVEL_PARAM  = 1753;
  //1757=usable, 1756=locked
  PRAYER_SPRITE_PARAM = 1757;

  GRID_COLS = 6;
var
  enumArchive, itemArchive: TArchive;
  enumDef: TEnumDefinition;
  itemDef: TItemDefinition;
  spriteSector: TArchiveSector;
  spriteData: TByteArray;
  sprites: TSpriteDefinitionArray;

  i, j, itemId, spriteId, level, enumId: Integer;
  name: String;
  glyphImg, gridImg: TImage;
  cellW, cellH, row, col, count: Integer;
  spriteList: array of TSpriteDefinition;
  seen: TIntegerArray;
begin
  CacheReader := TCacheReader.Create();
  CacheReader.Indices[ECacheIndex.CONFIGS].Cache();

  enumArchive := CacheReader.Indices[ECacheIndex.CONFIGS].ReferenceTable.Archives.Value[EConfigArchive.ENUMS];
  itemArchive := CacheReader.Indices[ECacheIndex.CONFIGS].ReferenceTable.Archives.Value[EConfigArchive.ITEM];

  for enumId in PRAYER_ENUMS do
  begin
    enumDef := TEnumDefinition.Create(enumId, enumArchive.Files.Value[enumId].Data);

    for i := 0 to enumDef.Size - 1 do
    begin
      itemId := enumDef.IntVals[i];

      //the enums share most of their prayers, only keep each one once
      if itemId in seen then
        Continue;
      seen += itemId;

      itemDef := TItemDefinition.Create(itemId, itemArchive.Files.Value[itemId].Data);

      name := '';
      level := -1;
      spriteId := -1;
      for j := 0 to High(itemDef.Params) do
        case itemDef.Params[j].Key of
          PRAYER_NAME_PARAM:   name := itemDef.Params[j].StrValue;
          PRAYER_LEVEL_PARAM:  level := itemDef.Params[j].IntValue;
          PRAYER_SPRITE_PARAM: spriteId := itemDef.Params[j].IntValue;
        end;

      WriteLn(name, ' (level ', level, ', item ', itemId, ', sprite ', spriteId, ')');

      if spriteId = -1 then
        Continue;

      spriteSector := CacheReader.Indices[ECacheIndex.SPRITES].ReadArchiveSector(
        spriteId, CacheReader.Indices[ECacheIndex.SPRITES].ID, CacheReader.Indices[ECacheIndex.SPRITES].IndexData
      );

      if Length(spriteSector.Data) = 0 then
        Continue;

      spriteData := spriteSector.Decompress();
      sprites := TSpriteDefinition.Create(spriteId, spriteData);

      count := Length(spriteList);
      SetLength(spriteList, count + 1);
      spriteList[count] := sprites[0];
    end;
  end;

  WriteLn('Found ', Length(spriteList), ' prayers.');

  if Length(spriteList) = 0 then
    Exit;

  cellW := 1;
  cellH := 1;
  for i := 0 to High(spriteList) do
  begin
    if spriteList[i].Width > cellW then cellW := spriteList[i].Width;
    if spriteList[i].Height > cellH then cellH := spriteList[i].Height;
  end;
  Inc(cellW, 4);
  Inc(cellH, 4);

  gridImg := new TImage(GRID_COLS * cellW, ((Length(spriteList) + GRID_COLS - 1) div GRID_COLS) * cellH);

  for i := 0 to High(spriteList) do
  begin
    if (spriteList[i].Width = 0) or (spriteList[i].Height = 0) then
      Continue;

    row := i div GRID_COLS;
    col := i mod GRID_COLS;

    glyphImg := spriteList[i].ToImage();
    gridImg.DrawImage(glyphImg, [col * cellW + (cellW - glyphImg.Width) div 2, row * cellH + (cellH - glyphImg.Height) div 2]);
  end;

  gridImg.Show();
end.
