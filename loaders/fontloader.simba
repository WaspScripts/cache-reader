(*
# Font Loader
Loads {ref}`FontDefinitions`.
*)

{$DEFINE WL_CACHE_LOADER_FONTS_INCLUDED}
{$IFNDEF WL_CACHE_READER_INCLUDED}             {$INCLUDE_ONCE ../reader/reader.simba}      {$ENDIF}
{$IFNDEF WL_CACHE_DEFINITION_FONTS_INCLUDED}   {$INCLUDE_ONCE ../definitions/fonts.simba}  {$ENDIF}

type
  TFontLoader = record
    Fonts: TFontDefinitionArray;
    const
    NAMES: TStringArray = [
      'p11_full', 'p12_full',
      'b12_full',
      'verdana_11pt_regular', 'verdana_13pt_regular', 'verdana_15pt_regular'
    ];
  end;

procedure TFontLoader.Load();
var
  fontIndex, spriteIndex: TCacheIndex;
  i: Integer;
  name: String;
  fontArchiveID, spritesArchiveID: Integer;
  archive: TArchive;
  sector: TArchiveSector;
  data: TByteArray;
  definition: TFontDefinition;
begin
  CacheReader.Indices[ECacheIndex.FONTS].Cache();
  SetLength(Self.Fonts, Length(TFontLoader.NAMES));

  fontIndex := CacheReader.Indices[ECacheIndex.FONTS];
  spriteIndex := CacheReader.Indices[ECacheIndex.SPRITES];

  for i := 0 to High(TFontLoader.NAMES) do
  begin
    name := TFontLoader.NAMES[i];

    fontArchiveID := fontIndex.ReferenceTable.ArchiveID(name);
    spritesArchiveID := spriteIndex.ReferenceTable.ArchiveID(name);

    archive := fontIndex.ReferenceTable.Archives.Value[fontArchiveId];

    sector := spriteIndex.ReadArchiveSector(spritesArchiveID, spriteIndex.ID, spriteIndex.IndexData);
    data := sector.Decompress();

    Self.Fonts[i] := TFontDefinition.Create(archive.HashName, archive.Files.Value[0].Data, data);
  end;
end;

var
  FontLoader: TFontLoader;
