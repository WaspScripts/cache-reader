(*
# NPC Loader
Reads NPC definitions out of the cache as they are needed, works out what the ones that change
form are shown as, and builds the NPC database WaspLib looks NPCs up in by name.
*)

{$DEFINE WL_CACHE_LOADER_NPCS_INCLUDED}
{$IFNDEF WL_CACHE_READER_INCLUDED}               {$INCLUDE_ONCE ../reader/reader.simba}         {$ENDIF}
{$IFNDEF WL_CACHE_DEFINITION_NPCS_INCLUDED}      {$INCLUDE_ONCE ../definitions/npcs.simba}      {$ENDIF}

type
  TNPCLoader = record
    Archive: TArchive;
    //indexed by NPC id, and only filled in for the NPCs TNPCLoader.Get was asked for
    Definitions: TNPCDefinitionArray;
    Decoded: TBooleanArray;
    IsLoaded: Boolean;
  end;

(*
## TNPCLoader.Load
```pascal
procedure TNPCLoader.Load();
```
Caches the NPC archive of the config index and makes room in `TNPCLoader.Definitions` for every
NPC id. No NPC is decoded until {ref}`TNPCLoader.Get` asks for it. Does nothing once loaded.

The archive is compressed as a whole, so it is unpacked in full even when only a few NPCs are
needed; decoding them is what's left for later.
*)
procedure TNPCLoader.Load();
begin
  if Self.IsLoaded then
    Exit;

  CacheReader.Indices[ECacheIndex.CONFIGS].Cache(EConfigArchive.NPC);
  Self.Archive := CacheReader.Indices[ECacheIndex.CONFIGS].ReferenceTable.Archives.Value[EConfigArchive.NPC];

  SetLength(Self.Definitions, Self.Archive.Files.Keys[High(Self.Archive.Files.Keys)] + 1);
  SetLength(Self.Decoded, Length(Self.Definitions));

  Self.IsLoaded := True;
end;

(*
## TNPCLoader.Get
```pascal
function TNPCLoader.Get(id: Integer): TNPCDefinition;
```
The definition of NPC `id`, decoded the first time it is asked for and kept in
`TNPCLoader.Definitions` from then on. Loads the archive first with {ref}`TNPCLoader.Load` if it
isn't yet.
*)
function TNPCLoader.Get(id: Integer): TNPCDefinition;
begin
  Self.Load();

  if not Self.Decoded[id] then
  begin
    Self.Definitions[id] := TNPCDefinition.Create(id, Self.Archive.Revision, Self.Archive.Files.Value[id].Data);
    Self.Decoded[id] := True;
  end;

  Result := Self.Definitions[id];
end;

(*
## TNPCLoader.Resolve
```pascal
function TNPCLoader.Resolve(id: Integer): TNPCDefinition;
```
The definition NPC `id` is shown as.

Some NPCs change with the player's progress and spawn as a stand-in whose definition only lists
what it can turn into. Those are shown as the first of their forms that has a name, or as
themselves if none of them has one. A name of `null`, or an empty one, doesn't count as a name.
Only the forms looked at are decoded.
*)
function TNPCLoader.Resolve(id: Integer): TNPCDefinition;
var
  child: Integer;
  def: TNPCDefinition;
begin
  Result := Self.Get(id);

  for child in Result.ConfigChangeDest do
  begin
    if Self.Definitions.IndexOf(child) = -1 then
      Continue;

    def := Self.Get(child);
    if (def.Name <> 'null') and (def.Name <> '') then
      Exit(def);
  end;
end;

(*
## TNPCLoader.WriteDatabase
```pascal
function TNPCLoader.WriteDatabase(path: String): Integer;
```
Writes the NPC database into `path` as two column files, `name.txt` and `id.txt`, where line `N`
of each belongs to row `N`. There is a row for every NPC id that has a name as shown by
{ref}`TNPCLoader.Resolve`, in id order, so a name with several ids has a row for
each. Names keep the case the game shows them in. Creates `path` if it doesn't exist and returns
how many rows were written.

This decodes every NPC.

Example:
```pascal
CacheReader := TCacheReader.Create();
NPCLoader.WriteDatabase('C:/npcs-db/');
```
*)
function TNPCLoader.WriteDatabase(path: String): Integer;
var
  names, ids: TStringArray;
  id: Integer;
  def: TNPCDefinition;
begin
  Self.Load();

  if not path.EndsWith(PATH_SEP) then
    path += PATH_SEP;

  if not DirCreate(path) then
    raise 'TNPCLoader: Couldn''t create ' + path;

  for id in Self.Archive.Files.Keys do
  begin
    def := Self.Resolve(id);
    if (def.Name = 'null') or (def.Name = '') then
      Continue;

    names += CacheString2UTF8(def.Name);
    ids += ToStr(id);
  end;

  if not FileWrite(path + 'name.txt', names.Join(LINE_SEP) + LINE_SEP) then
    raise 'TNPCLoader: Couldn''t write ' + path + 'name.txt';
  if not FileWrite(path + 'id.txt', ids.Join(LINE_SEP) + LINE_SEP) then
    raise 'TNPCLoader: Couldn''t write ' + path + 'id.txt';

  Result := Length(ids);
end;

var
  NPCLoader: TNPCLoader;
