(*
# Region
One 64 by 64 tile square of the world, expanded from the cache into the per-plane arrays the map
renderer walks: heights, settings, ground overlays and underlays, and the objects standing on it.
*)

{$DEFINE WL_CACHE_REGION_INCLUDED}

{$IFNDEF WL_CACHE_DEFINITION_MAP_INCLUDED}       {$INCLUDE_ONCE ../../definitions/map.simba}       {$ENDIF}
{$IFNDEF WL_CACHE_DEFINITION_LOCATIONS_INCLUDED} {$INCLUDE_ONCE ../../definitions/locations.simba} {$ENDIF}
{$IFNDEF WL_CACHE_HEIGHTCALC_INCLUDED}           {$INCLUDE_ONCE ../../utils/heightcalc.simba}      {$ENDIF}

type
  TWorldLocation = record
    ID, LocType, Orientation: Integer;
    X, Y, Z: Integer;
  end;

  TWorldLocationArray = array of TWorldLocation;

  TRegion = record
    RegionID, BaseX, BaseY, X, Y: Integer;

    TileHeights, TileSettings,
    OverlayIds, OverlayPaths, OverlayRotations,
    UnderlayIds: array of TIntegerMatrix;

    Locations: array of TWorldLocation;
  end;

(*
## Region._InitArrays
```pascal
procedure TRegion._InitArrays();
```
Allocates the region's per-plane tile arrays - 4 planes of 64 by 64, indexed `[z, x, y]`.
*)
procedure TRegion._InitArrays();
begin
  SetLength(Self.TileHeights, 4, 64, 64);
  SetLength(Self.TileSettings, 4, 64, 64);
  SetLength(Self.OverlayIds, 4, 64, 64);
  SetLength(Self.OverlayPaths, 4, 64, 64);
  SetLength(Self.OverlayRotations, 4, 64, 64);
  SetLength(Self.UnderlayIds, 4, 64, 64);
end;

(*
## Region.Create
```pascal
function TRegion.Create(id: Integer): TRegion; static;
function TRegion.Create(x, y: Integer): TRegion; static; overload;
```
An empty region at the given position, addressed either by its packed id or by its region
coordinates.

A region id packs its x into the high byte and its y into the low one, and each region covers 64
by 64 world tiles starting at `BaseX, BaseY`. The tile arrays are allocated but hold nothing
until {ref}`TRegion.LoadTerrain` fills them.
*)
function TRegion.Create(id: Integer): TRegion; static;
begin
  Result.RegionID := id;

  Result.X := (id shr 8) and $FF;
  Result.BaseX := Result.X shl 6;

  Result.Y := id and $FF;
  Result.BaseY := Result.Y shl 6;

  Result._InitArrays();
end;

function TRegion.Create(x, y: Integer): TRegion; static; overload;
begin
  Result.RegionID := (x shl 8) or y;

  Result.X := x;
  Result.BaseX := x shl 6;

  Result.Y := y;
  Result.BaseY := y shl 6;

  Result._InitArrays();
end;

(*
## Region.LoadTerrain
```pascal
procedure TRegion.LoadTerrain(constref map: TMapDefinition);
```
Expands a decoded {ref}`TMapDefinition` into the region's per-plane tile arrays.

A tile with no stored height falls back to the procedural terrain height, which depends only on
the tile's world x and y - not on its plane - so the whole region's worth is built in one pass
the first time any tile asks for it, and all four planes then read out of it.
*)
procedure TRegion.LoadTerrain(constref map: TMapDefinition);
var
  z, x, y, height, xOffset, yOffset: Integer;
  tile: TMapTile;
  procedural: TIntegerMatrix;
  heights, prevHeights, overlayIds, overlayPaths,
  overlayRotations, settings, underlayIds: TIntegerArray;
begin
  xOffset := Self.BaseX + $E3B7B;
  yOffset := Self.BaseY + $87CCE;

  for z := 0 to 3 do
    for x := 0 to 63 do
    begin
      heights          := Self.TileHeights[z, x];
      overlayIds       := Self.OverlayIds[z, x];
      overlayPaths     := Self.OverlayPaths[z, x];
      overlayRotations := Self.OverlayRotations[z, x];
      settings         := Self.TileSettings[z, x];
      underlayIds      := Self.UnderlayIds[z, x];
      if z > 0 then
        prevHeights := Self.TileHeights[z - 1, x];

      for y := 0 to 63 do
      begin
        tile := map.Tiles[z,x,y];

        if tile.Height = -1 then
        begin
          if procedural.IsEmpty then
            procedural := HeightCalc.CalculateArea(xOffset, yOffset, 64);
          height := procedural[x, y];
        end
        else
        begin
          height := tile.Height;
          if height = 1 then
            height := 0;
        end;

        if z = 0 then
          heights[y] := -height * 8
        else
          heights[y] := prevHeights[y] - height * 8;

        overlayIds[y]       := tile.OverlayId;
        overlayPaths[y]     := tile.OverlayPath;
        overlayRotations[y] := tile.OverlayRotation;
        settings[y]         := tile.Settings;
        underlayIds[y]      := tile.UnderlayId;
      end;
    end;
end;

(*
## Region.LoadLocations
```pascal
procedure TRegion.LoadLocations(constref locs: TLocationsDefinition);
```
Takes the region's object placements from a decoded {ref}`TLocationsDefinition`, converting each
one from a position within the region to a world coordinate.
*)
procedure TRegion.LoadLocations(constref locs: TLocationsDefinition);
var
  i: Integer;
begin
  SetLength(Self.Locations, Length(locs.Locations));
  for i := 0 to High(locs.Locations) do
  begin
    Self.Locations[i].ID := locs.Locations[i].ID;
    Self.Locations[i].LocType := locs.Locations[i].LocType;
    Self.Locations[i].Orientation := locs.Locations[i].Orientation;
    Self.Locations[i].X := Self.BaseX + locs.Locations[i].LocalX;
    Self.Locations[i].Y := Self.BaseY + locs.Locations[i].LocalY;
    Self.Locations[i].Z := locs.Locations[i].Height;
  end;
end;

(*
## Region.GetOverlayID
```pascal
function TRegion.GetOverlayID(z, x, y: Integer): Integer;
```
The ground overlay of one tile, or `0` if it has none.

The stored value keeps a flag in its top bit, which is masked off here.
*)
function TRegion.GetOverlayID(z, x, y: Integer): Integer;
begin
  Result := Self.OverlayIds[z,x,y] and $7FFF;
end;

(*
## Region.GetUnderlayID
```pascal
function TRegion.GetUnderlayID(z, x, y: Integer): Integer;
```
The ground underlay of one tile, or `0` if it has none, with the same flag bit masked off that
{ref}`TRegion.GetOverlayID` masks.
*)
function TRegion.GetUnderlayID(z, x, y: Integer): Integer;
begin
  Result := Self.UnderlayIds[z,x,y] and $7FFF;
end;

