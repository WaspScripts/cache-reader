(*
# Region Loader
Loads regions on demand and keeps track of which ones are in memory.

Ground colours blend across region boundaries, so a region is never useful on its own - see
{ref}`TRegionLoader.LoadRegionAndNeighbors`.
*)
{$include_once ../../reader/reader.simba}
{$include_once region.simba}

type
  TRegionLoader = record
    Regions: array of TRegion;  
    Lookup: TIntegerArray;
  end;

(*
## RegionLoader.BuildLookup
```pascal
procedure TRegionLoader.BuildLookup();
```
Builds the table that turns a region coordinate into an index into `Regions`.

It is a flat 256 by 256 array of indices rather than a search, since region coordinates are
bounded and small, and `-1` marks a coordinate with no region loaded. Already-built tables are
left alone; {ref}`TRegionLoader.LoadRegionAndNeighbors` keeps it up to date as it goes.
*)
procedure TRegionLoader.BuildLookup();
const
  LOOKUP_SIZE: Integer = 256*256;
var
  i, rx, ry: Integer;
begin
  if Length(Self.Lookup) = LOOKUP_SIZE then
    Exit;

  SetLength(Self.Lookup, LOOKUP_SIZE);
  FillMem(Self.Lookup[0], LOOKUP_SIZE * SizeOf(Integer), $FF); // -1 everywhere

  for i := 0 to High(Self.Regions) do
  begin
    rx := Self.Regions[i].X;
    ry := Self.Regions[i].Y;
    if InRange(rx, 0, 255) and InRange(ry, 0, 255) then
      Self.Lookup[(rx shl 8) or ry] := i;
  end;
end;

(*
## RegionLoader.RegionCoordinateIndex
```pascal
function TRegionLoader.RegionCoordinateIndex(x, y: Integer): Integer;
```
The index in `Regions` of the region at region coordinates `x, y`, or `-1` if it is not loaded.
*)
function TRegionLoader.RegionCoordinateIndex(x, y: Integer): Integer;
begin
  if not InRange(x, 0, 255) or not InRange(y, 0, 255) then
    Exit(-1);
  Result := Self.Lookup[(x shl 8) or y];
end;

(*
## RegionLoader.WorldCoordinateIndex
```pascal
function TRegionLoader.WorldCoordinateIndex(x, y: Integer): Integer;
```
{ref}`TRegionLoader.RegionCoordinateIndex` for a world tile rather than a region, so it is the
region that tile falls in.
*)
function TRegionLoader.WorldCoordinateIndex(x, y: Integer): Integer;
begin
  Result := Self.RegionCoordinateIndex(x shr 6, y shr 6);
end;


(*
## RegionLoader.RegionFileData
```pascal
function TRegionLoader.RegionFileData(id, fileID: Integer; out data: TByteArray): Boolean; static;
```
The bytes of one file of region `id`'s map archive - file `0` is its terrain and file `1` its
objects - or False if the map index holds no such archive or file.

Both are looked up by index rather than through `Value`, so a region that is simply empty world -
which most region ids are - costs one probe of each table and no copying at all.

The map index has to be cached first.
*)
function TRegionLoader.RegionFileData(id, fileID: Integer; out data: TByteArray): Boolean; static;
var
  archives: TArchiveArray;
  archiveIdx, fileIdx: Integer;
begin
  archiveIdx := CacheReader.Indices[ECacheIndex.MAPS].ReferenceTable.Archives.IndexOf(id);
  if archiveIdx = -1 then
    Exit;

  archives := CacheReader.Indices[ECacheIndex.MAPS].ReferenceTable.Archives.Values;

  fileIdx := archives[archiveIdx].Files.IndexOf(fileID);
  if fileIdx = -1 then
    Exit;

  data := archives[archiveIdx].Files.Values[fileIdx].Data;
  Result := not data.IsEmpty;
end;

(*
## RegionLoader.LoadMapDef
```pascal
function TRegionLoader.LoadMapDef(id: Integer; out map: TMapDefinition): Boolean;
```
Decodes the terrain of region `id`, returning False if the map index holds nothing for it -
which is the normal case for the many region ids that are simply empty world.

The map index has to be cached first.
*)
function TRegionLoader.LoadMapDef(id: Integer; out map: TMapDefinition): Boolean;
var
  data: TByteArray;
begin
  if not TRegionLoader.RegionFileData(id, 0, data) then
    Exit;

  map := TMapDefinition.Create(id shr 8, id and $FF, data);
  Result := True;
end;

(*
## RegionLoader.LoadLocDef
```pascal
function TRegionLoader.LoadLocDef(id: Integer; out locs: TLocationsDefinition): Boolean;
```
Decodes the object placements of region `id`, returning False if it has none.

A region that has terrain need not have objects, which is why this is separate from
{ref}`TRegionLoader.LoadMapDef`.
*)
function TRegionLoader.LoadLocDef(id: Integer; out locs: TLocationsDefinition): Boolean;
var
  data: TByteArray;
begin
  if not TRegionLoader.RegionFileData(id, 1, data) then
    Exit;

  locs := TLocationsDefinition.Create(id shr 8, id and $FF, data);
  Result := True;
end;


(*
## RegionLoader.LoadRegion
```pascal
function TRegionLoader.LoadRegion(id: Integer; out region: TRegion): Boolean;
```
Builds one region from the cache: its terrain, and its objects if it has any. Returns False if
there is no such region.
*)
function TRegionLoader.LoadRegion(id: Integer; out region: TRegion): Boolean;
var
  map: TMapDefinition;
  locs: TLocationsDefinition;
begin
  if not Self.LoadMapDef(id, map) then
    Exit;

  region := TRegion.Create(id);
  region.LoadTerrain(map);

  if Self.LoadLocDef(id, locs) then
    region.LoadLocations(locs);

  Result := True;
end;


(*
## RegionLoader.LoadRegionAndNeighbors
```pascal
function TRegionLoader.LoadRegionAndNeighbors(regionX, regionY: Integer): Boolean;
```
Loads the region at `regionX, regionY` along with the four next to it, and returns whether the
middle one exists.

The neighbours are needed because ground colours blend across region boundaries - without them
the map would show a seam at every edge. Regions already loaded are left alone, so calling this
per chunk while panning around only pays for what is new.
*)
function TRegionLoader.LoadRegionAndNeighbors(regionX, regionY: Integer): Boolean;
var
  region: TRegion;
  rx, ry: array [0..4] of Integer;
  i: Integer;
begin
  Self.BuildLookup();

  rx[0] := regionX;     ry[0] := regionY;     // center
  rx[1] := regionX - 1; ry[1] := regionY;     // left
  rx[2] := regionX + 1; ry[2] := regionY;     // right
  rx[3] := regionX;     ry[3] := regionY - 1; // down
  rx[4] := regionX;     ry[4] := regionY + 1; // up

  for i := 0 to 4 do
  begin
    if Self.RegionCoordinateIndex(rx[i], ry[i]) <> -1 then
    begin
      if i = 0 then
        Result := True;
      Continue;
    end;

    if Self.LoadRegion((rx[i] shl 8) or ry[i], region) then
    begin
      Self.Regions += region;
      if InRange(rx[i], 0, 255) and InRange(ry[i], 0, 255) then
        Self.Lookup[(rx[i] shl 8) or ry[i]] := High(Self.Regions);
      if i = 0 then
        Result := True;
    end;
  end;
end;

(*
## RegionLoader.LoadAllRegions
```pascal
procedure TRegionLoader.LoadAllRegions();
```
Loads every region the cache has, reporting progress as it goes.

This is minutes of work and gigabytes of memory - it is for dumping the whole world, not for
rendering part of it. {ref}`TRegionLoader.LoadRegionAndNeighbors` is what a map viewer wants.
*)
procedure TRegionLoader.LoadAllRegions();
const
  MAX_REGIONS: Integer = 25287;
var
  i, count: Integer;
  region: TRegion;
begin
  SetLength(Self.Regions, MAX_REGIONS);
  Self.BuildLookup();

  count := 0;

  for i := 0 to MAX_REGIONS-1 do
  begin
    if Self.LoadRegion(i, region) then
    begin
      Self.Regions[count] := region;

       if InRange(region.X, 0, 255) and InRange(region.Y, 0, 255) then
        Self.Lookup[(region.X shl 8) or region.Y] := count;
      Inc(count);
    end;

    if (i mod 100) = 0 then
      WriteLn('Progress: ', i, ' / ', MAX_REGIONS-1, ' (', count, ' regions loaded so far)');
  end;

  SetLength(Self.Regions, count);
end;

