(*
# Cache Index
An index is one category of cache content - models, sprites, maps, and so on - and is stored as
a `main_file_cache.idxN` file that says where each of its archives lives inside the single
`main_file_cache.dat2` data file.

{ref}`ECacheIndex` names the ones worth knowing about. {ref}`TCacheIndex` opens one and reads
its reference table; {ref}`TCacheIndex.Cache` unpacks its archives.
*)

{$DEFINE WL_CACHE_INDEX_INCLUDED}
{$IFNDEF WL_CACHE_REFTABLE_INCLUDED}  {$INCLUDE_ONCE reference_table.simba}  {$ENDIF}

type
  ECacheIndex = enum(
    ANIMATIONS, SKELETONS, CONFIGS, INTERFACES, SOUNDEFFECTS, MAPS, MUSIC_TRACKS,
    MODELS, SPRITES, TEXTURES, BINARY, MUSIC_JINGLES, CLIENTSCRIPT, FONTS,
    MUSIC_SAMPLES, MUSIC_PATCHES,
    WORLDMAP_GEOGRAPHY=18,
    WORLDMAP, WORLDMAP_GROUND, DBTABLEINDEX, ANIMAYAS,
    GAMEVALS=24
  );

  TCacheIndex = record
    ReferenceTable: TReferenceTable;
    ID, CRC: Integer;
    CompressionType: ECacheCompression;
    Whirlpool, MainData, Index255, IndexData: TByteArray;
    Cached: Boolean;
  end;

  TCacheReader = record
    Path: String;
    MainData, Index255Data: TByteArray;
    Indices: array of TCacheIndex;
  end;

(*
## CacheIndex.Create
```pascal
function TCacheIndex.Create(id: Integer; constref reader: TCacheReader): TCacheIndex; static;
function TCacheIndex.Create(id: ECacheIndex; constref reader: TCacheReader): TCacheIndex; static; overload;
```
Opens index `id` of `reader`'s cache by reading its `.idxN` file, and raises if that file is
missing.

This only opens the index. Its reference table is read by {ref}`TCacheIndex.Load`, which
{ref}`TCacheReader.Load` calls straight afterwards.
*)
function TCacheIndex.Create(id: Integer; constref reader: TCacheReader): TCacheIndex; static;
var
  path: String;
begin
  path := reader.Path + 'main_file_cache.idx' + ToStr(id);
  if not FileExists(path) then
    raise 'Cache Index ' + ToStr(id) + ' file does not exist.';

  Result.ID := id;
  Result.MainData := reader.MainData;
  Result.Index255 := reader.Index255Data;
  Result.ReferenceTable := TReferenceTable.Create(id);
  Result.IndexData := FileReadBytes(path);
end;

function TCacheIndex.Create(id: ECacheIndex; constref reader: TCacheReader): TCacheIndex; static; overload;
begin
  Result := TCacheIndex.Create(Ord(id), reader);
end;


(*
## CacheIndex.ReadArchiveSector
```pascal
function TCacheIndex.ReadArchiveSector(id, owner: Integer; constref data: TByteArray): TArchiveSector;
```
Reassembles archive `id` out of the data file and returns it still compressed - call
{ref}`TArchiveSector.Decompress` on the result to get at its contents.

`data` is the index table to look the archive up in, and `owner` is the index number the sectors
must be tagged with. An archive is not stored in one piece: the index gives its total size and
the position of its first sector, and every sector's header points at the next one. Each header
also repeats the archive id, the sector's position in the chain and the owning index, all of
which are checked as the chain is walked - anything that does not line up means the cache is
corrupt or the archive does not exist, and an empty sector is returned.
*)
function TCacheIndex.ReadArchiveSector(id, owner: Integer; constref data: TByteArray): TArchiveSector;
var
  sector: TArchiveSector;
  offset, position, size, readBytes, chunk,
  requiredToRead, sectorHeaderSize, sectorDataSize,
  sectorOffset, mainLength, maxPosition: Integer;
  big: Boolean;
begin
  offset := id * TArchiveSector.INDEX_SIZE;
  if (offset < 0) or (offset + TArchiveSector.INDEX_SIZE > Length(data)) then
    Exit;

  big := id > 65535;

  size     := Read24Bits(data, offset);
  position := Read24Bits(data, offset);

  mainLength  := Length(Self.MainData);
  maxPosition := mainLength div TArchiveSector.SECTOR_SIZE;

  if (size < 0) or not InRange(position, 1, maxPosition) then
    Exit;

  sector := TArchiveSector.Create(position, size, big);

  if big then
  begin
    sectorHeaderSize := TArchiveSector.HEADER_SIZE_BIG;
    sectorDataSize   := TArchiveSector.DATA_SIZE_BIG;
  end
  else
  begin
    sectorHeaderSize := TArchiveSector.HEADER_SIZE_SMALL;
    sectorDataSize   := TArchiveSector.DATA_SIZE_SMALL;
  end;

  while readBytes < size do
  begin
    if sector.Position = 0 then
      Exit;

    requiredToRead := Min(size - readBytes, sectorDataSize);

    sectorOffset := sector.Position * TArchiveSector.SECTOR_SIZE;
    if sectorOffset + sectorHeaderSize + requiredToRead > mainLength then
      Exit;

    offset := sectorOffset;

    if big then
      sector.ID := Read32Bits(Self.MainData, offset)
    else
      sector.ID := Read16Bits(Self.MainData, offset);

    if sector.ID <> id then
      Exit;

    sector.Chunk := Read16Bits(Self.MainData, offset);
    if sector.Chunk <> chunk then
      Exit;

    sector.NextPosition := Read24Bits(Self.MainData, offset);
    if (sector.NextPosition < 0) or (sector.NextPosition > maxPosition) then
      Exit;

    sector.Index := Read8Bits(Self.MainData, offset);
    if owner <> sector.Index then
      Exit;

    Move(Self.MainData[sectorOffset + sectorHeaderSize], sector.Data[readBytes], requiredToRead);
    Inc(readBytes, requiredToRead);

    sector.Position := sector.NextPosition;
    Inc(chunk);
  end;

  Result := sector;
end;


(*
## CacheIndex.Load
```pascal
procedure TCacheIndex.Load();
```
Reads this index's entry out of the master index, which is where its reference table lives, and
records the CRC and whirlpool digest of that entry.

The reference table is what says which archives the index holds and what is in them, so this
has to run before the index can be used for anything.
*)
procedure TCacheIndex.Load();
var
  sector: TArchiveSector;
  data: TByteArray;
  i, offset: Integer;
  digest: String;
begin
  if not InRange(Self.ID, 1, 255) then //TODO: check if min should be 0 (animations)
    Exit;

  sector := Self.ReadArchiveSector(Self.ID, 255, Self.Index255);
  if sector.Data.IsEmpty then
    Exit;

  Self.CRC := CrcData(@sector.Data[0], Length(sector.Data));
  digest := DigestData(EDigest.WHIRLPOOL, @sector.Data[0], Length(sector.Data));

  if Length(digest) < TArchiveSector.WHIRLPOOL_SIZE * 2 then
    raise 'Something is wrong with whirlpool digest';

  SetLength(Self.Whirlpool, TArchiveSector.WHIRLPOOL_SIZE);
  for i := 0 to TArchiveSector.WHIRLPOOL_SIZE - 1 do
    Self.Whirlpool[i] := (digest[i*2+1].ToHex() shl 4) or digest[i*2+2].ToHex();

  data := sector.Decompress();
  Self.ReferenceTable.Read(data, offset);
  Self.CompressionType := sector.CompressionType;
end;

(*
## CacheIndex.Cache
```pascal
procedure TCacheIndex.Cache();
```
Decompresses every archive in this index and splits it into its files, leaving the contents in
`ReferenceTable.Archives`.

This is the expensive step, and how expensive depends on the index - decompressing all of
`ECacheIndex.MAPS` unpacks well over a hundred megabytes. It is a no-op the second time, so
calling it before reaching for an archive's data is safe.

Example:
```pascal
CacheReader.Indices[ECacheIndex.CONFIGS].Cache();
archive := CacheReader.Indices[ECacheIndex.CONFIGS].ReferenceTable.Archives.Value[EConfigArchive.ITEM];
```
*)
procedure TCacheIndex.Cache();
var
  archives: TArchiveArray;
  sector: TArchiveSector;
  data: TByteArray;
  i, tailOffset, remaining, compressedFieldValue, revOffset: Integer;
begin
  if Self.Cached then
    Exit;

  archives := Self.ReferenceTable.Archives.Values;

  for i := 0 to High(archives) do
  begin
    sector := Self.ReadArchiveSector(archives[i].ID, Self.ID, Self.IndexData);
    if sector.Data.IsEmpty then
    begin
      archives[i].Files.Clear();
      Continue;
    end;

    data := sector.Decompress();
    archives[i].CompressionType := sector.CompressionType;

    if Length(data) > 0 then
      archives[i].Read(data);

    tailOffset := 1;
    compressedFieldValue := Read32Bits(sector.Data, tailOffset);
    remaining := Length(sector.Data) - (compressedFieldValue + tailOffset);

    if remaining >= 2 then
    begin
      revOffset := Length(sector.Data) - 2;
      archives[i].Revision := Read16Bits(sector.Data, revOffset);
    end;
  end;

  Self.Cached := True;
end;

