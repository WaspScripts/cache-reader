(*
# Cache Index
Cache index docs
*)
{$include_once ./reference_table.simba}

type
  ECacheIndex = enum(
    ANIMATIONS, SKELETONS, CONFIGS, INTERFACES, SOUNDEFFECTS, MAPS, MUSIC_TRACKS,
    MODELS, SPRITES, TEXTURES, BINARY, MUSIC_JINGLES, CLIENTSCRIPT, FONTS,
    MUSIC_SAMPLES, MUSIC_PATCHES,
    WORLDMAP_GEOGRAPHY=18,
    WORLDMAP, WORLDMAP_GROUND, DBTABLEINDEX, ANIMAYAS,
    GAMEVALS=24
  );

  TCacheIndex = record
    ReferenceTable: TReferenceTable;
    ID, CRC: Integer;
    CompressionType: ECacheCompression;
    Whirlpool, MainData, Index255, IndexData: TByteArray;
    Cached: Boolean;
  end;

  TCacheReader = record
    Path: String;
    MainData, Index255Data: TByteArray;
    Indices: array of TCacheIndex;
  end;

function TCacheIndex.Create(id: Integer; constref reader: TCacheReader): TCacheIndex; static;
var
  path: String;
begin
  path := reader.Path + 'main_file_cache.idx' + ToStr(id);
  if not FileExists(path) then
    raise 'Cache Index ' + ToStr(id) + ' file does not exist.';

  Result.ID := id;
  Result.MainData := reader.MainData;
  Result.Index255 := reader.Index255Data;
  Result.ReferenceTable := TReferenceTable.Create(id);
  Result.IndexData := FileReadBytes(path);
end;

function TCacheIndex.Create(id: ECacheIndex; constref reader: TCacheReader): TCacheIndex; static; overload;
begin
  Result := TCacheIndex.Create(Ord(id), reader);
end;


function TCacheIndex.ReadArchiveSector(id, owner: Integer; constref data: TByteArray): TArchiveSector;
var
  sector: TArchiveSector;
  offset, position, size, readBytes, chunk,
  requiredToRead, sectorHeaderSize, sectorDataSize,
  sectorOffset, mainLength, maxPosition: Integer;
  big: Boolean;
begin
  offset := id * TArchiveSector.INDEX_SIZE;
  if (offset < 0) or (offset + TArchiveSector.INDEX_SIZE > Length(data)) then
    Exit;

  big := id > 65535;

  size     := Read24Bits(data, offset);
  position := Read24Bits(data, offset);

  mainLength  := Length(Self.MainData);
  maxPosition := mainLength div TArchiveSector.SECTOR_SIZE;

  if (size < 0) or not InRange(position, 1, maxPosition) then
    Exit;

  sector := TArchiveSector.Create(position, size, big);

  if big then
  begin
    sectorHeaderSize := TArchiveSector.HEADER_SIZE_BIG;
    sectorDataSize   := TArchiveSector.DATA_SIZE_BIG;
  end
  else
  begin
    sectorHeaderSize := TArchiveSector.HEADER_SIZE_SMALL;
    sectorDataSize   := TArchiveSector.DATA_SIZE_SMALL;
  end;

  SetLength(sector.Data, size);
  while readBytes < size do
  begin
    if sector.Position = 0 then
      Exit;

    requiredToRead := Min(size - readBytes, sectorDataSize);

    sectorOffset := sector.Position * TArchiveSector.SECTOR_SIZE;
    if sectorOffset + sectorHeaderSize + requiredToRead > mainLength then
      Exit;

    offset := sectorOffset;

    sector.ID := sector.GetID(Self.MainData, offset);
    if sector.ID <> id then
      Exit;

    sector.Chunk := Read16Bits(Self.MainData, offset);
    if sector.Chunk <> chunk then
      Exit;

    sector.NextPosition := Read24Bits(Self.MainData, offset);
    if (sector.NextPosition < 0) or (sector.NextPosition > maxPosition) then
      Exit;

    sector.Index := Read8Bits(Self.MainData, offset);
    if owner <> sector.Index then
      Exit;

    Move(Self.MainData[sectorOffset + sectorHeaderSize], sector.Data[readBytes], requiredToRead);
    Inc(readBytes, requiredToRead);

    sector.Position := sector.NextPosition;
    Inc(chunk);
  end;

  Result := sector;
end;


procedure TCacheIndex.Load();
var
  sector: TArchiveSector;
  data: TByteArray;
  i, offset: Integer;
  digest: String;
begin
  if not InRange(Self.ID, 1, 255) then //TODO: check if min should be 0 (animations)
    Exit;

  sector := Self.ReadArchiveSector(Self.ID, 255, Self.Index255);
  if sector.Data.IsEmpty then
    Exit;

  Self.CRC := CrcData(@sector.Data[0], Length(sector.Data));
  digest := DigestData(EDigest.WHIRLPOOL, @sector.Data[0], Length(sector.Data));

  SetLength(Self.Whirlpool, TArchiveSector.WHIRLPOOL_SIZE);
  if Length(digest) < TArchiveSector.WHIRLPOOL_SIZE * 2 then
    raise 'Something is wrong with whirlpool digest';

  SetLength(Self.Whirlpool, TArchiveSector.WHIRLPOOL_SIZE);
  if Length(digest) < TArchiveSector.WHIRLPOOL_SIZE * 2 then
    raise 'Something is wrong with whirlpool digest';

  for i := 0 to TArchiveSector.WHIRLPOOL_SIZE - 1 do
    Self.Whirlpool[i] := (digest[i*2+1].ToHex() shl 4) or digest[i*2+2].ToHex();

  data := sector.Decompress();
  Self.ReferenceTable.Read(data, offset);
  Self.CompressionType := sector.CompressionType;
end;

procedure TCacheIndex.Cache();
var
  archive: TArchive;
  sector: TArchiveSector;
  data: TByteArray;
  tailOffset, remaining, compressedFieldValue, revOffset: Integer;
begin
  if Self.Cached then
    Exit;

  for archive in Self.ReferenceTable.Archives.Values do
  begin
    sector := Self.ReadArchiveSector(archive.ID, Self.ID, Self.IndexData);
    if Length(sector.Data) = 0 then
    begin
      archive.Files.Clear();
      Self.ReferenceTable.Archives.Value[archive.ID] := archive;
      Continue;
    end;

    data := sector.Decompress();
    archive.CompressionType := sector.CompressionType;

    if Length(data) > 0 then
      archive.Read(data);

    tailOffset := 1;
    compressedFieldValue := Read32Bits(sector.Data, tailOffset);
    remaining := Length(sector.Data) - (compressedFieldValue + tailOffset);

    if remaining >= 2 then
    begin
      revOffset := Length(sector.Data) - 2;
      archive.Revision := Read16Bits(sector.Data, revOffset);
    end;

    Self.ReferenceTable.Archives.Value[archive.ID] := archive;
  end;

  Self.Cached := True;
end;

