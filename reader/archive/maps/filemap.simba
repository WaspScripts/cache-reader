(*
# File Map
An id-keyed container for the {ref}`TFile` records of one archive.

`Values` is kept sorted by id and `HashSlots` is an open-addressed table pointing into it, so
lookups are constant time while iteration still comes out in id order.
*)

{$DEFINE WL_CACHE_FILEMAP_INCLUDED}
{$IFNDEF WL_CACHE_FILE_INCLUDED}    {$INCLUDE_ONCE ../file.simba}  {$ENDIF}

type
  TFileMap = record
    Keys, HashSlots: TIntegerArray;
    Values: TFileArray;
    Count, HashSize: Integer;
    IsSetup: Boolean;
  end;

(*
## MapHash
```pascal
function MapHash(key, size: Integer): Integer; static;
function MapHashSize(expectedCount: Integer): Integer; static;
```
`MapHash` is the slot a key hashes to in a table of `size` slots, and `MapHashSize` is the size
to give a table holding roughly `expectedCount` entries.

Ids are already well spread, so hashing one is only a fold back into range. Table sizes are
always powers of two - at least twice the expected count, so probing stays short - which makes
that fold a mask rather than a modulo, and lands a negative id in range without a correction.
Doubling a power of two leaves a power of two, so {ref}`TFileMap._Grow` keeps the property.
*)
function MapHash(key, size: Integer): Integer; static;
begin
  Result := key and (size - 1);
end;

function MapHashSize(expectedCount: Integer): Integer; static;
var
  wanted: Integer;
begin
  wanted := expectedCount * 2;
  Result := 16;
  while Result < wanted do
    Result := Result * 2;
end;


(*
## TFileMap._Init
```pascal
procedure TFileMap._Init(expectedCount: Integer);
```
Empties the map and sizes its hash table for roughly `expectedCount` entries.

The table is deliberately over-allocated - see {ref}`MapHashSize` - so that probing stays
short; {ref}`TFileMap._Grow` doubles it again if it ever fills past 60%.
*)
procedure TFileMap._Init(expectedCount: Integer);
begin
  Self.HashSize := MapHashSize(expectedCount);

  //dropping the arrays before resizing them hands back freshly zeroed memory, so the slots
  //do not have to be cleared by hand
  SetLength(Self.Keys, 0);
  SetLength(Self.Values, 0);
  SetLength(Self.HashSlots, 0);
  SetLength(Self.HashSlots, Self.HashSize);

  Self.Count := 0;
  Self.IsSetup := True;
end;

(*
## TFileMap._FindSlot
```pascal
function TFileMap._FindSlot(key: Integer): Integer;
```
The hash slot belonging to `key`: either the one already holding it, or the first free one after
where it hashes to. Collisions walk forward one slot at a time and wrap around.
*)
function TFileMap._FindSlot(key: Integer): Integer;
var
  slot: Integer;
begin
  if not Self.IsSetup then
    Self._Init(16);

  slot := MapHash(key, Self.HashSize);
  while (Self.HashSlots[slot] <> 0) and (Self.Keys[Self.HashSlots[slot] - 1] <> key) do
    slot := (slot + 1) and (Self.HashSize - 1);
  Result := slot;
end;

(*
## TFileMap._Grow
```pascal
procedure TFileMap._Grow();
```
Doubles the hash table and reinserts every key into it. Entry order is untouched - only the
slots that point at the entries are rebuilt.
*)
procedure TFileMap._Grow();
var
  i: Integer;
begin
  Self.HashSize := Self.HashSize * 2;

  SetLength(Self.HashSlots, 0);
  SetLength(Self.HashSlots, Self.HashSize);

  for i := 0 to High(Self.Keys) do
    Self.HashSlots[Self._FindSlot(Self.Keys[i])] := i + 1;
end;


(*
## FileMap.Build
```pascal
procedure TFileMap.Build(const keys: TIntegerArray; count: Integer);
```
Fills the map in one pass with an empty {ref}`TFile` per key, sizing the key, value and hash
arrays exactly once instead of regrowing them on every insert.

Only the first `count` entries of `keys` are used, so callers filling many maps in a row can
reuse one buffer. They must be in ascending order, which is how reference tables store them.
*)
procedure TFileMap.Build(const keys: TIntegerArray; count: Integer);
var
  i, slot, mask: Integer;
  slots: TIntegerArray;
  values: TFileArray;
begin
  Self.HashSize := MapHashSize(count);
  Self.Count := count;
  Self.IsSetup := True;

  //dropping the arrays before resizing them hands back freshly zeroed memory: empty slots, and
  //values that already look like the ones a Create() would return
  Self.Keys := Copy(keys, 0, count);
  SetLength(Self.Values, 0);
  SetLength(Self.Values, count);
  SetLength(Self.HashSlots, 0);
  SetLength(Self.HashSlots, Self.HashSize);

  //one map is built per archive of an index, so hundreds of thousands of them are built to open
  //a cache - hence the aliases, and the hash written out rather than called: at this scale the
  //field lookups and the call per key cost more than the probing does
  slots  := Self.HashSlots;
  values := Self.Values;
  mask   := Self.HashSize - 1;

  //the keys are distinct, so a slot is claimed by the first empty one rather than by _FindSlot
  for i := 0 to count - 1 do
  begin
    values[i].ID := keys[i];

    slot := keys[i] and mask;
    while slots[slot] <> 0 do
      slot := (slot + 1) and mask;

    slots[slot] := i + 1;
  end;
end;


(*
## TFileMap.Exists
```pascal
function TFileMap.Exists(key: Integer): Boolean;
```
Whether the map holds an entry with this id.
*)
function TFileMap.Exists(key: Integer): Boolean;
begin
  if not Self.IsSetup then
    Exit(False);
  Result := Self.HashSlots[Self._FindSlot(key)] <> 0;
end;

(*
## TFileMap.IndexOf
```pascal
function TFileMap.IndexOf(key: Integer): Integer;
```
The position of this id in `Values`, or `-1` if it is not in the map.
*)
function TFileMap.IndexOf(key: Integer): Integer;
var
  slot: Integer;
begin
  if not Self.IsSetup then
    Exit(-1);
  slot := Self._FindSlot(key);
  if Self.HashSlots[slot] = 0 then
    Result := -1
  else
    Result := Self.HashSlots[slot] - 1;
end;


(*
## TFileMap.Value
```pascal
property TFileMap.Value(key: Integer; const val: TFile);
property TFileMap.Value(key: Integer): TFile;
```
Reads or writes the file stored under `key`. Reading an id the map does not hold raises.

Writing keeps `Values` sorted by id. Appending an id above every existing one - which is how
reference tables arrive - only costs the append; inserting one in the middle has to shift the
entries after it and rebuild the hash table, so prefer {ref}`TFileMap.Build` when filling a map
from scratch.
*)
property TFileMap.Value(key: Integer; const val: TFile);
var
  slot, idx, i, insertPos: Integer;
begin
  if not Self.IsSetup then
    Self._Init(16);

  if (Length(Self.Keys) + 1) * 10 > Self.HashSize * 6 then
    Self._Grow();

  slot := Self._FindSlot(key);

  if Self.HashSlots[slot] <> 0 then
  begin
    Self.Values[Self.HashSlots[slot] - 1] := val;
    Exit;
  end;

  idx := Length(Self.Keys);
  if (idx = 0) or (key > Self.Keys[idx - 1]) then
  begin
    SetLength(Self.Keys, idx + 1);
    SetLength(Self.Values, idx + 1);
    Self.Keys[idx] := key;
    Self.Values[idx] := val;
    slot := Self._FindSlot(key);
    Self.HashSlots[slot] := idx + 1;
    Self.Count += 1;
  end
  else
  begin
    insertPos := 0;
    while (insertPos < idx) and (Self.Keys[insertPos] < key) do
      Inc(insertPos);

    SetLength(Self.Keys, idx + 1);
    SetLength(Self.Values, idx + 1);
    Self.Count += 1;

    for i := idx downto insertPos + 1 do
    begin
      Self.Keys[i] := Self.Keys[i - 1];
      Self.Values[i] := Self.Values[i - 1];
    end;
    Self.Keys[insertPos] := key;
    Self.Values[insertPos] := val;

    for i := 0 to Self.HashSize - 1 do
      Self.HashSlots[i] := 0;
    for i := 0 to idx do
      Self.HashSlots[Self._FindSlot(Self.Keys[i])] := i + 1;
  end;
end;

property TFileMap.Value(key: Integer): TFile;
var
  idx: Integer;
begin
  idx := Self.IndexOf(key);
  if idx = -1 then
    raise 'TFileMap: key ' + ToStr(key) + ' not found';
  Result := Self.Values[idx];
end;


(*
## TFileMap.Clear
```pascal
procedure TFileMap.Clear();
```
Drops every entry and the hash table with them, leaving the map as if it had never been used.
*)
procedure TFileMap.Clear();
begin
  SetLength(Self.Keys, 0);
  SetLength(Self.Values, 0);
  Self.Count := 0;
  Self.IsSetup := False;
end;

