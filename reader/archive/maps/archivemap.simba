(*
# Archive Map
An id-keyed container for the {ref}`TArchive` records of one index, laid out the same way
{ref}`TFileMap` is.

Config archives can also be addressed by their {ref}`EConfigArchive` name.
*)
{$include_once ../archive.simba}

type
  TArchiveMap = record
    Keys, HashSlots: TIntegerArray;
    Values: TArchiveArray;
    Count, HashSize: Integer;
    IsSetup: Boolean;
  end;

(*
## TArchiveMap._Init
```pascal
procedure TArchiveMap._Init(expectedCount: Integer);
```
Empties the map and sizes its hash table for roughly `expectedCount` entries.

The table is deliberately over-allocated - twice the expected count plus a margin - so that
probing stays short; {ref}`TArchiveMap._Grow` doubles it again if it ever fills past 60%.
*)
procedure TArchiveMap._Init(expectedCount: Integer);
begin
  Self.HashSize := expectedCount * 2 + 16;

  //dropping the arrays before resizing them hands back freshly zeroed memory, so the slots
  //do not have to be cleared by hand
  SetLength(Self.Keys, 0);
  SetLength(Self.Values, 0);
  SetLength(Self.HashSlots, 0);
  SetLength(Self.HashSlots, Self.HashSize);

  Self.Count := 0;
  Self.IsSetup := True;
end;

(*
## TArchiveMap._FindSlot
```pascal
function TArchiveMap._FindSlot(key: Integer): Integer;
```
The hash slot belonging to `key`: either the one already holding it, or the first free one after
where it hashes to. Collisions walk forward one slot at a time and wrap around.
*)
function TArchiveMap._FindSlot(key: Integer): Integer;
var
  slot: Integer;
begin
  if not Self.IsSetup then
    Self._Init(16);

  slot := MapHash(key, Self.HashSize);
  while (Self.HashSlots[slot] <> 0) and (Self.Keys[Self.HashSlots[slot] - 1] <> key) do
    slot := (slot + 1) mod Self.HashSize;
  Result := slot;
end;

(*
## TArchiveMap._Grow
```pascal
procedure TArchiveMap._Grow();
```
Doubles the hash table and reinserts every key into it. Entry order is untouched - only the
slots that point at the entries are rebuilt.
*)
procedure TArchiveMap._Grow();
var
  i: Integer;
begin
  Self.HashSize := Self.HashSize * 2;

  SetLength(Self.HashSlots, 0);
  SetLength(Self.HashSlots, Self.HashSize);

  for i := 0 to High(Self.Keys) do
    Self.HashSlots[Self._FindSlot(Self.Keys[i])] := i + 1;
end;


(*
## ArchiveMap.Build
```pascal
procedure TArchiveMap.Build(const keys: TIntegerArray; count: Integer);
```
Fills the map in one pass with an empty {ref}`TArchive` per key, sizing the key, value and hash
arrays exactly once instead of regrowing them on every insert.

Only the first `count` entries of `keys` are used, so callers filling many maps in a row can
reuse one buffer. They must be in ascending order, which is how reference tables store them.
*)
procedure TArchiveMap.Build(const keys: TIntegerArray; count: Integer);
var
  i, slot: Integer;
begin
  Self.HashSize := count * 2 + 16;
  Self.Count := count;
  Self.IsSetup := True;

  //dropping the arrays before resizing them hands back freshly zeroed memory: empty slots, and
  //values that already look like the ones a Create() would return
  Self.Keys := Copy(keys, 0, count);
  SetLength(Self.Values, 0);
  SetLength(Self.Values, count);
  SetLength(Self.HashSlots, 0);
  SetLength(Self.HashSlots, Self.HashSize);

  //the keys are distinct, so a slot is claimed by the first empty one rather than by _FindSlot
  for i := 0 to count - 1 do
  begin
    Self.Values[i].ID := keys[i];

    slot := MapHash(keys[i], Self.HashSize);
    while Self.HashSlots[slot] <> 0 do
      slot := (slot + 1) mod Self.HashSize;

    Self.HashSlots[slot] := i + 1;
  end;
end;


(*
## TArchiveMap.Exists
```pascal
function TArchiveMap.Exists(key: Integer): Boolean;
```
Whether the map holds an entry with this id.
*)
function TArchiveMap.Exists(key: Integer): Boolean;
begin
  if not Self.IsSetup then
    Exit(False);
  Result := Self.HashSlots[Self._FindSlot(key)] <> 0;
end;

(*
## TArchiveMap.IndexOf
```pascal
function TArchiveMap.IndexOf(key: Integer): Integer;
```
The position of this id in `Values`, or `-1` if it is not in the map.
*)
function TArchiveMap.IndexOf(key: Integer): Integer;
var
  slot: Integer;
begin
  if not Self.IsSetup then
    Exit(-1);
  slot := Self._FindSlot(key);
  if Self.HashSlots[slot] = 0 then
    Result := -1
  else
    Result := Self.HashSlots[slot] - 1;
end;


(*
## TArchiveMap.Value
```pascal
property TArchiveMap.Value(key: Integer; const val: TArchive);
property TArchiveMap.Value(key: Integer): TArchive;
(*
## TArchiveMap.Value
```pascal
property TArchiveMap.Value(key: EConfigArchive; const val: TArchive);
property TArchiveMap.Value(key: EConfigArchive): TArchive;
```
Overloads of {ref}`TArchiveMap.Value` for the config index, whose archives have names.
*)
property TArchiveMap.Value(key: EConfigArchive; const val: TArchive);
property TArchiveMap.Value(key: EConfigArchive): TArchive;
```
Reads or writes the archive stored under `key`, which may be an id or, for the config index, an
{ref}`EConfigArchive` name. Reading an id the map does not hold raises.

Writing keeps `Values` sorted by id, with the same trade-off {ref}`TFileMap.Value` describes.
*)
property TArchiveMap.Value(key: Integer; const val: TArchive);
var
  slot, idx, i, insertPos: Integer;
begin
  if not Self.IsSetup then
    Self._Init(16);

  if (Length(Self.Keys) + 1) * 10 > Self.HashSize * 6 then
    Self._Grow();

  slot := Self._FindSlot(key);

  if Self.HashSlots[slot] <> 0 then
  begin
    Self.Values[Self.HashSlots[slot] - 1] := val;
    Exit;
  end;

  idx := Length(Self.Keys);
  if (idx = 0) or (key > Self.Keys[idx - 1]) then
  begin
    SetLength(Self.Keys, idx + 1);
    SetLength(Self.Values, idx + 1); 
    Self.Count += 1;

    Self.Keys[idx] := key;
    Self.Values[idx] := val;

    slot := Self._FindSlot(key);
    Self.HashSlots[slot] := idx + 1;
  end
  else
  begin
    insertPos := 0;
    while (insertPos < idx) and (Self.Keys[insertPos] < key) do
      Inc(insertPos);

    SetLength(Self.Keys, idx + 1);
    SetLength(Self.Values, idx + 1);
    Self.Count += 1;

    for i := idx downto insertPos + 1 do
    begin
      Self.Keys[i] := Self.Keys[i - 1];
      Self.Values[i] := Self.Values[i - 1];
    end;

    Self.Keys[insertPos] := key;
    Self.Values[insertPos] := val;

    for i := 0 to Self.HashSize - 1 do
      Self.HashSlots[i] := 0;
    for i := 0 to idx do
      Self.HashSlots[Self._FindSlot(Self.Keys[i])] := i + 1;
  end;
end;

property TArchiveMap.Value(key: Integer): TArchive;
var
  idx: Integer;
begin
  idx := Self.IndexOf(key);
  if idx = -1 then
    raise 'TArchiveMap: key ' + ToStr(key) + ' not found';
  Result := Self.Values[idx];
end;

property TArchiveMap.Value(key: EConfigArchive; const val: TArchive);
begin
  Self.Value[Ord(key), val];
end;

property TArchiveMap.Value(key: EConfigArchive): TArchive;
begin
  Result := Self.Value[Ord(key)];
end;


(*
## TArchiveMap.Clear
```pascal
procedure TArchiveMap.Clear();
```
Drops every entry and the hash table with them, leaving the map as if it had never been used.
*)
procedure TArchiveMap.Clear();
begin
  SetLength(Self.Keys, 0);
  SetLength(Self.Values, 0);
  Self.Count := 0;
  Self.IsSetup := False;
end;

