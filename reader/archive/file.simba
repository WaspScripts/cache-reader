{$IFNDEF DISABLE_CACHEREADER_RANGE_CHECKS}{$R-}{$ENDIF}

type
  TFile = object
    ID, HashName: Integer;
    Data: TByteArray;
  end;
  TFileArray = array of TFile;

function TFile.Construct(id: Integer): TFile; static;
begin
  Result.ID := id;
  Result.Data := [];
  Result.HashName := 0;
end;

function TFile.Construct(id: Integer; const data: TByteArray): TFile; static; overload;
begin
  Result.ID := id;
  Result.Data := data;
  Result.HashName := 0;
end;

function TFile.Construct(id: Integer; const data: TByteArray; hashName: Integer): TFile; static; overload;
begin
  Result.ID := id;
  Result.Data := data;
  Result.HashName := hashName;
end;

function TFile.Construct(const other: TFile): TFile; static; overload;
begin
  Result.ID := other.ID;
  Result.Data := Copy(other.Data);
  Result.HashName := other.HashName;
end;

type
  TFileMap = record
    Keys: TIntegerArray;
    Values: TFileArray;
    HashSlots: TIntegerArray;
    HashSize: Integer;
    Initialized: Boolean;
  end;

function FMapHash(key, size: Integer): Integer;
begin
  Result := key mod size;
  if Result < 0 then
    Result := Result + size;
end;

procedure TFileMap.Init(expectedCount: Integer);
var
  i: Integer;
begin
  SetLength(Self.Keys, 0);
  SetLength(Self.Values, 0);
  Self.HashSize := expectedCount * 2 + 16;
  SetLength(Self.HashSlots, Self.HashSize);
  for i := 0 to Self.HashSize - 1 do
    Self.HashSlots[i] := 0;
  Self.Initialized := True;
end;

function TFileMap.FindSlot(key: Integer): Integer;
var
  slot: Integer;
begin
  if not Self.Initialized then
    Self.Init(16);

  slot := FMapHash(key, Self.HashSize);
  while (Self.HashSlots[slot] <> 0) and (Self.Keys[Self.HashSlots[slot] - 1] <> key) do
    slot := (slot + 1) mod Self.HashSize;
  Result := slot;
end;

function TFileMap.Exists(key: Integer): Boolean;
begin
  if not Self.Initialized then
    Exit(False);
  Result := Self.HashSlots[Self.FindSlot(key)] <> 0;
end;

function TFileMap.IndexOf(key: Integer): Integer;
var
  slot: Integer;
begin
  if not Self.Initialized then
    Exit(-1);
  slot := Self.FindSlot(key);
  if Self.HashSlots[slot] = 0 then
    Result := -1
  else
    Result := Self.HashSlots[slot] - 1;
end;


procedure TFileMap.Grow();
var
  i: Integer;
begin
  Self.HashSize := Self.HashSize * 2;
  SetLength(Self.HashSlots, Self.HashSize);
  for i := 0 to Self.HashSize - 1 do
    Self.HashSlots[i] := 0;
  for i := 0 to High(Self.Keys) do
    Self.HashSlots[Self.FindSlot(Self.Keys[i])] := i + 1;
end;

property TFileMap.Value(key: Integer; const val: TFile);
var
  slot, idx, i, insertPos: Integer;
begin
  if not Self.Initialized then
    Self.Init(16);

  if (Length(Self.Keys) + 1) * 10 > Self.HashSize * 6 then
    Self.Grow();

  slot := Self.FindSlot(key);

  if Self.HashSlots[slot] <> 0 then
  begin
    Self.Values[Self.HashSlots[slot] - 1] := val;
    Exit;
  end;

  idx := Length(Self.Keys);
  if (idx = 0) or (key > Self.Keys[idx - 1]) then
  begin
    SetLength(Self.Keys, idx + 1);
    SetLength(Self.Values, idx + 1);
    Self.Keys[idx] := key;
    Self.Values[idx] := val;
    slot := Self.FindSlot(key);
    Self.HashSlots[slot] := idx + 1;
  end
  else
  begin
    insertPos := 0;
    while (insertPos < idx) and (Self.Keys[insertPos] < key) do
      Inc(insertPos);

    SetLength(Self.Keys, idx + 1);
    SetLength(Self.Values, idx + 1);
    for i := idx downto insertPos + 1 do
    begin
      Self.Keys[i] := Self.Keys[i - 1];
      Self.Values[i] := Self.Values[i - 1];
    end;
    Self.Keys[insertPos] := key;
    Self.Values[insertPos] := val;

    for i := 0 to Self.HashSize - 1 do
      Self.HashSlots[i] := 0;
    for i := 0 to idx do
      Self.HashSlots[Self.FindSlot(Self.Keys[i])] := i + 1;
  end;
end;

property TFileMap.Value(key: Integer): TFile;
var
  idx: Integer;
begin
  idx := Self.IndexOf(key);
  if idx = -1 then
    raise 'TFileMap: key ' + ToStr(key) + ' not found';
  Result := Self.Values[idx];
end;

function TFileMap.Count(): Integer;
begin
  Result := Length(Self.Keys);
end;

property  TFileMap.ValueFromIndex(i: Integer): TFile;
begin
  Result := Self.Values[i];
end;

procedure TFileMap.Clear();
begin
  SetLength(Self.Keys, 0);
  SetLength(Self.Values, 0);
  Self.Initialized := False;
end;

procedure TFileMap.DeleteIndex(i: Integer);
var
  j: Integer;
begin
  for j := i to High(Self.Keys) - 1 do
  begin
    Self.Keys[j] := Self.Keys[j + 1];
    Self.Values[j] := Self.Values[j + 1];
  end;
  SetLength(Self.Keys, Length(Self.Keys) - 1);
  SetLength(Self.Values, Length(Self.Values) - 1);

  for j := 0 to Self.HashSize - 1 do
    Self.HashSlots[j] := 0;
  for j := 0 to High(Self.Keys) do
    Self.HashSlots[Self.FindSlot(Self.Keys[j])] := j + 1;
end;
{$R+}
