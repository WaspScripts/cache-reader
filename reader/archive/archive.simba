(*
# Archive
An archive is one addressable unit of an index, and holds one or more {ref}`TFile` records.

{ref}`EConfigArchive` names the archives of the config index, which is where item, object and
npc definitions live.
*)

{$DEFINE WL_CACHE_ARCHIVE_INCLUDED}

{$IFNDEF WL_CACHE_FILEMAP_INCLUDED}       {$INCLUDE_ONCE maps/filemap.simba}    {$ENDIF}
{$IFNDEF WL_CACHE_ARCHIVESECTOR_INCLUDED} {$INCLUDE_ONCE archive_sector.simba}  {$ENDIF}

type
  EConfigArchive = enum(
    UNDERLAY=1, IDENTKIT=3, OVERLAY=4, INV=5,
    OBJ=6, ENUMS=8, NPC=9, ITEM=10,
    PARAM=11, ANIMATION=12, SPOTANIM=13, VARBIT=14, VARCLIENTSTRING=15,
    VARPLAYER=16, VARCLIENT=19,
    HITSPLAT=32, HEALTHBAR=33, STRUCT=34, AREA=35,
    DBROW=38, DBTABLE=39,
    WORLDENTITY=72
  );

  TArchive = record
    ID, HashName, Revision, CRC,
    Checksum, CompressedLength, DecompressedLength: Integer;
    CompressionType: ECacheCompression;
    Whirlpool: TByteArray;
    XTEA: TIntegerArray;
    Files: TFileMap;
  end;

  TArchiveArray = array of TArchive;

(*
## Archive.Create
```pascal
function TArchive.Create(id: Integer): TArchive; static;
function TArchive.Create(id, hashName: Integer): TArchive; static; overload;
```
An empty archive with the given id, and optionally the hash of its name - see
{ref}`CacheString2Hash`. A named archive is assumed to be gzipped, which is what the cache uses
for everything it names.
*)
function TArchive.Create(id: Integer): TArchive; static;
begin
  Result.ID := id;
end;

function TArchive.Create(id, hashName: Integer): TArchive; static; overload;
begin
  Result := TArchive.Create(id);
  Result.HashName := hashName; 
  Result.CompressionType := ECacheCompression.GZIP;
end;

(*
## Archive.Read
```pascal
procedure TArchive.Read(const data: TByteArray);
```
Splits an archive's decompressed bytes across the files it holds.

An archive with one file is that file. With more than one, the bytes are interleaved in chunks -
a piece of every file, then another piece of every file - and a table at the end gives each
piece's size as a delta from the piece before it. So the sizes are summed in a first pass to
allocate each file, and a second pass copies the pieces into place, each file carrying how far
into its buffer the next piece goes.
*)
procedure TArchive.Read(const data: TByteArray);
var
  i, j, chunkCount, fileCount,
  dataOffset, tableOffset, tableStart, chunkSize: Integer;
  sizes, writeOffsets: TIntegerArray;
  files: TFileArray;
begin
  fileCount := Self.Files.Count;

  if fileCount = 0 then
    Exit;

  files := Self.Files.Values;

  if fileCount = 1 then
  begin
    files[0].Data := data;
    Exit;
  end;

  chunkCount := data.Last;
  SetLength(sizes, fileCount);
  SetLength(writeOffsets, fileCount);
  tableStart := Length(data) - 1 - (chunkCount * fileCount * 4);

  //calculate final file sizes.
  tableOffset := tableStart;
  for i := 0 to chunkCount - 1 do
  begin
    chunkSize := 0;
    for j := 0 to fileCount - 1 do
    begin
      chunkSize += Read32Bits(data, tableOffset);
      sizes[j] += chunkSize;
    end;
  end;

  //allocate buffers
  for i := 0 to fileCount - 1 do
    SetLength(files[i].Data, sizes[i]);

  //copy chunk data.
  dataOffset := 0;
  tableOffset := tableStart;

  for i := 0 to chunkCount - 1 do
  begin
    chunkSize := 0;
    for j := 0 to fileCount - 1 do
    begin
      chunkSize += Read32Bits(data, tableOffset);
      Move(data[dataOffset], files[j].Data[writeOffsets[j]], chunkSize);

      Inc(dataOffset, chunkSize);
      writeOffsets[j] += chunkSize;
    end;
  end;
end;

