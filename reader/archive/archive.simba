{$include_once ./file.simba}
{$include_once ./archive_sector.simba}
{$IFNDEF DISABLE_CACHEREADER_RANGE_CHECKS}{$R-}{$ENDIF}

type
  PArchive = ^TArchive;

  TArchive = object
    ID, HashName, Revision, CRC,
    Checksum, CompressedLength, DecompressedLength: Integer;

    CompressionType: ECacheCompression;
    Whirlpool: TByteArray;
    XTEA: TIntegerArray;

    HasRead, IsNew, NeedUpdate: Boolean;
    Files: TFileMap;
  end;

  TArchiveArray = array of TArchive;

function TArchive.Construct(id: Integer): TArchive; static;
begin
  Result.ID := id;
end;

function TArchive.Construct(id, hashName: Integer): TArchive; static; overload;
begin
  Result := new TArchive(id);
  Result.HashName := hashName; 
  Result.CompressionType := ECacheCompression.GZIP;
end;

function TArchive.Construct(const other: TArchive): TArchive; static; overload;
var
  _file: TFile;
begin
  Result.ID := other.ID;
  Result.HashName := other.HashName;
  Result.Revision := other.Revision;
  Result.CRC := other.CRC;
  Result.Whirlpool := Copy(other.Whirlpool);
  Result.XTEA := Copy(other.XTEA);

  for _file in other.Files.Values do
    Result.Files.Value[_file.ID] := new TFile(_file);
end;

function TArchive.ContainsData(): Boolean;
var
  _file: TFile;
begin
  for _file in Self.Files.Values do
    if _file.Data <> [] then
      Exit(True);
  Result := False;
end;


function TArchive.Contains(id: Integer): Boolean;
begin
  Result := Self.Files.Exists(id);
end;

function TArchive.Get(id: Integer): TFile;
begin
  Result := Self.Files.Value[id];
end;

function TArchive.FileIds(): TIntegerArray;
var
  files: TFileArray;
  i: Integer;
begin
  files := Self.Files.Values;
  SetLength(Result, Length(files));
  for i := 0 to High(files) do
    Result[i] := files[i].ID;
end;

function TArchive.CopyFiles(): TFileArray;
var
  files: TFileArray;
  i: Integer;
begin
  files := Self.Files.Values;
  SetLength(Result, Length(files));
  for i := 0 to High(files) do
    Result[i] := new TFile(files[i]);
end;

function TArchive.NextID(): Integer;
var
  count: Integer;
begin
  count := Self.Files.Count;
  if count = 0 then
    Exit(0);
  Result := Self.Files.ValueFromIndex[count-1].ID + 1;
end;


procedure TArchive.Restore();
var
  i: Integer;
  value: TFile;
begin
  for i := 0 to Self.Files.Count-1 do
  begin
    value := Self.Files.ValueFromIndex[i];
    value.Data := [];
    Self.Files.Value[value.ID] := value;
  end;
  Self.HasRead := False;
  Self.IsNew := False;
end;

function TArchive.Add(id: Integer; data: TByteArray; hashName: Integer = -1; overwrite: Boolean = True): TFile;
var
  idx: Integer;
  changed: Boolean;
begin
  idx := Self.Files.IndexOf(id);

  if idx = -1 then
  begin
    if hashName = -1 then
      Result := new TFile(id, data, 0)
    else
      Result := new TFile(id, data, hashName);
    Self.Files.Value[id] := Result;
    Self.NeedUpdate := True;
    Exit;
  end;

  Result := Self.Files.ValueFromIndex[idx];
  if not overwrite then
    Exit;

  changed := False;

  if not Result.Data.Equals(data) then
  begin
    Result.Data := data;
    changed := True;
  end;

  if (hashName <> -1) and (Result.HashName <> hashName) then
  begin
    Result.HashName := hashName;
    changed := True;
  end;

  if changed then
    Self.NeedUpdate := True;

  Self.Files.Value[id] := Result;
end;

function TArchive.Add(data: TByteArray): TFile; overload;
begin
  Result := Self.Add(Self.NextID(), data);
end;

procedure TArchive.Read(const data: TByteArray);
var
  chunkCount, fileCount: Integer;
  _file: TFile;
  sizes: TIntegerArray;
  dataOffset, tableOffset, chunkSize: Integer;
  i, j: Integer;
begin
  Self.HasRead := True;
  fileCount := Self.Files.Count;

  if fileCount = 0 then
    Exit;

  if fileCount = 1 then
  begin
    _file := Self.Files.ValueFromIndex[0];
    _file.Data := data;
    Exit;
  end;

  chunkCount := data.Last;
  SetLength(sizes, fileCount);
  tableOffset := Length(data) - 1 - (chunkCount * fileCount * 4);

  //calculate final file sizes.
  for i := 0 to chunkCount - 1 do
  begin
    chunkSize := 0;
    for j := 0 to fileCount - 1 do
    begin
      chunkSize += Read32Bit(data, tableOffset);
      sizes[j] += chunkSize;
    end;
  end;

  //allocate buffers
  for i := 0 to fileCount - 1 do
  begin
    _file := Self.Files.ValueFromIndex[i];
    SetLength(_file.Data, sizes[i]);
  end;

  //copy chunk data.
  dataOffset := 0;
  tableOffset := Length(data) - 1 - (chunkCount * fileCount * 4);

  for i := 0 to chunkCount - 1 do
  begin
    chunkSize := 0;
    for j := 0 to fileCount - 1 do
    begin
      chunkSize += Read32Bit(data, tableOffset);
      _file := Self.Files.ValueFromIndex[j];
      Move(data[dataOffset], _file.Data[Length(_file.Data) - sizes[j]], chunkSize);

      Inc(dataOffset, chunkSize);
      sizes[j] -= chunkSize;
    end;
  end;
end;

function TArchive.Write(): TByteArray;
var
  count, totalSize, offset, i, previous, fileSize: Integer;
begin
  count := Self.Files.Count;
  if count = 1 then
    Exit(Self.Files.ValueFromIndex[0].Data);

  totalSize := 1 + (count * 4);

  for i := 0 to count-1 do
    totalSize += Length(Self.Files.ValueFromIndex[i].Data);

  SetLength(Result, totalSize);

  offset := 0;

  for i := 0 to count-1 do
  begin
    Move(Self.Files.ValueFromIndex[i].Data[0], Result[offset], Length(Self.Files.ValueFromIndex[i].Data));
    Inc(offset, Length(Self.Files.ValueFromIndex[i].Data));
  end;

  previous := 0;

  for i := 0 to count-1 do
  begin
    fileSize := Length(Self.Files.ValueFromIndex[i].Data);
    fileSize := fileSize - previous;

    Result[offset] := fileSize shr 24;
    Result[offset + 1] := fileSize shr 16;
    Result[offset + 2] := fileSize shr 8;
    Result[offset + 3] := fileSize;

    Inc(offset, 4);

    previous := Length(Self.Files.ValueFromIndex[i].Data);
  end;

  Result[offset] := 1;
end;

function TArchive.GetRevisionBytes(): Integer;
begin
  if Self.Revision = -1 then
    Result := 0
  else
    Result := 2;
end;


type
  TArchiveMap = record
    Keys: TIntegerArray;
    Values: TArchiveArray;
    HashSlots: TIntegerArray;
    HashSize: Integer;
    Initialized: Boolean;
  end;

function AMapHash(key, size: Integer): Integer;
begin
  Result := key mod size;
  if Result < 0 then
    Result := Result + size;
end;

procedure TArchiveMap.Init(expectedCount: Integer);
var
  i: Integer;
begin
  SetLength(Self.Keys, 0);
  SetLength(Self.Values, 0);
  Self.HashSize := expectedCount * 2 + 16;
  SetLength(Self.HashSlots, Self.HashSize);
  for i := 0 to Self.HashSize - 1 do
    Self.HashSlots[i] := 0;
  Self.Initialized := True;
end;

function TArchiveMap.FindSlot(key: Integer): Integer;
var
  slot: Integer;
begin
  if not Self.Initialized then
    Self.Init(16);

  slot := AMapHash(key, Self.HashSize);
  while (Self.HashSlots[slot] <> 0) and (Self.Keys[Self.HashSlots[slot] - 1] <> key) do
    slot := (slot + 1) mod Self.HashSize;
  Result := slot;
end;

function TArchiveMap.Exists(key: Integer): Boolean;
begin
  if not Self.Initialized then
    Exit(False);
  Result := Self.HashSlots[Self.FindSlot(key)] <> 0;
end;

function TArchiveMap.IndexOf(key: Integer): Integer;
var
  slot: Integer;
begin
  if not Self.Initialized then
    Exit(-1);
  slot := Self.FindSlot(key);
  if Self.HashSlots[slot] = 0 then
    Result := -1
  else
    Result := Self.HashSlots[slot] - 1;
end;

procedure TArchiveMap.Grow();
var
  i: Integer;
begin
  Self.HashSize := Self.HashSize * 2;
  SetLength(Self.HashSlots, Self.HashSize);
  for i := 0 to Self.HashSize - 1 do
    Self.HashSlots[i] := 0;
  for i := 0 to High(Self.Keys) do
    Self.HashSlots[Self.FindSlot(Self.Keys[i])] := i + 1;
end;

property TArchiveMap.Value(key: Integer; const val: TArchive);
var
  slot, idx, i, insertPos: Integer;
begin
  if not Self.Initialized then
    Self.Init(16);

  if (Length(Self.Keys) + 1) * 10 > Self.HashSize * 6 then
    Self.Grow();

  slot := Self.FindSlot(key);

  if Self.HashSlots[slot] <> 0 then
  begin
    Self.Values[Self.HashSlots[slot] - 1] := val;
    Exit;
  end;

  idx := Length(Self.Keys);
  if (idx = 0) or (key > Self.Keys[idx - 1]) then
  begin
    SetLength(Self.Keys, idx + 1);
    SetLength(Self.Values, idx + 1);
    Self.Keys[idx] := key;
    Self.Values[idx] := val;
    slot := Self.FindSlot(key);
    Self.HashSlots[slot] := idx + 1;
  end
  else
  begin
    insertPos := 0;
    while (insertPos < idx) and (Self.Keys[insertPos] < key) do
      Inc(insertPos);

    SetLength(Self.Keys, idx + 1);
    SetLength(Self.Values, idx + 1);
    for i := idx downto insertPos + 1 do
    begin
      Self.Keys[i] := Self.Keys[i - 1];
      Self.Values[i] := Self.Values[i - 1];
    end;
    Self.Keys[insertPos] := key;
    Self.Values[insertPos] := val;

    for i := 0 to Self.HashSize - 1 do
      Self.HashSlots[i] := 0;
    for i := 0 to idx do
      Self.HashSlots[Self.FindSlot(Self.Keys[i])] := i + 1;
  end;
end;

property TArchiveMap.Value(key: Integer): TArchive;
var
  idx: Integer;
begin
  idx := Self.IndexOf(key);
  if idx = -1 then
    raise 'TArchiveMap: key ' + ToStr(key) + ' not found';
  Result := Self.Values[idx];
end;

property TArchiveMap.ValueFromIndex(i: Integer): TArchive;
begin
  Result := Self.Values[i];
end;

function TArchiveMap.Count(): Integer;
begin
  Result := Length(Self.Keys);
end;

procedure TArchiveMap.Clear();
begin
  SetLength(Self.Keys, 0);
  SetLength(Self.Values, 0);
  Self.Initialized := False;
end;

procedure TArchiveMap.DeleteIndex(i: Integer);
var
  j: Integer;
begin
  for j := i to High(Self.Keys) - 1 do
  begin
    Self.Keys[j] := Self.Keys[j + 1];
    Self.Values[j] := Self.Values[j + 1];
  end;
  SetLength(Self.Keys, Length(Self.Keys) - 1);
  SetLength(Self.Values, Length(Self.Values) - 1);

  for j := 0 to Self.HashSize - 1 do
    Self.HashSlots[j] := 0;
  for j := 0 to High(Self.Keys) do
    Self.HashSlots[Self.FindSlot(Self.Keys[j])] := j + 1;
end;
{$R+}

