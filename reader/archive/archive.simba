(*
# Archive
Types and methods to handle cache archives.
*)

{$include_once ./maps/filemap.simba}
{$include_once ./archive_sector.simba}

type
  EConfigArchive = enum(
    UNDERLAY=1, IDENTKIT=3, OVERLAY=4, INV=5,
    OBJ=6, ENUMS=8, NPC=9, ITEM=10,
    PARAM=11, ANIMATION=12, SPOTANIM=13, VARBIT=14, VARCLIENTSTRING=15,
    VARPLAYER=16, VARCLIENT=19,
    HITSPLAT=32, HEALTHBAR=33, STRUCT=34, AREA=35,
    DBROW=38, DBTABLE=39,
    WORLDENTITY=72
  );

  TArchive = record
    ID, HashName, Revision, CRC,
    Checksum, CompressedLength, DecompressedLength: Integer;
    CompressionType: ECacheCompression;
    Whirlpool: TByteArray;
    XTEA: TIntegerArray;
    Files: TFileMap;
  end;

  TArchiveArray = array of TArchive;

function TArchive.Create(id: Integer): TArchive; static;
begin
  Result.ID := id;
end;

function TArchive.Create(id, hashName: Integer): TArchive; static; overload;
begin
  Result := TArchive.Create(id);
  Result.HashName := hashName; 
  Result.CompressionType := ECacheCompression.GZIP;
end;

function TArchive.Create(const other: TArchive): TArchive; static; overload;
var
  _file: TFile;
begin
  Result.ID := other.ID;
  Result.HashName := other.HashName;
  Result.Revision := other.Revision;
  Result.CRC := other.CRC;
  Result.Whirlpool := Copy(other.Whirlpool);
  Result.XTEA := Copy(other.XTEA);

  for _file in other.Files.Values do
    Result.Files.Value[_file.ID] := TFile.Create(_file);
end;

function TArchive.ContainsData(): Boolean;
var
  _file: TFile;
begin
  for _file in Self.Files.Values do
    if not _file.Data.IsEmpty then
      Exit(True);
end;

function TArchive.FileIds(): TIntegerArray;
var
  files: TFileArray;
  i: Integer;
begin
  files := Self.Files.Values;
  SetLength(Result, Length(files));
  for i := 0 to High(files) do
    Result[i] := files[i].ID;
end;


procedure TArchive.Read(const data: TByteArray);
var
  i, j, chunkCount, fileCount,
  dataOffset, tableOffset, chunkSize: Integer;
  sizes: TIntegerArray;
begin
  fileCount := Self.Files.Count;

  if fileCount = 0 then
    Exit;

  if fileCount = 1 then
  begin
    Self.Files.Values[0].Data := data;
    Exit;
  end;

  chunkCount := data.Last;
  SetLength(sizes, fileCount);
  tableOffset := Length(data) - 1 - (chunkCount * fileCount * 4);

  //calculate final file sizes.
  for i := 0 to chunkCount - 1 do
  begin
    chunkSize := 0;
    for j := 0 to fileCount - 1 do
    begin
      chunkSize += Read32Bits(data, tableOffset);
      sizes[j] += chunkSize;
    end;
  end;

  //allocate buffers
  for i := 0 to fileCount - 1 do
    SetLength(Self.Files.Values[i].Data, sizes[i]);

  //copy chunk data.
  dataOffset := 0;
  tableOffset := Length(data) - 1 - (chunkCount * fileCount * 4);

  for i := 0 to chunkCount - 1 do
  begin
    chunkSize := 0;
    for j := 0 to fileCount - 1 do
    begin
      chunkSize += Read32Bits(data, tableOffset);
      Move(data[dataOffset], Self.Files.Values[j].Data[Length(Self.Files.Values[j].Data) - sizes[j]], chunkSize);

      Inc(dataOffset, chunkSize);
      sizes[j] -= chunkSize;
    end;
  end;
end;

