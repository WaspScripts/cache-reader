(*
# Archive Sector
An archive as it is stored: a chain of fixed size sectors scattered through the data file, still
compressed.

{ref}`TCacheIndex.ReadArchiveSector` walks that chain and hands back the bytes;
{ref}`TArchiveSector.Decompress` turns them into the archive's contents.
*)

{$DEFINE WL_CACHE_ARCHIVESECTOR_INCLUDED}
{$IFNDEF WL_CACHE_HELPERS_INCLUDED}  {$INCLUDE_ONCE ../../utils/helpers.simba}  {$ENDIF}

type
  ECacheCompression = enum(NONE, BZIP2, GZIP, LZMA);

  TArchiveSector = record
    ID, Index, Size, Position, Chunk, NextPosition: Integer;
    Big: Boolean;
    Data: TByteArray;

    CompressionType: ECacheCompression;

    const INDEX_SIZE: Integer = 6;
    const HEADER_SIZE_SMALL: Integer = 8;
    const HEADER_SIZE_BIG: Integer = 10;
    const DATA_SIZE_SMALL: Integer = 512;
    const DATA_SIZE_BIG: Integer = 510;
    const SECTOR_SIZE: Integer = 520;
    const WHIRLPOOL_SIZE: Integer = 64;
  end;

(*
## ArchiveSector.Create
```pascal
function TArchiveSector.Create(position, size: Integer; big: Boolean): TArchiveSector; static;
```
An empty sector chain of `size` bytes starting at `position` in the data file.

`big` marks an archive whose id needs 4 bytes rather than 2, which makes its sector headers two
bytes longer and leaves that much less room for data in each one.
*)
function TArchiveSector.Create(position, size: Integer; big: Boolean): TArchiveSector; static;
begin
  Result.Position := position;
  Result.Size := size;
  Result.Big := big;
  SetLength(Result.Data, size);
end;

(*
## ArchiveSector.Decompress
```pascal
function TArchiveSector.Decompress(): TByteArray;
```
The name of the function should be self explanatory, decompresses the compressed data in the
current archive sector.
*)
function TArchiveSector.Decompress(): TByteArray;
var
  offset, compressedLen, decompressedLen: Integer;
  compressed: TByteArray;
  compression: ECacheCompression;
  output: Pointer;
  size: Int64;
begin
  compression := ECacheCompression(Read8Bits(Self.Data, offset));
  Self.CompressionType := compression;

  compressedLen := Read32Bits(Self.Data, offset);

  if compression = ECacheCompression.NONE then
    Exit(Copy(Self.Data, offset, compressedLen));

  decompressedLen := Read32Bits(Self.Data, offset);

  //the payload is handed to the decompressor by pointer, so a length that runs off the end of a
  //truncated sector has to be clamped here - Copy() above would have clamped it for us
  if compressedLen > Length(Self.Data) - offset then
    compressedLen := Length(Self.Data) - offset;

  case compression of
    ECacheCompression.BZIP2:
    begin
      //bzip2 needs its 'BZh1' header prepended, the cache stores the payload without it
      SetLength(compressed, compressedLen + 4);
      compressed[0] := 66;
      compressed[1] := 90;
      compressed[2] := 104;
      compressed[3] := 49;
      Move(Self.Data[offset], compressed[4], compressedLen);
      DecompressData(ECompressAlgo.BZIP2, @compressed[0], compressedLen + 4, output, size);
    end;
    ECacheCompression.GZIP:  DecompressData(ECompressAlgo.GZ, @Self.Data[offset], compressedLen, output, size);
    ECacheCompression.LZMA:  DecompressData(ECompressAlgo.LZMA, @Self.Data[offset], compressedLen, output, size);
  end;

  if decompressedLen <> size then
    raise 'Decompressed expected length and actual length don''t match.';

  if size <= 0 then
    Exit;

  SetLength(Result, size);
  Move(output^, Result[0], size);
  FreeMem(output);
end;

