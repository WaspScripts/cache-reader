(*
## Archive Sector
Types and methods to handle archive sectors.
*)
{$include_once ../../utils/helpers.simba}

type
  ECacheCompression = enum(NONE, BZIP2, GZIP, LZMA);

  TArchiveSector = record
    ID, Index, Size, Position, Chunk, NextPosition: Integer;
    Big: Boolean;
    Data: TByteArray;

    CompressionType: ECacheCompression;

    GetID: function (constref data: TByteArray; var offset: Integer): Integer;
    const INDEX_SIZE: Integer = 6;
    const HEADER_SIZE_SMALL: Integer = 8;
    const HEADER_SIZE_BIG: Integer = 10;
    const DATA_SIZE_SMALL: Integer = 512;
    const DATA_SIZE_BIG: Integer = 510;
    const SECTOR_SIZE: Integer = 520;
    const WHIRLPOOL_SIZE: Integer = 64;
  end;

function TArchiveSector.Create(position, size: Integer; big: Boolean): TArchiveSector; static;
begin
  Result.Position := position;
  Result.Size := size;
  Result.Big := big;
  SetLength(Result.Data, size);

  if big then
    Result.GetID := @Read32Bits
  else
    Result.GetID := @Read16Bits;
end;

(*
## ArchiveSector.Read
```pascal
procedure TArchiveSector.Read(constref data: TByteArray; var offset: Integer);
```
Reads information about the archive sector.
`offset` should be "pointing" to the start of the sector information and will be modified to hold the
offset of what comes next.

This is not really used for anything as `CacheIndex.ReadArchiveSector` already does this
in a slightly more efficient way but you may use it if you need and know what you are doing.
*)
procedure TArchiveSector.Read(constref data: TByteArray; var offset: Integer);
begin
  Self.ID := Self.GetID(data, offset);
  Self.Chunk := Read16Bits(data, offset);
  Self.NextPosition := Read24Bits(data, offset);
  Self.Index := Read8Bits(data, offset);
end;


(*
## ArchiveSector.Decompress
```pascal
function TArchiveSector.Decompress(): TByteArray;
```
The name of the function should be self explanatory, decompresses the compressed data in the
current archive sector.
*)
function TArchiveSector.Decompress(): TByteArray;
var
  offset, compressedLen, decompressedLen: Integer;
  compressed: TByteArray;
  compression: ECacheCompression;
  output: Pointer;
  size: Int64;
begin
  compression := ECacheCompression(Read8Bits(Self.Data, offset));
  Self.CompressionType := compression;

  compressedLen := Read32Bits(Self.Data, offset);

  if compression = ECacheCompression.NONE then
    Exit(Copy(Self.Data, offset, compressedLen));

  decompressedLen := Read32Bits(Self.Data, offset);
  compressed := Copy(Self.Data, offset, compressedLen);

  case compression of
    ECacheCompression.BZIP2:
    begin
      compressed := [66,90,104,49] + compressed; //Add 'BZh1' bytes, the bzip2 header
      DecompressData(ECompressAlgo.BZIP2, @compressed[0], Length(compressed), output, size);
    end;
    ECacheCompression.GZIP:  DecompressData(ECompressAlgo.GZ, @compressed[0], Length(compressed), output, size);
    ECacheCompression.LZMA:  DecompressData(ECompressAlgo.LZMA, @compressed[0], Length(compressed), output, size);
  end;

  if decompressedLen <> size then
    raise 'Decompressed expected length and actual length don''t match.';

  if size <= 0 then
    Exit;

  SetLength(Result, size);
  Move(output^, Result[0], size);
  FreeMem(output);
end;

