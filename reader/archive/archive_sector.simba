function TArchiveSector.BZip2Decompress(compressed: TByteArray): TByteArray; static;
begin
  Result := BZip2FullDecompress(compressed);
end;

function TArchiveSector.GZipDecompress(compressed: TByteArray): TByteArray; static;
var
  outData: Pointer;
  outSize: Int64;
begin
  outData := nil;
  outSize := 0;

  DecompressData(ECompressAlgo.GZ, @compressed[0], Length(compressed), outData, outSize);
  if outSize <= 0 then
    Exit([]);

  SetLength(Result, outSize);
  Move(outData^, Result[0], outSize);
  FreeMem(outData);
end;

function TArchiveSector.LzmaDecompress(compressed: TByteArray): TByteArray; static; unimplemented;
begin
  raise 'TArchiveSector.LzmaDecompress: Not implemented.';
end;


function TArchiveSector.Decompress(): TByteArray;
var
  offset, compressedLen, decompressedLen: Integer;
  compressed: TByteArray;
  compression: ECacheCompression;
begin
  compression := ECacheCompression(Read8Bits(Self.Data, offset));
  Self.CompressionType := compression;

  compressedLen := Read32Bits(Self.Data, offset);

  if compression = ECacheCompression.NONE then
    Exit(Copy(Self.Data, offset, compressedLen));

  //not used but we need offset to skip these 4 bits anyway.
  decompressedLen := Read32Bits(Self.Data, offset);

  compressed := Copy(Self.Data, offset, compressedLen);

  case compression of
    ECacheCompression.BZIP2: Result := TArchiveSector.BZip2Decompress(compressed);
    ECacheCompression.GZIP:  Result := TArchiveSector.GZipDecompress(compressed);
    ECacheCompression.LZMA:  Result := TArchiveSector.LzmaDecompress(compressed);
  end;
end;
{$R+}
