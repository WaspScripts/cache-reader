{$include_once ./index.simba}
{$IFNDEF DISABLE_CACHEREADER_RANGE_CHECKS}{$R-}{$ENDIF}
//Type defined in index.simba

function TCacheReader.Construct(): TCacheReader; static;
begin
  Result.Path := {$IFDEF WINDOWS}GetEnvVar('USERPROFILE'){$ELSE}GetEnvVar('HOME'){$ENDIF} +
                 PATH_SEP + '.runelite' + PATH_SEP + 'jagexcache' + PATH_SEP + 'oldschool' +
                 PATH_SEP + 'LIVE' + PATH_SEP;
  Result.MainData := FileReadBytes(Result.Path + 'main_file_cache.dat2');
  Result.Index255Data := FileReadBytes(Result.Path + 'main_file_cache.idx255');
end;

procedure TCacheReader.Load();
var
  indicesLength, i: Integer;
begin
  Self.MainData := FileReadBytes(Self.Path + 'main_file_cache.dat2');
  Self.Index255Data := FileReadBytes(Self.Path + 'main_file_cache.idx255');

  indicesLength := Length(Self.Index255Data) div TArchiveSector.INDEX_SIZE;
  SetLength(Self.Indices, indicesLength);

  for i := 0 to indicesLength - 1 do
  begin
    Self.Indices[i] := new TCacheIndex(i, Self);
    if Self.Indices[i] <> nil then
      Self.Indices[i].Load();
  end;
end;
{$R+}
