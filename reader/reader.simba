{$include_once ./index.simba}

//Type defined in index.simba
procedure TCacheReader.Load();
var
  len, i: Integer;
begin
  Self.MainData := FileReadBytes(Self.Path + 'main_file_cache.dat2');
  Self.Index255Data := FileReadBytes(Self.Path + 'main_file_cache.idx255');

  len := Length(Self.Index255Data) div TArchiveSector.INDEX_SIZE;
  SetLength(Self.Indices, len);

  for i := 0 to len - 1 do
  begin
    Self.Indices[i] := TCacheIndex.Create(i, Self);
    Self.Indices[i].Load();
  end;
end;

function TCacheReader.Create(path: String): TCacheReader; static;
begin
  Result.Path := path + 'jagexcache' + PATH_SEP + 'oldschool' + PATH_SEP + 'LIVE' + PATH_SEP;
  Result.MainData := FileReadBytes(Result.Path + 'main_file_cache.dat2');
  Result.Index255Data := FileReadBytes(Result.Path + 'main_file_cache.idx255');
  Result.Load();
end;

function TCacheReader.Create(): TCacheReader; static; overload;
begin
  Result := TCacheReader.Create(
    {$IFDEF WINDOWS}GetEnvVar('USERPROFILE'){$ELSE}GetEnvVar('HOME'){$ENDIF} + PATH_SEP + '.runelite' + PATH_SEP
  );
end;

var
  CacheReader: TCacheReader;
