{$include_once ./archive/maps/archivemap.simba}

type
  TReferenceTable = record
    ID, Revision, Version, Mask: Integer;
    NeedUpdate: Boolean;
    Archives: TArchiveMap;
  end;

function TReferenceTable.Create(id: Integer): TReferenceTable; static;
begin
  Result.ID := id;
end;

function TReferenceTable.Contains(id: Integer): Boolean;
begin
  Result := Self.Archives.Exists(id);
end;



function TReferenceTable.HasName(): Boolean;
begin
  Result := (Self.Mask and $1) <> 0;
end;

function TReferenceTable.HasWhirlpool(): Boolean;
begin
  Result := (Self.Mask and $2) <> 0;
end;

function TReferenceTable.HasLengths(): Boolean;
begin
  Result := (Self.Mask and $4) <> 0;
end;

function TReferenceTable.HasChecksums(): Boolean;
begin
  Result := (Self.Mask and $8) <> 0;
end;


procedure TReferenceTable.Read(const data: TByteArray; var offset: Integer);
var
  named: Boolean;
  i, j, count, id: Integer;
  archives: TArchiveArray;
  fileCounts: TIntegerArray;
  _ReadFunc: function (constref data: TByteArray; var offset: Integer): Integer;
begin
  Self.Version := Read8Bits(data, offset);

  if not InRange(Self.Version, 5, 7) then
    raise 'Unknown version: ' + ToStr(Self.Version);

  if Self.Version >= 6 then
    Self.Revision := Read32Bits(data, offset)
  else
    Self.Revision := 0;

  Self.Mask := Read8Bits(data, offset);

  named := Self.HasName();

  if Self.Version >= 7 then
    _ReadFunc := @ReadBigSmart
  else
    _ReadFunc := @Read16Bits;

  count := _ReadFunc(data, offset);

  for i := 0 to count - 1 do
  begin
    id += _ReadFunc(data, offset);
    Self.Archives.Value[id] := TArchive.Create(id);
  end;

  archives := Self.Archives.Values;

  if named then
    for i := 0 to High(archives) do
      archives[i].HashName := Read32Bits(data, offset);

  for i := 0 to High(archives) do
    archives[i].CRC := Read32Bits(data, offset);

  if Self.HasChecksums() then
    for i := 0 to High(archives) do
      archives[i].Checksum := Read32Bits(data, offset);

  if Self.HasWhirlpool() then
    for i := 0 to High(archives) do
    begin
      SetLength(archives[i].Whirlpool, 64);
      Move(data[offset], archives[i].Whirlpool[0], 64);
      Inc(offset, 64);
    end;

  if Self.HasLengths() then
    for i := 0 to High(archives) do
    begin
      archives[i].CompressedLength := Read32Bits(data, offset);
      archives[i].DecompressedLength := Read32Bits(data, offset);
    end;

  for i := 0 to High(archives) do
    archives[i].Revision := Read32Bits(data, offset);

  SetLength(fileCounts, Self.Archives.Count);
  for i := 0 to High(archives) do
    fileCounts[i] := _ReadFunc(data, offset);

  for i := 0 to High(archives) do
  begin
    id := 0;
    for j := 0 to fileCounts[i] - 1 do
    begin
      id += _ReadFunc(data, offset);
      archives[i].Files.Value[id] := TFile.Create(id);
    end;
  end;

  if not named then
    Exit;

  for i := 0 to High(archives) do
    for j := 0 to archives[i].Files.Count - 1 do
      archives[i].Files.Values[j].HashName := Read32Bits(data, offset);
end;

function TReferenceTable.ArchiveID(const name: String): Integer;
var
  hash: Integer;
  archive: TArchive;
begin
  hash := CacheString2Hash(name);
  for archive in Self.Archives.Values do
    if archive.HashName = hash then
      Exit(archive.ID);
  Result := -1;
end;

