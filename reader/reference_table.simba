(*
# Reference Table
An index's catalogue: which archives it holds, which files are in each of them, and the
revisions and checksums of both.

It is read when the cache is opened, so what exists is known long before anything is
decompressed.
*)
{$include_once ./archive/maps/archivemap.simba}

type
  TReferenceTable = record
    ID, Revision, Version, Mask: Integer;
    NeedUpdate: Boolean;
    Archives: TArchiveMap;
  end;

(*
## ReferenceTable.Create
```pascal
function TReferenceTable.Create(id: Integer): TReferenceTable; static;
```
An empty reference table for index `id`. {ref}`TReferenceTable.Read` fills it in.
*)
function TReferenceTable.Create(id: Integer): TReferenceTable; static;
begin
  Result.ID := id;
end;

(*
## ReferenceTable.Contains
```pascal
function TReferenceTable.Contains(id: Integer): Boolean;
```
Whether this index holds an archive with the given id.
*)
function TReferenceTable.Contains(id: Integer): Boolean;
begin
  Result := Self.Archives.Exists(id);
end;



(*
## ReferenceTable flags
```pascal
function TReferenceTable.HasName(): Boolean;
function TReferenceTable.HasWhirlpool(): Boolean;
function TReferenceTable.HasLengths(): Boolean;
function TReferenceTable.HasChecksums(): Boolean;
```
Which optional fields this table stores for each of its archives.

The table's `Mask` is a bitfield that says which of the four are present, and they appear in
that order in the encoded table, so {ref}`TReferenceTable.Read` has to consult these to know
where each following field starts.
*)
function TReferenceTable.HasName(): Boolean;
begin
  Result := (Self.Mask and $1) <> 0;
end;

function TReferenceTable.HasWhirlpool(): Boolean;
begin
  Result := (Self.Mask and $2) <> 0;
end;

function TReferenceTable.HasLengths(): Boolean;
begin
  Result := (Self.Mask and $4) <> 0;
end;

function TReferenceTable.HasChecksums(): Boolean;
begin
  Result := (Self.Mask and $8) <> 0;
end;


(*
## ReferenceTable.Read
```pascal
procedure TReferenceTable.Read(const data: TByteArray; var offset: Integer);
```
Decodes an index's reference table: which archives it holds, which files are in each of them,
and the metadata the table carries about both.

The table is stored column by column rather than archive by archive - every archive's CRC, then
every archive's revision, and so on - so this makes one pass per field over the whole archive
list. Ids themselves are stored as deltas from the previous id, which is why they accumulate
and why they always come out ascending.

Version 7 tables write ids as {ref}`ReadBigSmart` because they can exceed 16 bits; earlier ones
always use 2 bytes. Anything outside versions 5 to 7 raises.

Opening a cache runs this over every index, which comes to some hundreds of thousands of ids and
as many again of per-archive fields, and it is the bulk of what {ref}`TCacheReader.Load` costs.
So the id and 32 bit reads are written out here rather than going through {ref}`ReadBigSmart` and
{ref}`Read32Bits` - a call per field is worth about a third of the running time at this scale -
and the version is branched on once instead of once per id.
*)
procedure TReferenceTable.Read(const data: TByteArray; var offset: Integer);
var
  named, bigIDs: Boolean;
  i, j, count, id, pos, fileCount: Integer;
  archives: TArchiveArray;
  files: TFileArray;
  fileCounts, ids: TIntegerArray;
begin
  Self.Version := Read8Bits(data, offset);

  if not InRange(Self.Version, 5, 7) then
    raise 'Unknown version: ' + ToStr(Self.Version);

  if Self.Version >= 6 then
    Self.Revision := Read32Bits(data, offset)
  else
    Self.Revision := 0;

  Self.Mask := Read8Bits(data, offset);

  named  := Self.HasName();
  bigIDs := Self.Version >= 7;

  if bigIDs then
    count := ReadBigSmart(data, offset)
  else
    count := Read16Bits(data, offset);

  pos := offset;

  SetLength(ids, count);
  if bigIDs then
    for i := 0 to count - 1 do
    begin
      if data[pos] < 128 then
      begin
        id += (data[pos] shl 8) or data[pos+1];
        Inc(pos, 2);
      end
      else
      begin
        id += ((data[pos] shl 24) or (data[pos+1] shl 16) or (data[pos+2] shl 8) or data[pos+3]) and $7FFFFFFF;
        Inc(pos, 4);
      end;
      ids[i] := id;
    end
  else
    for i := 0 to count - 1 do
    begin
      id += (data[pos] shl 8) or data[pos+1];
      Inc(pos, 2);
      ids[i] := id;
    end;

  Self.Archives.Build(ids, count);
  archives := Self.Archives.Values;

  if named then
    for i := 0 to High(archives) do
    begin
      archives[i].HashName := (data[pos] shl 24) or (data[pos+1] shl 16) or (data[pos+2] shl 8) or data[pos+3];
      Inc(pos, 4);
    end;

  for i := 0 to High(archives) do
  begin
    archives[i].CRC := (data[pos] shl 24) or (data[pos+1] shl 16) or (data[pos+2] shl 8) or data[pos+3];
    Inc(pos, 4);
  end;

  if Self.HasChecksums() then
    for i := 0 to High(archives) do
    begin
      archives[i].Checksum := (data[pos] shl 24) or (data[pos+1] shl 16) or (data[pos+2] shl 8) or data[pos+3];
      Inc(pos, 4);
    end;

  if Self.HasWhirlpool() then
    for i := 0 to High(archives) do
    begin
      SetLength(archives[i].Whirlpool, 64);
      Move(data[pos], archives[i].Whirlpool[0], 64);
      Inc(pos, 64);
    end;

  if Self.HasLengths() then
    for i := 0 to High(archives) do
    begin
      archives[i].CompressedLength := (data[pos] shl 24) or (data[pos+1] shl 16) or (data[pos+2] shl 8) or data[pos+3];
      archives[i].DecompressedLength := (data[pos+4] shl 24) or (data[pos+5] shl 16) or (data[pos+6] shl 8) or data[pos+7];
      Inc(pos, 8);
    end;

  for i := 0 to High(archives) do
  begin
    archives[i].Revision := (data[pos] shl 24) or (data[pos+1] shl 16) or (data[pos+2] shl 8) or data[pos+3];
    Inc(pos, 4);
  end;

  SetLength(fileCounts, Self.Archives.Count);
  count := 0;
  for i := 0 to High(archives) do
  begin
    if bigIDs and (data[pos] >= 128) then
    begin
      fileCount := ((data[pos] shl 24) or (data[pos+1] shl 16) or (data[pos+2] shl 8) or data[pos+3]) and $7FFFFFFF;
      Inc(pos, 4);
    end
    else
    begin
      fileCount := (data[pos] shl 8) or data[pos+1];
      Inc(pos, 2);
    end;

    fileCounts[i] := fileCount;
    if fileCount > count then
      count := fileCount;
  end;

  //one buffer big enough for the largest archive, reused for all of them
  SetLength(ids, count);

  for i := 0 to High(archives) do
  begin
    id := 0;
    fileCount := fileCounts[i];

    if bigIDs then
      for j := 0 to fileCount - 1 do
      begin
        if data[pos] < 128 then
        begin
          id += (data[pos] shl 8) or data[pos+1];
          Inc(pos, 2);
        end
        else
        begin
          id += ((data[pos] shl 24) or (data[pos+1] shl 16) or (data[pos+2] shl 8) or data[pos+3]) and $7FFFFFFF;
          Inc(pos, 4);
        end;
        ids[j] := id;
      end
    else
      for j := 0 to fileCount - 1 do
      begin
        id += (data[pos] shl 8) or data[pos+1];
        Inc(pos, 2);
        ids[j] := id;
      end;

    archives[i].Files.Build(ids, fileCount);
  end;

  if named then
    for i := 0 to High(archives) do
    begin
      files := archives[i].Files.Values;
      for j := 0 to High(files) do
      begin
        files[j].HashName := (data[pos] shl 24) or (data[pos+1] shl 16) or (data[pos+2] shl 8) or data[pos+3];
        Inc(pos, 4);
      end;
    end;

  offset := pos;
end;

(*
## ReferenceTable.ArchiveID
```pascal
function TReferenceTable.ArchiveID(const name: String): Integer;
```
The id of the archive named `name`, or `-1` if this index has no such archive.

The cache does not store names, only their hashes, so this compares against
{ref}`CacheString2Hash` of the name.

Example:
```pascal
id := CacheReader.Indices[ECacheIndex.SPRITES].ReferenceTable.ArchiveID('mapscene');
```
*)
function TReferenceTable.ArchiveID(const name: String): Integer;
var
  hash, i: Integer;
  archives: TArchiveArray;
begin
  hash := CacheString2Hash(name);
  archives := Self.Archives.Values;
  for i := 0 to High(archives) do
    if archives[i].HashName = hash then
      Exit(archives[i].ID);
  Result := -1;
end;

